{"chapters":[{"title":"Monotonic stack with a lower bound","code":"def verify_preorder(preorder):\n    low, stack = float(\"-inf\"), []\n    for v in preorder:\n        if v < low:\n            return False\n        while stack and stack[-1] < v:\n            low = stack.pop()                # entered this node's right subtree\n        stack.append(v)\n    return True","frames":[{"caption":"<strong>Monotonic stack with a lower bound</strong> &mdash; O(n) time, O(n) extra space. Input: <code>verify_preorder(preorder=[5, 2, 1, 3, 6])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>low, stack = float(\"-inf\"), []</code> &mdash; <code>low = -∞</code>; <code>stack = []</code>","line":2,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["low","-∞",1]],"stack":[]},{"caption":"<code>for v in preorder:</code> &mdash; <code>v = 5</code>","line":3,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["low","-∞",0],["v","5",1]],"stack":[]},{"caption":"<code>if v &lt; low:</code> &rarr; <strong>false</strong> (low = -∞, v = 5)","line":4,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["low","-∞",0],["v","5",0]],"stack":[]},{"caption":"<code>while stack and stack[-1] &lt; v:</code> &rarr; <strong>false</strong> (v = 5)","line":6,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["low",