rong> (low = -∞, v = 1)","line":4,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","2"],"cls":["",""]}],"vars":[["low","-∞",0],["v","1",0]],"stack":[]},{"caption":"<code>while stack and stack[-1] &lt; v:</code> &rarr; <strong>false</strong> (v = 1)","line":6,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","2"],"cls":["",""]}],"vars":[["low","-∞",0],["v","1",0]],"stack":[]},{"caption":"<code>stack.append(v)</code> &mdash; <code>stack</code> gets <code>1</code> appended","line":8,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","2","1"],"cls":["","","cur"]}],"vars":[["low","-∞",0],["v","1",0]],"stack":[]},{"caption":"<code>for v in preorder:</code> &mdash; <code>v = 3</code>","line":3,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","2","1"],"cls":["","",""]}],"vars":[["low","-∞",0],["v","3",1]],"stack":[]},{"caption":"<code>if v &lt; low:</code> &rarr; <strong>false</strong> (low = -∞, v = 3)","line":4,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","2","1"],"cls":["","",""]}],"vars":[["low","-∞",0],["v","3",0]],"stack":[]},{"caption":"<code>while stack and stack[-1] &lt; v:</code> &rarr; <strong>true</strong> (v = 3)","line":6,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","2","1"],"cls":["","",""]}],"vars":[["low","-∞",0],["v","3",0]],"stack":[]},{"caption":"<code>low = stack.pop()</code> &mdash; <code>low = 1</code>; <code>1</code> popped off the end of <code>stack</code>","line":7,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","2"],"cls":["",""]}],"vars":[["low","1",1],["v","3",0]],"stack":[]},{"caption":"<code>while stack and stack[-1] &lt; v:</code> &rarr; <strong>true</strong> (v = 3)","line":6,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","2"],"cls":["",""]}],"vars":[["low","1",0],["v","3",0]],"stack":[]},{"caption":"<code>low = stack.pop()</code> &mdash; <code>low = 2</code>; <code>2</code> popped off the end of <code>stack</code>","line":7,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5"],"cls":[""]}],"vars":[["low","2",1],["v","3",0]],"stack":[]},{"caption":"<code>while stack and stack[-1] &lt; v:</code> &rarr; <strong>false</strong> (v = 3)","line":6,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5"],"cls":[""]}],"vars":[["low","2",0],["v","3",0]],"stack":[]},{"caption":"<code>stack.append(v)</code> &mdash; <code>stack</code> gets <code>3</code> appended","line":8,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","3"],"cls":["","cur"]}],"vars":[["low","2",0],["v","3",0]],"stack":[]},{"caption":"<code>for v in preorder:</code> &mdash; <code>v = 6</code>","line":3,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","3"],"cls":["",""]}],"vars":[["low","2",0],["v","6",1]],"stack":[]},{"caption":"<code>if v &lt; low:</code> &rarr; <strong>false</strong> (low = 2, v = 6)","line":4,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","3"],"cls":["",""]}],"vars":[["low","2",0],["v","6",0]],"stack":[]},{"caption":"<code>while stack and stack[-1] &lt; v:</code> &rarr; <strong>true</strong> (v = 6)","line":6,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5","3"],"cls":["",""]}],"vars":[["low","2",0],["v","6",0]],"stack":[]},{"caption":"<code>low = stack.pop()</code> &mdash; <code>low = 3</code>; <code>3</code> popped off the end of <code>stack</code>","line":7,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5"],"cls":[""]}],"vars":[["low","3",1],["v","6",0]],"stack":[]},{"caption":"<code>while stack and stack[-1] &lt; v:</code> &rarr; <strong>true</strong> (v = 6)","line":6,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["5"],"cls":[""]}],"vars":[["low","3",0],["v","6",0]],"stack":[]},{"caption":"<code>low = stack.pop()</code> &mdash; <code>low = 5</code>; <code>5</code> popped off the end of <code>stack</code>","line":7,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["low","5",1],["v","6",0]],"stack":[]},{"caption":"<code>while stack and stack[-1] &lt; v:</code> &rarr; <strong>false</strong> (v = 6)","line":6,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["low","5",0],["v","6",0]],"stack":[]},{"caption":"<code>stack.append(v)</code> &mdash; <code>stack</code> gets <code>6</code> appended","line":8,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["6"],"cls":["cur"]}],"vars":[["low","5",0],["v","6",0]],"stack":[]},{"caption":"<code>for v in preorder:</code>","line":3,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["6"],"cls":[""]}],"vars":[["low","5",0],["v","6",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>. <strong>Result: T</strong>","line":9,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["6"],"cls":[""]}],"vars":[["low","5",0],["v","6",0]],"stack":[]}]},{"title":"Same idea, reusing the input as the stack","code":"def verify_preorder(preorder):\n    low, top = float(\"-inf\"), -1\n    for v in preorder:\n        if v < low:\n            return False\n        while top >= 0 and preorder[top] < v:\n            low = preorder[top]\n            top -= 1\n        top += 1\n        preorder[top] = v                    # the prefix doubles as the stack\n    return True","frames":[{"caption":"<strong>Same idea, reusing the input as the stack</strong> &mdash; O(n) time, O(1) extra space. Input: <code>verify_preorder(preorder=[5, 2, 1, 3, 6])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>low, top = float(\"-inf\"), -1</code> &mdash; <code>low = -∞</code>; <code>top = -1</code>","line":2,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]}],"vars":[["low","-∞",1],["top","-1",1]],"stack":[]},{"caption":"<code>for v in preorder:</code> &mdash; <code>v = 5</code>","line":3,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]}],"vars":[["low","-∞",0],["top","-1",0],["v","5",1]],"stack":[]},{"caption":"<code>if v &lt; low:</code> &rarr; <strong>false</strong> (low = -∞, v = 5)","line":4,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]}],"vars":[["low","-∞",0],["top","-1",0],["v","5",0]],"stack":[]},{"caption":"<code>while top &gt;= 0 and preorder[top] &lt; v:</code> &rarr; <strong>false</strong> (top = -1, v = 5)","line":6,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["","","","",""]}],"vars":[["low","-∞",0],["top","-1",0],["v","5",0]],"stack":[]},{"caption":"<code>top += 1</code> &mdash; <code>top = 0</code>","line":9,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["src","","","",""],"ptr":{"0":["top"]}}],"vars":[["low","-∞",0],["top","0",1],["v","5",0]],"stack":[]},{"caption":"<code>preorder[top] = v</code> <em>(the prefix doubles as the stack)</em>","line":10,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["src","","","",""],"ptr":{"0":["top"]}}],"vars":[["low","-∞",0],["top","0",0],["v","5",0]],"stack":[]},{"caption":"<code>for v in preorder:</code> &mdash; <code>v = 2</code>","line":3,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["src","","","",""],"ptr":{"0":["top"]}}],"vars":[["low","-∞",0],["top","0",0],["v","2",1]],"stack":[]},{"caption":"<code>if v &lt; low:</code> &rarr; <strong>false</strong> (low = -∞, v = 2)","line":4,"panels":[{"t":"arr","id":"preorder","label":"preorder","v":["5","2","1","3","6"],"cls":["src","","","",""],"ptr":{"0":["top"]}}],"vars":[["low","-∞",0],["top","0",0],["v","2",0]],"stack":[]},{"caption":"<code>while top &gt;= 0 and preorder[top] &lt; v:</code> &rarr; <strong>false</strong> (top = 0, v = 2)","line":6,"panels":[{"t":"arr","