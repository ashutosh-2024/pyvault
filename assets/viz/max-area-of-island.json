{"chapters":[{"title":"Recursive DFS returning the area","code":"def max_area_of_island(grid):\n    import sys\n    sys.setrecursionlimit(10 ** 6)\n    m, n = len(grid), len(grid[0])\n    seen = set()\n\n    def area(r, c):\n        if not (0 <= r < m and 0 <= c < n) or grid[r][c] == 0 or (r, c) in seen:\n            return 0\n        seen.add((r, c))\n        return 1 + area(r + 1, c) + area(r - 1, c) + area(r, c + 1) + area(r, c - 1)\n\n    return max(area(r, c) for r in range(m) for c in range(n))","frames":[{"caption":"<strong>Recursive DFS returning the area</strong> &mdash; O(m &middot; n) time, O(m &middot; n) extra space. Input: <code>max_area_of_island(grid=[[0, 0, 0]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","",""]]}],"vars":[],"stack":[]},{"caption":"<code>import sys</code>","line":2,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","",""]]}],"vars":[],"stack":[]},{"caption":"<code>sys.setrecursionlimit(10 ** 6)</code>","line":3,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","",""]]}],"vars":[],"stack":[]},{"caption":"<code>m, n = len(grid), len(grid[0])</code> &mdash; <code>m = 1</code>; <code>n = 3</code>","line":4,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","",""]]}],"vars":[["m","1",1],["n","3",1]],"stack":[]},{"caption":"<code>seen = set()</code> &mdash; <code>seen = set()</code>","line":5,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",1]],"stack":[]},{"caption":"<code>def area(r, c):</code>","line":7,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0]],"stack":[]},{"caption":"<code>return max(area(r, c) for r in range(m) for c in range(n))</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":13,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0]],"stack":["max_area_of_island(grid)","<genexpr>()"]},{"caption":"<code>return max(area(r, c) for r in range(m) for c in range(n))</code> &mdash; calls <code>area(r=0, c=0)</code>","line":13,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["src","",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["r","0",1],["c","0",1]],"stack":["max_area_of_island(grid)","<genexpr>()","area(r=0, c=0)"]},{"caption":"<code>if not (0 &lt;= r &lt; m and 0 &lt;= c &lt; n) or grid[r][c] == 0 or (r, c) in seen:</code> &rarr; <strong>true</strong> (c = 0, m = 1, n = 3, r = 0)","line":8,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["src","",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["r","0",0],["c","0",0]],"stack":["max_area_of_island(grid)","<genexpr>()","area(r=0, c=0)"]},{"caption":"<code>return 0</code> &mdash; <code>area</code> returns <code>0</code> to <code>&lt;genexpr&gt;</code>","line":9,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["src","",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["r","0",0],["c","0",0]],"stack":["max_area_of_island(grid)","<genexpr>()","area(r=0, c=0)"]},{"caption":"<code>return max(area(r, c) for r in range(m) for c in range(n))</code> &mdash; calls <code>area(r=0, c=1)</code>","line":13,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","src",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["r","0",0],["c","1",1]],"stack":["max_area_of_island(grid)","<genexpr>()","area(r=0, c=1)"]},{"caption":"<code>if not (0 &lt;= r &lt; m and 0 &lt;= c &lt; n) or grid[r][c] == 0 or (r, c) in seen:</code> &rarr; <strong>true</strong> (c = 1, m = 1, n = 3, r = 0)","line":8,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","src",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["r","0",0],["c","1",0]],"stack":["max_area_of_island(grid)","<genexpr>()","area(r=0, c=1)"]},{"caption":"<code>return 0</code> &mdash; <code>area</code> returns <code>0</code> to <code>&lt;genexpr&gt;</code>","line":9,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","src",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["r","0",0],["c","1",0]],"stack":["max_area_of_island(grid)","<genexpr>()","area(r=0, c=1)"]},{"caption":"<code>return max(area(r, c) for r in range(m) for c in range(n))</code> &mdash; calls <code>area(r=0, c=2)</code>","line":13,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","","src"]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["r","0",0],["c","2",1]],"stack":["max_area_of_island(grid)","<genexpr>()","area(r=0, c=2)"]},{"caption":"<code>if not (0 &lt;= r &lt; m and 0 &lt;= c &lt; n) or grid[r][c] == 0 or (r, c) in seen:</code> &rarr; <strong>true</strong> (c = 2, m = 1, n = 3, r = 0)","line":8,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","","src"]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["r","0",0],["c","2",0]],"stack":["max_area_of_island(grid)","<genexpr>()","area(r=0, c=2)"]},{"caption":"<code>return 0</code> &mdash; <code>area</code> returns <code>0</code> to <code>&lt;genexpr&gt;</code>","line":9,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","","src"]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["r","0",0],["c","2",0]],"stack":["max_area_of_island(grid)","<genexpr>()","area(r=0, c=2)"]},{"caption":"<code>return max(area(r, c) for r in range(m) for c in range(n))</code>","line":13,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","","src"]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["r","0",0],["c","2",0]],"stack":["max_area_of_island(grid)","<genexpr>()"]},{"caption":"<code>return max(area(r, c) for r in range(m) for c in range(n))</code> &mdash; yields <code>None</code>. <strong>Result: 0</strong>","line":13,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","","src"]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["r","0",0],["c","2",0]],"stack":["max_area_of_island(grid)","<genexpr>()"]}],"example":2},{"title":"Iterative flood fill with a stack","code":"def max_area_of_island(grid):\n    m, n = len(grid), len(grid[0])\n    seen, best = set(), 0\n    for r in range(m):\n        for c in range(n):\n            if grid[r][c] and (r, c) not in seen:\n                seen.add((r, c))\n                stack, size = [(r, c)], 0\n                while stack:\n                    x, y = stack.pop()\n                    size += 1\n                    for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n                        if 0 <= nx < m and 0 <= ny < n and grid[nx][ny] and (nx, ny) not in seen:\n                            seen.add((nx, ny))\n                            stack.append((nx, ny))\n                best = max(best, size)\n    return best","frames":[{"caption":"<strong>Iterative flood fill with a stack</strong> &mdash; O(m &middot; n) time, O(m &middot; n) extra space. Input: <code>max_area_of_island(grid=[[0, 0, 0]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","",""]]}],"vars":[],"stack":[]},{"caption":"<code>m, n = len(grid), len(grid[0])</code> &mdash; <code>m = 1</code>; <code>n = 3</code>","line":2,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","",""]]}],"vars":[["m","1",1],["n","3",1]],"stack":[]},{"caption":"<code>seen, best = set(), 0</code> &mdash; <code>seen = set()</code>; <code>best = 0</code>","line":3,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",1],["best","0",1]],"stack":[]},{"caption":"<code>for r in range(m):</code> &mdash; <code>r = 0</code>","line":4,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["best","0",0],["r","0",1]],"stack":[]},{"caption":"<code>for c in range(n):</code> &mdash; <code>c = 0</code>","line":5,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["src","",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["best","0",0],["r","0",0],["c","0",1]],"stack":[]},{"caption":"<code>if grid[r][c] and (r, c) not in seen:</code> &rarr; <strong>false</strong> (c = 0, r = 0)","line":6,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["src","",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["best","0",0],["r","0",0],["c","0",0]],"stack":[]},{"caption":"<code>for c in range(n):</code> &mdash; <code>c = 1</code>","line":5,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","src",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["best","0",0],["r","0",0],["c","1",1]],"stack":[]},{"caption":"<code>if grid[r][c] and (r, c) not in seen:</code> &rarr; <strong>false</strong> (c = 1, r = 0)","line":6,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","src",""]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["best","0",0],["r","0",0],["c","1",0]],"stack":[]},{"caption":"<code>for c in range(n):</code> &mdash; <code>c = 2</code>","line":5,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","","src"]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["best","0",0],["r","0",0],["c","2",1]],"stack":[]},{"caption":"<code>if grid[r][c] and (r, c) not in seen:</code> &rarr; <strong>false</strong> (c = 2, r = 0)","line":6,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","","src"]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["best","0",0],["r","0",0],["c","2",0]],"stack":[]},{"caption":"<code>for c in range(n):</code>","line":5,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","","src"]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["best","0",0],["r","0",0],["c","2",0]],"stack":[]},{"caption":"<code>for r in range(m):</code>","line":4,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","","src"]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["best","0",0],["r","0",0],["c","2",0]],"stack":[]},{"caption":"<code>return best</code> &mdash; returns <code>0</code>. <strong>Result: 0</strong>","line":17,"panels":[{"t":"grid","id":"grid","label":"grid","v":[["0","0","0"]],"cls":[["","","src"]]}],"vars":[["m","1",0],["n","3",0],["seen","set()",0],["best","0",0],["r","0",0],["c","2",0]],"stack":[]}],"example":2}]}