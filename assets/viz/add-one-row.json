l","1",0],["depth","3",0],["_","0",0]],"stack":[]}],"example":1},{"title":"DFS carrying the depth","code":"def add_one_row(root, val, depth):\n    if depth == 1:\n        return TreeNode(val, root, None)\n\n    def dfs(node, d):\n        if node is None:\n            return\n        if d == depth - 1:\n            node.left = TreeNode(val, node.left, None)\n            node.right = TreeNode(val, None, node.right)\n            return\n        dfs(node.left, d + 1)\n        dfs(node.right, d + 1)\n\n    dfs(root, 1)\n    return root","frames":[{"caption":"<strong>DFS carrying the depth</strong> &mdash; O(n) time, O(h) extra space. Input: <code>add_one_row(root=tree (4), val=1, depth=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4454444400","3",0.0,2.5,"",[]],["n4454347664","2",1.0,1.25,"",[]],["n4454442576","1",2.0,2.5,"",[]],["n4454570640","4",3.0,0.0,"cur",["root"]],["n4455899952","5",4.0,2.5,"",[]],["n4454347984","6",5.0,1.25,"",[]]],"edges":[["n4454570640","n4454347664","",""],["n4454347664","n4454444400","",""],["n4454347664","n4454442576","",""],["n4454570640","n4454347984","",""],["n4454347984","n4455899952","",""]],"dir":false}],"vars":[["val","1",0],["depth","3",0]],"stack":[]},{"caption":"<code>if depth == 1:</code> &rarr; <strong>false</strong> (depth = 3)","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4454444400","3",0.0,2.5,"",[]],["n4454347664","2",1.0,1.25,"",[]],["n4454442576","1",2.0,2.5,"",[]],["n4454570640","4",3.0,0.0,"cur",["root"]],["n4455899952","5",4.0,2.5,"",[]],["n4454347984","6",5.0,1.25,"",[]]],"edges":[["n4454570640","n4454347664","",""],["n4454347664","n4454444400","",""],["n4454347664","n4454442576","",""],["n4454570640","n4454347984","",""],["n4454347984","n4455899952","",""]],"dir":false}],"vars":[["val","1",0],["depth","3",0]],"stack":[]},{"caption":"<code>def dfs(node, d):</code>","line":5,"panels":[{"t":"net","id":"tree0","