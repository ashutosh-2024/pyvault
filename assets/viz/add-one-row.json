]],["n4389403568","3",5.0,1.25,"cur",["node"]],["n4393626304","9",6.0,2.5,"",[]]],"edges":[["n4394539984","n4389403408","",""],["n4389403408","n4395052224","",""],["n4389403408","n4395859536","",""],["n4394539984","n4389403568","",""],["n4389403568","n4395894864","",""],["n4389403568","n4393626304","",""]],"dir":false},{"t":"arr","id":"level","label":"level","v":["2","3"],"cls":["stack","stack"]}],"vars":[["val","9",0],["depth","3",0],["_","0",0]],"stack":[]}]},{"title":"DFS carrying the depth","code":"def add_one_row(root, val, depth):\n    if depth == 1:\n        return TreeNode(val, root, None)\n\n    def dfs(node, d):\n        if node is None:\n            return\n        if d == depth - 1:\n            node.left = TreeNode(val, node.left, None)\n            node.right = TreeNode(val, None, node.right)\n            return\n        dfs(node.left, d + 1)\n        dfs(node.right, d + 1)\n\n    dfs(root, 1)\n    return root","frames":[{"caption":"<strong>DFS carrying the depth</strong> &mdash; O(n) time, O(h) extra space. Input: <code>add_one_row(root=tree (1), val=9, depth=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4392450352","2",0.0,1.25,"",[]],["n4392580944","1",1.0,0.0,"cur",["root"]],["n4392450512","3",2.0,1.25,"",[]]],"edges":[["n4392580944","n4392450352","",""],["n4392580944","n4392450512","",""]],"dir":false}],"vars":[["val","9",0],["depth","3",0]],"stack":[]},{"caption":"<code>if depth == 1:</code> &rarr; <strong>false</strong> (depth = 3)","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4392450352","2",0.0,1.25,"",[]],["n4392580944","1",1.0,0.0,"cur",["root"]],["n4392450512","3",2.0,1.25,"",[]]],"edges":[["n4392580944","n4392450352","",""],["n4392580944","n4392450512","",""]],"dir":false}],"vars":[["val","9",0],["depth","3",0]],"stack":[]},{"caption":"<code>def dfs(node, d):</code>","line":5,"panels":[{"t":"net","id":"tree0","label":"tree","node