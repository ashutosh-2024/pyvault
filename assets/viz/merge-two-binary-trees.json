{"chapters":[{"title":"Recursive, reusing the first tree","code":"def merge_trees(root1, root2):\n    if root1 is None:\n        return root2          # whole subtree grafted, not walked\n    if root2 is None:\n        return root1\n    root1.val += root2.val\n    root1.left = merge_trees(root1.left, root2.left)\n    root1.right = merge_trees(root1.right, root2.right)\n    return root1","frames":[{"caption":"<strong>Recursive, reusing the first tree</strong> &mdash; O(min(n, m)) time, O(min(h, h')) extra space. Input: <code>merge_trees(root1=tree (1), root2=tree (2))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4424983344","1",0.0,1.25,"",[]],["n4424965920","4",1.0,2.5,"",[]],["n4425713520","2",2.0,0.0,"cur",["root2"]],["n4424965376","3",3.0,1.25,"",[]],["n4424994640","7",4.0,2.5,"",[]]],"edges":[["n4425713520","n4424983344","",""],["n4424983344","n4424965920","",""],["n4425713520","n4424965376","",""],["n4424965376","n4424994640","",""]],"dir":false},{"t":"net","id":"tree1","label":"tree (second)","nodes":[["n4422171872","5",0.0,2.5,"",[]],["n4422282256","3",1.0,1.25,"",[]],["n4425340912","1",2.0,0.0,"cur",["root1"]],["n4422280976","2",3.0,1.25,"",[]]],"edges":[["n4425340912","n4422282256","",""],["n4422282256","n4422171872","",""],["n4425340912","n4422280976","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>if root1 is None:</code> &rarr; <strong>false</strong>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4424983344","1",0.0,1.25,"",[]],["n4424965920","4",1.0,2.5,"",[]],["n4425713520","2",2.0,0.0,"cur",["root2"]],["n4424965376","3",3.0,1.25,"",[]],["n4424994640","7",4.0,2.5,"",[]]],"edges":[["n4425713520","n4424983344","",""],["n4424983344","n4424965920","",""],["n4425713520","n4424965376","",""],["n4424965376","n4424994640","",""]],"dir":false},{"t":"net","id":"tree1","label":"tree (second)","nodes":[["n4422171872","5",0.0,2.5,"",[]],["n4422