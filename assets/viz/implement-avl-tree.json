{"chapters":[{"title":"Recursive insert and delete with rebalance on the way up","code":"class AVLNode:\n    __slots__ = (\"key\", \"left\", \"right\", \"height\")\n\n    def __init__(self, key):\n        self.key, self.left, self.right, self.height = key, None, None, 1\n\n\ndef height(n):\n    return n.height if n else 0\n\n\ndef update(n):\n    n.height = 1 + max(height(n.left), height(n.right))\n\n\ndef balance_factor(n):\n    return height(n.left) - height(n.right)\n\n\ndef rotate_right(y):\n    x = y.left\n    y.left, x.right = x.right, y\n    update(y); update(x)                  # y is now below x: update it first\n    return x\n\n\ndef rotate_left(x):\n    y = x.right\n    x.right, y.left = y.left, x\n    update(x); update(y)\n    return y\n\n\ndef rebalance(n):\n    update(n)\n    bf = balance_factor(n)\n    if bf > 1:                            # left heavy\n        if balance_factor(n.left) < 0:    # LR: straighten it into LL first\n            n.left = rotate_left(n.left)\n        return rotate_right(n)            # LL\n    if bf < -1:                           # right heavy\n        if balance_factor(n.right) > 0:   # RL\n            n.right = rotate_right(n.right)\n        return rotate_left(n)             # RR\n    return n\n\n\nclass AVLTree:\n    def __init__(self):\n        self.root = None\n\n    def insert(self, key):\n        self.root = self._insert(self.root, key)\n\n    def _insert(self, n, key):\n        if n is None:\n            return AVLNode(key)\n        if key < n.key:\n            n.left = self._insert(n.left, key)\n        elif key > n.key:\n            n.right = self._insert(n.right, key)\n        else:\n            return n                      # already present\n        return rebalance(n)\n\n    def delete(self, key):\n        self.root = self._delete(self.root, key)\n\n    def _delete(self, n, key):\n        if n is None:\n            return None\n        if key < n.key:\n            n.left = self._delete(n.left, key)\n        elif key > n.key:\n            n.right = self._delete(n.right, key)\n        else:\n            if n.left is None:\n                return n.right\n            if n.right is None:\n                return n.left\n            succ = n.right                # two children: take the successor\n            while succ.left is not None:\n                succ = succ.left\n            n.key = succ.key\n            n.right = self._delete(n.right, succ.key)\n        return rebalance(n)\n\n    def __contains__(self, key):\n        n = self.root\n        while n is not None and n.key != key:\n            n = n.left if key < n.key else n.right\n        return n is not None\n\n    def inorder(self):\n        out, stack, n = [], [], self.root\n        while stack or n:\n            while n:\n                stack.append(n)\n                n = n.left\n            n = stack.pop()\n            out.append(n.key)\n            n = n.right\n        return out","frames":[{"caption":"<strong>Recursive insert and delete with rebalance on the way up</strong> &mdash; O(log n) per operation time, O(log n) recursion extra space. Running <code>t = AVLTree(); t.insert(k)</code>. Step through to watch the code work on this input.","line":49,"panels":[{"t":"arr","id":"self","label":"self","v":["A","V","L","T","r","e","e"],"cls":["","","","","","",""]}],"vars":[["self","'AVLTree'",0]],"stack":[]},{"caption":"<code>self.root = None</code> &mdash; returns <code>None</code>; <code>self.root = None</code>","line":50,"panels":[],"vars":[["self.root","None",1]],"stack":[]},{"caption":"<code>self.root = self._insert(self.root, key)</code> &mdash; calls <code>_insert(n=None, key=1)</code>","line":53,"panels":[],"vars":[["self.root","None",0],["key","1",1],["n","None",1]],"stack":["insert(key=1)","_insert(n=None, key=1)"]},{"caption":"<code>if n is None:</code> &rarr; <strong>true</strong> (n = None)","line":56,"panels":[],"vars":[["self.root","None",0],["key","1",0],["n","None",0]],"stack":["insert(key=1)","_insert(n=None, key=1)"]},{"caption":"<code>return AVLNode(key)</code> &mdash; calls <code>__init__(key=1)</code>","line":57,"panels":[{"t":"arr","id":"self","label":"self","v":["A","V","L","N","o","d","e"],"cls":["","","","cur","cur","cur",""]}],"vars":[["self.root","None",0],["key","1",0],["n","None",0],["self","'AVLNode'",1]],"stack":["insert(key=1)","_insert(n=None, key=1)","__init__(key=1)"]},{"caption":"<code>self.key, self.left, self.right, self.height = key, None, None, 1</code> &mdash; <code>__init__</code> returns <code>None</code> to <code>_insert</code>; <code>self</code> moves to <code>(1)</code>","line":5,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402482688","1",0.0,0.0,"cur",["self"]]],"edges":[],"dir":false}],"vars":[["self.root","None",0],["key","1",0],["n","None",0]],"stack":["insert(key=1)","_insert(n=None, key=1)","__init__(key=1)"]},{"caption":"<code>self.root = self._insert(self.root, key)</code> &mdash; calls <code>_insert(n=(1), key=2)</code>","line":53,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402482688","1",0.0,0.0,"cur",["self.root","n"]]],"edges":[],"dir":false}],"vars":[["key","2",1]],"stack":["insert(key=2)","_insert(n=(1), key=2)"]},{"caption":"<code>if n is None:</code> &rarr; <strong>false</strong>","line":56,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402482688","1",0.0,0.0,"cur",["self.root","n"]]],"edges":[],"dir":false}],"vars":[["key","2",0]],"stack":["insert(key=2)","_insert(n=(1), key=2)"]},{"caption":"<code>if key &lt; n.key:</code> &rarr; <strong>false</strong> (key = 2)","line":58,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402482688","1",0.0,0.0,"cur",["self.root","n"]]],"edges":[],"dir":false}],"vars":[["key","2",0]],"stack":["insert(key=2)","_insert(n=(1), key=2)"]},{"caption":"<code>elif key &gt; n.key:</code> &rarr; <strong>true</strong> (key = 2)","line":60,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402482688","1",0.0,0.0,"cur