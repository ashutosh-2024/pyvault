{"chapters":[{"title":"Inorder, link each node to the previous one","code":"def tree_to_doubly_list(root):\n    if root is None:\n        return None\n    head = prev = None\n\n    def walk(node):\n        nonlocal head, prev\n        if node is None:\n            return\n        walk(node.left)\n        if prev is None:\n            head = node\n        else:\n            prev.right, node.left = node, prev\n        prev = node\n        walk(node.right)\n\n    walk(root)\n    head.left, prev.right = prev, head         # close the circle\n    return head","frames":[{"caption":"<strong>Inorder, link each node to the previous one</strong> &mdash; O(n) time, O(h) extra space. Input: <code>tree_to_doubly_list(root=tree (4))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427918400","1",0.0,2.5,"",[]],["n4427818448","2",1.0,1.25,"",[]],["n4427919920","3",2.0,2.5,"",[]],["n4428045616","4",3.0,0.0,"cur",["root"]],["n4427813648","5",4.0,1.25,"",[]]],"edges":[["n4428045616","n4427818448","",""],["n4427818448","n4427918400","",""],["n4427818448","n4427919920","",""],["n4428045616","n4427813648","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>if root is None:</code> &rarr; <strong>false</strong>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427918400","1",0.0,2.5,"",[]],["n4427818448","2",1.0,1.25,"",[]],["n4427919920","3",2.0,2.5,"",[]],["n4428045616","4",3.0,0.0,"cur",["root"]],["n4427813648","5",4.0,1.25,"",[]]],"edges":[["n4428045616","n4427818448","",""],["n4427818448","n4427918400","",""],["n4427818448","n4427919920","",""],["n4428045616","n4427813648","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>head = prev = None</code> &mdash; <code>head = None</code>; <code>prev = None</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427918400","1",0.0,2.5,"",[]],["n4427818448","2",1.0,1.25,"",[]],["n4427919920","3",2