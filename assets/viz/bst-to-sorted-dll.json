{"chapters":[{"title":"Inorder, link each node to the previous one","code":"def tree_to_doubly_list(root):\n    if root is None:\n        return None\n    head = prev = None\n\n    def walk(node):\n        nonlocal head, prev\n        if node is None:\n            return\n        walk(node.left)\n        if prev is None:\n            head = node\n        else:\n            prev.right, node.left = node, prev\n        prev = node\n        walk(node.right)\n\n    walk(root)\n    head.left, prev.right = prev, head         # close the circle\n    return head","frames":[{"caption":"<strong>Inorder, link each node to the previous one</strong> &mdash; O(n) time, O(h) extra space. Input: <code>tree_to_doubly_list(root=tree (243))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4423359344","133",0.0,1.25,"",[]],["n4423419984","243",1.0,0.0,"cur",["root"]],["n4423364496","378",2.0,3.75,"",[]],["n4423452144","557",3.0,2.5,"",[]],["n4423453824","606",4.0,1.25,"",[]],["n4420727440","618",5.0,3.75,"",[]],["n4423893696","937",6.0,2.5,"",[]]],"edges":[["n4423419984","n4423359344","",""],["n4423419984","n4423453824","",""],["n4423453824","n4423452144","",""],["n4423452144","n4423364496","",""],["n4423453824","n4423893696","",""],["n4423893696","n4420727440","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>if root is None:</code> &rarr; <strong>false</strong>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4423359344","133",0.0,1.25,"",[]],["n4423419984","243",1.0,0.0,"cur",["root"]],["n4423364496","378",2.0,3.75,"",[]],["n4423452144","557",3.0,2.5,"",[]],["n4423453824","606",4.0,1.25,"",[]],["n4420727440","618",5.0,3.75,"",[]],["n4423893696","937",6.0,2.5,"",[]]],"edges":[["n4423419984","n4423359344","",""],["n4423419984","n4423453824","",""],["n4423453824","n4423452144","",""],["n4423452144","n4423364496","",""],["n4423453824","n4423893696","",""],["n4423893696","n44