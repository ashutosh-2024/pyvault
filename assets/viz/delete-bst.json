{"chapters":[{"title":"Recursive, replace with the successor","code":"def delete_node(root, key):\n    if root is None:\n        return None\n    if key < root.val:\n        root.left = delete_node(root.left, key)\n    elif key > root.val:\n        root.right = delete_node(root.right, key)\n    else:\n        if root.left is None:\n            return root.right            # leaf or right child only\n        if root.right is None:\n            return root.left             # left child only\n        succ = root.right                # two children: inorder successor\n        while succ.left is not None:\n            succ = succ.left\n        root.val = succ.val\n        root.right = delete_node(root.right, succ.val)\n    return root","frames":[{"caption":"<strong>Recursive, replace with the successor</strong> &mdash; O(h) time, O(h) extra space. Input: <code>delete_node(root=tree (5), key=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4424319056","2",0.0,2.5,"",[]],["n4420710352","3",1.0,1.25,"",[]],["n4424320272","4",2.0,2.5,"",[]],["n4424047248","5",3.0,0.0,"cur",["root"]],["n4420710032","6",4.0,1.25,"",[]],["n4424087120","7",5.0,2.5,"",[]]],"edges":[["n4424047248","n4420710352","",""],["n4420710352","n4424319056","",""],["n4420710352","n4424320272","",""],["n4424047248","n4420710032","",""],["n4420710032","n4424087120","",""]],"dir":false}],"vars":[["key","3",0]],"stack":[]},{"caption":"<code>if root is None:</code> &rarr; <strong>false</strong>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4424319056","2",0.0,2.5,"",[]],["n4420710352","3",1.0,1.25,"",[]],["n4424320272","4",2.0,2.5,"",[]],["n4424047248","5",3.0,0.0,"cur",["root"]],["n4420710032","6",4.0,1.25,"",[]],["n4424087120","7",5.0,2.5,"",[]]],"edges":[["n4424047248","n4420710352","",""],["n4420710352","n4424319056","",""],["n4420710352","n4424320272","",""],["n4424047248","n4420710032","",""],["n4420