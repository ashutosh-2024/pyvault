{"chapters":[{"title":"Count, then a size-k heap","code":"def top_k_frequent(nums, k):\n    counts = Counter(nums)\n    heap = []\n    for value, freq in counts.items():\n        heapq.heappush(heap, (freq, value))\n        if len(heap) > k:\n            heapq.heappop(heap)\n    return [value for freq, value in heap]","frames":[{"caption":"<strong>Count, then a size-k heap</strong> &mdash; O(n log k) time, O(n) extra space. Input: <code>top_k_frequent(nums=[1, 1, 1, 2, 2, 3], k=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","3"],"cls":["","","","","",""]}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>counts = Counter(nums)</code> &mdash; <code>counts = {1: 3, 2: 2, 3: 1}</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","3"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","2","1"],"cls":["","",""],"keys":["1","2","3"]}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>heap = []</code> &mdash; <code>heap = []</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","3"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","2","1"],"cls":["","",""],"keys":["1","2","3"]},{"t":"arr","id":"heap","label":"heap","v":[],"cls":[],"noidx":true}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>for value, freq in counts.items():</code> &mdash; <code>value = 1</code>; <code>freq = 3</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","3"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","2","1"],"cls":["","",""],"keys":["1","2","3"]},{"t":"arr","id":"heap","label":"heap","v":[],"cls":[],"noidx":true}],"vars":[["k","2",0],["value","1",1],["freq","3",1]],"stack":[]},{"caption":"<code>heapq.heappush(heap, (freq, value))</code> &mdash; <code>heap</code> g