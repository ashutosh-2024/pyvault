eq, value in heap]</code> &mdash; <code>value = 5</code>; <code>freq = 4</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["5","1","5","2","1","5","3","1","5"],"cls":["","","","","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["4","3","1","1"],"cls":["","","",""],"keys":["5","1","2","3"]},{"t":"arr","id":"heap","label":"heap","v":["3,1","4,5"],"cls":["",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h1","4,5",0.0,1.25,"",[]],["h0","3,1",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"heap"}],"vars":[["k","2",0],["value","5",1],["freq","4",1]],"stack":[]},{"caption":"<code>return [value for freq, value in heap]</code> &mdash; returns <code>[1, 5]</code>; <code>value = 3</code>; <code>freq = 1</code>. <strong>Result: [1, 5]</strong>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["5","1","5","2","1","5","3","1","5"],"cls":["","","","","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["4","3","1","1"],"cls":["","","",""],"keys":["5","1","2","3"]},{"t":"arr","id":"heap","label":"heap","v":["3,1","4,5"],"cls":["",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h1","4,5",0.0,1.25,"",[]],["h0","3,1",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"heap"},{"t":"arr","id":"result","label":"result","v":["1","5"],"cls":["answer","answer"]}],"vars":[["k","2",0],["value","3",1],["freq","1",1]],"stack":[]}],"example":1},{"title":"Bucket by frequency","code":"def top_k_frequent(nums, k):\n    counts = Counter(nums)\n    buckets = [[] for _ in range(len(nums) + 1)]\n    for value, freq in counts.items():\n        buckets[freq].append(value)\n\n    out = []\n    for freq in range(len(buckets) - 1, 0, -1):\n        for value in buckets[freq]:\n            out.append(value)\n            if len(out) == k:\n                return out\n    return out","frames":[{"caption":"<strong>Bucket by frequency</stro