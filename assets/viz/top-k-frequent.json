, value in heap]</code> &mdash; <code>value = 2</code>; <code>freq = 2</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","3"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","2","1"],"cls":["","",""],"keys":["1","2","3"]},{"t":"arr","id":"heap","label":"heap","v":["2,2","3,1"],"cls":["",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h1","3,1",0.0,1.25,"",[]],["h0","2,2",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"heap"}],"vars":[["k","2",0],["value","2",1],["freq","2",1]],"stack":[]},{"caption":"<code>return [value for freq, value in heap]</code> &mdash; <code>value = 1</code>; <code>freq = 3</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","3"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","2","1"],"cls":["","",""],"keys":["1","2","3"]},{"t":"arr","id":"heap","label":"heap","v":["2,2","3,1"],"cls":["",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h1","3,1",0.0,1.25,"",[]],["h0","2,2",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"heap"}],"vars":[["k","2",0],["value","1",1],["freq","3",1]],"stack":[]},{"caption":"<code>return [value for freq, value in heap]</code> &mdash; returns <code>[2, 1]</code>; <code>value = 3</code>; <code>freq = 1</code>. <strong>Result: [2, 1]</strong>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","3"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","2","1"],"cls":["","",""],"keys":["1","2","3"]},{"t":"arr","id":"heap","label":"heap","v":["2,2","3,1"],"cls":["",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h1","3,1",0.0,1.25,"",[]],["h0","2,2",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"heap"},{"t":"arr","id":"result","label":"result","v":["2","1"],"cls":["answer","answer"]}],"vars":[["k","2",0],["value","3",1],["freq","1",1]],"stack":[]}]},{"title":"Bucket by frequency","code":"def top_k_frequent(nums, k):\n    counts = Counter(nums)\n    buckets = [[] for _ in range(len(nums) + 1)]\n    for value, freq in counts.items():\n        buckets[freq].append(value)\n\n    out = []\n    for freq in range(len(buckets) - 1, 0, -1):\n        for value in buckets[freq]:\n            out.append(value)\n            if len(out) == k:\n                return out\n    return out","frames":[{"caption":"<strong>Bucket by frequency</strong> &mdash; O(n) time, O(n) extra space. Input: <code>top_k_frequent(nums=[4, 4, 4, 5, 5, 6], k=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","4","4","5","5","6"],"cls":["","","","","",""]}],"vars":[["k","3",0]],"stack":[]},{"caption":"<code>counts = Counter(nums)</code> &mdash; <code>counts = {4: 3, 5: 2, 6: 1}</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","4","4","5","5","6"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","2","1"],"cls":["","",""],"keys":["4","5","6"]}],"vars":[["k","3",0]],"stack":[]},{"caption":"<code>buckets = [[] for _ in range(len(nums) + 1)]</code> &mdash; <code>_ = 0</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","4","4","5","5","6"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","2","1"],"cls":["","",""],"keys":["4","5","6"]}],"vars":[["k","3",0],["_","0",1]],"stack":[]},{"caption":"<code>buckets = [[] for _ in range(len(nums) + 1)]</code> &mdash; <code>_ = 1</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","4","4","5","5","6"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","2","1"],"cls":["","",""],"keys":["4","5","6"]}],"vars":[["k","3",0],["_","1",1]],"stack":[]},{"caption":"<code>