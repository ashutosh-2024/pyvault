{"chapters":[{"title":"String reversal, range check","code":"def reverse(x):\n    sign = -1 if x < 0 else 1\n    r = sign * int(str(abs(x))[::-1])\n    return r if -2 ** 31 <= r <= 2 ** 31 - 1 else 0","frames":[{"caption":"<strong>String reversal, range check</strong> &mdash; O(digits) time, O(digits) extra space. Input: <code>reverse(x=123)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","123",0]],"stack":[]},{"caption":"<code>sign = -1 if x &lt; 0 else 1</code> &mdash; <code>sign = 1</code>","line":2,"panels":[],"vars":[["x","123",0],["sign","1",1]],"stack":[]},{"caption":"<code>r = sign * int(str(abs(x))[::-1])</code> &mdash; <code>r = 321</code>","line":3,"panels":[],"vars":[["x","123",0],["sign","1",0],["r","321",1]],"stack":[]},{"caption":"<code>return r if -2 ** 31 &lt;= r &lt;= 2 ** 31 - 1 else 0</code> &mdash; returns <code>321</code>. <strong>Result: 321</strong>","line":4,"panels":[],"vars":[["x","123",0],["sign","1",0],["r","321",0]],"stack":[]}]},{"title":"Pop and push digits, check before overflowing","code":"def reverse(x):\n    limit = 2 ** 31 - 1 if x >= 0 else 2 ** 31     # |INT_MIN| = 2^31\n    n, result = abs(x), 0\n    while n:\n        n, digit = divmod(n, 10)\n        if result > (limit - digit) // 10:\n            return 0                               # would overflow\n        result = result * 10 + digit\n    return result if x >= 0 else -result","frames":[{"caption":"<strong>Pop and push digits, check before overflowing</strong> &mdash; O(digits) time, O(1) extra space. Input: <code>reverse(x=-120)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","-120",0]],"stack":[]},{"caption":"<code>limit = 2 ** 31 - 1 if x &gt;= 0 else 2 ** 31</code> &mdash; <code>limit = 2147483648</code> <em>(|INT_MIN| = 2^31)</em>","line":2,"panels":[],"vars":[["x","-120",0],["limit","2147483648",1]],"stack":[]},{"caption":"<code>n, result = abs(x), 0</code> &mdash; <code>n = 120</code>; <code>result = 0</code>","line":3,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","120",1],["result","0",1]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>true</strong> (n = 120)","line":4,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","120",0],["result","0",0]],"stack":[]},{"caption":"<code>n, digit = divmod(n, 10)</code> &mdash; <code>n = 12</code>; <code>digit = 0</code>","line":5,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","12",1],["result","0",0],["digit","0",1]],"stack":[]},{"caption":"<code>if result &gt; (limit - digit) // 10:</code> &rarr; <strong>false</strong> (digit = 0, limit = 2147483648, result = 0)","line":6,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","12",0],["result","0",0],["digit","0",0]],"stack":[]},{"caption":"<code>result = result * 10 + digit</code>","line":8,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","12",0],["result","0",0],["digit","0",0]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>true</strong> (n = 12)","line":4,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","12",0],["result","0",0],["digit","0",0]],"stack":[]},{"caption":"<code>n, digit = divmod(n, 10)</code> &mdash; <code>n = 1</code>; <code>digit = 2</code>","line":5,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","1",1],["result","0",0],["digit","2",1]],"stack":[]},{"caption":"<code>if result &gt; (limit - digit) // 10:</code> &rarr; <strong>false</strong> (digit = 2, limit = 2147483648, result = 0)","line":6,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","1",0],["result","0",0],["digit","2",0]],"stack":[]},{"caption":"<code>result = result * 10 + digit</code> &mdash; <code>result = 2</code>","line":8,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","1",0],["result","2",1],["digit","2",0]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>true</strong> (n = 1)","line":4,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","1",0],["result","2",0],["digit","2",0]],"stack":[]},{"caption":"<code>n, digit = divmod(n, 10)</code> &mdash; <code>n = 0</code>; <code>digit = 1</code>","line":5,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","0",1],["result","2",0],["digit","1",1]],"stack":[]},{"caption":"<code>if result &gt; (limit - digit) // 10:</code> &rarr; <strong>false</strong> (digit = 1, limit = 2147483648, result = 2)","line":6,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","0",0],["result","2",0],["digit","1",0]],"stack":[]},{"caption":"<code>result = result * 10 + digit</code> &mdash; <code>result = 21</code>","line":8,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","0",0],["result","21",1],["digit","1",0]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>false</strong> (n = 0)","line":4,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","0",0],["result","21",0],["digit","1",0]],"stack":[]},{"caption":"<code>return result if x &gt;= 0 else -result</code> &mdash; returns <code>-21</code>. <strong>Result: -21</strong>","line":9,"panels":[],"vars":[["x","-120",0],["limit","2147483648",0],["n","0",0],["result","21",0],["digit","1",0]],"stack":[]}],"example":1}]}