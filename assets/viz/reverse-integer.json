{"chapters":[{"title":"String reversal, range check","code":"def reverse(x):\n    sign = -1 if x < 0 else 1\n    r = sign * int(str(abs(x))[::-1])\n    return r if -2 ** 31 <= r <= 2 ** 31 - 1 else 0","frames":[{"caption":"<strong>String reversal, range check</strong> &mdash; O(digits) time, O(digits) extra space. Input: <code>reverse(x=123)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","123",0]],"stack":[]},{"caption":"<code>sign = -1 if x &lt; 0 else 1</code> &mdash; <code>sign = 1</code>","line":2,"panels":[],"vars":[["x","123",0],["sign","1",1]],"stack":[]},{"caption":"<code>r = sign * int(str(abs(x))[::-1])</code> &mdash; <code>r = 321</code>","line":3,"panels":[],"vars":[["x","123",0],["sign","1",0],["r","321",1]],"stack":[]},{"caption":"<code>return r if -2 ** 31 &lt;= r &lt;= 2 ** 31 - 1 else 0</code> &mdash; returns <code>321</code>. <strong>Result: 321</strong>","line":4,"panels":[],"vars":[["x","123",0],["sign","1",0],["r","321",0]],"stack":[]}]},{"title":"Pop and push digits, check before overflowing","code":"def reverse(x):\n    limit = 2 ** 31 - 1 if x >= 0 else 2 ** 31     # |INT_MIN| = 2^31\n    n, result = abs(x), 0\n    while n:\n        n, digit = divmod(n, 10)\n        if result > (limit - digit) // 10:\n            return 0                               # would overflow\n        result = result * 10 + digit\n    return result if x >= 0 else -result","frames":[{"caption":"<strong>Pop and push digits, check before overflowing</strong> &mdash; O(digits) time, O(1) extra space. Input: <code>reverse(x=1463847412)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","1463847412",0]],"stack":[]},{"caption":"<code>limit = 2 ** 31 - 1 if x &gt;= 0 else 2 ** 31</code> &mdash; <code>limit = 2147483647</code> <em>(|INT_MIN| = 2^31)</em>","line":2,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",1]],"stack":[]},{"caption":"<code>n, result = abs(x), 0</code> &mdash; <code>n = 1463847412</code>; <code>result = 0</code>","line":3,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","1463847412",1],["result","0",1]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>true</strong> (n = 1463847412)","line":4,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","1463847412",0],["result","0",0]],"stack":[]},{"caption":"<code>n, digit = divmod(n, 10)</code> &mdash; <code>n = 146384741</code>; <code>digit = 2</code>","line":5,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","146384741",1],["result","0",0],["digit","2",1]],"stack":[]},{"caption":"<code>if result &gt; (limit - digit) // 10:</code> &rarr; <strong>false</strong> (digit = 2, limit = 2147483647, result = 0)","line":6,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","146384741",0],["result","0",0],["digit","2",0]],"stack":[]},{"caption":"<code>result = result * 10 + digit</code> &mdash; <code>result = 2</code>","line":8,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","146384741",0],["result","2",1],["digit","2",0]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>true</strong> (n = 146384741)","line":4,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","146384741",0],["result","2",0],["digit","2",0]],"stack":[]},{"caption":"<code>n, digit = divmod(n, 10)</code> &mdash; <code>n = 14638474</code>; <code>digit = 1</code>","line":5,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","14638474",1],["result","2",0],["digit","1",1]],"stack":[]},{"caption":"<code>if result &gt; (limit - digit) // 10:</code> &rarr; <strong>false</strong> (digit = 1, limit = 2147483647, result = 2)","line":6,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","14638474",0],["result","2",0],["digit","1",0]],"stack":[]},{"caption":"<code>result = result * 10 + digit</code> &mdash; <code>result = 21</code>","line":8,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","14638474",0],["result","21",1],["digit","1",0]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>true</strong> (n = 14638474)","line":4,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","14638474",0],["result","21",0],["digit","1",0]],"stack":[]},{"caption":"<code>n, digit = divmod(n, 10)</code> &mdash; <code>n = 1463847</code>; <code>digit = 4</code>","line":5,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","1463847",1],["result","21",0],["digit","4",1]],"stack":[]},{"caption":"<code>if result &gt; (limit - digit) // 10:</code> &rarr; <strong>false</strong> (digit = 4, limit = 2147483647, result = 21)","line":6,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","1463847",0],["result","21",0],["digit","4",0]],"stack":[]},{"caption":"<code>result = result * 10 + digit</code> &mdash; <code>result = 214</code>","line":8,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","1463847",0],["result","214",1],["digit","4",0]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>true</strong> (n = 1463847)","line":4,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","1463847",0],["result","214",0],["digit","4",0]],"stack":[]},{"caption":"<code>n, digit = divmod(n, 10)</code> &mdash; <code>n = 146384</code>; <code>digit = 7</code>","line":5,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","146384",1],["result","214",0],["digit","7",1]],"stack":[]},{"caption":"<code>if result &gt; (limit - digit) // 10:</code> &rarr; <strong>false</strong> (digit = 7, limit = 2147483647, result = 214)","line":6,"panels":[],"vars":[["x","1463847412",0],["limit","2147483647",0],["n","146384",0],["result","214",0],["digit","7",0]],"stack":[]},{"caption":"<code>result = result * 10 + digit</code> &mdash; <code>result = 2147</code>","line":8,"panels":[],"vars":[["x","1463847412",0],["limi