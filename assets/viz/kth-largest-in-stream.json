{"chapters":[{"title":"Min-heap capped at k","code":"class KthLargest:\n    def __init__(self, k, nums):\n        self.k = k\n        self.heap = list(nums)\n        heapq.heapify(self.heap)\n        while len(self.heap) > k:\n            heapq.heappop(self.heap)\n\n    def add(self, val):\n        heapq.heappush(self.heap, val)\n        if len(self.heap) > self.k:\n            heapq.heappop(self.heap)\n        return self.heap[0]","frames":[{"caption":"<strong>Min-heap capped at k</strong> &mdash; O(log k) per add time, O(k) extra space. Running <code>kth = KthLargest(3, [4, 5, 8, 2]); assert [kth.add(v) for v in (3, 5, 10, 9, 4)] == [4, 5, 5, 8, 8]</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","8","2"],"cls":["","","",""]}],"vars":[["self","'KthLargest'",0],["k","3",0]],"stack":[]},{"caption":"<code>self.k = k</code> &mdash; <code>self.k = 3</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","8","2"],"cls":["","","",""]}],"vars":[["self.k","3",1],["k","3",0]],"stack":[]},{"caption":"<code>self.heap = list(nums)</code> &mdash; <code>self.heap = [4, 5, 8, 2]</code>","line":4,"panels":[{"t":"arr","id":"self.heap","label":"self.heap","v":["4","5","8","2"],"cls":["","","",""]},{"t":"net","id":"heap:self.heap","label":"self.heap drawn as a tree","nodes":[["h3","2",0.0,2.5,"",[]],["h1","5",1.0,1.25,"",[]],["h0","4",2.0,0.0,"",["top"]],["h2","8",3.0,1.25,"",[]]],"edges":[["h0","h1","",""],["h1","h3","",""],["h0","h2","",""]],"dir":false,"mirror":"self.heap"},{"t":"arr","id":"nums","label":"nums","v":["4","5","8","2"],"cls":["","","",""]}],"vars":[["self.k","3",0],["k","3",0]],"stack":[]},{"caption":"<code>heapq.heapify(self.heap)</code> &mdash; <code>self.heap</code> is now <code>[2, 4, 8, 5]</code>","line":5,"panels":[{"t":"arr","id":"self.heap","label":"self.heap","v":["2","4","8","5"],"cls":["cur","cur","","cur"]},{"t":"net","id":"heap:self.heap","label":"self