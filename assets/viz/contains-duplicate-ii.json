 seen for each value","code":"def contains_nearby_duplicate(nums, k):\n    last = {}\n    for i, x in enumerate(nums):\n        if x in last and i - last[x] <= k:\n            return True\n        last[x] = i\n    return False","frames":[{"caption":"<strong>Last index seen for each value</strong> &mdash; O(n) time, O(n) extra space. Input: <code>contains_nearby_duplicate(nums=[1, 2, 3, 1, 2, 3], k=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","1","2","3"],"cls":["","","","","",""]}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>last = {}</code> &mdash; <code>last = {}</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","1","2","3"],"cls":["","","","","",""]},{"t":"arr","id":"last","label":"last","v":[],"cls":[],"keys":[]}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 0</code>; <code>x = 1</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","1","2","3"],"cls":["src","","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"last","label":"last","v":[],"cls":[],"keys":[]}],"vars":[["k","2",0],["i","0",1],["x","1",1]],"stack":[]},{"caption":"<code>if x in last and i - last[x] &lt;= k:</code> &rarr; <strong>false</strong> (i = 0, k = 2, x = 1)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","1","2","3"],"cls":["src","","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"last","label":"last","v":[],"cls":[],"keys":[]}],"vars":[["k","2",0],["i","0",0],["x","1",0]],"stack":[]},{"caption":"<code>last[x] = i</code> &mdash; <code>last[1] = 0</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","1","2","3"],"cls":["src","","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"last","label":"last","v":["0"],"cls":["cur"],"keys":["1"]}],"vars":[["k","2",0],["i","0",0],["x","1",0]],"stack":[]},{"caption":"<code>for i, x in enum