{"chapters":[{"title":"Recursive: title of the prefix, then the last letter","code":"def convert_to_title(n):\n    if n == 0:\n        return \"\"\n    q, r = divmod(n - 1, 26)\n    return convert_to_title(q) + chr(65 + r)","frames":[{"caption":"<strong>Recursive: title of the prefix, then the last letter</strong> &mdash; O(log n) time, O(log n) extra space. Input: <code>convert_to_title(n=701)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","701",0]],"stack":[]},{"caption":"<code>if n == 0:</code> &rarr; <strong>false</strong> (n = 701)","line":2,"panels":[],"vars":[["n","701",0]],"stack":[]},{"caption":"<code>q, r = divmod(n - 1, 26)</code> &mdash; <code>q = 26</code>; <code>r = 24</code>","line":4,"panels":[],"vars":[["n","701",0],["q","26",1],["r","24",1]],"stack":[]},{"caption":"<code>return convert_to_title(q) + chr(65 + r)</code> &mdash; calls <code>convert_to_title(n=26)</code>","line":5,"panels":[],"vars":[["n","26",1],["q","26",0],["r","24",0]],"stack":["convert_to_title(n=701)","convert_to_title(n=26)"]},{"caption":"<code>if n == 0:</code> &rarr; <strong>false</strong> (n = 26)","line":2,"panels":[],"vars":[["n","26",0],["q","26",0],["r","24",0]],"stack":["convert_to_title(n=701)","convert_to_title(n=26)"]},{"caption":"<code>q, r = divmod(n - 1, 26)</code> &mdash; <code>q = 0</code>; <code>r = 25</code>","line":4,"panels":[],"vars":[["n","26",0],["q","0",1],["r","25",1]],"stack":["convert_to_title(n=701)","convert_to_title(n=26)"]},{"caption":"<code>return convert_to_title(q) + chr(65 + r)</code> &mdash; calls <code>convert_to_title(n=0)</code>","line":5,"panels":[],"vars":[["n","0",1],["q","0",0],["r","25",0]],"stack":["convert_to_title(n=701)","convert_to_title(n=26)","convert_to_title(n=0)"]},{"caption":"<code>if n == 0:</code> &rarr; <strong>true</strong> (n = 0)","line":2,"panels":[],"vars":[["n","0",0],["q","0",0],["r","25",0]],"stack":["convert_to_title(n=701)","convert_to_title(n=26)","convert_to_title(n=0)"]},{"caption":"<code>return \"\"</code> &mdash; <code>convert_to_title</code> returns <code>''</code> to <code>convert_to_title</code>. <strong>Result: 'ZY'</strong>","line":3,"panels":[],"vars":[["n","0",0],["q","0",0],["r","25",0]],"stack":["convert_to_title(n=701)","convert_to_title(n=26)","convert_to_title(n=0)"]}],"example":1},{"title":"Bijective base 26: subtract one per digit","code":"def convert_to_title(n):\n    out = []\n    while n:\n        n, r = divmod(n - 1, 26)\n        out.append(chr(65 + r))\n    return \"\".join(reversed(out))","frames":[{"caption":"<strong>Bijective base 26: subtract one per digit</strong> &mdash; O(log n) time, O(log n) extra space. Input: <code>convert_to_title(n=701)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","701",0]],"stack":[]},{"caption":"<code>out = []</code> &mdash; <code>out = []</code>","line":2,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["n","701",0]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>true</strong> (n = 701)","line":3,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["n","701",0]],"stack":[]},{"caption":"<code>n, r = divmod(n - 1, 26)</code> &mdash; <code>n = 26</code>; <code>r = 24</code>","line":4,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["n","26",1],["r","24",1]],"stack":[]},{"caption":"<code>out.append(chr(65 + r))</code> &mdash; <code>out</code> gets <code>'Y'</code> appended","line":5,"panels":[{"t":"arr","id":"out","label":"out","v":["Y"],"cls":["cur"]}],"vars":[["n","26",0],["r","24",0]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>true</strong> (n = 26)","line":3,"panels":[{"t":"arr","id":"out","label":"out","v":["Y"],"cls":[""]}],"vars":[["n","26",0],["r","24",0]],"stack":[]},{"caption":"<code>n, r = divmod(n - 1, 26)</code> &mdash; <code>n = 0</code>; <code>r = 25</code>","line":4,"panels":[{"t":"arr","id":"out","label":"out","v":["Y"],"cls":[""]}],"vars":[["n","0",1],["r","25",1]],"stack":[]},{"caption":"<code>out.append(chr(65 + r))</code> &mdash; <code>out</code> gets <code>'Z'</code> appended","line":5,"panels":[{"t":"arr","id":"out","label":"out","v":["Y","Z"],"cls":["","cur"]}],"vars":[["n","0",0],["r","25",0]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>false</strong> (n = 0)","line":3,"panels":[{"t":"arr","id":"out","label":"out","v":["Y","Z"],"cls":["",""]}],"vars":[["n","0",0],["r","25",0]],"stack":[]},{"caption":"<code>return \"\".join(reversed(out))</code> &mdash; returns <code>'ZY'</code>. <strong>Result: 'ZY'</strong>","line":6,"panels":[{"t":"arr","id":"out","label":"out","v":["Y","Z"],"cls":["",""]}],"vars":[["n","0",0],["r","25",0]],"stack":[]}],"example":1}]}