            end = e                           # keep it\n        else:\n            removed += 1\n    return removed","frames":[{"caption":"<strong>Greedy: sort by end, keep the earliest-ending</strong> &mdash; O(n log n) time, O(1) beyond sorting extra space. Input: <code>erase_overlap_intervals(intervals=[[1, 2], [2, 3], [3, 4], [1, 3]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>removed, end = 0, float(\"-inf\")</code> &mdash; <code>removed = 0</code>; <code>end = -∞</code>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","0",1],["end","-∞",1]],"stack":[]},{"caption":"<code>for s, e in sorted(intervals, key=lambda iv: iv[1]):</code> &mdash; <code>s = 1</code>; <code>e = 2</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","0",0],["end","-∞",0],["s","1",1],["e","2",1]],"stack":[]},{"caption":"<code>if s &gt;= end:</code> &rarr; <strong>true</strong> (end = -∞, s = 1)","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","0",0],["end","-∞",0],["s","1",0],["e","2",0]],"stack":[]},{"caption":"<code>end = e</code> &mdash; <code>end = 2</code> <em>(keep it)</em>","line":5,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","0",0],["end","2",1],["s","1",0],["e","2",0]],"stack":[]},{"caption":"<code>for s, e in sorted(intervals, key=lambda iv: iv[1]):</code> &mdash; <code>s = 2</code>; <code>e = 3</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","0",0],["end","2",0],["s","2",1],["e","3",1]],"stack":[]},{"caption":"<code>if s &gt;= end:</code> &rarr; <strong>true</strong> (end = 2, s = 2)","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","0",0],["end","2",0],["s","2",0],["e","3",0]],"stack":[]},{"caption":"<code>end = e</code> &mdash; <code>end = 3</code> <em>(keep it)</em>","line":5,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","0",0],["end","3",1],["s","2",0],["e","3",0]],"stack":[]},{"caption":"<code>for s, e in sorted(intervals, key=lambda iv: iv[1]):</code> &mdash; <code>s = 1</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","0",0],["end","3",0],["s","1",1],["e","3",0]],"stack":[]},{"caption":"<code>if s &gt;= end:</code> &rarr; <strong>false</strong> (end = 3, s = 1)","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","0",0],["end","3",0],["s","1",0],["e","3",0]],"stack":[]},{"caption":"<code>removed += 1</code> &mdash; <code>removed = 1</code>","line":7,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","1",1],["end","3",0],["s","1",0],["e","3",0]],"stack":[]},{"caption":"<code>for s, e in sorted(intervals, key=lambda iv: iv[1]):</code> &mdash; <code>s = 3</code>; <code>e = 4</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","1",0],["end","3",0],["s","3",1],["e","4",1]],"stack":[]},{"caption":"<code>if s &gt;= end:</code> &rarr; <strong>true</strong> (end = 3, s = 3)","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","1",0],["end","3",0],["s","3",0],["e","4",0]],"stack":[]},{"caption":"<code>end = e</code> &mdash; <code>end = 4</code> <em>(keep it)</em>","line":5,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","1",0],["end","4",1],["s","3",0],["e","4",0]],"stack":[]},{"caption":"<code>for s, e in sorted(intervals, key=lambda iv: iv[1]):</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","1",0],["end","4",0],["s","3",0],["e","4",0]],"stack":[]},{"caption":"<code>return removed</code> &mdash; returns <code>1</code>. <strong>Result: 1</strong>","line":8,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[["removed","1",0],["end","4",0],["s","3",0],["e","4",0]],"stack":[]}]},{"title":"Greedy by start, drop the longer-ending one","code":"def erase_overlap_intervals(intervals):\n    iv = sorted(intervals)\n    removed, end = 0, iv[0][1]\n    for s, e in iv[1:]:\n        if s < end:\n            removed += 1\n            end = min(end, e)                 # keep whichever ends first\n        else:\n            end = e\n    return removed","frames":[{"caption":"<strong>Greedy by start, drop the longer-ending one</strong> &mdash; O(n log n) time, O(1) beyond sorting extra space. Input: <code>erase_overlap_intervals(intervals=[[1, 2], [2, 3], [3, 4], [1, 3]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>iv = sorted(intervals)</code> &mdash; <code>iv = [[1, 2], [1, 3], [2, 3], [3, 4]]</code>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]},{"t":"arr","id":"iv","label":"iv","v":["1,2","1,3","2,3","3,4"],"cls"