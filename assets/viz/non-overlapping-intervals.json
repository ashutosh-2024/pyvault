{"chapters":[{"title":"DP: longest chain of compatible intervals","code":"def erase_overlap_intervals(intervals):\n    iv = sorted(intervals)\n    keep = [1] * len(iv)\n    for i in range(len(iv)):\n        for j in range(i):\n            if iv[j][1] <= iv[i][0]:\n                keep[i] = max(keep[i], keep[j] + 1)\n    return len(iv) - max(keep)","frames":[{"caption":"<strong>DP: longest chain of compatible intervals</strong> &mdash; O(n&sup2;) time, O(n) extra space. Input: <code>erase_overlap_intervals(intervals=[[1, 2], [2, 3], [3, 4], [1, 3]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>iv = sorted(intervals)</code> &mdash; <code>iv = [[1, 2], [1, 3], [2, 3], [3, 4]]</code>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]},{"t":"arr","id":"iv","label":"iv","v":["1,2","1,3","2,3","3,4"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>keep = [1] * len(iv)</code> &mdash; <code>keep = [1, 1, 1, 1]</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]},{"t":"arr","id":"iv","label":"iv","v":["1,2","1,3","2,3","3,4"],"cls":["","","",""]},{"t":"arr","id":"keep","label":"keep","v":["1","1","1","1"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>for i in range(len(iv)):</code> &mdash; <code>i = 0</code>","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","2,3","3,4","1,3"],"cls":["","","",""]},{"t":"arr","id":"iv","label":"iv","v":["1,2","1,3","2,3","3,4"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"keep","label":"keep","v":["1","1","1","1"],"cls":["src","","",""],"ptr":{"0":["i"]}}],"vars":[["i","0",1]],"stack":[]},{"caption":"<code>for j in range(i):</code>","line":5,"panels":[{"t":"arr","i