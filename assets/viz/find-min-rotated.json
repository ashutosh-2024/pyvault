{"chapters":[{"title":"Linear scan","code":"def find_min(nums):\n    return min(nums)","frames":[{"caption":"<strong>Linear scan</strong> &mdash; O(n) time, O(1) extra space. Input: <code>find_min(nums=[3, 4, 5, 1, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","5","1","2"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>return min(nums)</code> &mdash; returns <code>1</code>. <strong>Result: 1</strong>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","5","1","2"],"cls":["","","","",""]}],"vars":[],"stack":[]}]},{"title":"Binary search against the right end","code":"def find_min(nums):\n    lo, hi = 0, len(nums) - 1\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if nums[mid] > nums[hi]:\n            lo = mid + 1                       # the drop is to the right\n        else:\n            hi = mid                           # mid..hi sorted: min at mid or left\n    return nums[lo]","frames":[{"caption":"<strong>Binary search against the right end</strong> &mdash; O(log n) time, O(1) extra space. Input: <code>find_min(nums=[4, 5, 6, 7, 0, 1, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>lo, hi = 0, len(nums) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 6</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","","","","src"],"ptr":{"6":["hi"],"0":["lo"]}}],"vars":[["lo","0",1],["hi","6",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","","","","src"],"ptr":{"6":["hi"],"0":["lo"]}}],"vars":[["lo","0",0],["hi","6",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 3</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["lo","0",0],["hi","6",0],["mid","3",1]],"stack":[]},{"caption":"<code>if nums[mid] &gt; nums[hi]:</code> &rarr; <strong>true</strong> (hi = 6, mid = 3)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["lo","0",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>lo = mid + 1</code> &mdash; <code>lo = 4</code> <em>(the drop is to the right)</em>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","src","src","","src"],"ptr":{"6":["hi"],"4":["lo"],"3":["mid"]}}],"vars":[["lo","4",1],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 4)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","src","src","","src"],"ptr":{"6":["hi"],"4":["lo"],"3":["mid"]}}],"vars":[["lo","4",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 5</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src","src"],"ptr":{"6":["hi"],"4":["lo"],"5":["mid"]}}],"vars":[["lo","4",0],["hi","6",0],["mid","5",1]],"stack":[]},{"caption":"<code>if nums[mid] &gt; nums[hi]:</code> &rarr; <strong>false</strong> (hi = 6, mid = 5)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src","src"],"ptr":{"6":["hi"],"4":["lo"],"5":["mid"]}}],"vars":[["lo","4",0],["hi","6",0],["mid","5",0]],"stack":[]},{"caption":"<code>hi = mid</code> &mdash; <code>hi = 5</code> <em>(mid..hi sorted: min at mid or left)</em>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src",""],"ptr":{"5":["hi","mid"],"4":["lo"]}}],"vars":[["lo","4",0],["hi","5",1],["mid","5",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 5, lo = 4)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src",""],"ptr":{"5":["hi","mid"],"4":["lo"]}}],"vars":[["lo","4",0],["hi","5",0],["mid","5",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 4</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src",""],"ptr":{"5":["hi"],"4":["lo","mid"]}}],"vars":[["lo","4",0],["hi","5",0],["mid","4",1]],"stack":[]},{"caption":"<code>if nums[mid] &gt; nums[hi]:</code> &rarr; <strong>false</strong> (hi = 5, mid = 4)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src",""],"ptr":{"5":["hi"],"4":["lo","mid"]}}],"vars":[["lo","4",0],["hi","5",0],["mid","4",0]],"stack":[]},{"caption":"<code>hi = mid</code> &mdash; <code>hi = 4</code> <em>(mid..hi sorted: min at mid or left)</em>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","",""],"ptr":{"4":["hi","lo","mid"]}}],"vars":[["lo","4",0],["hi","4",1],["mid","4",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>false</strong> (hi = 4, lo = 4)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","",""],"ptr":{"4":["hi","lo","mid"]}}],"vars":[["lo","4",0],["hi","4",0],["mid","4",0]],"stack":[]},{"caption":"<code>return nums[lo]</code> &mdash; returns <code>0</code>. <strong>Result: 0</strong>","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","",""],"ptr":{"4":["hi","lo","mid"]}}],"vars":[["lo","4",0],["hi","4",0],["mid","4",0]],"stack":[]}],"example":1}]}