g> (t = 'abcea')","line":6,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","","src","",""],"ptr":{"3":["i"]}}],"vars":[["s","'abcbea'",0],["i","3",0],["t","'abcea'",0]],"stack":[]},{"caption":"<code>for i in range(len(s)):</code> &mdash; <code>i = 4</code>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","","","src",""],"ptr":{"4":["i"]}}],"vars":[["s","'abcbea'",0],["i","4",1],["t","'abcea'",0]],"stack":[]},{"caption":"<code>t = s[:i] + s[i + 1:]</code> &mdash; <code>t = 'abcba'</code>","line":5,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","","","src",""],"ptr":{"4":["i"]}}],"vars":[["s","'abcbea'",0],["i","4",0],["t","'abcba'",1]],"stack":[]},{"caption":"<code>if t == t[::-1]:</code> &rarr; <strong>true</strong> (t = 'abcba')","line":6,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","","","src",""],"ptr":{"4":["i"]}}],"vars":[["s","'abcbea'",0],["i","4",0],["t","'abcba'",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>. <strong>Result: T</strong>","line":7,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","","","src",""],"ptr":{"4":["i"]}}],"vars":[["s","'abcbea'",0],["i","4",0],["t","'abcba'",0]],"stack":[]}],"example":1},{"title":"Two pointers, branch once at the first mismatch","code":"def valid_palindrome(s):\n    def pal(lo, hi):\n        while lo < hi:\n            if s[lo] != s[hi]:\n                return False\n            lo, hi = lo + 1, hi - 1\n        return True\n\n    lo, hi = 0, len(s) - 1\n    while lo < hi:\n        if s[lo] != s[hi]:\n            return pal(lo + 1, hi) or pal(lo, hi - 1)   # delete one side\n        lo, hi = lo + 1, hi - 1\n    return True","frames":[{"caption":"<strong>Two pointers, branch once at the first mismatch</strong> &mdash; O(n) time, O(1) extra space. Input: <code>valid_palindrome(s='abcbea')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","","","",""]}],"vars":[["s","'abcbea'",0]],"stack":[]},{"caption":"<code>def pal(lo, hi):</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","","","",""]}],"vars":[["s","'abcbea'",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(s) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 5</code>","line":9,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","0",1],["hi","5",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 5, lo = 0)","line":10,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","0",0],["hi","5",0]],"stack":[]},{"caption":"<code>if s[lo] != s[hi]:</code> &rarr; <strong>false</strong> (hi = 5, lo = 0, s = 'abcbea')","line":11,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","0",0],["hi","5",0]],"stack":[]},{"caption":"<code>lo, hi = lo + 1, hi - 1</code> &mdash; <code>lo = 1</code>; <code>hi = 4</code>","line":13,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","src","","","src",""],"ptr":{"4":["hi"],"1":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","1",1],["hi","4",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 4, lo = 1)","line":10,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","src","","","src",""],"ptr":{"4":["hi"],"1":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","1",0],["hi","4",0]],"stack":[]},{"caption":"<code>if s[lo] != s[hi]:</code> &rarr; <strong>true</strong> (hi = 4, lo = 1, s = 'abcbea')","line":11,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","src","","","src",""],"ptr":{"4":["hi"],"1":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","1",0],["hi","4",0]],"stack":[]},{"caption":"<code>return pal(lo + 1, hi) or pal(lo, hi - 1)</code> &mdash; calls <code>pal(lo=2, hi=4)</code> <em>(delete one side)</em>","line":12,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","src","","src",""],"ptr":{"4":["hi"],"2":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","2",1],["hi","4",0]],"stack":["valid_palindrome(s='abcbea')","pal(lo=2, hi=4)"]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 4, lo = 2)","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","src","","src",""],"ptr":{"4":["hi"],"2":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","2",0],["hi","4",0]],"stack":["valid_palindrome(s='abcbea')","pal(lo=2, hi=4)"]},{"caption":"<code>if s[lo] != s[hi]:</code> &rarr; <strong>true</strong> (hi = 4, lo = 2, s = 'abcbea')","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","src","","src",""],"ptr":{"4":["hi"],"2":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","2",0],["hi","4",0]],"stack":["valid_palindrome(s='abcbea')","pal(lo=2, hi=4)"]},{"caption":"<code>return False</code> &mdash; <code>pal</code> returns <code>F</code> to <code>valid_palindrome</code>","line":5,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","src","","src",""],"ptr":{"4":["hi"],"2":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","2",0],["hi","4",0]],"stack":["valid_palindrome(s='abcbea')","pal(lo=2, hi=4)"]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 3, lo = 1) &mdash; <code>lo = 1</code>; <code>hi = 3</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","src","","src","",""],"ptr":{"3":["hi"],"1":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","1",1],["hi","3",1]],"stack":["valid_palindrome(s='abcbea')","pal(lo=1, hi=3)"]},{"caption":"<code>if s[lo] != s[hi]:</code> &rarr; <strong>false</strong> (hi = 3, lo = 1, s = 'abcbea')","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","src","","src","",""],"ptr":{"3":["hi"],"1":["lo"]}}],"vars":[["s","'abcbea'",0],["lo","1",0],["hi","3",0]],"stack":["valid_palindrome(s='abcbea')","pal(lo=1, hi=3)"]},{"caption":"<code>lo, hi = lo + 1, hi - 1</code> &mdash; <code>lo = 2</code>; <code>hi = 2</code>","line":6,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","src","","",""],"ptr":{"2":["hi","lo"]}}],"vars":[["s","'abcbea'",0],["lo","2",1],["hi","2",1]],"stack":["valid_palindrome(s='abcbea')","pal(lo=2, hi=2)"]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>false</strong> (hi = 2, lo = 2)","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","src","","",""],"ptr":{"2":["hi","lo"]}}],"vars":[["s","'abcbea'",0],["lo","2",0],["hi","2",0]],"stack":["valid_palindrome(s='abcbea')","pal(lo=2, hi=2)"]},{"caption":"<code>return True</code> &mdash; <code>pal</code> returns <code>T</code> to <code>valid_palindrome</code>. <strong>Result: T</strong>","line":7,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","src","","",""],"ptr":{"2":["hi","lo"]}}],"vars":[["s","'abcbea'",0],["lo","2",0],["hi","2",0]],"stack":["valid_palindrome(s='abcbea')","pal(lo=2, hi=2)"]}],"example":1}]}