{"chapters":[{"title":"Try deleting each character","code":"def valid_palindrome(s):\n    if s == s[::-1]:\n        return True\n    for i in range(len(s)):\n        t = s[:i] + s[i + 1:]\n        if t == t[::-1]:\n            return True\n    return False","frames":[{"caption":"<strong>Try deleting each character</strong> &mdash; O(n&sup2;) time, O(n) extra space. Input: <code>valid_palindrome(s='abcbea')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","","","",""]}],"vars":[["s","'abcbea'",0]],"stack":[]},{"caption":"<code>if s == s[::-1]:</code> &rarr; <strong>false</strong> (s = 'abcbea')","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","","","","",""]}],"vars":[["s","'abcbea'",0]],"stack":[]},{"caption":"<code>for i in range(len(s)):</code> &mdash; <code>i = 0</code>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["src","","","","",""],"ptr":{"0":["i"]}}],"vars":[["s","'abcbea'",0],["i","0",1]],"stack":[]},{"caption":"<code>t = s[:i] + s[i + 1:]</code> &mdash; <code>t = 'bcbea'</code>","line":5,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["src","","","","",""],"ptr":{"0":["i"]}}],"vars":[["s","'abcbea'",0],["i","0",0],["t","'bcbea'",1]],"stack":[]},{"caption":"<code>if t == t[::-1]:</code> &rarr; <strong>false</strong> (t = 'bcbea')","line":6,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["src","","","","",""],"ptr":{"0":["i"]}}],"vars":[["s","'abcbea'",0],["i","0",0],["t","'bcbea'",0]],"stack":[]},{"caption":"<code>for i in range(len(s)):</code> &mdash; <code>i = 1</code>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c","b","e","a"],"cls":["","src","","","",""],"ptr":{"1":["i"]}}],"vars":[["s","'abcbea'",0],["i","1",1],["t","'bcbea'",0]],"stack":[]},{"caption":"<code>t = s[:i] + s[i + 1:]<