ption":"<code>return False</code> &mdash; returns <code>F</code>. <strong>Result: F</strong>","line":8,"panels":[{"t":"arr","id":"s","label":"s","v":["e","e","c","c","c","c","b","e","b","a","e","e","a","b","e","b","c","c","c","e","e","a"],"cls":["","","","","","","","","","","","","","","","","","","","","","src"],"ptr":{"21":["i"]}}],"vars":[["s","'eeccccbebaeeabebccceea'",0],["i","21",0],["t","'eeccccbebaeeabebcccee'",0]],"stack":[]}]},{"title":"Two pointers, branch once at the first mismatch","code":"def valid_palindrome(s):\n    def pal(lo, hi):\n        while lo < hi:\n            if s[lo] != s[hi]:\n                return False\n            lo, hi = lo + 1, hi - 1\n        return True\n\n    lo, hi = 0, len(s) - 1\n    while lo < hi:\n        if s[lo] != s[hi]:\n            return pal(lo + 1, hi) or pal(lo, hi - 1)   # delete one side\n        lo, hi = lo + 1, hi - 1\n    return True","frames":[{"caption":"<strong>Two pointers, branch once at the first mismatch</strong> &mdash; O(n) time, O(1) extra space. Input: <code>valid_palindrome(s='eeccccbebaeeabebccceea')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["e","e","c","c","c","c","b","e","b","a","e","e","a","b","e","b","c","c","c","e","e","a"],"cls":["","","","","","","","","","","","","","","","","","","","","",""]}],"vars":[["s","'eeccccbebaeeabebccceea'",0]],"stack":[]},{"caption":"<code>def pal(lo, hi):</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["e","e","c","c","c","c","b","e","b","a","e","e","a","b","e","b","c","c","c","e","e","a"],"cls":["","","","","","","","","","","","","","","","","","","","","",""]}],"vars":[["s","'eeccccbebaeeabebccceea'",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(s) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 21</code>","line":9,"panels":[{"t":"arr","id":"s","label":"s","v":["e","e","c","c","c","c","b","e","b","a","e","e","a","b","e","b","c","c","c","e","e","a"],"cls":["src",