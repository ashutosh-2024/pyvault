{"chapters":[{"title":"Carry the path maximum down","code":"def good_nodes(root):\n    def dfs(node, best):\n        if node is None:\n            return 0\n        good = node.val >= best\n        best = max(best, node.val)\n        return good + dfs(node.left, best) + dfs(node.right, best)\n\n    return dfs(root, root.val)","frames":[{"caption":"<strong>Carry the path maximum down</strong> &mdash; O(n) time, O(h) extra space. Input: <code>good_nodes(root=tree (3))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4433268064","3",0.0,2.5,"",[]],["n4428720208","1",1.0,1.25,"",[]],["n4431929296","3",2.0,0.0,"cur",["root"]],["n4433265936","1",3.0,2.5,"",[]],["n4428724048","4",4.0,1.25,"",[]],["n4440195440","5",5.0,2.5,"",[]]],"edges":[["n4431929296","n4428720208","",""],["n4428720208","n4433268064","",""],["n4431929296","n4428724048","",""],["n4428724048","n4433265936","",""],["n4428724048","n4440195440","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>def dfs(node, best):</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4433268064","3",0.0,2.5,"",[]],["n4428720208","1",1.0,1.25,"",[]],["n4431929296","3",2.0,0.0,"cur",["root"]],["n4433265936","1",3.0,2.5,"",[]],["n4428724048","4",4.0,1.25,"",[]],["n4440195440","5",5.0,2.5,"",[]]],"edges":[["n4431929296","n4428720208","",""],["n4428720208","n4433268064","",""],["n4431929296","n4428724048","",""],["n4428724048","n4433265936","",""],["n4428724048","n4440195440","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>return dfs(root, root.val)</code> &mdash; calls <code>dfs(node=(3), best=3)</code>","line":9,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4433268064","3",0.0,2.5,"",[]],["n4428720208","1",1.0,1.25,"",[]],["n4431929296","3",2.0,0.0,"cur",["node"]],["n4433265936","1",3.0,2.5,"",[]],["n4428724048","4",4.0,1.25,"",[]],["n4440195440","5",5.0,2.5,"",[]]],"edges":[["n4431929