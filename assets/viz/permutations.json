{"chapters":[{"title":"Used flags","code":"def permute(nums):\n    out, path, used = [], [], [False] * len(nums)\n\n    def dfs():\n        if len(path) == len(nums):\n            out.append(path[:])\n            return\n        for i, x in enumerate(nums):\n            if not used[i]:\n                used[i] = True\n                path.append(x)\n                dfs()\n                path.pop()\n                used[i] = False\n\n    dfs()\n    return out","frames":[{"caption":"<strong>Used flags</strong> &mdash; O(n &middot; n!) time, O(n) extra space. Input: <code>permute(nums=[1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>out, path, used = [], [], [False] * len(nums)</code> &mdash; <code>out = []</code>; <code>path = []</code>; <code>used = [F]</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1"],"cls":[""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true},{"t":"arr","id":"used","label":"used","v":["F"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>def dfs():</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1"],"cls":[""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true},{"t":"arr","id":"used","label":"used","v":["F"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>dfs()</code> &mdash; calls <code>dfs()</code>","line":16,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1"],"cls":[""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true},{"t":"arr","id":"used","label":"used","v":["F"],"cls":[""]}],"vars":[],"stack":["permute(nums)","dfs()"]},{"caption":"<code>if len(path) == len(nums):</code> &rarr; <strong>false</stro