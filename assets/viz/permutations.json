vars":[],"stack":[]}]},{"title":"Swap into place","code":"def permute(nums):\n    nums, out = nums[:], []\n\n    def dfs(i):\n        if i == len(nums):\n            out.append(nums[:])\n            return\n        for j in range(i, len(nums)):\n            nums[i], nums[j] = nums[j], nums[i]    # choose nums[j] for slot i\n            dfs(i + 1)\n            nums[i], nums[j] = nums[j], nums[i]    # un-choose\n\n    dfs(0)\n    return out","frames":[{"caption":"<strong>Swap into place</strong> &mdash; O(n &middot; n!) time, O(n) extra space. Input: <code>permute(nums=[1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>nums, out = nums[:], []</code> &mdash; <code>nums</code> is now <code>[1]</code>; <code>out = []</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1"],"cls":[""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>def dfs(i):</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1"],"cls":[""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>dfs(0)</code> &mdash; calls <code>dfs(i=0)</code>","line":13,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1"],"cls":["src"],"ptr":{"0":["i"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",1]],"stack":["permute(nums)","dfs(i=0)"]},{"caption":"<code>if i == len(nums):</code> &rarr; <strong>false</strong> (i = 0)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1"],"cls":["src"],"ptr":{"0":["i"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0]],"stack":["permute(nums)","dfs(i=0)"]},{"caption":"<code>for j in range(i, len(nums)):</code> &mdash; <code>j = 0</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1"],"cls":[