{"chapters":[{"title":"Sort, find the gap","code":"def missing_number(nums):\n    for i, x in enumerate(sorted(nums)):\n        if x != i:\n            return i\n    return len(nums)","frames":[{"caption":"<strong>Sort, find the gap</strong> &mdash; O(n log n) time, O(1)&ndash;O(n) extra space. Input: <code>missing_number(nums=[3, 0, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>for i, x in enumerate(sorted(nums)):</code> &mdash; <code>i = 0</code>; <code>x = 0</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[["i","0",1],["x","0",1]],"stack":[]},{"caption":"<code>if x != i:</code> &rarr; <strong>false</strong> (i = 0, x = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[["i","0",0],["x","0",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(sorted(nums)):</code> &mdash; <code>i = 1</code>; <code>x = 1</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[["i","1",1],["x","1",1]],"stack":[]},{"caption":"<code>if x != i:</code> &rarr; <strong>false</strong> (i = 1, x = 1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[["i","1",0],["x","1",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(sorted(nums)):</code> &mdash; <code>i = 2</code>; <code>x = 3</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[["i","2",1],["x","3",1]],"stack":[]},{"caption":"<code>if x != i:</code> &rarr; <strong>true</strong> (i = 2, x = 3)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[["i","2",0],["x","3",0]],"stack":[]},{"caption":"<code>return i</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[["i","2",0],["x","3",0]],"stack":[]}],"example":1},{"title":"Hash set","code":"def missing_number(nums):\n    present = set(nums)\n    return next(i for i in range(len(nums) + 1) if i not in present)","frames":[{"caption":"<strong>Hash set</strong> &mdash; O(n) time, O(n) extra space. Input: <code>missing_number(nums=[3, 0, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>present = set(nums)</code> &mdash; <code>present = {0, 1, 3}</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]},{"t":"arr","id":"present","label":"present (set)","v":["0","1","3"],"cls":["","",""],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>return next(i for i in range(len(nums) + 1) if i not in present)</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]},{"t":"arr","id":"present","label":"present (set)","v":["0","1","3"],"cls":["","",""],"noidx":true}],"vars":[],"stack":["missing_number(nums)","<genexpr>()"]},{"caption":"<code>return next(i for i in range(len(nums) + 1) if i not in present)</code> &mdash; <code>i = 0</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["src","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"present","label":"present (set)","v":["0","1","3"],"cls":["","",""],"noidx":true}],"vars":[["i","0",1]],"stack":["missing_number(nums)","<genexpr>()"]},{"caption":"<code>return next(i for i in range(len(nums) + 1) if i not in present)</code> &mdash; <code>i = 1</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","src",""],"ptr":{"1":["i"]}},{"t":"arr","id":"present","label":"present (set)","v":["0","1","3"],"cls":["","",""],"noidx":true}],"vars":[["i","1",1]],"stack":["missing_number(nums)","<genexpr>()"]},{"caption":"<code>return next(i for i in range(len(nums) + 1) if i not in present)</code> &mdash; yields <code>2</code>; <code>i = 2</code>. <strong>Result: 2</strong>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","","src"],"ptr":{"2":["i"]}},{"t":"arr","id":"present","label":"present (set)","v":["0","1","3"],"cls":["","",""],"noidx":true}],"vars":[["i","2",1]],"stack":["missing_number(nums)","<genexpr>()"]}],"example":1},{"title":"Gauss's sum","code":"def missing_number(nums):\n    n = len(nums)\n    return n * (n + 1) // 2 - sum(nums)","frames":[{"caption":"<strong>Gauss's sum</strong> &mdash; O(n) time, O(1) extra space. Input: <code>missing_number(nums=[3, 0, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>n = len(nums)</code> &mdash; <code>n = 3</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[["n","3",1]],"stack":[]},{"caption":"<code>return n * (n + 1) // 2 - sum(nums)</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[["n","3",0]],"stack":[]}]},{"title":"XOR indices with values","code":"def missing_number(nums):\n    result = len(nums)\n    for i, x in enumerate(nums):\n        result ^= i ^ x\n    return result","frames":[{"caption":"<strong>XOR indices with values</strong> &mdash; O(n) time, O(1) extra space. Input: <code>missing_number(nums=[3, 0, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","0","1"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>result = len(nums)</code> &mdash; <c