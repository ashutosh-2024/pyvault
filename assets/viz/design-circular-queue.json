{"chapters":[{"title":"Python list with pop(0)","code":"class MyCircularQueue:\n    def __init__(self, k):\n        self.k, self.items = k, []\n\n    def enQueue(self, value):\n        if len(self.items) == self.k:\n            return False\n        self.items.append(value)\n        return True\n\n    def deQueue(self):\n        if not self.items:\n            return False\n        self.items.pop(0)\n        return True\n\n    def Front(self):\n        return self.items[0] if self.items else -1\n\n    def Rear(self):\n        return self.items[-1] if self.items else -1\n\n    def isEmpty(self):\n        return not self.items\n\n    def isFull(self):\n        return len(self.items) == self.k","frames":[{"caption":"<strong>Python list with pop(0)</strong> &mdash; deQueue O(n) time, O(k) extra space. Running <code>q = MyCircularQueue(3); assert [q.enQueue(1), q.enQueue(2), q.enQueue(3), q.enQueue(4)] == [True, True, True, False]; assert q.Rear() == 3 and q.isFull() is True and q.deQueue() is True; assert q.enQueue(4) is True and q.Rear() == 4 and q.Front() == 2</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","y","C","i","r","c","u","l","a","r","Q","u","e","u","e"],"cls":["","","","","","","","","","","","","","",""]}],"vars":[["self","'MyCircularQueue'",0],["k","3",0]],"stack":[]},{"caption":"<code>self.k, self.items = k, []</code> &mdash; returns <code>None</code>; <code>self.k = 3</code>; <code>self.items = []</code>","line":3,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":[],"cls":[],"noidx":true}],"vars":[["self.k","3",1],["k","3",0]],"stack":[]},{"caption":"<code>if len(self.items) == self.k:</code> &rarr; <strong>false</strong> &mdash; <code>value = 1</code>","line":6,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":[],"cls":[],"noidx":true}],"vars":[["self.k","3",0],["value","1",1]],"stack":[]},{"caption":"<code>self.items.append(value)</code> &mdash; <code>self.items</code> gets <code>1</code> appended","line":8,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1"],"cls":["cur"]}],"vars":[["self.k","3",0],["value","1",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>","line":9,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1"],"cls":[""]}],"vars":[["self.k","3",0],["value","1",0]],"stack":[]},{"caption":"<code>if len(self.items) == self.k:</code> &rarr; <strong>false</strong> &mdash; <code>value = 2</code>","line":6,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1"],"cls":[""]}],"vars":[["self.k","3",0],["value","2",1]],"stack":[]},{"caption":"<code>self.items.append(value)</code> &mdash; <code>self.items</code> gets <code>2</code> appended","line":8,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1","2"],"cls":["","cur"]}],"vars":[["self.k","3",0],["value","2",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>","line":9,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1","2"],"cls":["",""]}],"vars":[["self.k","3",0],["value","2",0]],"stack":[]},{"caption":"<code>if len(self.items) == self.k:</code> &rarr; <strong>false</strong> &mdash; <code>value = 3</code>","line":6,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1","2"],"cls":["",""]}],"vars":[["self.k","3",0],["value","3",1]],"stack":[]},{"caption":"<code>self.items.append(value)</code> &mdash; <code>self.items</code> gets <code>3</code> appended","line":8,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1","2","3"],"cls":["","","cur"]}],"vars":[["self.k","3",0],["value","3",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>","line":9,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["value","3",0]],"stack":[]},{"caption":"<code>if len(self.items) == self.k:</code> &rarr; <strong>true</strong> &mdash; <code>value = 4</code>","line":6,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["value","4",1]],"stack":[]},{"caption":"<code>return False</code> &mdash; returns <code>F</code>","line":7,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["value","4",0]],"stack":[]},{"caption":"<code>return self.items[-1] if self.items else -1</code> &mdash; returns <code>3</code>","line":21,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0]],"stack":[]},{"caption":"<code>return len(self.items) == self.k</code> &mdash; returns <code>T</code>","line":27,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0]],"stack":[]},{"caption":"<code>if not self.items:</code> &rarr; <strong>false</strong>","line":12,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0]],"stack":[]},{"caption":"<code>self.items.pop(0)</code> &mdash; <code>1</code> taken from the front of <code>self.items</code>","line":14,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["2","3"],"cls":["cur","cur"]}],"vars":[["self.k","3",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>","line":15,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["2","3"],"cls":["",""]}],"vars":[["self.k","3",0]],"stack":[]},{"caption":"<code>if len(self.items) == self.k:</code> &rarr; <strong>false</strong> &mdash; <code>value = 4</code>","line":6,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["2","3"],"cls":["",""]}],"vars":[["self.k","3",0],["value","4",1]],"stack":[]},{"caption":"<code>self.items.append(value)</code> &mdash; <code>self.items</code> gets <code>4</code> appended","line":8,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["2","3","4"],"cls":["","","cur"]}],"vars":[["self.k","3",0],["value","4",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>","line":9,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["2","3","4"],"cls":["","",""]}],"vars":[["self.k","3",0],["value","4",0]],"stack":[]},{"caption":"<code>return self.items[-1] if self.items else -1</code> &mdash; returns <code>4</code>","line":21,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["2","3","4"],"cls":["","",""]}],"vars":[["self.k","3",0]],"stack":[]},{"caption":"<code>return self.items[0] if self.items else -1</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":18,"panels":[{"t":"arr","id":"self.items","label":"self.items","v":["2","3","4"],"cls":["","",""]}],"vars":[["self.k","3",0]],"stack":[]}]},{"title":"Array ring buffer with head and count","code":"class MyCircularQueue:\n    def __init__(self, k):\n        self.buf, self.k = [0] * k, k\n        self.head = self.count = 0\n\n    def enQueue(self, value):\n        if self.count == self.k:\n            return False\n        self.buf[(self.head + self.count) % self.k] = value\n        self.count += 1\n        return True\n\n    def deQueue(self):\n        if self.count == 0:\n            return False\n        self.head = (self.head + 1) % self.k\n        self.count -= 1\n        return True\n\n    def Front(self):\n        return self.buf[self.head] if self.count else -1\n\n    def Rear(self):\n        return self.buf[(self.head + self.count - 1) % self.k] if self.count else -1\n\n    def isEmpty(self):\n        return self.count == 0\n\n    def isFull(self):\n        return self.count == self.k","frames":[{"caption":"<strong>Array ring buffer with head and count</strong> &mdash; O(1) all time, O(k) extra space. Running <code>q = MyCircularQueue(3); assert [q.enQueue(1), q.enQueue(2), q.enQueue(3), q.enQueue(4)] == [True, True, True, False]; assert q.Rear() == 3 and q.isFull() is True and q.deQueue() is True; assert q.enQueue(4) is True and q.Rear() == 4 and q.Front() == 2</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","y","C","i","r","c","u","l","a","r","Q","u","e","u","e"],"cls":["","","","","","","","","","","","","","",""]}],"vars":[["self","'MyCircularQueue'",0],["k","3",0]],"stack":[]},{"caption":"<code>self.buf, self.k = [0] * k, k</code> &mdash; <code>self.buf = [0, 0, 0]</code>; <code>self.k = 3</code>","line":3,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["0","0","0"],"cls":["","",""]}],"vars":[["self.k","3",1],["k","3",0]],"stack":[]},{"caption":"<code>self.head = self.count = 0</code> &mdash; returns <code>None</code>; <code>self.head = 0</code>; <code>self.count = 0</code>","line":4,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["0","0","0"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",1],["self.count","0",1],["k","3",0]],"stack":[]},{"caption":"<code>if self.count == self.k:</code> &rarr; <strong>false</strong> &mdash; <code>value = 1</code>","line":7,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["0","0","0"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","0",0],["value","1",1]],"stack":[]},{"caption":"<code>self.buf[(self.head + self.count) % self.k] = value</code> &mdash; <code>self.buf[0]</code> becomes <code>1</code>","line":9,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","0","0"],"cls":["cur","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","0",0],["value","1",0]],"stack":[]},{"caption":"<code>self.count += 1</code> &mdash; <code>self.count = 1</code>","line":10,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","0","0"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","1",1],["value","1",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>","line":11,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","0","0"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","1",0],["value","1",0]],"stack":[]},{"caption":"<code>if self.count == self.k:</code> &rarr; <strong>false</strong> &mdash; <code>value = 2</code>","line":7,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","0","0"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","1",0],["value","2",1]],"stack":[]},{"caption":"<code>self.buf[(self.head + self.count) % self.k] = value</code> &mdash; <code>self.buf[1]</code> becomes <code>2</code>","line":9,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","0"],"cls":["","cur",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","1",0],["value","2",0]],"stack":[]},{"caption":"<code>self.count += 1</code> &mdash; <code>self.count = 2</code>","line":10,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","0"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","2",1],["value","2",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>","line":11,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","0"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","2",0],["value","2",0]],"stack":[]},{"caption":"<code>if self.count == self.k:</code> &rarr; <strong>false</strong> &mdash; <code>value = 3</code>","line":7,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","0"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","2",0],["value","3",1]],"stack":[]},{"caption":"<code>self.buf[(self.head + self.count) % self.k] = value</code> &mdash; <code>self.buf[2]</code> becomes <code>3</code>","line":9,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","","cur"]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","2",0],["value","3",0]],"stack":[]},{"caption":"<code>self.count += 1</code> &mdash; <code>self.count = 3</code>","line":10,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","3",1],["value","3",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>","line":11,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","3",0],["value","3",0]],"stack":[]},{"caption":"<code>if self.count == self.k:</code> &rarr; <strong>true</strong> &mdash; <code>value = 4</code>","line":7,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","3",0],["value","4",1]],"stack":[]},{"caption":"<code>return False</code> &mdash; returns <code>F</code>","line":8,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","3",0],["value","4",0]],"stack":[]},{"caption":"<code>return self.buf[(self.head + self.count - 1) % self.k] if self.count else -1</code> &mdash; returns <code>3</code>","line":24,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","3",0]],"stack":[]},{"caption":"<code>return self.count == self.k</code> &mdash; returns <code>T</code>","line":30,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","3",0]],"stack":[]},{"caption":"<code>if self.count == 0:</code> &rarr; <strong>false</strong>","line":14,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","0",0],["self.count","3",0]],"stack":[]},{"caption":"<code>self.head = (self.head + 1) % self.k</code> &mdash; <code>self.head = 1</code>","line":16,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","1",1],["self.count","3",0]],"stack":[]},{"caption":"<code>self.count -= 1</code> &mdash; <code>self.count = 2</code>","line":17,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","1",0],["self.count","2",1]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>","line":18,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","1",0],["self.count","2",0]],"stack":[]},{"caption":"<code>if self.count == self.k:</code> &rarr; <strong>false</strong> &mdash; <code>value = 4</code>","line":7,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["1","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","1",0],["self.count","2",0],["value","4",1]],"stack":[]},{"caption":"<code>self.buf[(self.head + self.count) % self.k] = value</code> &mdash; <code>self.buf[0]</code> becomes <code>4</code>","line":9,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["4","2","3"],"cls":["cur","",""]}],"vars":[["self.k","3",0],["self.head","1",0],["self.count","2",0],["value","4",0]],"stack":[]},{"caption":"<code>self.count += 1</code> &mdash; <code>self.count = 3</code>","line":10,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["4","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","1",0],["self.count","3",1],["value","4",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>","line":11,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["4","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","1",0],["self.count","3",0],["value","4",0]],"stack":[]},{"caption":"<code>return self.buf[(self.head + self.count - 1) % self.k] if self.count else -1</code> &mdash; returns <code>4</code>","line":24,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["4","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","1",0],["self.count","3",0]],"stack":[]},{"caption":"<code>return self.buf[self.head] if self.count else -1</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":21,"panels":[{"t":"arr","id":"self.buf","label":"self.buf","v":["4","2","3"],"cls":["","",""]}],"vars":[["self.k","3",0],["self.head","1",0],["self.count","3",0]],"stack":[]}]},{"title":"Singly linked list with a size cap","code":"class MyCircularQueue:\n    def __init__(self, k):\n        self.k, self.size = k, 0\n        self.head = self.tail = None\n\n    def enQueue(self, value):\n        if self.size == self.k:\n            return False\n        node = ListNode(value)\n        if self.tail:\n            self.tail.next = node\n        else:\n            self.head = node\n        self.tail = node\n        self.size += 1\n        return True\n\n    def deQueue(self):\n        if self.size == 0:\n            return False\n        self.head = self.head.next\n        if self.head is None:\n            self.tail = None\n        self.size -= 1\n        return True\n\n    def Front(self):\n        return self.head.val if self.head else -1\n\n    def Rear(self):\n        return self.tail.val if self.tail else -1\n\n    def isEmpty(self):\n        return self.size == 0\n\n    def isFull(self):\n        return self.size == self.k","frames":[{"caption":"<strong>Singly linked list with a size cap</strong> &mdash; O(1) all time, O(current size) extra space. Running <code>q = MyCircularQueue(3); assert [q.enQueue(1), q.enQueue(2), q.enQueue(3), q.enQueue(4)] == [True, True, True, False]; assert q.Rear() == 3 and q.isFull() is True and q.deQueue() is True; assert q.enQueue(4) is True and q.Rear() == 4 and q.Front() == 2</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","y","C","i","r","c","u","l","a","r","Q","u","e","u","e"],"cls":["","","","","","","","","","","","","","",""]}],"vars":[["self","'MyCircularQueue'",0],["k","3",0]],"stack":[]},{"caption":"<code>self.k, self.size = k, 0</code> &mdash; <code>self.k = 3</code>; <code>self.size = 0</code>","line":3,"panels":[],"vars":[["self.k","3",1],["self.size","0",1],["k","3",0]],"stack":[]},{"caption":"<code>self.head = self.tail = None</code> &mdash; returns <code>None</code>; <code>self.head = None</code>; <code>self.tail = None</code>","line":4,"panels":[],"vars":[["self.k","3",0],["self.size","0",0],["self.head","None",1],["self.tail","None",1],["k","3",0]],"stack":[]},{"caption":"<code>if self.size == self.k:</code> &rarr; <strong>false</strong> &mdash; <code>value = 1</code>","line":7,"panels":[],"vars":[["self.k","3",0],["self.size","0",0],["self.head","None",0],["self.tail","None",0],["value","1",1]],"stack":[]},{"caption":"<code>node = ListNode(value)</code>","line":9,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4424042880","1",0.0,0.0,"cur",["node"]]],"edges":[],"dir":true}],"vars":[["self.k","3",0],["self.size","0",0],["self.head","None",0],["self.tail","None",0],["value","1",0]],"stack":[]},{"caption":"<code>if self.tail:</code> &rarr; <strong>false</strong>","line":10,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4424042880","1",0.0,0.0,"cur",["node"]]],"edges":[],"dir":true}],"vars":[["self.k","3",0],["self.size","0",0],["self.head","None",0],["self.tail","None",0],["value","1",0]],"stack":[]},{"caption":"<code>self.head = node</code> &mdash; <code>self.head</code> moves to <code>(1)</code>","line":13,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4424042880","1",0.0,0.0,"cur",["self.head","node"]]],"edges":[],"dir":true}],"vars":[["self.k","3",0],["self.size","0"