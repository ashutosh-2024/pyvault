{"chapters":[{"title":"Every pair","code":"def two_sum_sorted(numbers, target):\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if numbers[i] + numbers[j] == target:\n                return [i + 1, j + 1]","frames":[{"caption":"<strong>Every pair</strong> &mdash; O(n&sup2;) time, O(1) extra space. Input: <code>two_sum_sorted(numbers=[1, 3, 4, 6, 8, 11], target=10)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","","","","",""]}],"vars":[["target","10",0]],"stack":[]},{"caption":"<code>for i in range(len(numbers)):</code> &mdash; <code>i = 0</code>","line":2,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","","","","",""],"ptr":{"0":["i"]}}],"vars":[["target","10",0],["i","0",1]],"stack":[]},{"caption":"<code>for j in range(i + 1, len(numbers)):</code> &mdash; <code>j = 1</code>","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","src","","","",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["target","10",0],["i","0",0],["j","1",1]],"stack":[]},{"caption":"<code>if numbers[i] + numbers[j] == target:</code> &rarr; <strong>false</strong> (i = 0, j = 1, target = 10)","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","src","","","",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["target","10",0],["i","0",0],["j","1",0]],"stack":[]},{"caption":"<code>for j in range(i + 1, len(numbers)):</code> &mdash; <code>j = 2</code>","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","","src","","",""],"ptr":{"0":["i"],"2":["j"]}}],"vars":[["target","10",0],["i","0",0],["j","2",1]],"stack":[]},{"caption":"<code>if numbers[i] + numbers[j] == target:</code> &rarr; <strong>false</strong> (i = 0, j = 2, target = 10)","line":4