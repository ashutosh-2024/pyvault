code>j = 3</code>","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","","src","src","",""],"ptr":{"2":["i"],"3":["j"]}}],"vars":[["target","10",0],["i","2",0],["j","3",1]],"stack":[]},{"caption":"<code>if numbers[i] + numbers[j] == target:</code> &rarr; <strong>true</strong> (i = 2, j = 3, target = 10)","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","","src","src","",""],"ptr":{"2":["i"],"3":["j"]}}],"vars":[["target","10",0],["i","2",0],["j","3",0]],"stack":[]},{"caption":"<code>return [i + 1, j + 1]</code> &mdash; returns <code>[3, 4]</code>. <strong>Result: [3, 4]</strong>","line":5,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","","src","src","",""],"ptr":{"2":["i"],"3":["j"]}},{"t":"arr","id":"result","label":"result","v":["3","4"],"cls":["answer","answer"]}],"vars":[["target","10",0],["i","2",0],["j","3",0]],"stack":[]}],"example":1},{"title":"Binary search for each complement","code":"def two_sum_sorted(numbers, target):\n    for i, x in enumerate(numbers):\n        j = bisect.bisect_left(numbers, target - x, i + 1)\n        if j < len(numbers) and numbers[j] == target - x:\n            return [i + 1, j + 1]","frames":[{"caption":"<strong>Binary search for each complement</strong> &mdash; O(n log n) time, O(1) extra space. Input: <code>two_sum_sorted(numbers=[1, 3, 4, 6, 8, 11], target=10)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","","","","",""]}],"vars":[["target","10",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(numbers):</code> &mdash; <code>i = 0</code>; <code>x = 1</code>","line":2,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","","","","",""],"ptr":{"0":["i"]}}],"vars":[["target","10",0],["i","0",1],["x","1",1]],"stack":[]},{"caption":"<code>j = bisect.bisect_left(numbers, target - x, i + 1)</code> &mdash; <code>j = 5</code>","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","","","","","src"],"ptr":{"0":["i"],"5":["j"]}}],"vars":[["target","10",0],["i","0",0],["x","1",0],["j","5",1]],"stack":[]},{"caption":"<code>if j &lt; len(numbers) and numbers[j] == target - x:</code> &rarr; <strong>false</strong> (j = 5, target = 10, x = 1)","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","","","","","src"],"ptr":{"0":["i"],"5":["j"]}}],"vars":[["target","10",0],["i","0",0],["x","1",0],["j","5",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(numbers):</code> &mdash; <code>i = 1</code>; <code>x = 3</code>","line":2,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","src","","","","src"],"ptr":{"1":["i"],"5":["j"]}}],"vars":[["target","10",0],["i","1",1],["x","3",1],["j","5",0]],"stack":[]},{"caption":"<code>j = bisect.bisect_left(numbers, target - x, i + 1)</code> &mdash; <code>j = 4</code>","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","src","","","src",""],"ptr":{"1":["i"],"4":["j"]}}],"vars":[["target","10",0],["i","1",0],["x","3",0],["j","4",1]],"stack":[]},{"caption":"<code>if j &lt; len(numbers) and numbers[j] == target - x:</code> &rarr; <strong>false</strong> (j = 4, target = 10, x = 3)","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","src","","","src",""],"ptr":{"1":["i"],"4":["j"]}}],"vars":[["target","10",0],["i","1",0],["x","3",0],["j","4",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(numbers):</code> &mdash; <code>i = 2</code>; <code>x = 4</code>","line":2,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","","src","","src",""],"ptr":{"2":["i"],"4":["j"]}}],"vars":[["target","10",0],["i","2",1],["x","4",1],["j","4",0]],"stack":[]},{"caption":"<code>j = bisect.bisect_left(numbers, target - x, i + 1)</code> &mdash; <code>j = 3</code>","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","","src","src","",""],"ptr":{"2":["i"],"3":["j"]}}],"vars":[["target","10",0],["i","2",0],["x","4",0],["j","3",1]],"stack":[]},{"caption":"<code>if j &lt; len(numbers) and numbers[j] == target - x:</code> &rarr; <strong>true</strong> (j = 3, target = 10, x = 4)","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","","src","src","",""],"ptr":{"2":["i"],"3":["j"]}}],"vars":[["target","10",0],["i","2",0],["x","4",0],["j","3",0]],"stack":[]},{"caption":"<code>return [i + 1, j + 1]</code> &mdash; returns <code>[3, 4]</code>. <strong>Result: [3, 4]</strong>","line":5,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","","src","src","",""],"ptr":{"2":["i"],"3":["j"]}},{"t":"arr","id":"result","label":"result","v":["3","4"],"cls":["answer","answer"]}],"vars":[["target","10",0],["i","2",0],["x","4",0],["j","3",0]],"stack":[]}],"example":1},{"title":"Two pointers from both ends","code":"def two_sum_sorted(numbers, target):\n    lo, hi = 0, len(numbers) - 1\n    while lo < hi:\n        total = numbers[lo] + numbers[hi]\n        if total == target:\n            return [lo + 1, hi + 1]\n        if total < target:\n            lo += 1\n        else:\n            hi -= 1","frames":[{"caption":"<strong>Two pointers from both ends</strong> &mdash; O(n) time, O(1) extra space. Input: <code>two_sum_sorted(numbers=[1, 3, 4, 6, 8, 11], target=10)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["","","","","",""]}],"vars":[["target","10",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(numbers) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 5</code>","line":2,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","10",0],["lo","0",1],["hi","5",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 5, lo = 0)","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","10",0],["lo","0",0],["hi","5",0]],"stack":[]},{"caption":"<code>total = numbers[lo] + numbers[hi]</code> &mdash; <code>total = 12</code>","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","10",0],["lo","0",0],["hi","5",0],["total","12",1]],"stack":[]},{"caption":"<code>if total == target:</code> &rarr; <strong>false</strong> (target = 10, total = 12)","line":5,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","10",0],["lo","0",0],["hi","5",0],["total","12",0]],"stack":[]},{"caption":"<code>if total &lt; target:</code> &rarr; <strong>false</strong> (target = 10, total = 12)","line":7,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","10",0],["lo","0",0],["hi","5",0],["total","12",0]],"stack":[]},{"caption":"<code>hi -= 1</code> &mdash; <code>hi = 4</code>","line":10,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["1","3","4","6","8","11"],"cls":["src","","","","src",""],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["target","10",0],["lo","0",0],["hi","4",1],["total","12",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 4