{"chapters":[{"title":"Every pair","code":"def two_sum_sorted(numbers, target):\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if numbers[i] + numbers[j] == target:\n                return [i + 1, j + 1]","frames":[{"caption":"<strong>Every pair</strong> &mdash; O(n&sup2;) time, O(1) extra space. Input: <code>two_sum_sorted(numbers=[2, 3, 4], target=6)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","3","4"],"cls":["","",""]}],"vars":[["target","6",0]],"stack":[]},{"caption":"<code>for i in range(len(numbers)):</code> &mdash; <code>i = 0</code>","line":2,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","3","4"],"cls":["src","",""],"ptr":{"0":["i"]}}],"vars":[["target","6",0],["i","0",1]],"stack":[]},{"caption":"<code>for j in range(i + 1, len(numbers)):</code> &mdash; <code>j = 1</code>","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","3","4"],"cls":["src","src",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["target","6",0],["i","0",0],["j","1",1]],"stack":[]},{"caption":"<code>if numbers[i] + numbers[j] == target:</code> &rarr; <strong>false</strong> (i = 0, j = 1, target = 6)","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","3","4"],"cls":["src","src",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["target","6",0],["i","0",0],["j","1",0]],"stack":[]},{"caption":"<code>for j in range(i + 1, len(numbers)):</code> &mdash; <code>j = 2</code>","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","3","4"],"cls":["src","","src"],"ptr":{"0":["i"],"2":["j"]}}],"vars":[["target","6",0],["i","0",0],["j","2",1]],"stack":[]},{"caption":"<code>if numbers[i] + numbers[j] == target:</code> &rarr; <strong>true</strong> (i = 0, j = 2, target = 6)","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","3","4"],"cls":["src","","src"],"ptr":{"0":["i"],"2":["j"]}}],"vars":[["target","6",0],["i","0",0],["j","2",0]],"stack":[]},{"caption":"<code>return [i + 1, j + 1]</code> &mdash; returns <code>[1, 3]</code>. <strong>Result: [1, 3]</strong>","line":5,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","3","4"],"cls":["src","","src"],"ptr":{"0":["i"],"2":["j"]}},{"t":"arr","id":"result","label":"result","v":["1","3"],"cls":["answer","answer"]}],"vars":[["target","6",0],["i","0",0],["j","2",0]],"stack":[]}]},{"title":"Binary search for each complement","code":"def two_sum_sorted(numbers, target):\n    for i, x in enumerate(numbers):\n        j = bisect.bisect_left(numbers, target - x, i + 1)\n        if j < len(numbers) and numbers[j] == target - x:\n            return [i + 1, j + 1]","frames":[{"caption":"<strong>Binary search for each complement</strong> &mdash; O(n log n) time, O(1) extra space. Input: <code>two_sum_sorted(numbers=[2, 7, 11, 15], target=9)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(numbers):</code> &mdash; <code>i = 0</code>; <code>x = 2</code>","line":2,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","","",""],"ptr":{"0":["i"]}}],"vars":[["target","9",0],["i","0",1],["x","2",1]],"stack":[]},{"caption":"<code>j = bisect.bisect_left(numbers, target - x, i + 1)</code> &mdash; <code>j = 1</code>","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","src","",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["target","9",0],["i","0",0],["x","2",0],["j","1",1]],"stack":[]},{"caption":"<code>if j &lt; len(numbers) and numbers[j] == target - x:</code> &rarr; <strong>true</strong> (j = 1, target = 9, x = 2)","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","src","",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["target","9",0],["i","0",0],["x","2",0],["j","1",0]],"stack":[]},{"caption":"<code>return [i + 1, j + 1]</code> &mdash; returns <code>[1, 2]</code>. <strong>Result: [1, 2]</strong>","line":5,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","src","",""],"ptr":{"0":["i"],"1":["j"]}},{"t":"arr","id":"result","label":"result","v":["1","2"],"cls":["answer","answer"]}],"vars":[["target","9",0],["i","0",0],["x","2",0],["j","1",0]],"stack":[]}]},{"title":"Two pointers from both ends","code":"def two_sum_sorted(numbers, target):\n    lo, hi = 0, len(numbers) - 1\n    while lo < hi:\n        total = numbers[lo] + numbers[hi]\n        if total == target:\n            return [lo + 1, hi + 1]\n        if total < target:\n            lo += 1\n        else:\n            hi -= 1","frames":[{"caption":"<strong>Two pointers from both ends</strong> &mdash; O(n) time, O(1) extra space. Input: <code>two_sum_sorted(numbers=[2, 7, 11, 15], target=9)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(numbers) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 3</code>","line":2,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",1],["hi","3",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 3, lo = 0)","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",0]],"stack":[]},{"caption":"<code>total = numbers[lo] + numbers[hi]</code> &mdash; <code>total = 17</code>","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",0],["total","17",1]],"stack":[]},{"caption":"<code>if total == target:</code> &rarr; <strong>false</strong> (target = 9, total = 17)","line":5,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",0],["total","17",0]],"stack":[]},{"caption":"<code>if total &lt; target:</code> &rarr; <strong>false</strong> (target = 9, total = 17)","line":7,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",0],["total","17",0]],"stack":[]},{"caption":"<code>hi -= 1</code> &mdash; <code>hi = 2</code>","line":10,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","2",1],["total","17",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 2, lo = 0)","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","2",0],["total","17",0]],"stack":[]},{"caption":"<code>total = numbers[lo] + numbers[hi]</code> &mdash; <code>total = 13</code>","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","2",0],["total","13",1]],"stack":[]},{"caption":"<code>if total == target:</code> &rarr; <strong>false</strong> (target = 9, total = 13)","line":5,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","2",0],["total","13",0]],"stack":[]},{"caption":"<code>if total &lt; target:</code> &rarr; <strong>false</strong> (target = 9, total = 13)","line":7,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","2",0],["total","13",0]],"stack":[]},{"caption":"<code>hi -= 1</code> &mdash; <code>hi = 1</code>","line":10,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","1",1],["total","13",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 1, lo = 0)","line":3,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","1",0],["total","13",0]],"stack":[]},{"caption":"<code>total = numbers[lo] + numbers[hi]</code> &mdash; <code>total = 9</code>","line":4,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","1",0],["total","9",1]],"stack":[]},{"caption":"<code>if total == target:</code> &rarr; <strong>true</strong> (target = 9, total = 9)","line":5,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","1",0],["total","9",0]],"stack":[]},{"caption":"<code>return [lo + 1, hi + 1]</code> &mdash; returns <code>[1, 2]</code>. <strong>Result: [1, 2]</strong>","line":6,"panels":[{"t":"arr","id":"numbers","label":"numbers","v":["2","7","11","15"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}},{"t":"arr","id":"result","label":"result","v":["1","2"],"cls":["answer","answer"]}],"vars":[["target","9",0],["lo","0",0],["hi","1",0],["total","9",0]],"stack":[]}]}]}