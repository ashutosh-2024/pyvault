, i=1)","line(lo=0, i=0)","line(lo=0, i=-1)"]},{"caption":"<code>if i &lt; lo:</code> &rarr; <strong>true</strong> (i = -1, lo = 0)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["src","","","",""],"ptr":{"0":["lo"]}}],"vars":[["n","5",0],["lo","0",0],["i","-1",0]],"stack":["rob(nums)","line(lo=0, i=3)","line(lo=0, i=2)","line(lo=0, i=1)","line(lo=0, i=0)","line(lo=0, i=-1)"]},{"caption":"<code>return 0</code> &mdash; <code>line</code> returns <code>0</code> to <code>line</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["src","","","",""],"ptr":{"0":["lo"]}}],"vars":[["n","5",0],["lo","0",0],["i","-1",0]],"stack":["rob(nums)","line(lo=0, i=3)","line(lo=0, i=2)","line(lo=0, i=1)","line(lo=0, i=0)","line(lo=0, i=-1)"]},{"caption":"<code>if i &lt; lo:</code> &rarr; <strong>true</strong> (i = -2, lo = 0) &mdash; <code>i = -2</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["src","","","",""],"ptr":{"0":["lo"]}}],"vars":[["n","5",0],["lo","0",0],["i","-2",1]],"stack":["rob(nums)","line(lo=0, i=3)","line(lo=0, i=2)","line(lo=0, i=1)","line(lo=0, i=0)","line(lo=0, i=-2)"]},{"caption":"<code>return 0</code> &mdash; <code>line</code> returns <code>0</code> to <code>line</code>. <strong>Result: 11</strong>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["src","","","",""],"ptr":{"0":["lo"]}}],"vars":[["n","5",0],["lo","0",0],["i","-2",0]],"stack":["rob(nums)","line(lo=0, i=3)","line(lo=0, i=2)","line(lo=0, i=1)","line(lo=0, i=0)","line(lo=0, i=-2)"]}],"example":1},{"title":"Bottom-up table","code":"def rob(nums):\n    def line(lo, hi):          # houses lo..hi-1\n        dp = [0] * (hi - lo + 1)\n        for k in range(1, hi - lo + 1):\n            take = nums[lo + k - 1] + (dp[k - 2] if k >= 2 else 0)\n            dp[k] = max(dp[k - 1], take)\n        return dp[-1]\n\n    n = len(nums)\n    if n == 1:\n        return nums[0]\n    return max(line(1, n), line(0, n - 1))","frames":[{"caption":"<strong>Bottom-up table</strong> &mdash; O(n) time, O(n) extra space. Input: <code>rob(nums=[2, 7, 9, 3, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>def line(lo, hi):</code> <em>(houses lo..hi-1)</em>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>n = len(nums)</code> &mdash; <code>n = 5</code>","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["","","","",""]}],"vars":[["n","5",1]],"stack":[]},{"caption":"<code>if n == 1:</code> &rarr; <strong>false</strong> (n = 5)","line":10,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["","","","",""]}],"vars":[["n","5",0]],"stack":[]},{"caption":"<code>return max(line(1, n), line(0, n - 1))</code> &mdash; calls <code>line(lo=1, hi=5)</code>","line":12,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","5"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["n","5",0],["lo","1",1],["hi","5",1]],"stack":["rob(nums)","line(lo=1, hi=5)"]},{"caption":"<code>dp = [0] * (hi - lo + 1)</code> &mdash; <code>dp = [0, 0, 0, 0, 0]</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["","","","",""]},{"t":"arr","id":"dp","label":"dp","v":["0","0","0","0","0"],"cls":["","src","","",""],"ptr":{"5":["hi"],"1":["lo"]}}],"vars":[["n","5",0],["lo","1",0],["hi","5",0]],"stack":["rob(nums)","line(lo=1, hi=5)"]},{"caption":"<code>for k in range(1, hi - lo + 1):</code> &mdash; <code>k = 1</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3",