,0],["k","4",0],["take","10",0]],"stack":["rob(nums)","line(lo=0, hi=4)"]},{"caption":"<code>for k in range(1, hi - lo + 1):</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["","","","",""]},{"t":"arr","id":"dp","label":"dp","v":["0","2","7","11","11"],"cls":["src","","","","src"],"ptr":{"4":["hi","k"],"0":["lo"]}}],"vars":[["n","5",0],["lo","0",0],["hi","4",0],["k","4",0],["take","10",0]],"stack":["rob(nums)","line(lo=0, hi=4)"]},{"caption":"<code>return dp[-1]</code> &mdash; <code>line</code> returns <code>11</code> to <code>rob</code>. <strong>Result: 11</strong>","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["","","","",""]},{"t":"arr","id":"dp","label":"dp","v":["0","2","7","11","11"],"cls":["src","","","","src"],"ptr":{"4":["hi","k"],"0":["lo"]}}],"vars":[["n","5",0],["lo","0",0],["hi","4",0],["k","4",0],["take","10",0]],"stack":["rob(nums)","line(lo=0, hi=4)"]}],"example":1},{"title":"Two variables per pass","code":"def rob(nums):\n    def line(lo, hi):          # houses lo..hi-1\n        prev, cur = 0, 0\n        for i in range(lo, hi):\n            prev, cur = cur, max(cur, prev + nums[i])\n        return cur\n\n    n = len(nums)\n    if n == 1:\n        return nums[0]\n    return max(line(1, n), line(0, n - 1))","frames":[{"caption":"<strong>Two variables per pass</strong> &mdash; O(n) time, O(1) extra space. Input: <code>rob(nums=[2, 7, 9, 3, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>def line(lo, hi):</code> <em>(houses lo..hi-1)</em>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","9","3","1"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>n = len(nums)</code> &mdash; <code>n = 5</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7"