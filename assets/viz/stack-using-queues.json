{"chapters":[{"title":"Two queues, pay on pop","code":"class MyStack:\n    def __init__(self):\n        self.q, self.helper = deque(), deque()\n\n    def push(self, x):\n        self.q.append(x)\n\n    def pop(self):\n        while len(self.q) > 1:\n            self.helper.append(self.q.popleft())\n        top = self.q.popleft()\n        self.q, self.helper = self.helper, self.q\n        return top\n\n    def top(self):\n        x = self.pop()\n        self.push(x)\n        return x\n\n    def empty(self):\n        return not self.q","frames":[{"caption":"<strong>Two queues, pay on pop</strong> &mdash; push O(1), pop O(n) time, O(n) extra space. Running <code>s = MyStack(); s.push(x); __ex = ([s.top(), s.pop(), s.pop(), s.empty()])</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","y","S","t","a","c","k"],"cls":["","","","","","",""]}],"vars":[["self","'MyStack'",0]],"stack":[]},{"caption":"<code>self.q, self.helper = deque(), deque()</code> &mdash; returns <code>None</code>; <code>self.q = []</code>; <code>self.helper = []</code>","line":3,"panels":[{"t":"arr","id":"self.q","label":"self.q","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.q.append(x)</code> &mdash; returns <code>None</code>; <code>self.q</code> gets <code>1</code> appended; <code>x = 1</code>","line":6,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1"],"cls":["cur"]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","1",1]],"stack":[]},{"caption":"<code>self.q.append(x)</code> &mdash; returns <code>None</code>; <code>self.q</code> gets <code>2</code> appended; <code>x = 2</code>","line":6,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2"],"cls":["","cur"]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","2",1]],"stack":[]},{"caption":"<code>self.q.append(x)</code> &mdash; returns <code>None</code>; <code>self.q</code> gets <code>3</code> appended; <code>x = 3</code>","line":6,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2","3"],"cls":["","","cur"]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","3",1]],"stack":[]},{"caption":"<code>x = self.pop()</code> &mdash; calls <code>pop()</code>","line":16,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[],"stack":["top()","pop()"]},{"caption":"<code>while len(self.q) &gt; 1:</code> &rarr; <strong>true</strong>","line":9,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[],"stack":["top()","pop()"]},{"caption":"<code>self.helper.append(self.q.popleft())</code> &mdash; <code>1</code> taken from the front of <code>self.q</code>; <code>self.helper</code> gets <code>1</code> appended","line":10,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["2","3"],"cls":["cur","cur"]},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1"],"cls":["cur"]}],"vars":[],"stack":["top()","pop()"]},{"caption":"<code>while len(self.q) &gt; 1:</code> &rarr; <strong>true</strong>","line":9,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["2","3"],"cls":["",""]},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1"],"cls":[""]}],"vars":[],"stack":["top()","pop()"]},{"caption":"<code>self.helper.append(self.q.popleft())</code> &mdash; <code>2</code> taken from the front of <code>self.q</code>; <code>self.helper</code> gets <code>2</code> appended","line":10,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["3"],"cls":["cur"]},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1","2"],"cls":["","cur"]}],"vars":[],"stack":["top()","pop()"]},{"caption":"<code>while len(self.q) &gt; 1:</code> &rarr; <strong>false</strong>","line":9,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["3"],"cls":[""]},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1","2"],"cls":["",""]}],"vars":[],"stack":["top()","pop()"]},{"caption":"<code>top = self.q.popleft()</code> &mdash; <code>3</code> taken from the front of <code>self.q</code>; <code>top = 3</code>","line":11,"panels":[{"t":"arr","id":"self.q","label":"self.q","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1","2"],"cls":["",""]}],"vars":[["top","3",1]],"stack":["top()","pop()"]},{"caption":"<code>self.q, self.helper = self.helper, self.q</code> &mdash; <code>self.q</code> is now <code>[1, 2]</code>; <code>self.helper</code> is now <code>[]</code>","line":12,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2"],"cls":["cur","cur"]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["top","3",0]],"stack":["top()","pop()"]},{"caption":"<code>return top</code> &mdash; <code>pop</code> returns <code>3</code> to <code>top</code>","line":13,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2"],"cls":["",""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["top","3",0]],"stack":["top()","pop()"]},{"caption":"<code>self.push(x)</code> &mdash; calls <code>push(x=3)</code>","line":17,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2"],"cls":["",""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","3",1]],"stack":["top()","push(x=3)"]},{"caption":"<code>self.q.append(x)</code> &mdash; <code>push</code> returns <code>None</code> to <code>top</code>; <code>self.q</code> gets <code>3</code> appended","line":6,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2","3"],"cls":["","","cur"]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","3",0]],"stack":["top()","push(x=3)"]},{"caption":"<code>return x</code> &mdash; returns <code>3</code>","line":18,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","3",0]],"stack":[]},{"caption":"<code>while len(self.q) &gt; 1:</code> &rarr; <strong>true</strong>","line":9,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.helper.append(self.q.popleft())</code> &mdash; <code>1</code> taken from the front of <code>self.q</code>; <code>self.helper</code> gets <code>1</code> appended","line":10,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["2","3"],"cls":["cur","cur"]},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1"],"cls":["cur"]}],"vars":[],"stack":[]},{"caption":"<code>while len(self.q) &gt; 1:</code> &rarr; <strong>true</strong>","line":9,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["2","3"],"cls":["",""]},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>self.helper.append(self.q.popleft())</code> &mdash; <code>2</code> taken from the front of <code>self.q</code>; <code>self.helper</code> gets <code>2</code> appended","line":10,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["3"],"cls":["cur"]},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1","2"],"cls":["","cur"]}],"vars":[],"stack":[]},{"caption":"<code>while len(self.q) &gt; 1:</code> &rarr; <strong>false</strong>","line":9,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["3"],"cls":[""]},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1","2"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>top = self.q.popleft()</code> &mdash; <code>3</code> taken from the front of <code>self.q</code>; <code>top = 3</code>","line":11,"panels":[{"t":"arr","id":"self.q","label":"self.q","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1","2"],"cls":["",""]}],"vars":[["top","3",1]],"stack":[]},{"caption":"<code>self.q, self.helper = self.helper, self.q</code> &mdash; <code>self.q</code> is now <code>[1, 2]</code>; <code>self.helper</code> is now <code>[]</code>","line":12,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2"],"cls":["cur","cur"]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["top","3",0]],"stack":[]},{"caption":"<code>return top</code> &mdash; returns <code>3</code>","line":13,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2"],"cls":["",""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["top","3",0]],"stack":[]},{"caption":"<code>while len(self.q) &gt; 1:</code> &rarr; <strong>true</strong>","line":9,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2"],"cls":["",""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.helper.append(self.q.popleft())</code> &mdash; <code>1</code> taken from the front of <code>self.q</code>; <code>self.helper</code> gets <code>1</code> appended","line":10,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["2"],"cls":["cur"]},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1"],"cls":["cur"]}],"vars":[],"stack":[]},{"caption":"<code>while len(self.q) &gt; 1:</code> &rarr; <strong>false</strong>","line":9,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["2"],"cls":[""]},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>top = self.q.popleft()</code> &mdash; <code>2</code> taken from the front of <code>self.q</code>; <code>top = 2</code>","line":11,"panels":[{"t":"arr","id":"self.q","label":"self.q","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.helper","label":"self.helper (deque)","v":["1"],"cls":[""]}],"vars":[["top","2",1]],"stack":[]},{"caption":"<code>self.q, self.helper = self.helper, self.q</code> &mdash; <code>self.q</code> gets <code>1</code> appended; <code>1</code> popped off the end of <code>self.helper</code>","line":12,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1"],"cls":["cur"]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["top","2",0]],"stack":[]},{"caption":"<code>return top</code> &mdash; returns <code>2</code>","line":13,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1"],"cls":[""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["top","2",0]],"stack":[]},{"caption":"<code>return not self.q</code> &mdash; returns <code>F</code>. <strong>Result: F</strong>","line":21,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1"],"cls":[""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]}],"example":1},{"title":"One queue, rotate on push","code":"class MyStack:\n    def __init__(self):\n        self.q = deque()\n\n    def push(self, x):\n        self.q.append(x)\n        for _ in range(len(self.q) - 1):\n            self.q.append(self.q.popleft())      # newest to the front\n\n    def pop(self):\n        return self.q.popleft()\n\n    def top(self):\n        return self.q[0]\n\n    def empty(self):\n        return not self.q","frames":[{"caption":"<strong>One queue, rotate on push</strong> &mdash; push O(n), pop O(1) time, O(n) extra space. Running <code>s = MyStack(); s.push(x); __ex = ([s.top(), s.pop(), s.pop(), s.empty()])</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","y","S","t","a","c","k"],"cls":["","","","","","",""]}],"vars":[["self","'MyStack'",0]],"stack":[]},{"caption":"<code>self.q = deque()</code> &mdash; returns <code>None</code>; <code>self.q = []</code>","line":3,"panels":[{"t":"arr","id":"self.q","label":"self.q","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.q.append(x)</code> &mdash; <code>self.q</code> gets <code>1</code> appended; <code>x = 1</code>","line":6,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1"],"cls":["cur"]}],"vars":[["x","1",1]],"stack":[]},{"caption":"<code>for _ in range(len(self.q) - 1):</code> &mdash; returns <code>None</code>","line":7,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1"],"cls":[""]}],"vars":[["x","1",0]],"stack":[]},{"caption":"<code>self.q.append(x)</code> &mdash; <code>self.q</code> gets <code>2</code> appended; <code>x = 2</code>","line":6,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2"],"cls":["","cur"]}],"vars":[["x","2",1]],"stack":[]},{"caption":"<code>for _ in range(len(self.q) - 1):</code> &mdash; <code>_ = 0</code>","line":7,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","2"],"cls":["",""]}],"vars":[["x","2",0],["_","0",1]],"stack":[]},{"caption":"<code>self.q.append(self.q.popleft())</code> &mdash; swap <code>self.q[0]</code> and <code>self.q[1]</code> <em>(newest to the front)</em>","line":8,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["2","1"],"cls":["cur","cur"]}],"vars":[["x","2",0],["_","0",0]],"stack":[]},{"caption":"<code>for _ in range(len(self.q) - 1):</code> &mdash; returns <code>None</code>","line":7,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["2","1"],"cls":["",""]}],"vars":[["x","2",0],["_","0",0]],"stack":[]},{"caption":"<code>self.q.append(x)</code> &mdash; <code>self.q</code> gets <code>3</code> appended; <code>x = 3</code>","line":6,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["2","1","3"],"cls":["","","cur"]}],"vars":[["x","3",1]],"stack":[]},{"caption":"<code>for _ in range(len(self.q) - 1):</code> &mdash; <code>_ = 0</code>","line":7,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["2","1","3"],"cls":["","",""]}],"vars":[["x","3",0],["_","0",1]],"stack":[]},{"caption":"<code>self.q.append(self.q.popleft())</code> &mdash; <code>self.q</code> is now <code>[1, 3, 2]</code> <em>(newest to the front)</em>","line":8,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","3","2"],"cls":["cur","cur","cur"]}],"vars":[["x","3",0],["_","0",0]],"stack":[]},{"caption":"<code>for _ in range(len(self.q) - 1):</code> &mdash; <code>_ = 1</code>","line":7,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["1","3","2"],"cls":["","",""]}],"vars":[["x","3",0],["_","1",1]],"stack":[]},{"caption":"<code>self.q.append(self.q.popleft())</code> &mdash; <code>self.q</code> is now <code>[3, 2, 1]</code> <em>(newest to the front)</em>","line":8,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["3","2","1"],"cls":["cur","cur","cur"]}],"vars":[["x","3",0],["_","1",0]],"stack":[]},{"caption":"<code>for _ in range(len(self.q) - 1):</code> &mdash; returns <code>None</code>","line":7,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["3","2","1"],"cls":["","",""]}],"vars":[["x","3",0],["_","1",0]],"stack":[]},{"caption":"<code>return self.q[0]</code> &mdash; returns <code>3</code>","line":14,"panels":[{"t":"arr","id":"self.q","label":"self.q (deque)","v":["3","2","1"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.q.popleft()</code> &mdash; returns <code>3</code>; <code>3</c