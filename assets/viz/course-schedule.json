{"chapters":[{"title":"DFS with three colours","code":"def can_finish(num_courses, prerequisites):\n    adj = defaultdict(list)\n    for a, b in prerequisites:\n        adj[b].append(a)\n    WHITE, GREY, BLACK = 0, 1, 2\n    color = [WHITE] * num_courses\n\n    def has_cycle(u):\n        color[u] = GREY\n        for v in adj[u]:\n            if color[v] == GREY or (color[v] == WHITE and has_cycle(v)):\n                return True\n        color[u] = BLACK\n        return False\n\n    return not any(color[u] == WHITE and has_cycle(u) for u in range(num_courses))","frames":[{"caption":"<strong>DFS with three colours</strong> &mdash; O(V + E) time, O(V + E) extra space. Input: <code>can_finish(num_courses=4, prerequisites=[[1, 0], [2, 1], [3, 2], [1, 3]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"prerequisites","label":"prerequisites","v":["1,0","2,1","3,2","1,3"],"cls":["","","",""]}],"vars":[["num_courses","4",0]],"stack":[]},{"caption":"<code>adj = defaultdict(list)</code> &mdash; <code>adj = {}</code>","line":2,"panels":[{"t":"arr","id":"prerequisites","label":"prerequisites","v":["1,0","2,1","3,2","1,3"],"cls":["","","",""]},{"t":"net","id":"graph:adj","label":"adj (graph)","nodes":[],"edges":[],"dir":false}],"vars":[["num_courses","4",0]],"stack":[]},{"caption":"<code>for a, b in prerequisites:</code> &mdash; <code>a = 1</code>; <code>b = 0</code>","line":3,"panels":[{"t":"arr","id":"prerequisites","label":"prerequisites","v":["1,0","2,1","3,2","1,3"],"cls":["","","",""]},{"t":"net","id":"graph:adj","label":"adj (graph)","nodes":[],"edges":[],"dir":false}],"vars":[["num_courses","4",0],["a","1",1],["b","0",1]],"stack":[]},{"caption":"<code>adj[b].append(a)</code> &mdash; <code>adj[0] = [1]</code>","line":4,"panels":[{"t":"arr","id":"prerequisites","label":"prerequisites","v":["1,0","2,1","3,2","1,3"],"cls":["","","",""]},{"t":"net","id":"graph:adj","label":"adj (graph)","nodes":[["g0","0",1.6,0.0,"cur",["b"]],