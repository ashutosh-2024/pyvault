rong>.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["dim","dim","dim","dim","cur",""]],"rowLabels":["nums"],"colLabels":["0","1","2","3","4","5"]},"array":{"label":"array","v":["3","5","6"],"cls":["answer","done","src"]},"trees":[{"label":"min-heap (k = 2)","v":["3","5","6"],"cls":["answer","done","src"],"arrows":[[2,0]]}]},{"caption":"5 is the smaller child and beats 6: swap them.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["dim","dim","dim","dim","cur",""]],"rowLabels":["nums"],"colLabels":["0","1","2","3","4","5"]},"array":{"label":"array","v":["6","5"],"cls":["cur","src"]},"trees":[{"label":"min-heap (k = 2)","v":["6","5"],"cls":["cur","src"],"arrows":[[0,1],[1,0]]}]},{"caption":"6 is a leaf: stop.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["dim","dim","dim","dim","cur",""]],"rowLabels":["nums"],"colLabels":["0","1","2","3","4","5"]},"array":{"label":"array","v":["5","6"],"cls":["done","chosen"]},"trees":[{"label":"min-heap (k = 2)","v":["5","6"],"cls":["done","chosen"]}]},{"caption":"Push 4. The heap now has more than k items.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["dim","dim","dim","dim","dim","cur"]],"rowLabels":["nums"],"colLabels":["0","1","2","3","4","5"]},"array":{"label":"array","v":["4","6","5"],"cls":["done","done","done"]},"trees":[{"label":"min-heap (k = 2)","v":["4","6","5"],"cls":["cur","done","done"]}]},{"caption":"Evict the smallest: Pop the top, 4. Move the last element into the root and sift it <strong>down</strong>.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["dim","dim","dim","dim","dim","cur"]],"rowLabels":["nums"],"colLabels":["0","1","2","3","4","5"]},"array":{"label":"array","v":["4","6","5"],"cls":["answer","done","src"]},"trees":[{"label":"min-heap (k = 2)","v":["4","6","5"],"cls":["answer","done","src"],"arrows":[[2,0]]}]},{"caption":"5 is no larger than its children: stop.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["dim","dim","dim","dim","dim","cur"]],"rowLabels":["nums"],"colLabels":["0","1","2","