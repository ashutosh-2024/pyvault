{"chapters":[{"title":"Min-heap of size k","code":"def find_kth_largest(nums, k):\n    heap = []\n    for value in nums:\n        heapq.heappush(heap, value)\n        if len(heap) > k:\n            heapq.heappop(heap)      # drop the smallest of the k+1\n    return heap[0]","frames":[{"caption":"<strong>Min-heap of size k</strong> &mdash; O(n log k) time, O(k) extra space. Input: <code>find_kth_largest(nums=[3, 2, 1, 5, 6, 4], k=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>heap = []</code> &mdash; <code>heap = []</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]},{"t":"arr","id":"heap","label":"heap","v":[],"cls":[],"noidx":true}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>for value in nums:</code> &mdash; <code>value = 3</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]},{"t":"arr","id":"heap","label":"heap","v":[],"cls":[],"noidx":true}],"vars":[["k","2",0],["value","3",1]],"stack":[]},{"caption":"<code>heapq.heappush(heap, value)</code> &mdash; <code>heap</code> gets <code>3</code> appended","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]},{"t":"arr","id":"heap","label":"heap","v":["3"],"cls":["cur"]}],"vars":[["k","2",0],["value","3",0]],"stack":[]},{"caption":"<code>if len(heap) &gt; k:</code> &rarr; <strong>false</strong> (k = 2)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]},{"t":"arr","id":"heap","label":"heap","v":["3"],"cls":[""]}],"vars":[["k","2",0],["value","3",0]],"stack":[]},{"caption":"<code>for value in nums:</code> &mdash; <code>value = 2</code>","line":3,"panels":[{"t":"arr","id":"nums","l