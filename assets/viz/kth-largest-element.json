ms:</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]},{"t":"arr","id":"heap","label":"heap","v":["5","6"],"cls":["",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h1","6",0.0,1.25,"",[]],["h0","5",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"heap"}],"vars":[["k","2",0],["value","4",0]],"stack":[]},{"caption":"<code>return heap[0]</code> &mdash; returns <code>5</code>. <strong>Result: 5</strong>","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]},{"t":"arr","id":"heap","label":"heap","v":["5","6"],"cls":["",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h1","6",0.0,1.25,"",[]],["h0","5",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"heap"}],"vars":[["k","2",0],["value","4",0]],"stack":[]}],"example":1},{"title":"nlargest / sorting","code":"def find_kth_largest(nums, k):\n    return heapq.nlargest(k, nums)[-1]","frames":[{"caption":"<strong>nlargest / sorting</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>find_kth_largest(nums=[3, 2, 1, 5, 6, 4], k=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>return heapq.nlargest(k, nums)[-1]</code> &mdash; returns <code>5</code>. <strong>Result: 5</strong>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]}],"vars":[["k","2",0]],"stack":[]}]},{"title":"Quickselect","code":"def find_kth_largest(nums, k):\n    import random\n    target = len(nums) - k          # k-th largest = this index when sorted\n    lo, hi = 0, len(nums) - 1\n    nums = list(nums)\n    while True:\n        pivot = random.randint(lo, hi)\n        nums[pivot], nums[hi] = nums[hi], nums[pivot]\n        store = lo\n        for i in range(lo, hi):\n            if nums[i] < nums[hi]:\n                nums[store], nums[i] = nums[i], nums[store]\n                store += 1\n        nums[store], nums[hi] = nums[hi], nums[store]\n        if store == target:\n            return nums[store]\n        if store < target:\n            lo = store + 1\n        else:\n            hi = store - 1","frames":[{"caption":"<strong>Quickselect</strong> &mdash; O(n) average, O(n&sup2;) worst time, O(1) extra space. Input: <code>find_kth_largest(nums=[3, 2, 1, 5, 6, 4], k=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>import random</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>target = len(nums) - k</code> &mdash; <code>target = 4</code> <em>(k-th largest = this index when sorted)</em>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["","","","","",""]}],"vars":[["k","2",0],["target","4",1]],"stack":[]},{"caption":"<code>lo, hi = 0, len(nums) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 5</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["k","2",0],["target","4",0],["lo","0",1],["hi","5",1]],"stack":[]},{"caption":"<code>nums = list(nums)</code> &mdash; <code>nums</code> is now <code>[3, 2, 1, 5, 6, 4]</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","5","6","4"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["k","2",0],["target","4",0],["lo","0",0],["hi","5",0]],"stack":[]},{"caption":"<code>while True:</code> &rarr; <strong>