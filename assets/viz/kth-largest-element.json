{"chapters":[{"title":"Min-heap of size k","frames":[{"caption":"Keep a <strong>min-heap of the k = 2 largest values seen so far</strong>. Its top is the smallest of them, i.e. the k-th largest, and the first thing to evict when something bigger arrives.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["","","","","",""]],"rowLabels":["nums"],"colLabels":["0","1","2","3","4","5"]}},{"caption":"Push 3.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["cur","","","","",""]],"rowLabels":["nums"],"colLabels":["0","1","2","3","4","5"]},"array":{"label":"array","v":["3"],"cls":["done"]},"trees":[{"label":"min-heap (k = 2)","v":["3"],"cls":["cur"]}]},{"caption":"Push 2.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["dim","cur","","","",""]],"rowLabels":["nums"],"colLabels":["0","1","2","3","4","5"]},"array":{"label":"array","v":["2","3"],"cls":["done","done"]},"trees":[{"label":"min-heap (k = 2)","v":["2","3"],"cls":["cur","done"]}]},{"caption":"Push 1. The heap now has more than k items.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["dim","dim","cur","","",""]],"rowLabels":["nums"],"colLabels":["0","1","2","3","4","5"]},"array":{"label":"array","v":["1","3","2"],"cls":["done","done","done"]},"trees":[{"label":"min-heap (k = 2)","v":["1","3","2"],"cls":["cur","done","done"]}]},{"caption":"Evict the smallest: Pop the top, 1. Move the last element into the root and sift it <strong>down</strong>.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["dim","dim","cur","","",""]],"rowLabels":["nums"],"colLabels":["0","1","2","3","4","5"]},"array":{"label":"array","v":["1","3","2"],"cls":["answer","done","src"]},"trees":[{"label":"min-heap (k = 2)","v":["1","3","2"],"cls":["answer","done","src"],"arrows":[[2,0]]}]},{"caption":"2 is no larger than its children: stop.","grid":{"v":[["3","2","1","5","6","4"]],"cls":[["dim","dim","cur","","",""]],"rowLabels":["nums"],"colLabels":["0","1","2","3","4","5"]},"array":{"label":"array","v":["2","3"],"cls":["chosen","src"]},"trees":[{"lab