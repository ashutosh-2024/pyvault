{"chapters":[{"title":"Backtracking with length bounds","code":"def restore_ip_addresses(s):\n    out, parts = [], []\n\n    def dfs(i):\n        left = 4 - len(parts)\n        if left == 0:\n            if i == len(s):\n                out.append(\".\".join(parts))\n            return\n        if not left <= len(s) - i <= 3 * left:\n            return                              # too few or too many digits left\n        for size in (1, 2, 3):\n            seg = s[i:i + size]\n            if len(seg) < size or (size > 1 and seg[0] == \"0\") or int(seg) > 255:\n                break                           # a longer piece cannot fix it\n            parts.append(seg)\n            dfs(i + size)\n            parts.pop()\n\n    dfs(0)\n    return out","frames":[{"caption":"<strong>Backtracking with length bounds</strong> &mdash; O(1) time, O(1) extra space. Input: <code>restore_ip_addresses(s='0000')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["0","0","0","0"],"cls":["","","",""]}],"vars":[["s","'0000'",0]],"stack":[]},{"caption":"<code>out, parts = [], []</code> &mdash; <code>out = []</code>; <code>parts = []</code>","line":2,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"parts","label":"parts","v":[],"cls":[],"noidx":true}],"vars":[["s","'0000'",0]],"stack":[]},{"caption":"<code>def dfs(i):</code>","line":4,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"parts","label":"parts","v":[],"cls":[],"noidx":true}],"vars":[["s","'0000'",0]],"stack":[]},{"caption":"<code>dfs(0)</code> &mdash; calls <code>dfs(i=0)</code>","line":20,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"parts","label":"parts","v":[],"cls":[],"noidx":true}],"vars":[["s","'0000'",0],["i","0",1]],"stack":["restore_ip_addresses(s='0000')","dfs(i=0)"]},{"caption":"<code>left = 4 - len(parts)</code> 