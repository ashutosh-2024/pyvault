{"chapters":[{"title":"Copy in and sort","code":"def merge(nums1, m, nums2, n):\n    nums1[m:] = nums2\n    nums1.sort()","frames":[{"caption":"<strong>Copy in and sort</strong> &mdash; O((m + n) log(m + n)) time, O(1)&ndash;O(m + n) extra space. Input: <code>merge(nums1=[1, 2, 3, 0, 0, 0], m=3, nums2=[2, 5, 6], n=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums1","label":"nums1","v":["1","2","3","0","0","0"],"cls":["","","","","",""]},{"t":"arr","id":"nums2","label":"nums2","v":["2","5","6"],"cls":["","",""]}],"vars":[["m","3",0],["n","3",0]],"stack":[]},{"caption":"<code>nums1[m:] = nums2</code> &mdash; <code>nums1</code> is now <code>[1, 2, 3, 2, 5, 6]</code>","line":2,"panels":[{"t":"arr","id":"nums1","label":"nums1","v":["1","2","3","2","5","6"],"cls":["","","","cur","cur","cur"]},{"t":"arr","id":"nums2","label":"nums2","v":["2","5","6"],"cls":["","",""]}],"vars":[["m","3",0],["n","3",0]],"stack":[]},{"caption":"<code>nums1.sort()</code> &mdash; returns <code>None</code>; swap <code>nums1[2]</code> and <code>nums1[3]</code>. <strong>Result: None</strong>","line":3,"panels":[{"t":"arr","id":"nums1","label":"nums1","v":["1","2","2","3","5","6"],"cls":["","","cur","cur","",""]},{"t":"arr","id":"nums2","label":"nums2","v":["2","5","6"],"cls":["","",""]}],"vars":[["m","3",0],["n","3",0]],"stack":[]}]},{"title":"Copy nums1's values, merge forward","code":"def merge(nums1, m, nums2, n):\n    first = nums1[:m]\n    i = j = k = 0\n    while i < m and j < n:\n        if first[i] <= nums2[j]:\n            nums1[k] = first[i]; i += 1\n        else:\n            nums1[k] = nums2[j]; j += 1\n        k += 1\n    nums1[k:] = first[i:] + nums2[j:]","frames":[{"caption":"<strong>Copy nums1's values, merge forward</strong> &mdash; O(m + n) time, O(m) extra space. Input: <code>merge(nums1=[1, 2, 3, 0, 0, 0], m=3, nums2=[2, 5, 6], n=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums1","label":"nums1","v":["1","2","3","0","0","0"],"cls":["","","","","",""]},{"t":"arr","id":"nums2","label":"nums2","v":["2","5","6"],"cls":["","",""]}],"vars":[["m","3",0],["n","3",0]],"stack":[]},{"caption":"<code>first = nums1[:m]</code> &mdash; <code>first = [1, 2, 3]</code>","line":2,"panels":[{"t":"arr","id":"nums1","label":"nums1","v":["1","2","3","0","0","0"],"cls":["","","","","",""]},{"t":"arr","id":"nums2","label":"nums2","v":["2","5","6"],"cls":["","",""]},{"t":"arr","id":"first","label":"first","v":["1","2","3"],"cls":["","",""]}],"vars":[["m","3",0],["n","3",0]],"stack":[]},{"caption":"<code>i = j = k = 0</code> &mdash; <code>i = 0</code>; <code>j = 0</code>; <code>k = 0</code>","line":3,"panels":[{"t":"arr","id":"nums1","label":"nums1","v":["1","2","3","0","0","0"],"cls":["src","","","","",""],"ptr":{"0":["k"]}},{"t":"arr","id":"nums2","label":"nums2","v":["2","5","6"],"cls":["src","",""],"ptr":{"0":["j"]}},{"t":"arr","id":"first","label":"first","v":["1","2","3"],"cls":["src","",""],"ptr":{"0":["i"]}}],"vars":[["m","3",0],["n","3",0],["i","0",1],["j","0",1],["k","0",1]],"stack":[]},{"caption":"<code>while i &lt; m and j &lt; n:</code> &rarr; <strong>true</strong> (i = 0, j = 0, m = 3, n = 3)","line":4,"panels":[{"t":"arr","id":"nums1","label":"nums1","v":["1","2","3","0","0","0"],"cls":["src","","","","",""],"ptr":{"0":["k"]}},{"t":"arr","id":"nums2","label":"nums2","v":["2","5","6"],"cls":["src","",""],"ptr":{"0":["j"]}},{"t":"arr","id":"first","label":"first","v":["1","2","3"],"cls":["src","",""],"ptr":{"0":["i"]}}],"vars":[["m","3",0],["n","3",0],["i","0",0],["j","0",0],["k","0",0]],"stack":[]},{"caption":"<code>if first[i] &lt;= nums2[j]:</code> &rarr; <strong>true</strong> (i = 0, j = 0)","line":5,"panels":[{"t":"arr","id":"nums1","label":"nums1","v":["1","2","3","0","0","0"],"cls":["src","","","","",""],"ptr":{"0":["k"]}},{"t":"arr","id":"nums2","label":"nums2","v":["2","5","6"],"cls":["src","",""],"ptr":{"0":["j"]}},{"t":"arr","id":"fir