{"chapters":[{"title":"Inorder, compare with the previous value","code":"def get_minimum_difference(root):\n    best, prev = float(\"inf\"), None\n\n    def walk(node):\n        nonlocal best, prev\n        if node is None:\n            return\n        walk(node.left)\n        if prev is not None:\n            best = min(best, node.val - prev)\n        prev = node.val\n        walk(node.right)\n\n    walk(root)\n    return best","frames":[{"caption":"<strong>Inorder, compare with the previous value</strong> &mdash; O(n) time, O(h) extra space. Input: <code>get_minimum_difference(root=tree (4))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4425612816","1",0.0,2.5,"",[]],["n4425722256","2",1.0,1.25,"",[]],["n4436494192","3",2.0,2.5,"",[]],["n4428173328","4",3.0,0.0,"cur",["root"]],["n4425721616","6",4.0,1.25,"",[]]],"edges":[["n4428173328","n4425722256","",""],["n4425722256","n4425612816","",""],["n4425722256","n4436494192","",""],["n4428173328","n4425721616","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>best, prev = float(\"inf\"), None</code> &mdash; <code>best = ∞</code>; <code>prev = None</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4425612816","1",0.0,2.5,"",[]],["n4425722256","2",1.0,1.25,"",[]],["n4436494192","3",2.0,2.5,"",[]],["n4428173328","4",3.0,0.0,"cur",["root"]],["n4425721616","6",4.0,1.25,"",[]]],"edges":[["n4428173328","n4425722256","",""],["n4425722256","n4425612816","",""],["n4425722256","n4436494192","",""],["n4428173328","n4425721616","",""]],"dir":false}],"vars":[["best","∞",1],["prev","None",1]],"stack":[]},{"caption":"<code>def walk(node):</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4425612816","1",0.0,2.5,"",[]],["n4425722256","2",1.0,1.25,"",[]],["n4436494192","3",2.0,2.5,"",[]],["n4428173328","4",3.0,0.0,"cur",["root"]],["n4425721616","6",4.0,1.25,"",[]]],"edges":[["n4428173328