{"chapters":[{"title":"Inorder, compare with the previous value","code":"def get_minimum_difference(root):\n    best, prev = float(\"inf\"), None\n\n    def walk(node):\n        nonlocal best, prev\n        if node is None:\n            return\n        walk(node.left)\n        if prev is not None:\n            best = min(best, node.val - prev)\n        prev = node.val\n        walk(node.right)\n\n    walk(root)\n    return best","frames":[{"caption":"<strong>Inorder, compare with the previous value</strong> &mdash; O(n) time, O(h) extra space. Input: <code>get_minimum_difference(root=tree (1))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455201552","0",0.0,1.25,"",[]],["n4455430000","1",1.0,0.0,"cur",["root"]],["n4455290896","12",2.0,2.5,"",[]],["n4455197072","48",3.0,1.25,"",[]],["n4455294240","49",4.0,2.5,"",[]]],"edges":[["n4455430000","n4455201552","",""],["n4455430000","n4455197072","",""],["n4455197072","n4455290896","",""],["n4455197072","n4455294240","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>best, prev = float(\"inf\"), None</code> &mdash; <code>best = ∞</code>; <code>prev = None</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455201552","0",0.0,1.25,"",[]],["n4455430000","1",1.0,0.0,"cur",["root"]],["n4455290896","12",2.0,2.5,"",[]],["n4455197072","48",3.0,1.25,"",[]],["n4455294240","49",4.0,2.5,"",[]]],"edges":[["n4455430000","n4455201552","",""],["n4455430000","n4455197072","",""],["n4455197072","n4455290896","",""],["n4455197072","n4455294240","",""]],"dir":false}],"vars":[["best","∞",1],["prev","None",1]],"stack":[]},{"caption":"<code>def walk(node):</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455201552","0",0.0,1.25,"",[]],["n4455430000","1",1.0,0.0,"cur",["root"]],["n4455290896","12",2.0,2.5,"",[]],["n4455197072","48",3.0,1.25,"",[]],["n4455294240","49",4.0,2.5,"",[]]],"edges":[["n4