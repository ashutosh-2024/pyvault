:["4","5"],"cls":["",""]},{"t":"arr","id":"total","label":"total","v":["5","5","3","5"],"cls":["","","",""]}],"vars":[["num1","'123'",0],["num2","'45'",0],["total","'5535'",0],["shift","1",0],["ch","'4'",0]],"stack":[]}],"example":1},{"title":"Position array: digit i × digit j goes to i + j","code":"def multiply(num1, num2):\n    m, n = len(num1), len(num2)\n    pos = [0] * (m + n)\n    for i, a in enumerate(reversed(num1)):\n        for j, b in enumerate(reversed(num2)):\n            pos[i + j] += int(a) * int(b)\n    carry = 0\n    for k in range(m + n):\n        carry, pos[k] = divmod(pos[k] + carry, 10)\n    out = \"\".join(map(str, reversed(pos))).lstrip(\"0\")\n    return out or \"0\"","frames":[{"caption":"<strong>Position array: digit i × digit j goes to i + j</strong> &mdash; O(m &middot; n) time, O(m + n) extra space. Input: <code>multiply(num1='123', num2='45')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"num1","label":"num1","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"num2","label":"num2","v":["4","5"],"cls":["",""]}],"vars":[["num1","'123'",0],["num2","'45'",0]],"stack":[]},{"caption":"<code>m, n = len(num1), len(num2)</code> &mdash; <code>m = 3</code>; <code>n = 2</code>","line":2,"panels":[{"t":"arr","id":"num1","label":"num1","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"num2","label":"num2","v":["4","5"],"cls":["",""]}],"vars":[["num1","'123'",0],["num2","'45'",0],["m","3",1],["n","2",1]],"stack":[]},{"caption":"<code>pos = [0] * (m + n)</code> &mdash; <code>pos = [0, 0, 0, 0, 0]</code>","line":3,"panels":[{"t":"arr","id":"pos","label":"pos","v":["0","0","0","0","0"],"cls":["","","","",""]}],"vars":[["num1","'123'",0],["num2","'45'",0],["m","3",0],["n","2",0]],"stack":[]},{"caption":"<code>for i, a in enumerate(reversed(num1)):</code> &mdash; <code>i = 0</code>; <code>a = '3'</code>","line":4,"panels":[{"t":"arr","id":"pos","label":"pos","v":["0","0","0","0","0"],"cls":["","","","","