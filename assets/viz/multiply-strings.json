{"chapters":[{"title":"Schoolbook: add a shifted partial product per digit","code":"def multiply(num1, num2):\n    def add(a, b):\n        i, j, carry, out = len(a) - 1, len(b) - 1, 0, []\n        while i >= 0 or j >= 0 or carry:\n            t = carry + (int(a[i]) if i >= 0 else 0) + (int(b[j]) if j >= 0 else 0)\n            out.append(str(t % 10)); carry = t // 10; i -= 1; j -= 1\n        return \"\".join(reversed(out))\n\n    def times_digit(a, d):\n        carry, out = 0, []\n        for ch in reversed(a):\n            t = int(ch) * d + carry\n            out.append(str(t % 10)); carry = t // 10\n        if carry:\n            out.append(str(carry))\n        return \"\".join(reversed(out))\n\n    if num1 == \"0\" or num2 == \"0\":\n        return \"0\"\n    total = \"0\"\n    for shift, ch in enumerate(reversed(num2)):\n        total = add(total, times_digit(num1, int(ch)) + \"0\" * shift)\n    return total","frames":[{"caption":"<strong>Schoolbook: add a shifted partial product per digit</strong> &mdash; O(m &middot; n + n&sup2;) time, O(m + n) extra space. Input: <code>multiply(num1='123', num2='45')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"num1","label":"num1","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"num2","label":"num2","v":["4","5"],"cls":["",""]}],"vars":[["num1","'123'",0],["num2","'45'",0]],"stack":[]},{"caption":"<code>def add(a, b):</code>","line":2,"panels":[{"t":"arr","id":"num1","label":"num1","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"num2","label":"num2","v":["4","5"],"cls":["",""]}],"vars":[["num1","'123'",0],["num2","'45'",0]],"stack":[]},{"caption":"<code>def times_digit(a, d):</code>","line":9,"panels":[{"t":"arr","id":"num1","label":"num1","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"num2","label":"num2","v":["4","5"],"cls":["",""]}],"vars":[["num1","'123'",0],["num2","'45'",0]],"stack":[]},{"caption":"<code>if num1 == \"0\" or num2 == \"0\":</code> &rarr; <strong>false</strong> (num1 = '123', num2 = '45')","line":18,"panels":[{"t":"arr","id":"num1","label":"num1","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"num2","label":"num2","v":["4","5"],"cls":["",""]}],"vars":[["num1","'123'",0],["num2","'45'",0]],"stack":[]},{"caption":"<code>total = \"0\"</code> &mdash; <code>total = '0'</code>","line":20,"panels":[{"t":"arr","id":"num1","label":"num1","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"num2","label":"num2","v":["4","5"],"cls":["",""]}],"vars":[["num1","'123'",0],["num2","'45'",0],["total","'0'",1]],"stack":[]},{"caption":"<code>for shift, ch in enumerate(reversed(num2)):</code> &mdash; <code>shift = 0</code>; <code>ch = '5'</code>","line":21,"panels":[{"t":"arr","id":"num1","label":"num1","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"num2","label":"num2","v":["4","5"],"cls":["",""]}],"vars":[["num1","'123'",0],["num2","'45'",0],["total","'0'",0],["shift","0",1],["ch","'5'",1]],"stack":[]},{"caption":"<code>total = add(total, times_digit(num1, int(ch)) + \"0\" * shift)</code> &mdash; calls <code>times_digit(a='123', d=5)</code>","line":22,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2","3"],"cls":["","",""]}],"vars":[["num1","'123'",0],["num2","'45'",0],["total","'0'",0],["shift","0",0],["ch","'5'",0],["a","'123'",1],["d","5",1]],"stack":["multiply(num1='123', num2='45')","times_digit(a='123', d=5)"]},{"caption":"<code>carry, out = 0, []</code> &mdash; <code>carry = 0</code>; <code>out = []</code>","line":10,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["num1","'123'",0],["num2","'45'",0],["total","'0'",0],["shift","0",0],["ch","'5'",0],["a","'123'",0],["d","5",0],["carry","0",1]],"stack":["multiply(num1='123', num2='45')","times_digit(a='123', d=5)"]},{"caption":"<code>for ch in reversed(a):</code> &mdash; <code>ch = '3'</code>","line":11,"panels":[{"t":"arr","id":"a","label":"a","v