{"chapters":[{"title":"Match the two-letter pairs first","code":"def roman_to_int(s):\n    pairs = {\"IV\": 4, \"IX\": 9, \"XL\": 40, \"XC\": 90, \"CD\": 400, \"CM\": 900}\n    single = {\"I\": 1, \"V\": 5, \"X\": 10, \"L\": 50, \"C\": 100, \"D\": 500, \"M\": 1000}\n    i = total = 0\n    while i < len(s):\n        if s[i:i + 2] in pairs:\n            total += pairs[s[i:i + 2]]\n            i += 2\n        else:\n            total += single[s[i]]\n            i += 1\n    return total","frames":[{"caption":"<strong>Match the two-letter pairs first</strong> &mdash; O(n) time, O(1) extra space. Input: <code>roman_to_int(s='LVIII')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["L","V","I","I","I"],"cls":["","","","",""]}],"vars":[["s","'LVIII'",0]],"stack":[]},{"caption":"<code>pairs = {\"IV\": 4, \"IX\": 9, \"XL\": 40, \"XC\": 90, \"CD\": 400, \"CM\": 900}</code> &mdash; <code>pairs = {'IV': 4, 'IX': 9, 'XL': 40, 'XC': 90, 'CD': 400, 'CM': 900}</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["L","V","I","I","I"],"cls":["","","","",""]},{"t":"arr","id":"pairs","label":"pairs","v":["4","9","40","90","400","900"],"cls":["","","","","",""],"keys":["IV","IX","XL","XC","CD","CM"]}],"vars":[["s","'LVIII'",0]],"stack":[]},{"caption":"<code>single = {\"I\": 1, \"V\": 5, \"X\": 10, \"L\": 50, \"C\": 100, \"D\": 500, \"M\": 1000}</code> &mdash; <code>single = {'I': 1, 'V': 5, 'X': 10, 'L': 50, 'C': 100, 'D': 500, …}</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["L","V","I","I","I"],"cls":["","","","",""]},{"t":"arr","id":"pairs","label":"pairs","v":["4","9","40","90","400","900"],"cls":["","","","","",""],"keys":["IV","IX","XL","XC","CD","CM"]},{"t":"arr","id":"single","label":"single","v":["1","5","10","50","100","500","1000"],"cls":["","","","","","",""],"keys":["I","V","X","L","C","D","M"]}],"vars":[["s","'LVIII'",0]],"stack":[]},{"caption":"<code>i = total = 0</code> &mdash