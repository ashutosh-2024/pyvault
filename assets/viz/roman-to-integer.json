 (i = 5, s = 'LVIII')","line":5,"panels":[{"t":"arr","id":"s","label":"s","v":["L","V","I","I","I"],"cls":["","","","",""],"ptr":{"5":["i"]}},{"t":"arr","id":"pairs","label":"pairs","v":["4","9","40","90","400","900"],"cls":["","","","","",""],"keys":["IV","IX","XL","XC","CD","CM"]},{"t":"arr","id":"single","label":"single","v":["1","5","10","50","100","500","1000"],"cls":["","","","","","",""],"keys":["I","V","X","L","C","D","M"]}],"vars":[["s","'LVIII'",0],["i","5",0],["total","58",0]],"stack":[]},{"caption":"<code>return total</code> &mdash; returns <code>58</code>. <strong>Result: 58</strong>","line":12,"panels":[{"t":"arr","id":"s","label":"s","v":["L","V","I","I","I"],"cls":["","","","",""],"ptr":{"5":["i"]}},{"t":"arr","id":"pairs","label":"pairs","v":["4","9","40","90","400","900"],"cls":["","","","","",""],"keys":["IV","IX","XL","XC","CD","CM"]},{"t":"arr","id":"single","label":"single","v":["1","5","10","50","100","500","1000"],"cls":["","","","","","",""],"keys":["I","V","X","L","C","D","M"]}],"vars":[["s","'LVIII'",0],["i","5",0],["total","58",0]],"stack":[]}]},{"title":"Subtract when smaller than the next symbol","code":"def roman_to_int(s):\n    val = {\"I\": 1, \"V\": 5, \"X\": 10, \"L\": 50, \"C\": 100, \"D\": 500, \"M\": 1000}\n    total = 0\n    for i, ch in enumerate(s):\n        v = val[ch]\n        if i + 1 < len(s) and v < val[s[i + 1]]:\n            total -= v                           # IV, IX, XL, ...\n        else:\n            total += v\n    return total","frames":[{"caption":"<strong>Subtract when smaller than the next symbol</strong> &mdash; O(n) time, O(1) extra space. Input: <code>roman_to_int(s='MCMXCIV')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["M","C","M","X","C","I","V"],"cls":["","","","","","",""]}],"vars":[["s","'MCMXCIV'",0]],"stack":[]},{"caption":"<code>val = {\"I\": 1, \"V\": 5, \"X\": 10, \"L\": 50, \"C\": 100, \"D\": 500, \"M\": 1000}</code> &mdash