{"chapters":[{"title":"Recursive","code":"def preorder(root):\n    out = []\n\n    def walk(node):\n        if node is None:\n            return\n        out.append(node.val)   # root\n        walk(node.left)        # left\n        walk(node.right)       # right\n\n    walk(root)\n    return out","frames":[{"caption":"<strong>Recursive</strong> &mdash; O(n) time, O(h) extra space. Input: <code>preorder(root=tree (1))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>out = []</code> &mdash; <code>out = []</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>def walk(node):</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>walk(root)</code> &mdash; calls <code>walk(node=(1))</code>","line":11,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"cur",["node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[],"stack":["preorder(root=(1))","walk(node=(1))"]},{"caption":"<code>if node is None:</code> &rarr; <strong>false</strong>","line":5,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"cur",["node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[],"stack":["preorder(root=(1))","walk(node=(1))"]},{"caption":"<code>out.append(node.val)</code> &mdash; <code>out</code> gets <code>1</code> appended <em>(root)</em>","line":7,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"cur",["node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":["cur"]}],"vars":[],"stack":["preorder(root=(1))","walk(node=(1))"]},{"caption":"<code>walk(node.left)</code> &mdash; calls <code>walk(node=None)</code> <em>(left)</em>","line":8,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"stack",[]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]}],"vars":[["node","None",1]],"stack":["preorder(root=(1))","walk(node=(1))","walk(node=None)"]},{"caption":"<code>if node is None:</code> &rarr; <strong>true</strong> (node = None)","line":5,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"stack",[]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]}],"vars":[["node","None",0]],"stack":["preorder(root=(1))","walk(node=(1))","walk(node=None)"]},{"caption":"<code>return</code> &mdash; <code>walk</code> returns <code>None</code> to <code>walk</code>","line":6,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"stack",[]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]}],"vars":[["node","None",0]],"stack":["preorder(root=(1))","walk(node=(1))","walk(node=None)"]},{"caption":"<code>walk(node.right)</code> &mdash; calls <code>walk(node=None)</code> <em>(right)</em>","line":9,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"stack",[]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]}],"vars":[["node","None",0]],"stack":["preorder(root=(1))","walk(node=(1))","walk(node=None)"]},{"caption":"<code>if node is None:</code> &rarr; <strong>true</strong> (node = None)","line":5,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"stack",[]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]}],"vars":[["node","None",0]],"stack":["preorder(root=(1))","walk(node=(1))","walk(node=None)"]},{"caption":"<code>return</code> &mdash; <code>walk</code> returns <code>None</code> to <code>walk</code>","line":6,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"stack",[]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]}],"vars":[["node","None",0]],"stack":["preorder(root=(1))","walk(node=(1))","walk(node=None)"]},{"caption":"<code>return out</code> &mdash; returns <code>[1]</code>. <strong>Result: [1]</strong>","line":12,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431248","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]},{"t":"arr","id":"result","label":"result","v":["1"],"cls":["answer"]}],"vars":[],"stack":[]}]},{"title":"Iterative, one stack","code":"def preorder(root):\n    if root is None:\n        return []\n    out, stack = [], [root]\n    while stack:\n        node = stack.pop()\n        out.append(node.val)\n        if node.right is not None:\n            stack.append(node.right)   # pushed first, popped second\n        if node.left is not None:\n            stack.append(node.left)\n    return out","frames":[{"caption":"<strong>Iterative, one stack</strong> &mdash; O(n) time, O(h) extra space. Input: <code>preorder(root=tree (1))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431504","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>if root is None:</code> &rarr; <strong>false</strong>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431504","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>out, stack = [], [root]</code> &mdash; <code>out = []</code>; <code>stack = [(1)]</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431504","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"stack","label":"stack","v":["1"],"cls":["stack"]}],"vars":[],"stack":[]},{"caption":"<code>while stack:</code> &rarr; <strong>true</strong>","line":5,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431504","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"stack","label":"stack","v":["1"],"cls":["stack"]}],"vars":[],"stack":[]},{"caption":"<code>node = stack.pop()</code> &mdash; <code>(1)</code> popped off the end of <code>stack</code>","line":6,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431504","1",0.0,0.0,"cur",["root","node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>out.append(node.val)</code> &mdash; <code>out</code> gets <code>1</code> appended","line":7,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431504","1",0.0,0.0,"cur",["root","node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":["cur"]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>if node.right is not None:</code> &rarr; <strong>false</strong>","line":8,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431504","1",0.0,0.0,"cur",["root","node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>if node.left is not None:</code> &rarr; <strong>false</strong>","line":10,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431504","1",0.0,0.0,"cur",["root","node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>while stack:</code> &rarr; <strong>false</strong>","line":5,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431504","1",0.0,0.0,"cur",["root","node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>return out</code> &mdash; returns <code>[1]</code>. <strong>Result: [1]</strong>","line":12,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431431504","1",0.0,0.0,"cur",["root","node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true},{"t":"arr","id":"result","label":"result","v":["1"],"cls":["answer"]}],"vars":[],"stack":[]}]},{"title":"Morris traversal","code":"def preorder(root):\n    out, node = [], root\n    while node is not None:\n        if node.left is None:\n            out.append(node.val)\n            node = node.right\n            continue\n        pred = node.left\n        while pred.right is not None and pred.right is not node:\n            pred = pred.right\n        if pred.right is None:\n            out.append(node.val)   # emit before descending: preorder\n            pred.right = node      # thread\n            node = node.left\n        else:\n            pred.right = None      # unthread, left subtree done\n            node = node.right\n    return out","frames":[{"caption":"<strong>Morris traversal</strong> &mdash; O(n) time, O(1) extra space. Input: <code>preorder(root=tree (1))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431433808","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>out, node = [], root</code> &mdash; <code>out = []</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431433808","1",0.0,0.0,"cur",["root","node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>while node is not None:</code> &rarr; <strong>true</strong>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431433808","1",0.0,0.0,"cur",["root","node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>if node.left is None:</code> &rarr; <strong>true</strong>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431433808","1",0.0,0.0,"cur",["root","node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>out.append(node.val)</code> &mdash; <code>out</code> gets <code>1</code> appended","line":5,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431433808","1",0.0,0.0,"cur",["root","node"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":["cur"]}],"vars":[],"stack":[]},{"caption":"<code>node = node.right</code> &mdash; <code>node = None</code>","line":6,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431433808","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]}],"vars":[["node","None",1]],"stack":[]},{"caption":"<code>continue</code>","line":7,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431433808","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]}],"vars":[["node","None",0]],"stack":[]},{"caption":"<code>while node is not None:</code> &rarr; <strong>false</strong> (node = None)","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431433808","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]}],"vars":[["node","None",0]],"stack":[]},{"caption":"<code>return out</code> &mdash; returns <code>[1]</code>. <strong>Result: [1]</strong>","line":18,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4431433808","1",0.0,0.0,"cur",["root"]]],"edges":[],"dir":false},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]},{"t":"arr","id":"result","label":"result","v":["1"],"cls":["answer"]}],"vars":[["node","None",0]],"stack":[]}]}]}