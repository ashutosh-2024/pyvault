rong>","line":3,"panels":[{"t":"arr","id":"clean","label":"clean","v":["r","a","c","e","c","a","r"],"cls":["","","","","","",""]}],"vars":[["s","'Race, car!'",0]],"stack":[]}],"example":1},{"title":"Two pointers skipping non-alphanumerics","code":"def is_palindrome(s):\n    lo, hi = 0, len(s) - 1\n    while lo < hi:\n        if not s[lo].isalnum():\n            lo += 1\n        elif not s[hi].isalnum():\n            hi -= 1\n        elif s[lo].lower() != s[hi].lower():\n            return False\n        else:\n            lo, hi = lo + 1, hi - 1\n    return True","frames":[{"caption":"<strong>Two pointers skipping non-alphanumerics</strong> &mdash; O(n) time, O(1) extra space. Input: <code>is_palindrome(s='Race, car!')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["R","a","c","e",","," ","c","a","r","!"],"cls":["","","","","","","","","",""]}],"vars":[["s","'Race, car!'",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(s) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 9</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["R","a","c","e",","," ","c","a","r","!"],"cls":["src","","","","","","","","","src"],"ptr":{"9":["hi"],"0":["lo"]}}],"vars":[["s","'Race, car!'",0],["lo","0",1],["hi","9",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 9, lo = 0)","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["R","a","c","e",","," ","c","a","r","!"],"cls":["src","","","","","","","","","src"],"ptr":{"9":["hi"],"0":["lo"]}}],"vars":[["s","'Race, car!'",0],["lo","0",0],["hi","9",0]],"stack":[]},{"caption":"<code>if not s[lo].isalnum():</code> &rarr; <strong>false</strong> (lo = 0, s = 'Race, car!')","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["R","a","c","e",","," ","c","a","r","!"],"cls":["src","","","","","","","","","src"],"ptr":{"9":["hi"],"0":["lo"]}}],"vars":[["s","'Race, car!'",0],["lo","0",0],["hi","9",0]],"stack":[]},{"capt