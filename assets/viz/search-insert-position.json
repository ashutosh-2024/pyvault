{"chapters":[{"title":"Linear scan for the first value ≥ target","code":"def search_insert(nums, target):\n    for i, x in enumerate(nums):\n        if x >= target:\n            return i\n    return len(nums)","frames":[{"caption":"<strong>Linear scan for the first value ≥ target</strong> &mdash; O(n) time, O(1) extra space. Input: <code>search_insert(nums=[1, 3, 5, 6], target=7)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["","","",""]}],"vars":[["target","7",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 0</code>; <code>x = 1</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","","",""],"ptr":{"0":["i"]}}],"vars":[["target","7",0],["i","0",1],["x","1",1]],"stack":[]},{"caption":"<code>if x &gt;= target:</code> &rarr; <strong>false</strong> (target = 7, x = 1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","","",""],"ptr":{"0":["i"]}}],"vars":[["target","7",0],["i","0",0],["x","1",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 1</code>; <code>x = 3</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["","src","",""],"ptr":{"1":["i"]}}],"vars":[["target","7",0],["i","1",1],["x","3",1]],"stack":[]},{"caption":"<code>if x &gt;= target:</code> &rarr; <strong>false</strong> (target = 7, x = 3)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["","src","",""],"ptr":{"1":["i"]}}],"vars":[["target","7",0],["i","1",0],["x","3",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 2</code>; <code>x = 5</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["","","src",""],"ptr":{"2":["i"]}}],"vars":[["target","7",0],["i","2",1],["x","5",1]],"stack":[]},{"caption":"<code>if x &gt;= target:</code> &rarr; <strong>false</strong> (target = 7, x = 5)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["","","src",""],"ptr":{"2":["i"]}}],"vars":[["target","7",0],["i","2",0],["x","5",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 3</code>; <code>x = 6</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["","","","src"],"ptr":{"3":["i"]}}],"vars":[["target","7",0],["i","3",1],["x","6",1]],"stack":[]},{"caption":"<code>if x &gt;= target:</code> &rarr; <strong>false</strong> (target = 7, x = 6)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["","","","src"],"ptr":{"3":["i"]}}],"vars":[["target","7",0],["i","3",0],["x","6",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["","","","src"],"ptr":{"3":["i"]}}],"vars":[["target","7",0],["i","3",0],["x","6",0]],"stack":[]},{"caption":"<code>return len(nums)</code> &mdash; returns <code>4</code>. <strong>Result: 4</strong>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["","","","src"],"ptr":{"3":["i"]}}],"vars":[["target","7",0],["i","3",0],["x","6",0]],"stack":[]}]},{"title":"Lower bound on a half-open range","code":"def search_insert(nums, target):\n    lo, hi = 0, len(nums)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if nums[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid                            # mid may be the answer\n    return lo","frames":[{"caption":"<strong>Lower bound on a half-open range</strong> &mdash; O(log n) time, O(1) extra space. Input: <code>search_insert(nums=[1, 3, 5, 6], target=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["","","",""]}],"vars":[["target","2",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(nums)</code> &mdash; <code>lo = 0</code>; <code>hi = 4</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","","",""],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["target","2",0],["lo","0",1],["hi","4",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 4, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","","",""],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["target","2",0],["lo","0",0],["hi","4",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 2</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","","src",""],"ptr":{"4":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","4",0],["mid","2",1]],"stack":[]},{"caption":"<code>if nums[mid] &lt; target:</code> &rarr; <strong>false</strong> (mid = 2, target = 2)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","","src",""],"ptr":{"4":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","4",0],["mid","2",0]],"stack":[]},{"caption":"<code>hi = mid</code> &mdash; <code>hi = 2</code> <em>(mid may be the answer)</em>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","","src",""],"ptr":{"2":["hi","mid"],"0":["lo"]}}],"vars":[["target","2",0],["lo","0",0],["hi","2",1],["mid","2",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 2, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","","src",""],"ptr":{"2":["hi","mid"],"0":["lo"]}}],"vars":[["target","2",0],["lo","0",0],["hi","2",0],["mid","2",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 1</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","src","src",""],"ptr":{"2":["hi"],"0":["lo"],"1":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","2",0],["mid","1",1]],"stack":[]},{"caption":"<code>if nums[mid] &lt; target:</code> &rarr; <strong>false</strong> (mid = 1, target = 2)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","src","src",""],"ptr":{"2":["hi"],"0":["lo"],"1":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","2",0],["mid","1",0]],"stack":[]},{"caption":"<code>hi = mid</code> &mdash; <code>hi = 1</code> <em>(mid may be the answer)</em>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","src","",""],"ptr":{"1":["hi","mid"],"0":["lo"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",1],["mid","1",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 1, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","src","",""],"ptr":{"1":["hi","mid"],"0":["lo"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",0],["mid","1",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 0</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo","mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",0],["mid","0",1]],"stack":[]},{"caption":"<code>if nums[mid] &lt; target:</code> &rarr; <strong>true</strong> (mid = 0, target = 2)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo","mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",0],["mid","0",0]],"stack":[]},{"caption":"<code>lo = mid + 1</code> &mdash; <code>lo = 1</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","src","",""],"ptr":{"1":["hi","lo"],"0":["mid"]}}],"vars":[["target","2",0],["lo","1",1],["hi","1",0],["mid","0",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>false</strong> (hi = 1, lo = 1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","src","",""],"ptr":{"1":["hi","lo"],"0":["mid"]}}],"vars":[["target","2",0],["lo","1",0],["hi","1",0],["mid","0",0]],"stack":[]},{"caption":"<code>return lo</code> &mdash; returns <code>1</code>. <strong>Result: 1</strong>","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","5","6"],"cls":["src","src","",""],"ptr":{"1":["hi","lo"],"0":["mid"]}}],"vars":[["target","2",0],["lo","1",0],["hi","1",0],["mid","0",0]],"stack":[]}]}]}