{"chapters":[{"title":"Convert to an integer and back","code":"def plus_one(digits):\n    return [int(d) for d in str(int(\"\".join(map(str, digits))) + 1)]","frames":[{"caption":"<strong>Convert to an integer and back</strong> &mdash; O(n) time, O(n) extra space. Input: <code>plus_one(digits=[1, 2, 9, 9])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","9"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>return [int(d) for d in str(int(\"\".join(map(str, digits))) + 1)]</code> &mdash; <code>d = '1'</code>","line":2,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","9"],"cls":["","","",""]}],"vars":[["d","'1'",1]],"stack":[]},{"caption":"<code>return [int(d) for d in str(int(\"\".join(map(str, digits))) + 1)]</code> &mdash; <code>d = '3'</code>","line":2,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","9"],"cls":["","","",""]}],"vars":[["d","'3'",1]],"stack":[]},{"caption":"<code>return [int(d) for d in str(int(\"\".join(map(str, digits))) + 1)]</code> &mdash; <code>d = '0'</code>","line":2,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","9"],"cls":["","","",""]}],"vars":[["d","'0'",1]],"stack":[]},{"caption":"<code>return [int(d) for d in str(int(\"\".join(map(str, digits))) + 1)]</code>","line":2,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","9"],"cls":["","","",""]}],"vars":[["d","'0'",0]],"stack":[]},{"caption":"<code>return [int(d) for d in str(int(\"\".join(map(str, digits))) + 1)]</code> &mdash; returns <code>[1, 3, 0, 0]</code>. <strong>Result: [1, 3, 0, 0]</strong>","line":2,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","9"],"cls":["","","",""]},{"t":"arr","id":"result","label":"result","v":["1","3","0","0"],"cls":["answer","answer","answer","answer"]}],"vars":[],"stack":[]}],"example":1},{"title":"Carry from the end","code":"def plus_one(digits):\n    digits = digits[:]\n    for i in range(len(digits) - 1, -1, -1):\n        if digits[i] < 9:\n            digits[i] += 1\n            return digits\n        digits[i] = 0                          # 9 + 1: write 0, carry on\n    return [1] + digits","frames":[{"caption":"<strong>Carry from the end</strong> &mdash; O(n) time, O(1) (O(n) only for all 9s) extra space. Input: <code>plus_one(digits=[1, 2, 9, 9])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","9"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>digits = digits[:]</code> &mdash; <code>digits</code> is now <code>[1, 2, 9, 9]</code>","line":2,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","9"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>for i in range(len(digits) - 1, -1, -1):</code> &mdash; <code>i = 3</code>","line":3,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","9"],"cls":["","","","src"],"ptr":{"3":["i"]}}],"vars":[["i","3",1]],"stack":[]},{"caption":"<code>if digits[i] &lt; 9:</code> &rarr; <strong>false</strong> (i = 3)","line":4,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","9"],"cls":["","","","src"],"ptr":{"3":["i"]}}],"vars":[["i","3",0]],"stack":[]},{"caption":"<code>digits[i] = 0</code> &mdash; <code>digits[3]</code> becomes <code>0</code> <em>(9 + 1: write 0, carry on)</em>","line":7,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","0"],"cls":["","","","cur"],"ptr":{"3":["i"]}}],"vars":[["i","3",0]],"stack":[]},{"caption":"<code>for i in range(len(digits) - 1, -1, -1):</code> &mdash; <code>i = 2</code>","line":3,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","0"],"cls":["","","src",""],"ptr":{"2":["i"]}}],"vars":[["i","2",1]],"stack":[]},{"caption":"<code>if digits[i] &lt; 9:</code> &rarr; <strong>false</strong> (i = 2)","line":4,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","9","0"],"cls":["","","src",""],"ptr":{"2":["i"]}}],"vars":[["i","2",0]],"stack":[]},{"caption":"<code>digits[i] = 0</code> &mdash; <code>digits[2]</code> becomes <code>0</code> <em>(9 + 1: write 0, carry on)</em>","line":7,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","0","0"],"cls":["","","cur",""],"ptr":{"2":["i"]}}],"vars":[["i","2",0]],"stack":[]},{"caption":"<code>for i in range(len(digits) - 1, -1, -1):</code> &mdash; <code>i = 1</code>","line":3,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","0","0"],"cls":["","src","",""],"ptr":{"1":["i"]}}],"vars":[["i","1",1]],"stack":[]},{"caption":"<code>if digits[i] &lt; 9:</code> &rarr; <strong>true</strong> (i = 1)","line":4,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","2","0","0"],"cls":["","src","",""],"ptr":{"1":["i"]}}],"vars":[["i","1",0]],"stack":[]},{"caption":"<code>digits[i] += 1</code> &mdash; <code>digits[1]</code> becomes <code>3</code>","line":5,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","3","0","0"],"cls":["","cur","",""],"ptr":{"1":["i"]}}],"vars":[["i","1",0]],"stack":[]},{"caption":"<code>return digits</code> &mdash; returns <code>[1, 3, 0, 0]</code>. <strong>Result: [1, 3, 0, 0]</strong>","line":6,"panels":[{"t":"arr","id":"digits","label":"digits","v":["1","3","0","0"],"cls":["","src","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"result","label":"result","v":["1","3","0","0"],"cls":["answer","answer","answer","answer"]}],"vars":[["i","1",0]],"stack":[]}],"example":1}]}