{"chapters":[{"title":"Return (sum, size)","code":"def average_of_subtree(root):\n    count = 0\n\n    def dfs(node):\n        nonlocal count\n        if node is None:\n            return 0, 0\n        ls, ln = dfs(node.left)\n        rs, rn = dfs(node.right)\n        total, size = ls + rs + node.val, ln + rn + 1\n        count += total // size == node.val\n        return total, size\n\n    dfs(root)\n    return count","frames":[{"caption":"<strong>Return (sum, size)</strong> &mdash; O(n) time, O(h) extra space. Input: <code>average_of_subtree(root=tree (4))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4389091056","0",0.0,2.5,"",[]],["n4389199760","8",1.0,1.25,"",[]],["n4389092576","1",2.0,2.5,"",[]],["n4388879536","4",3.0,0.0,"cur",["root"]],["n4389202000","5",4.0,1.25,"",[]],["n4391902320","6",5.0,2.5,"",[]]],"edges":[["n4388879536","n4389199760","",""],["n4389199760","n4389091056","",""],["n4389199760","n4389092576","",""],["n4388879536","n4389202000","",""],["n4389202000","n4391902320","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>count = 0</code> &mdash; <code>count = 0</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4389091056","0",0.0,2.5,"",[]],["n4389199760","8",1.0,1.25,"",[]],["n4389092576","1",2.0,2.5,"",[]],["n4388879536","4",3.0,0.0,"cur",["root"]],["n4389202000","5",4.0,1.25,"",[]],["n4391902320","6",5.0,2.5,"",[]]],"edges":[["n4388879536","n4389199760","",""],["n4389199760","n4389091056","",""],["n4389199760","n4389092576","",""],["n4388879536","n4389202000","",""],["n4389202000","n4391902320","",""]],"dir":false}],"vars":[["count","0",1]],"stack":[]},{"caption":"<code>def dfs(node):</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4389091056","0",0.0,2.5,"",[]],["n4389199760","8",1.0,1.25,"",[]],["n4389092576","1",2.0,2.5,"",[]],["n4388879536","4",3.0,0.0,"cur",["root"]],["n4389202000","5",4.