{"chapters":[{"title":"Reversed root-right-to-left preorder","code":"def postorder(root):\n    out, stack = [], [root] if root else []\n    while stack:\n        node = stack.pop()\n        out.append(node.val)\n        stack.extend(node.children)      # last child popped first\n    return out[::-1]","frames":[{"caption":"<strong>Reversed root-right-to-left preorder</strong> &mdash; O(n) time, O(n) extra space. Input: <code>postorder(root=tree (1))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455295152","5",0.0,2.5,"",[]],["n4455412752","6",1.0,2.5,"",[]],["n4455200592","3",0.5,1.25,"",[]],["n4455198352","2",2.0,1.25,"",[]],["n4455295760","4",3.0,1.25,"",[]],["n4455422944","1",1.75,0.0,"cur",["root"]]],"edges":[["n4455422944","n4455200592","",""],["n4455200592","n4455295152","",""],["n4455200592","n4455412752","",""],["n4455422944","n4455198352","",""],["n4455422944","n4455295760","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>out, stack = [], [root] if root else []</code> &mdash; <code>out = []</code>; <code>stack = [(1)]</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455295152","5",0.0,2.5,"",[]],["n4455412752","6",1.0,2.5,"",[]],["n4455200592","3",0.5,1.25,"",[]],["n4455198352","2",2.0,1.25,"",[]],["n4455295760","4",3.0,1.25,"",[]],["n4455422944","1",1.75,0.0,"cur",["root"]]],"edges":[["n4455422944","n4455200592","",""],["n4455200592","n4455295152","",""],["n4455200592","n4455412752","",""],["n4455422944","n4455198352","",""],["n4455422944","n4455295760","",""]],"dir":false},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"stack","label":"stack","v":["1"],"cls":["stack"]}],"vars":[],"stack":[]},{"caption":"<code>while stack:</code> &rarr; <strong>true</strong>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455295152","5",0.0,2.5,"",[]],["n4455412752","6",1.0,2.5,"",[]],["n44