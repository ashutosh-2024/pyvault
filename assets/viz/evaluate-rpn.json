{"chapters":[{"title":"Operand stack","code":"def eval_rpn(tokens):\n    ops = {\n        \"+\": lambda a, b: a + b,\n        \"-\": lambda a, b: a - b,\n        \"*\": lambda a, b: a * b,\n        \"/\": lambda a, b: int(a / b),        # truncate toward zero\n    }\n    stack = []\n    for tok in tokens:\n        if tok in ops:\n            b, a = stack.pop(), stack.pop()   # right operand is on top\n            stack.append(ops[tok](a, b))\n        else:\n            stack.append(int(tok))\n    return stack[0]","frames":[{"caption":"<strong>Operand stack</strong> &mdash; O(n) time, O(n) extra space. Input: <code>eval_rpn(tokens=['5', '1', '2', '+', '4', '*', '+', '3', …])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"tokens","label":"tokens","v":["5","1","2","+","4","*","+","3","-"],"cls":["","","","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>\"+\": lambda a, b: a + b,</code>","line":3,"panels":[{"t":"arr","id":"tokens","label":"tokens","v":["5","1","2","+","4","*","+","3","-"],"cls":["","","","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>\"-\": lambda a, b: a - b,</code>","line":4,"panels":[{"t":"arr","id":"tokens","label":"tokens","v":["5","1","2","+","4","*","+","3","-"],"cls":["","","","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>\"*\": lambda a, b: a * b,</code>","line":5,"panels":[{"t":"arr","id":"tokens","label":"tokens","v":["5","1","2","+","4","*","+","3","-"],"cls":["","","","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>\"/\": lambda a, b: int(a / b),</code> <em>(truncate toward zero)</em>","line":6,"panels":[{"t":"arr","id":"tokens","label":"tokens","v":["5","1","2","+","4","*","+","3","-"],"cls":["","","","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>ops = {</code> &mdash; <code>ops = {'+': 'function', '-': 'function', '*': 'function', '/': 'function'}</code>","line":2,"panels":[{"t":"arr","id":"tokens","label":"tokens","v":["5