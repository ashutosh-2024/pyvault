)","ok(i=1, fives=1, tens=0)","ok(i=2, fives=2, tens=0)","ok(i=3, fives=1, tens=1)","ok(i=4, fives=0, tens=0)","ok(i=5, fives=1, tens=0)","ok(i=6, fives=2, tens=0)","ok(i=7, fives=3, tens=0)","ok(i=8, fives=0, tens=0)"]},{"caption":"<code>return ((tens &gt; 0 and fives &gt; 0 and ok(i + 1, fives - 1, tens - 1))</code> &mdash; <code>ok</code> returns <code>T</code> to <code>ok</code>; <code>i = 7</code>; <code>fives = 3</code>. <strong>Result: T</strong>","line":11,"panels":[{"t":"arr","id":"bills","label":"bills","v":["5","5","10","20","5","5","5","20"],"cls":["","","","","","","","src"],"ptr":{"7":["i"]}}],"vars":[["i","7",1],["fives","3",1],["tens","0",0],["b","20",0]],"stack":["lemonade_change(bills)","ok(i=0, fives=0, tens=0)","ok(i=1, fives=1, tens=0)","ok(i=2, fives=2, tens=0)","ok(i=3, fives=1, tens=1)","ok(i=4, fives=0, tens=0)","ok(i=5, fives=1, tens=0)","ok(i=6, fives=2, tens=0)","ok(i=7, fives=3, tens=0)"]}],"example":1},{"title":"Count bills, prefer giving a $10","code":"def lemonade_change(bills):\n    fives = tens = 0\n    for b in bills:\n        if b == 5:\n            fives += 1\n        elif b == 10:\n            if not fives:\n                return False\n            fives, tens = fives - 1, tens + 1\n        elif tens and fives:                     # $20: keep the more useful $5s\n            fives, tens = fives - 1, tens - 1\n        elif fives >= 3:\n            fives -= 3\n        else:\n            return False\n    return True","frames":[{"caption":"<strong>Count bills, prefer giving a $10</strong> &mdash; O(n) time, O(1) extra space. Input: <code>lemonade_change(bills=[5, 5, 10, 20, 5, 5, 5, 20])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"bills","label":"bills","v":["5","5","10","20","5","5","5","20"],"cls":["","","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>fives = tens = 0</code> &mdash; <code>fives = 0</code>; <code>tens = 0</code>","line":2,"panels":[{"t":"arr","id":"