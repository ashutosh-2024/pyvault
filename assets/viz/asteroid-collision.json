{"chapters":[{"title":"Resolve one collision at a time","code":"def asteroid_collision(asteroids):\n    a = list(asteroids)\n    changed = True\n    while changed:\n        changed = False\n        for i in range(len(a) - 1):\n            if a[i] > 0 > a[i + 1]:\n                if abs(a[i]) > abs(a[i + 1]):\n                    del a[i + 1]\n                elif abs(a[i]) < abs(a[i + 1]):\n                    del a[i]\n                else:\n                    del a[i:i + 2]\n                changed = True\n                break\n    return a","frames":[{"caption":"<strong>Resolve one collision at a time</strong> &mdash; O(n&sup2;) time, O(n) extra space. Input: <code>asteroid_collision(asteroids=[10, 2, -5])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>a = list(asteroids)</code> &mdash; <code>a = [10, 2, -5]</code>","line":2,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","2","-5"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>changed = True</code> &mdash; <code>changed = T</code>","line":3,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","2","-5"],"cls":["","",""]}],"vars":[["changed","T",1]],"stack":[]},{"caption":"<code>while changed:</code> &rarr; <strong>true</strong> (changed = T)","line":4,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","2","-5"],"cls":["","",""]}],"vars":[["changed","T",0]],"stack":[]},{"caption":"<code>changed = False</code> &mdash; <code>changed = F</code>","line":5,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","2","-5"],"cls":["","",""]}],"vars":[["changed","F",1]],"stack":[]},{"caption":"<code>for i in range(len(a) - 1):</code> &mdash; <code>i = 0</code>","line":6,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","2","-5"],"cls":["src","",""],"ptr":{"0":["i"]}}],"vars":[["changed","F",0],["i","0",1]],"stack":[]},{"caption":"<code>if a[i] &gt; 0 &gt; a[i + 1]:</code> &rarr; <strong>false</strong> (i = 0)","line":7,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","2","-5"],"cls":["src","",""],"ptr":{"0":["i"]}}],"vars":[["changed","F",0],["i","0",0]],"stack":[]},{"caption":"<code>for i in range(len(a) - 1):</code> &mdash; <code>i = 1</code>","line":6,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","2","-5"],"cls":["","src",""],"ptr":{"1":["i"]}}],"vars":[["changed","F",0],["i","1",1]],"stack":[]},{"caption":"<code>if a[i] &gt; 0 &gt; a[i + 1]:</code> &rarr; <strong>true</strong> (i = 1)","line":7,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","2","-5"],"cls":["","src",""],"ptr":{"1":["i"]}}],"vars":[["changed","F",0],["i","1",0]],"stack":[]},{"caption":"<code>if abs(a[i]) &gt; abs(a[i + 1]):</code> &rarr; <strong>false</strong> (i = 1)","line":8,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","2","-5"],"cls":["","src",""],"ptr":{"1":["i"]}}],"vars":[["changed","F",0],["i","1",0]],"stack":[]},{"caption":"<code>elif abs(a[i]) &lt; abs(a[i + 1]):</code> &rarr; <strong>true</strong> (i = 1)","line":10,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","2","-5"],"cls":["","src",""],"ptr":{"1":["i"]}}],"vars":[["changed","F",0],["i","1",0]],"stack":[]},{"caption":"<code>del a[i]</code> &mdash; <code>a</code> is now <code>[10, -5]</code>","line":11,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","-5"],"cls":["","cur"],"ptr":{"1":["i"]}}],"vars":[["changed","F",0],["i","1",0]],"stack":[]},{"caption":"<code>changed = True</code> &mdash; <code>changed = T</code>","line":14,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","-5"],"cls":["","src"],"ptr":{"1":["i"]}}],"vars":[["changed","T",1],["i","1",0]],"stack":[]},{"caption":"<code>break</code>","line":15,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","-5"],"cls":["","src"],"ptr":{"1":["i"]}}],"vars":[["changed","T",0],["i","1",0]],"stack":[]},{"caption":"<code>while changed:</code> &rarr; <strong>true</strong> (changed = T)","line":4,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","-5"],"cls":["","src"],"ptr":{"1":["i"]}}],"vars":[["changed","T",0],["i","1",0]],"stack":[]},{"caption":"<code>changed = False</code> &mdash; <code>changed = F</code>","line":5,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","-5"],"cls":["","src"],"ptr":{"1":["i"]}}],"vars":[["changed","F",1],["i","1",0]],"stack":[]},{"caption":"<code>for i in range(len(a) - 1):</code> &mdash; <code>i = 0</code>","line":6,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","-5"],"cls":["src",""],"ptr":{"0":["i"]}}],"vars":[["changed","F",0],["i","0",1]],"stack":[]},{"caption":"<code>if a[i] &gt; 0 &gt; a[i + 1]:</code> &rarr; <strong>true</strong> (i = 0)","line":7,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","-5"],"cls":["src",""],"ptr":{"0":["i"]}}],"vars":[["changed","F",0],["i","0",0]],"stack":[]},{"caption":"<code>if abs(a[i]) &gt; abs(a[i + 1]):</code> &rarr; <strong>true</strong> (i = 0)","line":8,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10","-5"],"cls":["src",""],"ptr":{"0":["i"]}}],"vars":[["changed","F",0],["i","0",0]],"stack":[]},{"caption":"<code>del a[i + 1]</code> &mdash; <code>-5</code> popped off the end of <code>a</code>","line":9,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10"],"cls":["src"],"ptr":{"0":["i"]}}],"vars":[["changed","F",0],["i","0",0]],"stack":[]},{"caption":"<code>changed = True</code> &mdash; <code>changed = T</code>","line":14,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10"],"cls":["src"],"ptr":{"0":["i"]}}],"vars":[["changed","T",1],["i","0",0]],"stack":[]},{"caption":"<code>break</code>","line":15,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10"],"cls":["src"],"ptr":{"0":["i"]}}],"vars":[["changed","T",0],["i","0",0]],"stack":[]},{"caption":"<code>while changed:</code> &rarr; <strong>true</strong> (changed = T)","line":4,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10"],"cls":["src"],"ptr":{"0":["i"]}}],"vars":[["changed","T",0],["i","0",0]],"stack":[]},{"caption":"<code>changed = False</code> &mdash; <code>changed = F</code>","line":5,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10"],"cls":["src"],"ptr":{"0":["i"]}}],"vars":[["changed","F",1],["i","0",0]],"stack":[]},{"caption":"<code>for i in range(len(a) - 1):</code>","line":6,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10"],"cls":["src"],"ptr":{"0":["i"]}}],"vars":[["changed","F",0],["i","0",0]],"stack":[]},{"caption":"<code>while changed:</code> &rarr; <strong>false</strong> (changed = F)","line":4,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10"],"cls":["src"],"ptr":{"0":["i"]}}],"vars":[["changed","F",0],["i","0",0]],"stack":[]},{"caption":"<code>return a</code> &mdash; returns <code>[10]</code>. <strong>Result: [10]</strong>","line":16,"panels":[{"t":"arr","id":"asteroids","label":"asteroids","v":["10","2","-5"],"cls":["","",""]},{"t":"arr","id":"a","label":"a","v":["10"],"cls":["src"],"ptr":{"0":["i"]}},{"t":"arr","id":"result","label":"result","v":["10"],"cls":["answer"]}],"vars":[["changed","F",0],["i","0",0]],"stack":[]}]},{"title":"Stack of survivors","code":"def asteroid_collision(asteroids):\n    stack = []\n    for a in asteroids:\n        alive = True\n        while alive and a < 0 and stack and stack[-1] > 0:\n            if stack[-1] < -a:\n                stack.pop()                   # the right-mover explodes, keep going\n            elif stack[-1] == -a:\n                stack.pop()\n                alive = False                 # both explode\n            else:\n                alive = False                 # the left-mover explodes\n        if alive:\n            stack.append(a)\n    return stack","frames":[{"caption":"<strong>Stack of survivors</strong> &mdash; O(n) time, O(n) extra space. Input: <code>asteroid_collision(asteroids=[10, 2, -5])</code>. Step through to watch the code work on this i