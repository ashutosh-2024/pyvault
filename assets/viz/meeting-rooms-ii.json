{"chapters":[{"title":"Min-heap of end times","code":"def min_meeting_rooms(intervals):\n    if not intervals:\n        return 0\n    intervals.sort()\n    ends = []                       # min-heap of in-use room end times\n\n    for start, end in intervals:\n        if ends and ends[0] <= start:\n            heapq.heappop(ends)     # earliest room is free, reuse it\n        heapq.heappush(ends, end)\n    return len(ends)","frames":[{"caption":"<strong>Min-heap of end times</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>min_meeting_rooms(intervals=[[1, 10], [2, 7], [3, 19], [8, 12], [10, 20], [11, 30]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>if not intervals:</code> &rarr; <strong>false</strong>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>intervals.sort()</code>","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>ends = []</code> &mdash; <code>ends = []</code> <em>(min-heap of in-use room end times)</em>","line":5,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]},{"t":"arr","id":"ends","label":"ends","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>for start, end in intervals:</code> &mdash; <code>start = 1</code>; <code>end = 10</code>","line":7,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]},{"t":"arr","id":"ends","label":"ends","v":[],"cls":[],"noidx":true}],"vars":[["start","1",1],["en