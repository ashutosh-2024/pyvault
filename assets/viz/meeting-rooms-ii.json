"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]},{"t":"arr","id":"ends","label":"ends","v":["12","19","20","30"],"cls":["","","","cur"]},{"t":"net","id":"heap:ends","label":"ends drawn as a tree","nodes":[["h3","30",0.0,2.5,"cur",[]],["h1","19",1.0,1.25,"",[]],["h0","12",2.0,0.0,"",["top"]],["h2","20",3.0,1.25,"",[]]],"edges":[["h0","h1","",""],["h1","h3","",""],["h0","h2","",""]],"dir":false,"mirror":"ends"}],"vars":[["start","11",0],["end","30",0]],"stack":[]},{"caption":"<code>for start, end in intervals:</code>","line":7,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]},{"t":"arr","id":"ends","label":"ends","v":["12","19","20","30"],"cls":["","","",""]},{"t":"net","id":"heap:ends","label":"ends drawn as a tree","nodes":[["h3","30",0.0,2.5,"",[]],["h1","19",1.0,1.25,"",[]],["h0","12",2.0,0.0,"",["top"]],["h2","20",3.0,1.25,"",[]]],"edges":[["h0","h1","",""],["h1","h3","",""],["h0","h2","",""]],"dir":false,"mirror":"ends"}],"vars":[["start","11",0],["end","30",0]],"stack":[]},{"caption":"<code>return len(ends)</code> &mdash; returns <code>4</code>. <strong>Result: 4</strong>","line":11,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]},{"t":"arr","id":"ends","label":"ends","v":["12","19","20","30"],"cls":["","","",""]},{"t":"net","id":"heap:ends","label":"ends drawn as a tree","nodes":[["h3","30",0.0,2.5,"",[]],["h1","19",1.0,1.25,"",[]],["h0","12",2.0,0.0,"",["top"]],["h2","20",3.0,1.25,"",[]]],"edges":[["h0","h1","",""],["h1","h3","",""],["h0","h2","",""]],"dir":false,"mirror":"ends"}],"vars":[["start","11",0],["end","30",0]],"stack":[]}]},{"title":"Sweep the endpoints","code":"def min_meeting_rooms(intervals):\n    starts = sorted(s for s, _ in intervals)\n    ends = sorted(e for _, e in intervals)\n\n    rooms = best = 0\n    j = 0\n    for start in starts:\n        while ends[j] <= start:\n            rooms -= 1\n            j += 1\n        rooms += 1\n        best = max(best, rooms)\n    return best","frames":[{"caption":"<strong>Sweep the endpoints</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>min_meeting_rooms(intervals=[[1, 10], [2, 7], [3, 19], [8, 12], [10, 20], [11, 30]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>starts = sorted(s for s, _ in intervals)</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]}],"vars":[],"stack":["min_meeting_rooms(intervals)","<genexpr>()"]},{"caption":"<code>starts = sorted(s for s, _ in intervals)</code> &mdash; yields <code>1</code>; <code>s = 1</code>; <code>_ = 10</code>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]}],"vars":[["s","1",1],["_","10",1]],"stack":["min_meeting_rooms(intervals)","<genexpr>()"]},{"caption":"<code>starts = sorted(s for s, _ in intervals)</code> &mdash; yields <code>2</code>; <code>s = 2</code>; <code>_ = 7</code>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]}],"vars":[["s","2",1],["_","7",1]],"stack":["min_meeting_rooms(intervals)","<genexpr>()"]},{"caption":"<code>starts = sorted(s for s, _ in intervals)</code> &mdash; yields <code>3</code>; <code>s = 3</code>; <code>_ = 19</code>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,10","2,7","3,19","8,12","10,20","11,30"],"cls":["","","","","",""]}],"vars":[["s","3",1],["_","19",1]],"stack":["min_m