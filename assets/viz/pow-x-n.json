{"chapters":[{"title":"Multiply n times","code":"def my_pow(x, n):\n    if n < 0:\n        x, n = 1 / x, -n\n    result = 1.0\n    for _ in range(n):\n        result *= x\n    return result","frames":[{"caption":"<strong>Multiply n times</strong> &mdash; O(n) time, O(1) extra space. Input: <code>my_pow(x=2, n=10)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","2",0],["n","10",0]],"stack":[]},{"caption":"<code>if n &lt; 0:</code> &rarr; <strong>false</strong> (n = 10)","line":2,"panels":[],"vars":[["x","2",0],["n","10",0]],"stack":[]},{"caption":"<code>result = 1.0</code> &mdash; <code>result = 1</code>","line":4,"panels":[],"vars":[["x","2",0],["n","10",0],["result","1",1]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 0</code>","line":5,"panels":[],"vars":[["x","2",0],["n","10",0],["result","1",0],["_","0",1]],"stack":[]},{"caption":"<code>result *= x</code> &mdash; <code>result = 2</code>","line":6,"panels":[],"vars":[["x","2",0],["n","10",0],["result","2",1],["_","0",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 1</code>","line":5,"panels":[],"vars":[["x","2",0],["n","10",0],["result","2",0],["_","1",1]],"stack":[]},{"caption":"<code>result *= x</code> &mdash; <code>result = 4</code>","line":6,"panels":[],"vars":[["x","2",0],["n","10",0],["result","4",1],["_","1",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 2</code>","line":5,"panels":[],"vars":[["x","2",0],["n","10",0],["result","4",0],["_","2",1]],"stack":[]},{"caption":"<code>result *= x</code> &mdash; <code>result = 8</code>","line":6,"panels":[],"vars":[["x","2",0],["n","10",0],["result","8",1],["_","2",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 3</code>","line":5,"panels":[],"vars":[["x","2",0],["n","10",0],["result","8",0],["_","3",1]],"stack":[]},{"caption":"<code>result *= x</code> &mdash; <code>result = 16</code>","line":6,"panels":[],"vars":[["x","2",0],["n","10",0],["result","16",1],["_","3",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 4</code>","line":5,"panels":[],"vars":[["x","2",0],["n","10",0],["result","16",0],["_","4",1]],"stack":[]},{"caption":"<code>result *= x</code> &mdash; <code>result = 32</code>","line":6,"panels":[],"vars":[["x","2",0],["n","10",0],["result","32",1],["_","4",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 5</code>","line":5,"panels":[],"vars":[["x","2",0],["n","10",0],["result","32",0],["_","5",1]],"stack":[]},{"caption":"<code>result *= x</code> &mdash; <code>result = 64</code>","line":6,"panels":[],"vars":[["x","2",0],["n","10",0],["result","64",1],["_","5",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 6</code>","line":5,"panels":[],"vars":[["x","2",0],["n","10",0],["result","64",0],["_","6",1]],"stack":[]},{"caption":"<code>result *= x</code> &mdash; <code>result = 128</code>","line":6,"panels":[],"vars":[["x","2",0],["n","10",0],["result","128",1],["_","6",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 7</code>","line":5,"panels":[],"vars":[["x","2",0],["n","10",0],["result","128",0],["_","7",1]],"stack":[]},{"caption":"<code>result *= x</code> &mdash; <code>result = 256</code>","line":6,"panels":[],"vars":[["x","2",0],["n","10",0],["result","256",1],["_","7",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 8</code>","line":5,"panels":[],"vars":[["x","2",0],["n","10",0],["result","256",0],["_","8",1]],"stack":[]},{"caption":"<code>result *= x</code> &mdash; <code>result = 512</code>","line":6,"panels":[],"vars":[["x","2",0],["n","10",0],["result","512",1],["_","8",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 9</code>","line":5,"panels":[],"vars":[["x","2",0],["n","10",0],["result","512",0],["_","9",1]],"stack":[]},{"caption":"<code>result *= x</code> &mdash; <code>result = 1024</code>","line":6,"panels":[],"vars":[["x","2",0],["n","10",0],["result","1024",1],["_","9",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code>","line":5,"panels":[],"vars":[["x","2",0],["n","10",0],["result","1024",0],["_","9",0]],"stack":[]},{"caption":"<code>return result</code> &mdash; returns <code>1024</code>. <strong>Result: 1024</strong>","line":7,"panels":[],"vars":[["x","2",0],["n","10",0],["result","1024",0],["_","9",0]],"stack":[]}],"example":1},{"title":"Recursive squaring","code":"def my_pow(x, n):\n    def go(n):\n        if n == 0:\n            return 1.0\n        half = go(n // 2)\n        return half * half * (x if n % 2 else 1)\n    return go(n) if n >= 0 else 1 / go(-n)","frames":[{"caption":"<strong>Recursive squaring</strong> &mdash; O(log n) time, O(log n) extra space. Input: <code>my_pow(x=2, n=10)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","2",0],["n","10",0]],"stack":[]},{"caption":"<code>def go(n):</code>","line":2,"panels":[],"vars":[["x","2",0],["n","10",0]],"stack":[]},{"caption":"<code>return go(n) if n &gt;= 0 else 1 / go(-n)</code> &mdash; calls <code>go(n=10)</code>","line":7,"panels":[],"vars":[["x","2",0],["n","10",0]],"stack":["my_pow(x=2, n=10)","go(n=10)"]},{"caption":"<code>if n == 0:</code> &rarr; <strong>false</strong> (n = 10)","line":3,"panels":[],"vars":[["x","2",0],["n","10",0]],"stack":["my_pow(x=2, n=10)","go(n=10)"]},{"caption":"<code>half = go(n // 2)</code> &mdash; calls <code>go(n=5)</code>","line":5,"panels":[],"vars":[["x","2",0],["n","5",1]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)"]},{"caption":"<code>if n == 0:</code> &rarr; <strong>false</strong> (n = 5)","line":3,"panels":[],"vars":[["x","2",0],["n","5",0]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)"]},{"caption":"<code>half = go(n // 2)</code> &mdash; calls <code>go(n=2)</code>","line":5,"panels":[],"vars":[["x","2",0],["n","2",1]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)","go(n=2)"]},{"caption":"<code>if n == 0:</code> &rarr; <strong>false</strong> (n = 2)","line":3,"panels":[],"vars":[["x","2",0],["n","2",0]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)","go(n=2)"]},{"caption":"<code>half = go(n // 2)</code> &mdash; calls <code>go(n=1)</code>","line":5,"panels":[],"vars":[["x","2",0],["n","1",1]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)","go(n=2)","go(n=1)"]},{"caption":"<code>if n == 0:</code> &rarr; <strong>false</strong> (n = 1)","line":3,"panels":[],"vars":[["x","2",0],["n","1",0]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)","go(n=2)","go(n=1)"]},{"caption":"<code>half = go(n // 2)</code> &mdash; calls <code>go(n=0)</code>","line":5,"panels":[],"vars":[["x","2",0],["n","0",1]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)","go(n=2)","go(n=1)","go(n=0)"]},{"caption":"<code>if n == 0:</code> &rarr; <strong>true</strong> (n = 0)","line":3,"panels":[],"vars":[["x","2",0],["n","0",0]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)","go(n=2)","go(n=1)","go(n=0)"]},{"caption":"<code>return 1.0</code> &mdash; <code>go</code> returns <code>1</code> to <code>go</code>","line":4,"panels":[],"vars":[["x","2",0],["n","0",0]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)","go(n=2)","go(n=1)","go(n=0)"]},{"caption":"<code>return half * half * (x if n % 2 else 1)</code> &mdash; <code>go</code> returns <code>2</code> to <code>go</code>; <code>n = 1</code>; <code>half = 1</code>","line":6,"panels":[],"vars":[["x","2",0],["n","1",1],["half","1",1]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)","go(n=2)","go(n=1)"]},{"caption":"<code>return half * half * (x if n % 2 else 1)</code> &mdash; <code>go</code> returns <code>4</code> to <code>go</code>; <code>n = 2</code>; <code>half = 2</code>","line":6,"panels":[],"vars":[["x","2",0],["n","2",1],["half","2",1]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)","go(n=2)"]},{"caption":"<code>return half * half * (x if n % 2 else 1)</code> &mdash; <code>go</code> returns <code>32</code> to <code>go</code>; <code>n = 5</code>; <code>half = 4</code>","line":6,"panels":[],"vars":[["x","2",0],["n","5",1],["half","4",1]],"stack":["my_pow(x=2, n=10)","go(n=10)","go(n=5)"]},{"caption":"<code>return half * half * (x if n % 2 else 1)</code> &mdash; <code>go</code> returns <code>1024</code> to <code>my_pow</code>; <code>n = 10</code>; <code>half = 32</code>. <strong>Result: 1024</strong>","line":6,"panels":[],"vars":[["x","2",0],["n","10",1],["half","32",1]],"stack":["my_pow(x=2, n=10)","go(n=10)"]}],"example":1},{"title":"Iterative binary exponentiation","code":"def my_pow(x, n):\n    if n < 0:\n        x, n = 1 / x, -n\n    result = 1.0\n    while n:\n        if n & 1:\n            result *= x\n        x *= x                                 # x, x^2, x^4, x^8, ...\n        n >>= 1\n    return result","frames":[{"caption":"<strong>Iterative binary exponentiation</strong> &mdash; O(log n) time, O(1) extra space. Input: <code>my_pow(x=2, n=10)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"grid","id":"@bits","label":"bits","v":[["0","0","0","0","1","0","1","0"]],"cls":[["","","","","yes","","yes",""]],"rowLabels":["n=10"],"colLabels":["7","6","5","4","3","2","1","0"]}],"vars":[["x","2",0],["n","10",0]],"stack":[]},{"caption":"<code>if n &lt; 0:</code> &rarr; <strong>false</strong> (n = 10)","line":2,"panels":[{"t":"grid","id":"@bits","label":"bits","v":[["0","0","0","0","1","0","1","0"]],"cls":[["","","","","yes","","yes",""]],"rowLabels":["n=10"],"colLabels":["7","6","5","4","3","2","1","0"]}],"vars":[["x","2",0],["n","10",0]],"stack":[]},{"caption":"<code>result = 1.0</code> &mdash; <code>result = 1</code>","line":4,"panels":[{"t":"grid","id":"@bits","label":"bits","v":[["0","0","0","0","1","0","1","0"]],"cls":[["","","","","yes","","yes",""]],"rowLabels":["n=10"],"colLabels":["7","6","5","4","3","2","1","0"]}],"vars":[["x","2",0],["n","10",0],["result","1",1]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>true</strong> (n = 10)","line":5,"panels":[{"t":"grid","id":"@bits","label":"bits","v":[["0","0","0","0","1","0","1","0"]],"cls":[["","","","","yes","","yes",""]],"rowLabels":["n=10"],"colLabels":["7","6","5","4","3","2","1","0"]}],"vars":[["x","2",0],["n","10",0],["result","1",0]],"stack":[]},{"caption":"<code>if n &amp; 1:</code> &rarr; <strong>false</strong> (n = 10)","line":6,"panels":[{"t":"grid","id":"@bits","label":"bits","v":[["0","0","0","0","1","0","1","0"]],"cls":[["","","","","yes","","yes",""]],"rowLabels":["n=10"],"colLabels":["7","6","5","4","3","2","1","0"]}],"vars":[["x","2",0],["n","10",0],["result","1",0]],"stack":[]},{"caption":"<code>x *= x</code> &mdash; <code>x = 4</code> <em>(x, x^2, x^4, x^8, ...)</em>","line":8,"panels":[{"t":"grid","id":"@bits","label":"bits","v":[["0","0","0","0","1","0","1","0"]],"cls":[["","","","","yes","","yes",""]],"rowLabels":["n=10"],"colLabels":["7","6","5","4","3","2","1","0"]}],"vars":[["x","4",1],["n","10",0],["result","1",0]],"stack":[]},{"caption":"<code>n &gt;&gt;= 1</code> &mdash; <code>n = 5</code>","line":9,"panels":[{"t":"grid","id":"@bits","label":"bits","v":[["0","0","0","0","0","1","0","1"]],"cls":[["","","","","cur","cur","cur","cur"]],"rowLabels":["n=5"],"colLabels":["7","6","5","4","3","2","1","0"]}],"vars":[["x","4",0],["n","5",1],["result","1",0]],"stack":[]},{"caption":"<code>while n:</code> &rarr; <strong>true</strong> (n = 5)","line":5,"panels":[{"t":"grid","id":"@bits","label":"bits","v":[["0","0","0","0","0","1","0","1"]],"cls":[["","","","","","yes","","yes"]],"rowLabels":["n=5"],"colLabels":["7","6","5","4","3","2","1","0"]}],"vars":[["x","4",0],["n","5",0],["result","1",0]],"stack":[]},{"caption":"<code>if n &amp; 1:</code> &rarr; <strong>true</strong> (n = 5)","line":6,"panels":[{"t":"grid","id":"@bits","label":"bits","v":[["0","0","0","0","0","1","0","1"]],"cls":[["","","","","","yes","","yes"]],"rowLabels":["n=5"],"colLabels":["7","6","5","4","3","2","1","0"]}],"vars":[