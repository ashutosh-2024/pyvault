,"5"],"cls":["src","","",""],"ptr":{"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","-1",1],["boats","3",0]],"stack":[]},{"caption":"<code>boats += 1</code> &mdash; <code>boats = 4</code>","line":8,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","","",""],"ptr":{"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","-1",0],["boats","4",1]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>false</strong> (hi = -1, lo = 0)","line":4,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","","",""],"ptr":{"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","-1",0],["boats","4",0]],"stack":[]},{"caption":"<code>return boats</code> &mdash; returns <code>4</code>. <strong>Result: 4</strong>","line":9,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","","",""],"ptr":{"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","-1",0],["boats","4",0]],"stack":[]}]},{"title":"Counting sort, then the same greedy","code":"def num_rescue_boats(people, limit):\n    counts = [0] * (limit + 1)\n    for w in people:\n        counts[w] += 1\n    ordered = [w for w in range(limit + 1) for _ in range(counts[w])]\n    lo, hi, boats = 0, len(ordered) - 1, 0\n    while lo <= hi:\n        if ordered[lo] + ordered[hi] <= limit:\n            lo += 1\n        hi -= 1\n        boats += 1\n    return boats","frames":[{"caption":"<strong>Counting sort, then the same greedy</strong> &mdash; O(n + limit) time, O(limit) extra space. Input: <code>num_rescue_boats(people=[3, 5, 3, 4], limit=5)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"people","label":"people","v":["3","5","3","4"],"cls":["","","",""]}],"vars":[["limit","5",0]],"stack":[]},{"caption":"<code>counts = [0] * (limit + 1)</code> &mdash; <code>counts = [0, 0, 0, 0, 0, 0]</code>","line":2,"panels":[{"t":"arr","id":"people","label":"people","v":["3"