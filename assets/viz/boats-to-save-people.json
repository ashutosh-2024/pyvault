{"chapters":[{"title":"Sort, pair heaviest with lightest","code":"def num_rescue_boats(people, limit):\n    people = sorted(people)\n    lo, hi, boats = 0, len(people) - 1, 0\n    while lo <= hi:\n        if people[lo] + people[hi] <= limit:\n            lo += 1                            # lightest rides along\n        hi -= 1                                # heaviest always leaves\n        boats += 1\n    return boats","frames":[{"caption":"<strong>Sort, pair heaviest with lightest</strong> &mdash; O(n log n) time, O(1) or O(n) extra space. Input: <code>num_rescue_boats(people=[3, 5, 3, 4], limit=5)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"people","label":"people","v":["3","5","3","4"],"cls":["","","",""]}],"vars":[["limit","5",0]],"stack":[]},{"caption":"<code>people = sorted(people)</code> &mdash; <code>people</code> is now <code>[3, 3, 4, 5]</code>","line":2,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["","cur","cur","cur"]}],"vars":[["limit","5",0]],"stack":[]},{"caption":"<code>lo, hi, boats = 0, len(people) - 1, 0</code> &mdash; <code>lo = 0</code>; <code>hi = 3</code>; <code>boats = 0</code>","line":3,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",1],["hi","3",1],["boats","0",1]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 3, lo = 0)","line":4,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","3",0],["boats","0",0]],"stack":[]},{"caption":"<code>if people[lo] + people[hi] &lt;= limit:</code> &rarr; <strong>false</strong> (hi = 3, limit = 5, lo = 0)","line":5,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","3",0],["boats","0",0]],"stack":[]},{"caption":"<code>hi -= 1</code> &mdash; <code>hi = 2</code> <em>(heaviest always leaves)</em>","line":7,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","2",1],["boats","0",0]],"stack":[]},{"caption":"<code>boats += 1</code> &mdash; <code>boats = 1</code>","line":8,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","2",0],["boats","1",1]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 2, lo = 0)","line":4,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","2",0],["boats","1",0]],"stack":[]},{"caption":"<code>if people[lo] + people[hi] &lt;= limit:</code> &rarr; <strong>false</strong> (hi = 2, limit = 5, lo = 0)","line":5,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","2",0],["boats","1",0]],"stack":[]},{"caption":"<code>hi -= 1</code> &mdash; <code>hi = 1</code> <em>(heaviest always leaves)</em>","line":7,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","1",1],["boats","1",0]],"stack":[]},{"caption":"<code>boats += 1</code> &mdash; <code>boats = 2</code>","line":8,"panels":[{"t":"arr","id":"people","label":"people","v":["3","3","4","5"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}}],"vars":[["limit","5",0],["lo","0",0],["hi","1",0],["boats","2",1]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <