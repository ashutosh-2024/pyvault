{"chapters":[{"title":"DFS with backtracking, smallest destination first","code":"def find_itinerary(tickets):\n    adj = defaultdict(list)\n    for a, b in sorted(tickets):\n        adj[a].append(b)\n    route = [\"JFK\"]\n\n    def dfs(airport):\n        if len(route) == len(tickets) + 1:\n            return True\n        for i, nxt in enumerate(adj[airport]):\n            if nxt is None:\n                continue\n            adj[airport][i] = None               # use the ticket\n            route.append(nxt)\n            if dfs(nxt):\n                return True\n            route.pop()\n            adj[airport][i] = nxt                # give it back\n        return False\n\n    dfs(\"JFK\")\n    return route","frames":[{"caption":"<strong>DFS with backtracking, smallest destination first</strong> &mdash; O(E<sup>d</sup>) worst time, O(E) extra space. Input: <code>find_itinerary(tickets=[['JFK', 'KUL'], ['JFK', 'NRT'], ['NRT', 'JFK']])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"tickets","label":"tickets","v":["JFK,KUL","JFK,NRT","NRT,JFK"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>adj = defaultdict(list)</code> &mdash; <code>adj = {}</code>","line":2,"panels":[{"t":"arr","id":"tickets","label":"tickets","v":["JFK,KUL","JFK,NRT","NRT,JFK"],"cls":["","",""]},{"t":"arr","id":"adj","label":"adj (defaultdict)","v":[],"cls":[],"keys":[]}],"vars":[],"stack":[]},{"caption":"<code>for a, b in sorted(tickets):</code> &mdash; <code>a = 'JFK'</code>; <code>b = 'KUL'</code>","line":3,"panels":[{"t":"arr","id":"tickets","label":"tickets","v":["JFK,KUL","JFK,NRT","NRT,JFK"],"cls":["","",""]},{"t":"arr","id":"adj","label":"adj (defaultdict)","v":[],"cls":[],"keys":[]}],"vars":[["a","'JFK'",1],["b","'KUL'",1]],"stack":[]},{"caption":"<code>adj[a].append(b)</code> &mdash; <code>adj['JFK'] = ['KUL']</code>","line":4,"panels":[{"t":"arr","id":"tickets","label":"tickets","v":["JFK,KUL","JFK,NRT","NRT,JFK"],"cls":[