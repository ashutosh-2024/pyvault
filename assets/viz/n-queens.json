{"chapters":[{"title":"One row at a time, three sets of attacked lines","code":"def solve_n_queens(n):\n    out, cols, diag, anti, place = [], set(), set(), set(), []\n\n    def dfs(r):\n        if r == n:\n            out.append([\".\" * c + \"Q\" + \".\" * (n - c - 1) for c in place])\n            return\n        for c in range(n):\n            if c in cols or r - c in diag or r + c in anti:\n                continue\n            cols.add(c); diag.add(r - c); anti.add(r + c); place.append(c)\n            dfs(r + 1)\n            cols.remove(c); diag.remove(r - c); anti.remove(r + c); place.pop()\n\n    dfs(0)\n    return out","frames":[{"caption":"<strong>One row at a time, three sets of attacked lines</strong> &mdash; O(n!) time, O(n) extra space. Input: <code>solve_n_queens(n=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","3",0]],"stack":[]},{"caption":"<code>out, cols, diag, anti, place = [], set(), set(), set(), []</code> &mdash; <code>anti = set()</code>; <code>cols = set()</code>; <code>diag = set()</code>; <code>out = []</code>; …","line":2,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"place","label":"place","v":[],"cls":[],"noidx":true}],"vars":[["n","3",0],["anti","set()",1],["cols","set()",1],["diag","set()",1]],"stack":[]},{"caption":"<code>def dfs(r):</code>","line":4,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"place","label":"place","v":[],"cls":[],"noidx":true}],"vars":[["n","3",0],["anti","set()",0],["cols","set()",0],["diag","set()",0]],"stack":[]},{"caption":"<code>dfs(0)</code> &mdash; calls <code>dfs(r=0)</code>","line":15,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"place","label":"place","v":[],"cls":[],"noidx":true}],"vars":[["n","3",0],["anti","set()",0],["cols","set()",0],["diag","set()",0],["r","0",1]],"stack":["solve_n_queens(n=3)","dfs(r=0)"]},{"ca