{"chapters":[{"title":"Two indices","code":"def merge_alternately(word1, word2):\n    out, i = [], 0\n    while i < len(word1) and i < len(word2):\n        out += [word1[i], word2[i]]\n        i += 1\n    return \"\".join(out) + word1[i:] + word2[i:]","frames":[{"caption":"<strong>Two indices</strong> &mdash; O(m + n) time, O(m + n) extra space. Input: <code>merge_alternately(word1='abcd', word2='pq')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"word1","label":"word1","v":["a","b","c","d"],"cls":["","","",""]},{"t":"arr","id":"word2","label":"word2","v":["p","q"],"cls":["",""]}],"vars":[["word1","'abcd'",0],["word2","'pq'",0]],"stack":[]},{"caption":"<code>out, i = [], 0</code> &mdash; <code>out = []</code>; <code>i = 0</code>","line":2,"panels":[{"t":"arr","id":"word1","label":"word1","v":["a","b","c","d"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"word2","label":"word2","v":["p","q"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["word1","'abcd'",0],["word2","'pq'",0],["i","0",1]],"stack":[]},{"caption":"<code>while i &lt; len(word1) and i &lt; len(word2):</code> &rarr; <strong>true</strong> (i = 0, word1 = 'abcd', word2 = 'pq')","line":3,"panels":[{"t":"arr","id":"word1","label":"word1","v":["a","b","c","d"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"word2","label":"word2","v":["p","q"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["word1","'abcd'",0],["word2","'pq'",0],["i","0",0]],"stack":[]},{"caption":"<code>out += [word1[i], word2[i]]</code> &mdash; <code>out</code> is now <code>['a', 'p']</code>","line":4,"panels":[{"t":"arr","id":"word1","label":"word1","v":["a","b","c","d"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"word2","label":"word2","v":["p","q"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"out","label":"out","v":["