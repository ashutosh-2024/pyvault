{"chapters":[{"title":"Carry the number down","code":"def sum_numbers(root):\n    def dfs(node, current):\n        if node is None:\n            return 0\n        current = current * 10 + node.val\n        if node.left is None and node.right is None:\n            return current\n        return dfs(node.left, current) + dfs(node.right, current)\n\n    return dfs(root, 0)","frames":[{"caption":"<strong>Carry the number down</strong> &mdash; O(n) time, O(h) extra space. Input: <code>sum_numbers(root=tree (1))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4432540560","2",0.0,1.25,"",[]],["n4432766896","1",1.0,0.0,"cur",["root"]],["n4432540240","3",2.0,1.25,"",[]]],"edges":[["n4432766896","n4432540560","",""],["n4432766896","n4432540240","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>def dfs(node, current):</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4432540560","2",0.0,1.25,"",[]],["n4432766896","1",1.0,0.0,"cur",["root"]],["n4432540240","3",2.0,1.25,"",[]]],"edges":[["n4432766896","n4432540560","",""],["n4432766896","n4432540240","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>return dfs(root, 0)</code> &mdash; calls <code>dfs(node=(1), current=0)</code>","line":10,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4432540560","2",0.0,1.25,"",[]],["n4432766896","1",1.0,0.0,"cur",["node"]],["n4432540240","3",2.0,1.25,"",[]]],"edges":[["n4432766896","n4432540560","",""],["n4432766896","n4432540240","",""]],"dir":false}],"vars":[["current","0",1]],"stack":["sum_numbers(root=(1))","dfs(node=(1), current=0)"]},{"caption":"<code>if node is None:</code> &rarr; <strong>false</strong>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4432540560","2",0.0,1.25,"",[]],["n4432766896","1",1.0,0.0,"cur",["node"]],["n4432540240","3",2.0,1.25,"",[]]],"edges":[["n4432766896","n4432540560","",""],["n4432766896","