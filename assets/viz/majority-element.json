{"chapters":[{"title":"Count each candidate","code":"def majority_element(nums):\n    for x in nums:\n        if nums.count(x) > len(nums) // 2:\n            return x","frames":[{"caption":"<strong>Count each candidate</strong> &mdash; O(n&sup2;) time, O(1) extra space. Input: <code>majority_element(nums=[6, 5, 5])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["6","5","5"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>for x in nums:</code> &mdash; <code>x = 6</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["6","5","5"],"cls":["","",""]}],"vars":[["x","6",1]],"stack":[]},{"caption":"<code>if nums.count(x) &gt; len(nums) // 2:</code> &rarr; <strong>false</strong> (x = 6)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["6","5","5"],"cls":["","",""]}],"vars":[["x","6",0]],"stack":[]},{"caption":"<code>for x in nums:</code> &mdash; <code>x = 5</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["6","5","5"],"cls":["","",""]}],"vars":[["x","5",1]],"stack":[]},{"caption":"<code>if nums.count(x) &gt; len(nums) // 2:</code> &rarr; <strong>true</strong> (x = 5)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["6","5","5"],"cls":["","",""]}],"vars":[["x","5",0]],"stack":[]},{"caption":"<code>return x</code> &mdash; returns <code>5</code>. <strong>Result: 5</strong>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["6","5","5"],"cls":["","",""]}],"vars":[["x","5",0]],"stack":[]}],"example":2},{"title":"Hash map of counts","code":"def majority_element(nums):\n    counts = Counter(nums)\n    return max(counts, key=counts.get)","frames":[{"caption":"<strong>Hash map of counts</strong> &mdash; O(n) time, O(n) extra space. Input: <code>majority_element(nums=[3, 2, 3])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","3"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>counts = Counter(nums)</code> &mdash; <code>counts = {3: 2, 2: 1}</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","3"],"cls":["","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["2","1"],"cls":["",""],"keys":["3","2"]}],"vars":[],"stack":[]},{"caption":"<code>return max(counts, key=counts.get)</code> &mdash; returns <code>3</code>. <strong>Result: 3</strong>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","3"],"cls":["","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["2","1"],"cls":["",""],"keys":["3","2"]}],"vars":[],"stack":[]}]},{"title":"Sort, take the middle","code":"def majority_element(nums):\n    return sorted(nums)[len(nums) // 2]","frames":[{"caption":"<strong>Sort, take the middle</strong> &mdash; O(n log n) time, O(1) or O(n) extra space. Input: <code>majority_element(nums=[3, 2, 3])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","3"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>return sorted(nums)[len(nums) // 2]</code> &mdash; returns <code>3</code>. <strong>Result: 3</strong>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","3"],"cls":["","",""]}],"vars":[],"stack":[]}]},{"title":"Boyer-Moore voting","code":"def majority_element(nums):\n    candidate, votes = None, 0\n    for x in nums:\n        if votes == 0:\n            candidate = x\n        votes += 1 if x == candidate else -1\n    return candidate","frames":[{"caption":"<strong>Boyer-Moore voting</strong> &mdash; O(n) time, O(1) extra space. Input: <code>majority_element(nums=[2, 2, 1, 1, 1, 2, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","2","1","1","1","2","2"],"cls":["","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>candidate, votes = None, 0</code> 