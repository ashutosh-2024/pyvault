{"chapters":[{"title":"Add only what keeps the prefix valid","code":"def generate_parenthesis(n):\n    out, path = [], []\n\n    def dfs(open_, close):\n        if len(path) == 2 * n:\n            out.append(\"\".join(path))\n            return\n        if open_ < n:\n            path.append(\"(\")\n            dfs(open_ + 1, close)\n            path.pop()\n        if close < open_:\n            path.append(\")\")\n            dfs(open_, close + 1)\n            path.pop()\n\n    dfs(0, 0)\n    return out","frames":[{"caption":"<strong>Add only what keeps the prefix valid</strong> &mdash; O(4<sup>n</sup> / &radic;n) time, O(n) extra space. Input: <code>generate_parenthesis(n=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>out, path = [], []</code> &mdash; <code>out = []</code>; <code>path = []</code>","line":2,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>def dfs(open_, close):</code>","line":4,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>dfs(0, 0)</code> &mdash; calls <code>dfs(open_=0, close=0)</code>","line":17,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","2",0],["open_","0",1],["close","0",1]],"stack":["generate_parenthesis(n=2)","dfs(open_=0, close=0)"]},{"caption":"<code>if len(path) == 2 * n:</code> &rarr; <strong>false</strong> (n = 2)","line":5,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","2",0],["open_","0",0],["close","0",0]],"stack":["generate_parenthes