{"chapters":[{"title":"Heap of row heads","frames":[{"caption":"Rows are sorted, so this is a k-way merge of the rows: start with every row's first element.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["src","",""],["src","",""],["src","",""]]},"trees":[{"label":"min-heap","v":["1","10","12"],"cls":["done","done","done"]}]},{"caption":"Pop #1: 1. Push its right neighbour 5.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["chosen","src",""],["src","",""],["src","",""]]},"formula":"popped 1 of k-1 = 7","trees":[{"label":"min-heap","v":["5","12","10"],"cls":["done","done","done"]}]},{"caption":"Pop #2: 5. Push its right neighbour 9.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["dim","chosen","src"],["src","",""],["src","",""]]},"formula":"popped 2 of k-1 = 7","trees":[{"label":"min-heap","v":["9","12","10"],"cls":["done","done","done"]}]},{"caption":"Pop #3: 9.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["dim","dim","chosen"],["src","",""],["src","",""]]},"formula":"popped 3 of k-1 = 7","trees":[{"label":"min-heap","v":["10","12"],"cls":["done","done"]}]},{"caption":"Pop #4: 10. Push its right neighbour 11.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["dim","dim","dim"],["chosen","src",""],["src","",""]]},"formula":"popped 4 of k-1 = 7","trees":[{"label":"min-heap","v":["11","12"],"cls":["done","done"]}]},{"caption":"Pop #5: 11. Push its right neighbour 13.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["dim","dim","dim"],["dim","chosen","src"],["src","",""]]},"formula":"popped 5 of k-1 = 7","trees":[{"label":"min-heap","v":["12","13"],"cls":["done","done"]}]},{"caption":"Pop #6: 12. Push its right neighbour 13.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["dim","dim","dim"],["dim","dim","src"],["chosen","src",""]]},"formula":"popped 6 of k-1 = 7","trees":[{"label":"min-heap","v":["13","13"],"cls":["done","done"]}]},{"caption":"Pop #7: 13.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["dim","dim","dim"],["dim","dim","chosen"],["dim","src",""]]},"formula":"popped 7 of k-1 = 7","trees":[{"label":"min-heap","v":["13"],"cls":["done"]}]},{"caption":"After k &minus; 1 = 7 pops the top is the k-th smallest: <strong>13</strong>. O(k log n).","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["dim","dim","dim"],["dim","dim","dim"],["dim","answer",""]]},"formula":"answer = 13","trees":[{"label":"min-heap","v":["13"],"cls":["answer"]}]}]},{"title":"Best: binary search on the value","frames":[{"caption":"Guess mid = 8 in [1, 15]. Count cells &le; 8 with a staircase walk from the bottom-left: 2. Since 2 &lt; k = 8, the answer is &gt; mid.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["yes","yes","no"],["no","no","no"],["no","no","no"]]},"formula":"lo=1 hi=15 mid=8 count=2"},{"caption":"Guess mid = 12 in [9, 15]. Count cells &le; 12 with a staircase walk from the bottom-left: 6. Since 6 &lt; k = 8, the answer is &gt; mid.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["yes","yes","yes"],["yes","yes","no"],["yes","no","no"]]},"formula":"lo=9 hi=15 mid=12 count=6"},{"caption":"Guess mid = 14 in [13, 15]. Count cells &le; 14 with a staircase walk from the bottom-left: 8. Since 8 &ge; k = 8, the answer is &le; mid.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["yes","yes","yes"],["yes","yes","yes"],["yes","yes","no"]]},"formula":"lo=13 hi=15 mid=14 count=8"},{"caption":"Guess mid = 13 in [13, 14]. Count cells &le; 13 with a staircase walk from the bottom-left: 8. Since 8 &ge; k = 8, the answer is &le; mid.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["yes","yes","yes"],["yes","yes","yes"],["yes","yes","no"]]},"formula":"lo=13 hi=14 mid=13 count=8"},{"caption":"lo = hi = <strong>13</strong>: the smallest value with at least k cells &le; it. O(n log(max &minus; min)) with O(1) space.","grid":{"v":[["1","5","9"],["10","11","13"],["12","13","15"]],"cls":[["","",""],["","","answer"],["","answer",""]]},"formula":"answer = 13"}]}]}