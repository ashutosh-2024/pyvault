,"8","10"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["n","10",0],["lo","6",0],["hi","10",0],["mid","8",0],["g","-1",0]],"stack":[]},{"caption":"<code>hi = mid - 1</code> &mdash; <code>hi = 7</code> <em>(the pick is lower)</em>","line":9,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["6","8","7"],"cls":["","","cur"],"keys":["lo","mid","hi"]}],"vars":[["n","10",0],["lo","6",0],["hi","7",1],["mid","8",0],["g","-1",0]],"stack":[]},{"caption":"<code>while True:</code> &rarr; <strong>true</strong>","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["6","8","7"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["n","10",0],["lo","6",0],["hi","7",0],["mid","8",0],["g","-1",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 6</code>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["6","6","7"],"cls":["","cur",""],"keys":["lo","mid","hi"]}],"vars":[["n","10",0],["lo","6",0],["hi","7",0],["mid","6",1],["g","-1",0]],"stack":[]},{"caption":"<code>g = guess(mid)</code> &mdash; <code>g = 0</code>","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["6","6","7"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["n","10",0],["lo","6",0],["hi","7",0],["mid","6",0],["g","0",1]],"stack":[]},{"caption":"<code>if g == 0:</code> &rarr; <strong>true</strong> (g = 0)","line":6,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["6","6","7"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["n","10",0],["lo","6",0],["hi","7",0],["mid","6",0],["g","0",0]],"stack":[]},{"caption":"<code>return mid</code> &mdash; returns <code>6</code>. <strong>Result: 6</strong>","line":7,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["6","6","7"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["n","10",0],["lo","6",0],["hi","7",0],["mid","6",0],["g","0",0]],"stack":[]}],"example":1}]}