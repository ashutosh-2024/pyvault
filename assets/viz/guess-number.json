{"chapters":[{"title":"Try every number","code":"def guess_number(n):\n    for k in range(1, n + 1):\n        if guess(k) == 0:\n            return k","frames":[{"caption":"<strong>Try every number</strong> &mdash; O(n) calls time, O(1) extra space. Input: <code>guess_number(n=10)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","10",0]],"stack":[]},{"caption":"<code>for k in range(1, n + 1):</code> &mdash; <code>k = 1</code>","line":2,"panels":[],"vars":[["n","10",0],["k","1",1]],"stack":[]},{"caption":"<code>if guess(k) == 0:</code>","line":3,"panels":[],"vars":[["n","10",0],["k","1",0]],"stack":[]},{"caption":"<code>for k in range(1, n + 1):</code> &mdash; <code>k = 2</code>","line":2,"panels":[],"vars":[["n","10",0],["k","2",1]],"stack":[]},{"caption":"<code>if guess(k) == 0:</code>","line":3,"panels":[],"vars":[["n","10",0],["k","2",0]],"stack":[]},{"caption":"<code>for k in range(1, n + 1):</code> &mdash; <code>k = 3</code>","line":2,"panels":[],"vars":[["n","10",0],["k","3",1]],"stack":[]},{"caption":"<code>if guess(k) == 0:</code>","line":3,"panels":[],"vars":[["n","10",0],["k","3",0]],"stack":[]},{"caption":"<code>for k in range(1, n + 1):</code> &mdash; <code>k = 4</code>","line":2,"panels":[],"vars":[["n","10",0],["k","4",1]],"stack":[]},{"caption":"<code>if guess(k) == 0:</code>","line":3,"panels":[],"vars":[["n","10",0],["k","4",0]],"stack":[]},{"caption":"<code>for k in range(1, n + 1):</code> &mdash; <code>k = 5</code>","line":2,"panels":[],"vars":[["n","10",0],["k","5",1]],"stack":[]},{"caption":"<code>if guess(k) == 0:</code>","line":3,"panels":[],"vars":[["n","10",0],["k","5",0]],"stack":[]},{"caption":"<code>for k in range(1, n + 1):</code> &mdash; <code>k = 6</code>","line":2,"panels":[],"vars":[["n","10",0],["k","6",1]],"stack":[]},{"caption":"<code>if guess(k) == 0:</code>","line":3,"panels":[],"vars":[["n","10",0],["k","6",0]],"stack":[]},{"caption":"<code>return k</code> &mdash; returns <code>6</code>. <strong>Result: 6</strong>","line":4,"panels":[],"vars":[["n","10",0],["k","6",0]],"stack":[]}],"example":1},{"title":"Binary search on the range","code":"def guess_number(n):\n    lo, hi = 1, n\n    while True:\n        mid = (lo + hi) // 2\n        g = guess(mid)\n        if g == 0:\n            return mid\n        if g < 0:\n            hi = mid - 1                       # the pick is lower\n        else:\n            lo = mid + 1","frames":[{"caption":"<strong>Binary search on the range</strong> &mdash; O(log n) calls time, O(1) extra space. Input: <code>guess_number(n=10)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","10",0]],"stack":[]},{"caption":"<code>lo, hi = 1, n</code> &mdash; <code>lo = 1</code>; <code>hi = 10</code>","line":2,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["1","10"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["n","10",0],["lo","1",1],["hi","10",1]],"stack":[]},{"caption":"<code>while True:</code> &rarr; <strong>true</strong>","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["1","10"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["n","10",0],["lo","1",0],["hi","10",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 5</code>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["1","5","10"],"cls":["","cur","cur"],"keys":["lo","mid","hi"]}],"vars":[["n","10",0],["lo","1",0],["hi","10",0],["mid","5",1]],"stack":[]},{"caption":"<code>g = guess(mid)</code> &mdash; <code>g = 1</code>","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["1","5","10"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["n","10",0],["lo","1",0],["hi","10",0],["mid","5",0],["g","1",1]],"stack":[]},{"caption":"<code>if g == 0:</code> &rarr; <strong>false</strong> (g = 1)","line":6,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["1","5","10"],"cls":["","",""],"keys":["lo","mid","hi"