{"chapters":[{"title":"Max-heap of fuel already driven past","code":"def min_refuel_stops(target, start_fuel, stations):\n    passed = []                    # max-heap of fuel amounts, negated\n    fuel, stops, i = start_fuel, 0, 0\n\n    while fuel < target:\n        while i < len(stations) and stations[i][0] <= fuel:\n            heapq.heappush(passed, -stations[i][1])\n            i += 1\n        if not passed:\n            return -1              # cannot reach any further station\n        fuel -= heapq.heappop(passed)\n        stops += 1\n    return stops","frames":[{"caption":"<strong>Max-heap of fuel already driven past</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>min_refuel_stops(target=100, start_fuel=10, stations=[[10, 60], [20, 30], [30, 30], [60, 40]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["","","",""]}],"vars":[["target","100",0],["start_fuel","10",0]],"stack":[]},{"caption":"<code>passed = []</code> &mdash; <code>passed = []</code> <em>(max-heap of fuel amounts, negated)</em>","line":2,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["","","",""]},{"t":"arr","id":"passed","label":"passed","v":[],"cls":[],"noidx":true}],"vars":[["target","100",0],["start_fuel","10",0]],"stack":[]},{"caption":"<code>fuel, stops, i = start_fuel, 0, 0</code> &mdash; <code>fuel = 10</code>; <code>stops = 0</code>; <code>i = 0</code>","line":3,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"passed","label":"passed","v":[],"cls":[],"noidx":true}],"vars":[["target","100",0],["start_fuel","10",0],["fuel","10",1],["stops","0",1],["i","0",1]],"stack":[]},{"caption":"<code>while fuel &lt; target:</code> &rarr; <strong>true</strong> (fuel = 10, target = 100)","line":5,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"passed","label":"passed","v":[],"cls":[],"noidx":true}],"vars":[["target","100",0],["start_fuel","10",0],["fuel","10",0],["stops","0",0],["i","0",0]],"stack":[]},{"caption":"<code>while i &lt; len(stations) and stations[i][0] &lt;= fuel:</code> &rarr; <strong>true</strong> (fuel = 10, i = 0)","line":6,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"passed","label":"passed","v":[],"cls":[],"noidx":true}],"vars":[["target","100",0],["start_fuel","10",0],["fuel","10",0],["stops","0",0],["i","0",0]],"stack":[]},{"caption":"<code>heapq.heappush(passed, -stations[i][1])</code> &mdash; <code>passed</code> gets <code>-60</code> appended","line":7,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"passed","label":"passed","v":["-60"],"cls":["cur"]}],"vars":[["target","100",0],["start_fuel","10",0],["fuel","10",0],["stops","0",0],["i","0",0]],"stack":[]},{"caption":"<code>i += 1</code> &mdash; <code>i = 1</code>","line":8,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["","src","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"passed","label":"passed","v":["-60"],"cls":[""]}],"vars":[["target","100",0],["start_fuel","10",0],["fuel","10",0],["stops","0",0],["i","1",1]],"stack":[]},{"caption":"<code>while i &lt; len(stations) and stations[i][0] &lt;= fuel:</code> &rarr; <strong>false</strong> (fuel = 10, i = 1)","line":6,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["","src","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"passed","label":"passed","v":["-60"],"cls":[""]}],"vars":[["target","100",0],["start_fuel","10",0],["fuel","10",0],["stops","0",0],["i","1",0]],"stack":[]},{"caption":"<code>if not passed:</code> &rarr; <strong>false</strong>","line":9,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["","src","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"passed","label":"passed","v":["-60"],"cls":[""]}],"vars":[["target","100",0],["start_fuel","10",0],["fuel","10",0],["stops","0",0],["i","1",0]],"stack":[]},{"caption":"<code>fuel -= heapq.heappop(passed)</code> &mdash; <code>-60</code> popped off the end of <code>passed</code>; <code>fuel = 70</code>","line":11,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["","src","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"passed","label":"passed","v":[],"cls":[],"noidx":true}],"vars":[["target","100",0],["start_fuel","10",0],["fuel","70",1],["stops","0",0],["i","1",0]],"stack":[]},{"caption":"<code>stops += 1</code> &mdash; <code>stops = 1</code>","line":12,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["","src","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"passed","label":"passed","v":[],"cls":[],"noidx":true}],"vars":[["target","100",0],["start_fuel","10",0],["fuel","70",0],["stops","1",1],["i","1",0]],"stack":[]},{"caption":"<code>while fuel &lt; target:</code> &rarr; <strong>true</strong> (fuel = 70, target = 100)","line":5,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["","src","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"passed","label":"passed","v":[],"cls":[],"noidx":true}],"vars":[["target","100",0],["start_fuel","10",0],["fuel","70",0],["stops","1",0],["i","1",0]],"stack":[]},{"caption":"<code>while i &lt; len(stations) and stations[i][0] &lt;= fuel:</code> &rarr; <strong>true</strong> (fuel = 70, i = 1)","line":6,"panels":[{"t":"arr","id":"stations","label":"stations","v":["10,60","20,30","30,30","60,40"],"cls":["","src","",""],"ptr":{"1":["i"]}},{"t":