{"chapters":[{"title":"Convert to integers and back","code":"def add_two_numbers(l1, l2):\n    def value(node):\n        total, place = 0, 1\n        while node:\n            total += node.val * place\n            place *= 10\n            node = node.next\n        return total\n\n    s = value(l1) + value(l2)\n    dummy = tail = ListNode()\n    while True:\n        s, d = divmod(s, 10)\n        tail.next = tail = ListNode(d)\n        if s == 0:\n            return dummy.next","frames":[{"caption":"<strong>Convert to integers and back</strong> &mdash; O(m + n) time, O(m + n) extra space. Input: <code>add_two_numbers(l1=list (2), l2=list (5))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4462640688","5",0.0,0.0,"cur",["l2"]],["n4455679120","6",1.7,0.0,"",[]],["n4455681568","4",3.4,0.0,"",[]],["n4455201872","2",0.0,1.3,"cur",["l1"]],["n4455202192","4",1.7,1.3,"",[]],["n4455296976","3",3.4,1.3,"",[]]],"edges":[["n4462640688","n4455679120","",""],["n4455679120","n4455681568","",""],["n4455201872","n4455202192","",""],["n4455202192","n4455296976","",""]],"dir":true}],"vars":[],"stack":[]},{"caption":"<code>def value(node):</code>","line":2,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4462640688","5",0.0,0.0,"cur",["l2"]],["n4455679120","6",1.7,0.0,"",[]],["n4455681568","4",3.4,0.0,"",[]],["n4455201872","2",0.0,1.3,"cur",["l1"]],["n4455202192","4",1.7,1.3,"",[]],["n4455296976","3",3.4,1.3,"",[]]],"edges":[["n4462640688","n4455679120","",""],["n4455679120","n4455681568","",""],["n4455201872","n4455202192","",""],["n4455202192","n4455296976","",""]],"dir":true}],"vars":[],"stack":[]},{"caption":"<code>s = value(l1) + value(l2)</code> &mdash; calls <code>value(node=(2))</code>","line":10,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4462640688","5",0.0,0.0,"stack",[]],["n4455679120","6",1.7,0.0,"",[]],["n4455681568","4",3.4,0.0,"",[]],["n4455201