{"chapters":[{"title":"Hash map of counts","code":"def majority_element_ii(nums):\n    return [x for x, c in Counter(nums).items() if c > len(nums) // 3]","frames":[{"caption":"<strong>Hash map of counts</strong> &mdash; O(n) time, O(n) extra space. Input: <code>majority_element_ii(nums=[1, 2, 1, 3, 1, 2, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>return [x for x, c in Counter(nums).items() if c &gt; len(nums) // 3]</code> &mdash; <code>x = 1</code>; <code>c = 3</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["x","1",1],["c","3",1]],"stack":[]},{"caption":"<code>return [x for x, c in Counter(nums).items() if c &gt; len(nums) // 3]</code> &mdash; <code>x = 2</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["x","2",1],["c","3",0]],"stack":[]},{"caption":"<code>return [x for x, c in Counter(nums).items() if c &gt; len(nums) // 3]</code> &mdash; <code>x = 3</code>; <code>c = 1</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["x","3",1],["c","1",1]],"stack":[]},{"caption":"<code>return [x for x, c in Counter(nums).items() if c &gt; len(nums) // 3]</code> &mdash; returns <code>[1, 2]</code>. <strong>Result: [1, 2]</strong>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]},{"t":"arr","id":"result","label":"result","v":["1","2"],"cls":["answer","answer"]}],"vars":[],"stack":[]}],"example":1},{"title":"Sort and measure runs","code":"def majority_element_ii(nums):\n    nums, out, i = sorted(nums), [], 0\n    while i < len(nums):\n        j = i\n        while j < len(nums) and nums[j] == nums[i]:\n            j += 1\n        if j - i > len(nums) // 3:\n            out.append(nums[i])\n        i = j\n    return out","frames":[{"caption":"<strong>Sort and measure runs</strong> &mdash; O(n log n) time, O(1) or O(n) extra space. Input: <code>majority_element_ii(nums=[1, 2, 1, 3, 1, 2, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>nums, out, i = sorted(nums), [], 0</code> &mdash; <code>nums</code> is now <code>[1, 1, 1, 2, 2, 2, 3]</code>; <code>out = []</code>; <code>i = 0</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["src","cur","","cur","cur","","cur"],"ptr":{"0":["i"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",1]],"stack":[]},{"caption":"<code>while i &lt; len(nums):</code> &rarr; <strong>true</strong> (i = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["src","","","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0]],"stack":[]},{"caption":"<code>j = i</code> &mdash; <code>j = 0</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["src","","","","","",""],"ptr":{"0":["i","j"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["j","0",1]],"stack":[]},{"caption":"<code>while j &lt; len(nums) and nums[j] == nums[i]:</code> &rarr; <strong>true</strong> (i = 0, j = 0)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["src","","","","","",""],"ptr":{"0":["i","j"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["j","0",0]],"stack":[]},{"caption":"<code>j += 1</code> &mdash; <code>j = 1</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["src","src","","","","",""],"ptr":{"0":["i"],"1":["j"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["j","1",1]],"stack":[]},{"caption":"<code>while j &lt; len(nums) and nums[j] == nums[i]:</code> &rarr; <strong>true</strong> (i = 0, j = 1)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["src","src","","","","",""],"ptr":{"0":["i"],"1":["j"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["j","1",0]],"stack":[]},{"caption":"<code>j += 1</code> &mdash; <code>j = 2</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["src","","src","","","",""],"ptr":{"0":["i"],"2":["j"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["j","2",1]],"stack":[]},{"caption":"<code>while j &lt; len(nums) and nums[j] == nums[i]:</code> &rarr; <strong>true</strong> (i = 0, j = 2)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["src","","src","","","",""],"ptr":{"0":["i"],"2":["j"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["j","2",0]],"stack":[]},{"caption":"<code>j += 1</code> &mdash; <code>j = 3</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["src","","","src","","",""],"ptr":{"0":["i"],"3":["j"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["j","3",1]],"stack":[]},{"caption":"<code>while j &lt; len(nums) and nums[j] == nums[i]:</code> &rarr; <strong>false</strong> (i = 0, j = 3)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["src","","","src","","",""],"ptr":{"0":["i"],"3":["j"