":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","src","","","src"],"ptr":{"3":["i"],"6":["j"]}},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]}],"vars":[["i","3",0],["j","6",0]],"stack":[]},{"caption":"<code>if j - i &gt; len(nums) // 3:</code> &rarr; <strong>true</strong> (i = 3, j = 6)","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","src","","","src"],"ptr":{"3":["i"],"6":["j"]}},{"t":"arr","id":"out","label":"out","v":["1"],"cls":[""]}],"vars":[["i","3",0],["j","6",0]],"stack":[]},{"caption":"<code>out.append(nums[i])</code> &mdash; <code>out</code> gets <code>2</code> appended","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","src","","","src"],"ptr":{"3":["i"],"6":["j"]}},{"t":"arr","id":"out","label":"out","v":["1","2"],"cls":["","cur"]}],"vars":[["i","3",0],["j","6",0]],"stack":[]},{"caption":"<code>i = j</code> &mdash; <code>i = 6</code>","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","","","","src"],"ptr":{"6":["i","j"]}},{"t":"arr","id":"out","label":"out","v":["1","2"],"cls":["",""]}],"vars":[["i","6",1],["j","6",0]],"stack":[]},{"caption":"<code>while i &lt; len(nums):</code> &rarr; <strong>true</strong> (i = 6)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","","","","src"],"ptr":{"6":["i","j"]}},{"t":"arr","id":"out","label":"out","v":["1","2"],"cls":["",""]}],"vars":[["i","6",0],["j","6",0]],"stack":[]},{"caption":"<code>j = i</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","","","","src"],"ptr":{"6":["i","j"]}},{"t":"arr","id":"out","label":"out","v":["1","2"],"cls":["",""]}],"vars":[["i","6",0],["j","6",0]],"stack":[]},{"caption":"<code>while j &lt; len(nums) and nums[j] == nums[i]:</code> &rarr; <strong>true</strong> (i = 6, j = 6)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","","","","src"],"ptr":{"6":["i","j"]}},{"t":"arr","id":"out","label":"out","v":["1","2"],"cls":["",""]}],"vars":[["i","6",0],["j","6",0]],"stack":[]},{"caption":"<code>j += 1</code> &mdash; <code>j = 7</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","","","","src"],"ptr":{"6":["i"],"7":["j"]}},{"t":"arr","id":"out","label":"out","v":["1","2"],"cls":["",""]}],"vars":[["i","6",0],["j","7",1]],"stack":[]},{"caption":"<code>while j &lt; len(nums) and nums[j] == nums[i]:</code> &rarr; <strong>false</strong> (i = 6, j = 7)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","","","","src"],"ptr":{"6":["i"],"7":["j"]}},{"t":"arr","id":"out","label":"out","v":["1","2"],"cls":["",""]}],"vars":[["i","6",0],["j","7",0]],"stack":[]},{"caption":"<code>if j - i &gt; len(nums) // 3:</code> &rarr; <strong>false</strong> (i = 6, j = 7)","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","","","","src"],"ptr":{"6":["i"],"7":["j"]}},{"t":"arr","id":"out","label":"out","v":["1","2"],"cls":["",""]}],"vars":[["i","6",0],["j","7",0]],"stack":[]},{"caption":"<code>i = j</code> &mdash; <code>i = 7</code>","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","","","",""],"ptr":{"7":["i","j"]}},{"t":"arr","id":"out","label":"out","v":["1","2"],"cls":["",""]}],"vars":[["i","7",1],["j","7",0]],"stack":[]},{"caption":"<code>while i &lt; len(nums):</code> &rarr; <strong>false</strong> (i = 7)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","","","",""],"ptr":{"7":["i","j"]}},{"t":"arr","id":"out","label":"out","v":["1","2"],"cls":["",""]}],"vars":[["i","7",0],["j","7",0]],"stack":[]},{"caption":"<code>return out</code> &mdash; returns <code>[1, 2]</code>. <strong>Result: [1, 2]</strong>","line":10,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","1","2","2","2","3"],"cls":["","","","","","",""],"ptr":{"7":["i","j"]}},{"t":"arr","id":"out","label":"out","v":["1","2"],"cls":["",""]},{"t":"arr","id":"result","label":"result","v":["1","2"],"cls":["answer","answer"]}],"vars":[["i","7",0],["j","7",0]],"stack":[]}],"example":1},{"title":"Boyer-Moore with two candidates","code":"def majority_element_ii(nums):\n    c1 = c2 = None\n    v1 = v2 = 0\n    for x in nums:\n        if x == c1:\n            v1 += 1\n        elif x == c2:\n            v2 += 1\n        elif v1 == 0:\n            c1, v1 = x, 1\n        elif v2 == 0:\n            c2, v2 = x, 1\n        else:\n            v1 -= 1                            # cancel three distinct values\n            v2 -= 1\n    return [c for c in {c1, c2} if c is not None and nums.count(c) > len(nums) // 3]","frames":[{"caption":"<strong>Boyer-Moore with two candidates</strong> &mdash; O(n) time, O(1) extra space. Input: <code>majority_element_ii(nums=[1, 2, 1, 3, 1, 2, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>c1 = c2 = None</code> &mdash; <code>c1 = None</code>; <code>c2 = None</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["c1","None",1],["c2","None",1]],"stack":[]},{"caption":"<code>v1 = v2 = 0</code> &mdash; <code>v1 = 0</code>; <code>v2 = 0</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["c1","None",0],["c2","None",0],["v1","0",1],["v2","0",1]],"stack":[]},{"caption":"<code>for x in nums:</code> &mdash; <code>x = 1</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["c1","None",0],["c2","None",0],["v1","0",0],["v2","0",0],["x","1",1]],"stack":[]},{"caption":"<code>if x == c1:</code> &rarr; <strong>false</strong> (c1 = None, x = 1)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["c1","None",0],["c2","None",0],["v1","0",0],["v2","0",0],["x","1",0]],"stack":[]},{"caption":"<code>elif x == c2:</code> &rarr; <strong>false</strong> (c2 = None, x = 1)","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["c1","None",0],["c2","None",0],["v1","0",0],["v2","0",0],["x","1",0]],"stack":[]},{"caption":"<code>elif v1 == 0:</code> &rarr; <strong>true</strong> (v1 = 0)","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["c1","None",0],["c2","None",0],["v1","0",0],["v2","0",0],["x","1",0]],"stack":[]},{"caption":"<code>c1, v1 = x, 1</code> &mdash; <code>c1 = 1</code>; <code>v1 = 1</code>","line":10,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["c1","1",1],["c2","None",0],["v1","1",1],["v2","0",0],["x","1",0]],"stack":[]},{"caption":"<code>for x in nums:</code> &mdash; <code>x = 2</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["c1","1",0],["c2","None",0],["v1","1",0],["v2","0",0],["x","2",1]],"stack":[]},{"caption":"<code>if x == c1:</code> &rarr; <strong>false</strong> (c1 = 1, x = 2)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","1","3","1","2","2"],"cls":["","","","","","",""]}],"vars":[["c1","1",0],["c2","None",0],["v1","1",0],["v2","0",0],["x","2",0]],"stack":[]},{"caption":"<code>elif x == c2:</code