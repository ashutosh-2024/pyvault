{"chapters":[{"title":"Linear scan","code":"def search_rotated_ii(nums, target):\n    return target in nums","frames":[{"caption":"<strong>Linear scan</strong> &mdash; O(n) time, O(1) extra space. Input: <code>search_rotated_ii(nums=[2, 5, 6, 0, 0, 1, 2], target=0)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["","","","","","",""]}],"vars":[["target","0",0]],"stack":[]},{"caption":"<code>return target in nums</code> &mdash; returns <code>T</code>. <strong>Result: T</strong>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["","","","","","",""]}],"vars":[["target","0",0]],"stack":[]}]},{"title":"Binary search, shrink both ends on ambiguity","code":"def search_rotated_ii(nums, target):\n    lo, hi = 0, len(nums) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if nums[mid] == target:\n            return True\n        if nums[lo] == nums[mid] == nums[hi]:\n            lo, hi = lo + 1, hi - 1                     # ambiguous: shrink both ends\n        elif nums[lo] <= nums[mid]:\n            if nums[lo] <= target < nums[mid]:\n                hi = mid - 1\n            else:\n                lo = mid + 1\n        else:\n            if nums[mid] < target <= nums[hi]:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n    return False","frames":[{"caption":"<strong>Binary search, shrink both ends on ambiguity</strong> &mdash; O(log n) typical, O(n) worst time, O(1) extra space. Input: <code>search_rotated_ii(nums=[1, 0, 1, 1, 1], target=0)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","","","",""]}],"vars":[["target","0",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(nums) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 4</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["src","","","","src"],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["target","0",0],["lo","0",1],["hi","4",1]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 4, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["src","","","","src"],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["target","0",0],["lo","0",0],["hi","4",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 2</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["src","","src","","src"],"ptr":{"4":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","0",0],["hi","4",0],["mid","2",1]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 2, target = 0)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["src","","src","","src"],"ptr":{"4":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","0",0],["hi","4",0],["mid","2",0]],"stack":[]},{"caption":"<code>if nums[lo] == nums[mid] == nums[hi]:</code> &rarr; <strong>true</strong> (hi = 4, lo = 0, mid = 2)","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["src","","src","","src"],"ptr":{"4":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","0",0],["hi","4",0],["mid","2",0]],"stack":[]},{"caption":"<code>lo, hi = lo + 1, hi - 1</code> &mdash; <code>lo = 1</code>; <code>hi = 3</code> <em>(ambiguous: shrink both ends)</em>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","src","src",""],"ptr":{"3":["hi"],"1":["lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","1",1],["hi","3",1],["mid","2",0]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 3, lo = 1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","src","src",""],"ptr":{"3":["hi"],"1":["lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","1",0],["hi","3",0],["mid","2",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","src","src",""],"ptr":{"3":["hi"],"1":["lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","1",0],["hi","3",0],["mid","2",0]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 2, target = 0)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","src","src",""],"ptr":{"3":["hi"],"1":["lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","1",0],["hi","3",0],["mid","2",0]],"stack":[]},{"caption":"<code>if nums[lo] == nums[mid] == nums[hi]:</code> &rarr; <strong>false</strong> (hi = 3, lo = 1, mid = 2)","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","src","src",""],"ptr":{"3":["hi"],"1":["lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","1",0],["hi","3",0],["mid","2",0]],"stack":[]},{"caption":"<code>elif nums[lo] &lt;= nums[mid]:</code> &rarr; <strong>true</strong> (lo = 1, mid = 2)","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","src","src",""],"ptr":{"3":["hi"],"1":["lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","1",0],["hi","3",0],["mid","2",0]],"stack":[]},{"caption":"<code>if nums[lo] &lt;= target &lt; nums[mid]:</code> &rarr; <strong>true</strong> (lo = 1, mid = 2, target = 0)","line":10,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","src","src",""],"ptr":{"3":["hi"],"1":["lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","1",0],["hi","3",0],["mid","2",0]],"stack":[]},{"caption":"<code>hi = mid - 1</code> &mdash; <code>hi = 1</code>","line":11,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","src","",""],"ptr":{"1":["hi","lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","1",0],["hi","1",1],["mid","2",0]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 1, lo = 1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","src","",""],"ptr":{"1":["hi","lo"],"2":["mid"]}}],"vars":[["target","0",0],["lo","1",0],["hi","1",0],["mid","2",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 1</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","","",""],"ptr":{"1":["hi","lo","mid"]}}],"vars":[["target","0",0],["lo","1",0],["hi","1",0],["mid","1",1]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>true</strong> (mid = 1, target = 0)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","","",""],"ptr":{"1":["hi","lo","mid"]}}],"vars":[["target","0",0],["lo","1",0],["hi","1",0],["mid","1",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>. <strong>Result: T</strong>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","0","1","1","1"],"cls":["","src","","",""],"ptr":{"1":["hi","lo","mid"]}}],"vars":[["target","0",0],["lo","1",0],["hi","1",0],["mid","1",0]],"stack":[]}],"example":1}]}