{"chapters":[{"title":"Linear scan","code":"def search_rotated_ii(nums, target):\n    return target in nums","frames":[{"caption":"<strong>Linear scan</strong> &mdash; O(n) time, O(1) extra space. Input: <code>search_rotated_ii(nums=[2, 5, 6, 0, 0, 1, 2], target=0)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["","","","","","",""]}],"vars":[["target","0",0]],"stack":[]},{"caption":"<code>return target in nums</code> &mdash; returns <code>T</code>. <strong>Result: T</strong>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["","","","","","",""]}],"vars":[["target","0",0]],"stack":[]}]},{"title":"Binary search, shrink both ends on ambiguity","code":"def search_rotated_ii(nums, target):\n    lo, hi = 0, len(nums) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if nums[mid] == target:\n            return True\n        if nums[lo] == nums[mid] == nums[hi]:\n            lo, hi = lo + 1, hi - 1                     # ambiguous: shrink both ends\n        elif nums[lo] <= nums[mid]:\n            if nums[lo] <= target < nums[mid]:\n                hi = mid - 1\n            else:\n                lo = mid + 1\n        else:\n            if nums[mid] < target <= nums[hi]:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n    return False","frames":[{"caption":"<strong>Binary search, shrink both ends on ambiguity</strong> &mdash; O(log n) typical, O(n) worst time, O(1) extra space. Input: <code>search_rotated_ii(nums=[2, 5, 6, 0, 0, 1, 2], target=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["","","","","","",""]}],"vars":[["target","3",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(nums) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 6</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","","","","","src"],"ptr":{"6":["hi"],"0":["lo"]}}],"vars":[["target","3",0],["lo","0",1],["hi","6",1]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","","","","","src"],"ptr":{"6":["hi"],"0":["lo"]}}],"vars":[["target","3",0],["lo","0",0],["hi","6",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 3</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","6",0],["mid","3",1]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 3, target = 3)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>if nums[lo] == nums[mid] == nums[hi]:</code> &rarr; <strong>false</strong> (hi = 6, lo = 0, mid = 3)","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>elif nums[lo] &lt;= nums[mid]:</code> &rarr; <strong>false</strong> (lo = 0, mid = 3)","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>if nums[mid] &lt; target &lt;= nums[hi]:</code> &rarr; <strong>false</strong> (hi = 6, mid = 3, target = 3)","line":15,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>hi = mid - 1</code> &mdash; <code>hi = 2</code>","line":18,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","src","src","","",""],"ptr":{"2":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","2",1],["mid","3",0]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 2, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","src","src","","",""],"ptr":{"2":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","2",0],["mid","3",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 1</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","src","src","","","",""],"ptr":{"2":["hi"],"0":["lo"],"1":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","2",0],["mid","1",1]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 1, target = 3)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","src","src","","","",""],"ptr":{"2":["hi"],"0":["lo"],"1":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","2",0],["mid","1",0]],"stack":[]},{"caption":"<code>if nums[lo] == nums[mid] == nums[hi]:</code> &rarr; <strong>false</strong> (hi = 2, lo = 0, mid = 1)","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","src","src","","","",""],"ptr":{"2":["hi"],"0":["lo"],"1":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","2",0],["mid","1",0]],"stack":[]},{"caption":"<code>elif nums[lo] &lt;= nums[mid]:</code> &rarr; <strong>true</strong> (lo = 0, mid = 1)","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","src","src","","","",""],"ptr":{"2":["hi"],"0":["lo"],"1":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","2",0],["mid","1",0]],"stack":[]},{"caption":"<code>if nums[lo] &lt;= target &lt; nums[mid]:</code> &rarr; <strong>true</strong> (lo = 0, mid = 1, target = 3)","line":10,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","src","src","","","",""],"ptr":{"2":["hi"],"0":["lo"],"1":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","2",0],["mid","1",0]],"stack":[]},{"caption":"<code>hi = mid - 1</code> &mdash; <code>hi = 0</code>","line":11,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","src","","","","",""],"ptr":{"0":["hi","lo"],"1":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","0",1],["mid","1",0]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 0, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","src","","","","",""],"ptr":{"0":["hi","lo"],"1":["mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","0",0],["mid","1",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 0</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","","","","",""],"ptr":{"0":["hi","lo","mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","0",0],["mid","0",1]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 0, target = 3)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","","","","",""],"ptr":{"0":["hi","lo","mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","0",0],["mid","0",0]],"stack":[]},{"caption":"<code>if nums[lo] == nums[mid] == nums[hi]:</code> &rarr; <strong>true</strong> (hi = 0, lo = 0, mid = 0)","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","","","","","",""],"ptr":{"0":["hi","lo","mid"]}}],"vars":[["target","3",0],["lo","0",0],["hi","0",0],["mid","0",0]],"stack":[]},{"caption":"<code>lo, hi = lo + 1, hi - 1</code> &mdash; <code>lo = 1</code>; <code>hi = -1</code> <em>(ambiguous: shrink both ends)</em>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","src","","","","",""],"ptr":{"1":["lo"],"0":["mid"]}}],"vars":[["target","3",0],["lo","1",1],["hi","-1",1],["mid","0",0]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>false</strong> (hi = -1, lo = 1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","src","","","","",""],"ptr":{"1":["lo"],"0":["mid"]}}],"vars":[["target","3",0],["lo","1",0],["hi","-1",0],["mid","0",0]],"stack":[]},{"caption":"<code>return False</code> &mdash; returns <code>F</code>. <strong>Result: F</strong>","line":19,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","5","6","0","0","1","2"],"cls":["src","src","","","","",""],"ptr":{"1":["lo"],"0":["mid"]}}],"vars":[["target","3",0],["lo","1",0],["hi","-1",0],["mid","0",0]],"stack":[]}]}]}