{"chapters":[{"title":"BFS, scanning each full range","code":"def can_reach(s, min_jump, max_jump):\n    n = len(s)\n    seen, queue = {0}, deque([0])\n    while queue:\n        i = queue.popleft()\n        for j in range(i + min_jump, min(n - 1, i + max_jump) + 1):\n            if s[j] == \"0\" and j not in seen:\n                seen.add(j)\n                queue.append(j)\n    return n - 1 in seen","frames":[{"caption":"<strong>BFS, scanning each full range</strong> &mdash; O(n &middot; (maxJump - minJump)) time, O(n) extra space. Input: <code>can_reach(s='011010', min_jump=2, max_jump=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","0"],"cls":["","","","","",""]}],"vars":[["s","'011010'",0],["min_jump","2",0],["max_jump","3",0]],"stack":[]},{"caption":"<code>n = len(s)</code> &mdash; <code>n = 6</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","0"],"cls":["","","","","",""]}],"vars":[["s","'011010'",0],["min_jump","2",0],["max_jump","3",0],["n","6",1]],"stack":[]},{"caption":"<code>seen, queue = {0}, deque([0])</code> &mdash; <code>seen = {0}</code>; <code>queue = [0]</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","0"],"cls":["","","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["0"],"cls":[""],"noidx":true},{"t":"arr","id":"queue","label":"queue (deque)","v":["0"],"cls":[""]}],"vars":[["s","'011010'",0],["min_jump","2",0],["max_jump","3",0],["n","6",0]],"stack":[]},{"caption":"<code>while queue:</code> &rarr; <strong>true</strong>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","0"],"cls":["","","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["0"],"cls":[""],"noidx":true},{"t":"arr","id":"queue","label":"queue (deque)","v":["0"],"cls":[""]}],"vars":[["s","'011010'",0],["min_jump","2",0],["max_jump","3",0],["n","6",0]],"stack":[]},{"caption":"<