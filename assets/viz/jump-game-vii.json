[]}]},{"title":"BFS that never rescans (farthest pointer)","code":"def can_reach(s, min_jump, max_jump):\n    n = len(s)\n    queue, farthest = deque([0]), 0\n    while queue:\n        i = queue.popleft()\n        for j in range(max(i + min_jump, farthest + 1), min(n - 1, i + max_jump) + 1):\n            if s[j] == \"0\":\n                if j == n - 1:\n                    return True\n                queue.append(j)\n        farthest = max(farthest, i + max_jump)\n    return n == 1","frames":[{"caption":"<strong>BFS that never rescans (farthest pointer)</strong> &mdash; O(n) time, O(n) extra space. Input: <code>can_reach(s='01101110', min_jump=2, max_jump=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","1","1","0"],"cls":["","","","","","","",""]}],"vars":[["s","'01101110'",0],["min_jump","2",0],["max_jump","3",0]],"stack":[]},{"caption":"<code>n = len(s)</code> &mdash; <code>n = 8</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","1","1","0"],"cls":["","","","","","","",""]}],"vars":[["s","'01101110'",0],["min_jump","2",0],["max_jump","3",0],["n","8",1]],"stack":[]},{"caption":"<code>queue, farthest = deque([0]), 0</code> &mdash; <code>queue = [0]</code>; <code>farthest = 0</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","1","1","0"],"cls":["","","","","","","",""]},{"t":"arr","id":"queue","label":"queue (deque)","v":["0"],"cls":[""]}],"vars":[["s","'01101110'",0],["min_jump","2",0],["max_jump","3",0],["n","8",0],["farthest","0",1]],"stack":[]},{"caption":"<code>while queue:</code> &rarr; <strong>true</strong>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","1","1","0"],"cls":["","","","","","","",""]},{"t":"arr","id":"queue","label":"queue (deque)","v":["0"],"cls":[""]}],"vars":[["s","'01101110'",0],["min_jump","2",0],["max_jump","3",0],["n","8",0],["farthest","0",0]],"stack"