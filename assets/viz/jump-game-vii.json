ueue","v":[],"cls":[],"noidx":true}],"vars":[["s","'01101110'",0],["min_jump","2",0],["max_jump","3",0],["n","8",0],["farthest","6",0],["i","3",0],["j","6",0]],"stack":[]},{"caption":"<code>return n == 1</code> &mdash; returns <code>F</code>. <strong>Result: F</strong>","line":12,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","1","1","0"],"cls":["","","","","","","src",""],"ptr":{"6":["j"]}},{"t":"arr","id":"queue","label":"queue","v":[],"cls":[],"noidx":true}],"vars":[["s","'01101110'",0],["min_jump","2",0],["max_jump","3",0],["n","8",0],["farthest","6",0],["i","3",0],["j","6",0]],"stack":[]}]},{"title":"DP with a sliding count of reachable sources","code":"def can_reach(s, min_jump, max_jump):\n    n = len(s)\n    ok = [False] * n\n    ok[0] = True\n    window = 0                                   # reachable indices in [j-max, j-min]\n    for j in range(1, n):\n        if j >= min_jump:\n            window += ok[j - min_jump]\n        if j > max_jump:\n            window -= ok[j - max_jump - 1]\n        ok[j] = s[j] == \"0\" and window > 0\n    return ok[-1]","frames":[{"caption":"<strong>DP with a sliding count of reachable sources</strong> &mdash; O(n) time, O(n) extra space. Input: <code>can_reach(s='01101110', min_jump=2, max_jump=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","1","1","0"],"cls":["","","","","","","",""]}],"vars":[["s","'01101110'",0],["min_jump","2",0],["max_jump","3",0]],"stack":[]},{"caption":"<code>n = len(s)</code> &mdash; <code>n = 8</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","1","1","0"],"cls":["","","","","","","",""]}],"vars":[["s","'01101110'",0],["min_jump","2",0],["max_jump","3",0],["n","8",1]],"stack":[]},{"caption":"<code>ok = [False] * n</code> &mdash; <code>ok = [F, F, F, F, F, F, F, F]</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["0","1","1","0","1","1","1"