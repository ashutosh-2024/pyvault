{"chapters":[{"title":"Inorder, find the inversions","code":"def recover_tree(root):\n    first = second = prev = None\n\n    def walk(node):\n        nonlocal first, second, prev\n        if node is None:\n            return\n        walk(node.left)\n        if prev is not None and prev.val > node.val:\n            if first is None:\n                first = prev              # larger value of the first inversion\n            second = node                 # smaller value of the last inversion\n        prev = node\n        walk(node.right)\n\n    walk(root)\n    first.val, second.val = second.val, first.val","frames":[{"caption":"<strong>Inorder, find the inversions</strong> &mdash; O(n) time, O(h) extra space. Input: <code>recover_tree(root=tree (3))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4459712752","1",0.0,1.25,"",[]],["n4459713056","3",1.0,0.0,"cur",["root"]],["n4455930864","2",2.0,2.5,"",[]],["n4462135056","4",3.0,1.25,"",[]]],"edges":[["n4459713056","n4459712752","",""],["n4459713056","n4462135056","",""],["n4462135056","n4455930864","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>first = second = prev = None</code> &mdash; <code>first = None</code>; <code>prev = None</code>; <code>second = None</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4459712752","1",0.0,1.25,"",[]],["n4459713056","3",1.0,0.0,"cur",["root"]],["n4455930864","2",2.0,2.5,"",[]],["n4462135056","4",3.0,1.25,"",[]]],"edges":[["n4459713056","n4459712752","",""],["n4459713056","n4462135056","",""],["n4462135056","n4455930864","",""]],"dir":false}],"vars":[["first","None",1],["prev","None",1],["second","None",1]],"stack":[]},{"caption":"<code>def walk(node):</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4459712752","1",0.0,1.25,"",[]],["n4459713056","3",1.0,0.0,"cur",["root"]],["n4455930864","2",2.0,2.5,"",[]],["n4462135056","4",3.