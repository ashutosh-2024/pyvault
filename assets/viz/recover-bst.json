"n4459713056","3",1.0,0.0,"cur",["first"]],["n4455930864","2",2.0,2.5,"cur",["second"]],["n4462135056","4",3.0,1.25,"cur",["prev"]]],"edges":[["n4459713056","n4459712752","",""],["n4459713056","n4462135056","",""],["n4462135056","n4455930864","",""]],"dir":false}],"vars":[["node","None",0]],"stack":["recover_tree(root=(3))","walk(node=(3))","walk(node=(4))","walk(node=None)"]},{"caption":"<code>first.val, second.val = second.val, first.val</code> &mdash; returns <code>None</code>. <strong>Result: None</strong>","line":17,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4459712752","1",0.0,1.25,"done",[]],["n4459713056","2",1.0,0.0,"cur",["root","first"]],["n4455930864","3",2.0,2.5,"cur",["second"]],["n4462135056","4",3.0,1.25,"cur",["prev"]]],"edges":[["n4459713056","n4459712752","",""],["n4459713056","n4462135056","",""],["n4462135056","n4455930864","",""]],"dir":false}],"vars":[],"stack":[]}]},{"title":"Morris inorder","code":"def recover_tree(root):\n    first = second = prev = None\n    node = root\n\n    def visit(cur):\n        nonlocal first, second, prev\n        if prev is not None and prev.val > cur.val:\n            if first is None:\n                first = prev\n            second = cur\n        prev = cur\n\n    while node is not None:\n        if node.left is None:\n            visit(node)\n            node = node.right\n            continue\n        pred = node.left\n        while pred.right is not None and pred.right is not node:\n            pred = pred.right\n        if pred.right is None:\n            pred.right = node\n            node = node.left\n        else:\n            pred.right = None\n            visit(node)\n            node = node.right\n    first.val, second.val = second.val, first.val","frames":[{"caption":"<strong>Morris inorder</strong> &mdash; O(n) time, O(1) extra space. Input: <code>recover_tree(root=tree (3))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","lab