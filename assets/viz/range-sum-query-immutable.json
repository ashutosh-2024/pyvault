{"chapters":[{"title":"Sum the slice on every query","code":"class NumArray:\n    def __init__(self, nums):\n        self.nums = nums\n\n    def sumRange(self, left, right):\n        return sum(self.nums[left:right + 1])","frames":[{"caption":"<strong>Sum the slice on every query</strong> &mdash; O(n) per query time, O(1) extra space. Running <code>a = NumArray([-2, 0, 3, -5, 2, -1]); assert a.sumRange(0, 2) == 1; assert a.sumRange(2, 5) == -1; assert a.sumRange(0, 5) == -3</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-2","0","3","-5","2","-1"],"cls":["","","","","",""]}],"vars":[["self","'NumArray'",0]],"stack":[]},{"caption":"<code>self.nums = nums</code> &mdash; returns <code>None</code>; <code>self.nums = [-2, 0, 3, -5, 2, -1]</code>","line":3,"panels":[{"t":"arr","id":"self.nums","label":"self.nums","v":["-2","0","3","-5","2","-1"],"cls":["","","","","",""]},{"t":"arr","id":"nums","label":"nums","v":["-2","0","3","-5","2","-1"],"cls":["","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>return sum(self.nums[left:right + 1])</code> &mdash; returns <code>1</code>; <code>left = 0</code>; <code>right = 2</code>","line":6,"panels":[{"t":"arr","id":"self.nums","label":"self.nums","v":["-2","0","3","-5","2","-1"],"cls":["","","","","",""]},{"t":"arr","id":"range:left","label":"search range","v":["0","2"],"cls":["",""],"keys":["left","right"]}],"vars":[["left","0",1],["right","2",1]],"stack":[]},{"caption":"<code>return sum(self.nums[left:right + 1])</code> &mdash; returns <code>-1</code>; <code>left = 2</code>; <code>right = 5</code>","line":6,"panels":[{"t":"arr","id":"self.nums","label":"self.nums","v":["-2","0","3","-5","2","-1"],"cls":["","","","","",""]},{"t":"arr","id":"range:left","label":"search range","v":["2","5"],"cls":["cur","cur"],"keys":["left","right"]}],"vars":[["left","2",1],["right","5",1]],"stack":[]},{"caption":"<code>return sum(self.nums[left:right + 1])</code> &mdash; returns <code>-3</code>; <code>left = 0</code>. <strong>Result: -3</strong>","line":6,"panels":[{"t":"arr","id":"self.nums","label":"self.nums","v":["-2","0","3","-5","2","-1"],"cls":["","","","","",""]},{"t":"arr","id":"range:left","label":"search range","v":["0","5"],"cls":["cur",""],"keys":["left","right"]}],"vars":[["left","0",1],["right","5",0]],"stack":[]}]},{"title":"Prefix sums","code":"class NumArray:\n    def __init__(self, nums):\n        self.pre = [0] + list(accumulate(nums))\n\n    def sumRange(self, left, right):\n        return self.pre[right + 1] - self.pre[left]","frames":[{"caption":"<strong>Prefix sums</strong> &mdash; O(n) build, O(1) per query time, O(n) extra space. Running <code>a = NumArray([-2, 0, 3, -5, 2, -1]); assert a.sumRange(0, 2) == 1; assert a.sumRange(2, 5) == -1; assert a.sumRange(0, 5) == -3</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-2","0","3","-5","2","-1"],"cls":["","","","","",""]}],"vars":[["self","'NumArray'",0]],"stack":[]},{"caption":"<code>self.pre = [0] + list(accumulate(nums))</code> &mdash; returns <code>None</code>; <code>self.pre = [0, -2, -2, 1, -4, -2, -3]</code>","line":3,"panels":[{"t":"arr","id":"self.pre","label":"self.pre","v":["0","-2","-2","1","-4","-2","-3"],"cls":["","","","","","",""]},{"t":"arr","id":"nums","label":"nums","v":["-2","0","3","-5","2","-1"],"cls":["","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.pre[right + 1] - self.pre[left]</code> &mdash; returns <code>1</code>; <code>left = 0</code>; <code>right = 2</code>","line":6,"panels":[{"t":"arr","id":"self.pre","label":"self.pre","v":["0","-2","-2","1","-4","-2","-3"],"cls":["src","","src","","","",""],"ptr":{"0":["left"],"2":["right"]}}],"vars":[["left","0",1],["right","2",1]],"stack":[]},{"caption":"<code>return self.pre[right + 1] - self.pre[left]</code> &mdash; returns <code>-1</code>; <code>left = 2</code>; <code>right = 5</code>","line":6,"panels":[{"t":"arr","id":"self.pre","label":"self.pre","v":["0","-2","-2","1","-4","-2","-3"],"cls":["","","src","","","src",""],"ptr":{"2":["left"],"5":["right"]}}],"vars":[["left","2",1],["right","5",1]],"stack":[]},{"caption":"<code>return self.pre[right + 1] - self.pre[left]</code> &mdash; returns <code>-3</code>; <code>left = 0</code>. <strong>Result: -3</strong>","line":6,"panels":[{"t":"arr","id":"self.pre","label":"self.pre","v":["0","-2","-2","1","-4","-2","-3"],"cls":["src","","","","","src",""],"ptr":{"0":["left"],"5":["right"]}}],"vars":[["left","0",1],["right","5",0]],"stack":[]}]}]}