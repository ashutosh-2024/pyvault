: 10"},{"caption":"Call <code>ways(3)</code>. Computed 2&times; so far.","grid":{"v":[["2","3","2","2","1","1"]],"cls":[["heat2","heat3","heat2","cur","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5"]},"formula":"calls so far: 11"},{"caption":"Call <code>ways(2)</code>. Computed 3&times; so far.","grid":{"v":[["2","3","3","2","1","1"]],"cls":[["heat2","heat3","cur","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5"]},"formula":"calls so far: 12"},{"caption":"Call <code>ways(1)</code> &mdash; base case (1 way). Computed 4&times; so far.","grid":{"v":[["2","4","3","2","1","1"]],"cls":[["heat2","cur","stack","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5"]},"formula":"calls so far: 13"},{"caption":"Call <code>ways(0)</code> &mdash; base case (1 way). Computed 3&times; so far.","grid":{"v":[["3","4","3","2","1","1"]],"cls":[["cur","heat4","stack","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5"]},"formula":"calls so far: 14"},{"caption":"Call <code>ways(1)</code> &mdash; base case (1 way). Computed 5&times; so far.","grid":{"v":[["3","5","3","2","1","1"]],"cls":[["heat3","cur","heat3","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5"]},"formula":"calls so far: 15"},{"caption":"15 calls for 6 distinct steps. The same small sub-answers are recomputed again and again.","grid":{"v":[["3","5","3","2","1","1"]],"cls":[["heat3","heat5","heat3","heat2","heat1","heat1"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5"]},"formula":"15 calls vs 6 distinct sub-problems"}]},{"title":"Bottom-up table","frames":[{"caption":"One way to stand on step 0 (do nothing) and one way to reach step 1.","grid":{"v":[["1","1","","","",""]],"cls":[["base","base","empty","empty","empty","empty"]],"rowLabels":["ways"],"colLabels":["0","1","2","3","4","5"]},"formula":"ways[0] = 1,  ways[1] = 1"},{"caption":"Arrive at step 