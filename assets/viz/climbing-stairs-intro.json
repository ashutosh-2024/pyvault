mpty","empty","empty"]],"rowLabels":["ways"],"colLabels":["0","1","2","3","4","5"]},"formula":"kept in memory: 1, 1"},{"caption":"Step 2: only <code>ways[1]</code>, <code>ways[2]</code> will ever be read again; everything faded can be forgotten.","grid":{"v":[["1","1","2","","",""]],"cls":[["dim","done","cur","empty","empty","empty"]],"rowLabels":["ways"],"colLabels":["0","1","2","3","4","5"]},"formula":"kept in memory: 1, 2"},{"caption":"Step 3: only <code>ways[2]</code>, <code>ways[3]</code> will ever be read again; everything faded can be forgotten.","grid":{"v":[["1","1","2","3","",""]],"cls":[["dim","dim","done","cur","empty","empty"]],"rowLabels":["ways"],"colLabels":["0","1","2","3","4","5"]},"formula":"kept in memory: 2, 3"},{"caption":"Step 4: only <code>ways[3]</code>, <code>ways[4]</code> will ever be read again; everything faded can be forgotten.","grid":{"v":[["1","1","2","3","5",""]],"cls":[["dim","dim","dim","done","cur","empty"]],"rowLabels":["ways"],"colLabels":["0","1","2","3","4","5"]},"formula":"kept in memory: 3, 5"},{"caption":"Step 5: only <code>ways[4]</code>, <code>ways[5]</code> will ever be read again; everything faded can be forgotten.","grid":{"v":[["1","1","2","3","5","8"]],"cls":[["dim","dim","dim","dim","done","cur"]],"rowLabels":["ways"],"colLabels":["0","1","2","3","4","5"]},"formula":"kept in memory: 5, 8"},{"caption":"Only the previous two counts are needed, so two variables replace the table.","grid":{"v":[["1","1","2","3","5","8"]],"cls":[["dim","dim","dim","dim","dim","answer"]],"rowLabels":["ways"],"colLabels":["0","1","2","3","4","5"]},"formula":"answer = 8"}]}]}