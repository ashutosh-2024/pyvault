{"chapters":[{"title":"Inorder, re-link onto a tail","code":"def increasing_bst(root):\n    dummy = tail = TreeNode(0)\n\n    def walk(node):\n        nonlocal tail\n        if node is None:\n            return\n        walk(node.left)\n        node.left = None\n        tail.right = node\n        tail = node\n        walk(node.right)\n\n    walk(root)\n    return dummy.right","frames":[{"caption":"<strong>Inorder, re-link onto a tail</strong> &mdash; O(n) time, O(h) extra space. Input: <code>increasing_bst(root=tree (4))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427016368","1",0.0,2.5,"",[]],["n4426921488","2",1.0,1.25,"",[]],["n4427016064","3",2.0,2.5,"",[]],["n4427148864","4",3.0,0.0,"cur",["root"]],["n4426921168","5",4.0,1.25,"",[]]],"edges":[["n4427148864","n4426921488","",""],["n4426921488","n4427016368","",""],["n4426921488","n4427016064","",""],["n4427148864","n4426921168","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>dummy = tail = TreeNode(0)</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427016368","1",0.0,2.5,"",[]],["n4426921488","2",1.0,1.25,"",[]],["n4427016064","3",2.0,2.5,"",[]],["n4427148864","4",3.0,0.0,"cur",["root"]],["n4426921168","5",4.0,1.25,"",[]]],"edges":[["n4427148864","n4426921488","",""],["n4426921488","n4427016368","",""],["n4426921488","n4427016064","",""],["n4427148864","n4426921168","",""]],"dir":false},{"t":"net","id":"tree1","label":"tree (second)","nodes":[["n4427134256","0",0.0,0.0,"cur",["dummy","tail"]]],"edges":[],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>def walk(node):</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427016368","1",0.0,2.5,"",[]],["n4426921488","2",1.0,1.25,"",[]],["n4427016064","3",2.0,2.5,"",[]],["n4427148864","4",3.0,0.0,"cur",["root"]],["n4426921168","5",4.0,1.25,"",[]]],"edges":[["n4427148864","n4426921488","",""],["n4426921488