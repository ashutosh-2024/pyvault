{"chapters":[{"title":"Simulate from every start","code":"def can_complete_circuit(gas, cost):\n    n = len(gas)\n    for start in range(n):\n        tank = 0\n        for k in range(n):\n            i = (start + k) % n\n            tank += gas[i] - cost[i]\n            if tank < 0:\n                break\n        else:\n            return start\n    return -1","frames":[{"caption":"<strong>Simulate from every start</strong> &mdash; O(n&sup2;) time, O(1) extra space. Input: <code>can_complete_circuit(gas=[1, 2, 3, 4, 5], cost=[3, 4, 5, 1, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"gas","label":"gas","v":["1","2","3","4","5"],"cls":["","","","",""]},{"t":"arr","id":"cost","label":"cost","v":["3","4","5","1","2"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>n = len(gas)</code> &mdash; <code>n = 5</code>","line":2,"panels":[{"t":"arr","id":"gas","label":"gas","v":["1","2","3","4","5"],"cls":["","","","",""]},{"t":"arr","id":"cost","label":"cost","v":["3","4","5","1","2"],"cls":["","","","",""]}],"vars":[["n","5",1]],"stack":[]},{"caption":"<code>for start in range(n):</code> &mdash; <code>start = 0</code>","line":3,"panels":[{"t":"arr","id":"gas","label":"gas","v":["1","2","3","4","5"],"cls":["src","","","",""],"ptr":{"0":["start"]}},{"t":"arr","id":"cost","label":"cost","v":["3","4","5","1","2"],"cls":["src","","","",""],"ptr":{"0":["start"]}}],"vars":[["n","5",0],["start","0",1]],"stack":[]},{"caption":"<code>tank = 0</code> &mdash; <code>tank = 0</code>","line":4,"panels":[{"t":"arr","id":"gas","label":"gas","v":["1","2","3","4","5"],"cls":["src","","","",""],"ptr":{"0":["start"]}},{"t":"arr","id":"cost","label":"cost","v":["3","4","5","1","2"],"cls":["src","","","",""],"ptr":{"0":["start"]}}],"vars":[["n","5",0],["start","0",0],["tank","0",1]],"stack":[]},{"caption":"<code>for k in range(n):</code> &mdash; <code>k = 0</code>","line":5,"panels":[{"t":"arr","id":"gas","label":"gas","v":["1",