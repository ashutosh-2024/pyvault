{"chapters":[{"title":"Linear scan","code":"def search(nums, target):\n    for i, x in enumerate(nums):\n        if x == target:\n            return i\n    return -1","frames":[{"caption":"<strong>Linear scan</strong> &mdash; O(n) time, O(1) extra space. Input: <code>search(nums=[-1, 0, 3, 5, 9, 12], target=9)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 0</code>; <code>x = -1</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","",""],"ptr":{"0":["i"]}}],"vars":[["target","9",0],["i","0",1],["x","-1",1]],"stack":[]},{"caption":"<code>if x == target:</code> &rarr; <strong>false</strong> (target = 9, x = -1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","",""],"ptr":{"0":["i"]}}],"vars":[["target","9",0],["i","0",0],["x","-1",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 1</code>; <code>x = 0</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","src","","","",""],"ptr":{"1":["i"]}}],"vars":[["target","9",0],["i","1",1],["x","0",1]],"stack":[]},{"caption":"<code>if x == target:</code> &rarr; <strong>false</strong> (target = 9, x = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","src","","","",""],"ptr":{"1":["i"]}}],"vars":[["target","9",0],["i","1",0],["x","0",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 2</code>; <code>x = 3</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","src","","",""],"ptr":{"2":["i"]}}],"vars":[["target","9",0],["i","2",1],["x","3",1]],"stack":[]},{"caption":"<code>if x == target:</code> &rarr; <strong>false</strong> (target = 9, x = 3)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","src","","",""],"ptr":{"2":["i"]}}],"vars":[["target","9",0],["i","2",0],["x","3",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 3</code>; <code>x = 5</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","src","",""],"ptr":{"3":["i"]}}],"vars":[["target","9",0],["i","3",1],["x","5",1]],"stack":[]},{"caption":"<code>if x == target:</code> &rarr; <strong>false</strong> (target = 9, x = 5)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","src","",""],"ptr":{"3":["i"]}}],"vars":[["target","9",0],["i","3",0],["x","5",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 4</code>; <code>x = 9</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","src",""],"ptr":{"4":["i"]}}],"vars":[["target","9",0],["i","4",1],["x","9",1]],"stack":[]},{"caption":"<code>if x == target:</code> &rarr; <strong>true</strong> (target = 9, x = 9)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","src",""],"ptr":{"4":["i"]}}],"vars":[["target","9",0],["i","4",0],["x","9",0]],"stack":[]},{"caption":"<code>return i</code> &mdash; returns <code>4</code>. <strong>Result: 4</strong>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","src",""],"ptr":{"4":["i"]}}],"vars":[["target","9",0],["i","4",0],["x","9",0]],"stack":[]}],"example":1},{"title":"Recursive binary search","code":"def search(nums, target):\n    def go(lo, hi):\n        if lo > hi:\n            return -1\n        mid = (lo + hi) // 2\n        if nums[mid] == target:\n            return mid\n        return go(mid + 1, hi) if nums[mid] < target else go(lo, mid - 1)\n    return go(0, len(nums) - 1)","frames":[{"caption":"<strong>Recursive binary search</strong> &mdash; O(log n) time, O(log n) extra space. Input: <code>search(nums=[-1, 0, 3, 5, 9, 12], target=9)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>def go(lo, hi):</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>return go(0, len(nums) - 1)</code> &mdash; calls <code>go(lo=0, hi=5)</code>","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",1],["hi","5",1]],"stack":["search(nums, target=9)","go(lo=0, hi=5)"]},{"caption":"<code>if lo &gt; hi:</code> &rarr; <strong>false</strong> (hi = 5, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","5",0]],"stack":["search(nums, target=9)","go(lo=0, hi=5)"]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 2</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","src","","","src"],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","9",0],["lo","0",0],["hi","5",0],["mid","2",1]],"stack":["search(nums, target=9)","go(lo=0, hi=5)"]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 2, target = 9)","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","src","","","src"],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","9",0],["lo","0",0],["hi","5",0],["mid","2",0]],"stack":["search(nums, target=9)","go(lo=0, hi=5)"]},{"caption":"<code>return go(mid + 1, hi) if nums[mid] &lt; target else go(lo, mid - 1)</code> &mdash; calls <code>go(lo=3, hi=5)</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","src","src","","src"],"ptr":{"5":["hi"],"3":["lo"],"2":["mid"]}}],"vars":[["target","9",0],["lo","3",1],["hi","5",0],["mid","2",0]],"stack":["search(nums, target=9)","go(lo=0, hi=5)","go(lo=3, hi=5)"]},{"caption":"<code>if lo &gt; hi:</code> &rarr; <strong>false</strong> (hi = 5, lo = 3)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","src","src","","src"],"ptr":{"5":["hi"],"3":["lo"],"2":["mid"]}}],"vars":[["target","9",0],["lo","3",0],["hi","5",0],["mid","2",0]],"stack":["search(nums, target=9)","go(lo=0, hi=5)","go(lo=3, hi=5)"]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 4</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","src","src","src"],"ptr":{"5":["hi"],"3":["lo"],"4":["mid"]}}],"vars":[["target","9",0],["lo","3",0],["hi","5",0],["mid","4",1]],"stack":["search(nums, target=9)","go(lo=0, hi=5)","go(lo=3, hi=5)"]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>true</strong> (mid = 4, target = 9)","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","src","src","src"],"ptr":{"5":["hi"],"3":["lo"],"4":["mid"]}}],"vars":[["target","9",0],["lo","3",0],["hi","5",0],["mid","4",0]],"stack":["search(nums, target=9)","go(lo=0, hi=5)","go(lo=3, hi=5)"]},{"caption":"<code>return mid</code> &mdash; <code>go</code> returns <code>4</code> to <code>go</code>. <strong>Result: 4</strong>","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","src","src","src"],"ptr":{"5":["hi"],"3":["lo"],"4":["mid"]}}],"vars":[["target","9",0],["lo","3",0],["hi","5",0],["mid","4",0]],"stack":["search(nums, target=9)","go(lo=0, hi=5)","go(lo=3, hi=5)"]}],"example":1},{"title":"Iterative binary search","code":"def search(nums, target):\n    lo, hi = 0, len(nums) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if nums[mid] == target:\n            return mid\n        if nums[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return -1","frames":[{"caption":"<strong>Iterative binary search</strong> &mdash; O(log n) time, O(1) extra space. Input: <code>search(nums=[-1, 0, 3, 5, 9, 12], target=9)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(nums) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 5</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",1],["hi","5",1]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 5, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","5",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 2</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","src","","","src"],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","9",0],["lo","0",0],["hi","5",0],["mid","2",1]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 2, target = 9)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","src","","","src"],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","9",0],["lo","0",0],["hi","5",0],["mid","2",0]],"stack":[]},{"caption":"<code>if nums[mid] &lt; target:</code> &rarr; <strong>true</strong> (mid = 2, target = 9)","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","src","","","src"],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","9",0],["lo","0",0],["hi","5",0],["mid","2",0]],"stack":[]},{"caption":"<code>lo = mid + 1</code> &mdash; <code>lo = 3</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","src","src","","src"],"ptr":{"5":["hi"],"3":["lo"],"2":["mid"]}}],"vars":[["target","9",0],["lo","3",1],["hi","5",0],["mid","2",0]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 5, lo = 3)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","src","src","","src"],"ptr":{"5":["hi"],"3":["lo"],"2":["mid"]}}],"vars":[["target","9",0],["lo","3",0],["hi","5",0],["mid","2",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 4</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","src","src","src"],"ptr":{"5":["hi"],"3":["lo"],"4":["mid"]}}],"vars":[["target","9",0],["lo","3",0],["hi","5",0],["mid","4",1]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>true</strong> (mid = 4, target = 9)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","src","src","src"],"ptr":{"5":["hi"],"3":["lo"],"4":["mid"]}}],"vars":[["target","9",0],["lo","3",0],["hi","5",0],["mid","4",0]],"stack":[]},{"caption":"<code>return mid</code> &mdash; returns <code>4</code>. <strong>Result: 4</strong>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","src","src","src"],"ptr":{"5":["hi"],"3":["lo"],"4":["mid"]}}],"vars":[["target","9",0],["lo","3",0],["hi","5",0],["mid","4",0]],"stack":[]}],"example":1}]}