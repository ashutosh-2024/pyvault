{"chapters":[{"title":"Linear scan","code":"def search(nums, target):\n    for i, x in enumerate(nums):\n        if x == target:\n            return i\n    return -1","frames":[{"caption":"<strong>Linear scan</strong> &mdash; O(n) time, O(1) extra space. Input: <code>search(nums=[-1, 0, 3, 5, 9, 12], target=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","",""]}],"vars":[["target","2",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 0</code>; <code>x = -1</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","",""],"ptr":{"0":["i"]}}],"vars":[["target","2",0],["i","0",1],["x","-1",1]],"stack":[]},{"caption":"<code>if x == target:</code> &rarr; <strong>false</strong> (target = 2, x = -1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","",""],"ptr":{"0":["i"]}}],"vars":[["target","2",0],["i","0",0],["x","-1",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 1</code>; <code>x = 0</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","src","","","",""],"ptr":{"1":["i"]}}],"vars":[["target","2",0],["i","1",1],["x","0",1]],"stack":[]},{"caption":"<code>if x == target:</code> &rarr; <strong>false</strong> (target = 2, x = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","src","","","",""],"ptr":{"1":["i"]}}],"vars":[["target","2",0],["i","1",0],["x","0",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 2</code>; <code>x = 3</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","src","","",""],"ptr":{"2":["i"]}}],"vars":[["target","2",0],["i","2",1],["x","3",1]],"stack":[]},{"caption":"<code>if x == target:</code> &rarr; <strong>false</strong> (target = 2, x = 3)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","src","","",""],"ptr":{"2":["i"]}}],"vars":[["target","2",0],["i","2",0],["x","3",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 3</code>; <code>x = 5</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","src","",""],"ptr":{"3":["i"]}}],"vars":[["target","2",0],["i","3",1],["x","5",1]],"stack":[]},{"caption":"<code>if x == target:</code> &rarr; <strong>false</strong> (target = 2, x = 5)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","src","",""],"ptr":{"3":["i"]}}],"vars":[["target","2",0],["i","3",0],["x","5",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 4</code>; <code>x = 9</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","src",""],"ptr":{"4":["i"]}}],"vars":[["target","2",0],["i","4",1],["x","9",1]],"stack":[]},{"caption":"<code>if x == target:</code> &rarr; <strong>false</strong> (target = 2, x = 9)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","src",""],"ptr":{"4":["i"]}}],"vars":[["target","2",0],["i","4",0],["x","9",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 5</code>; <code>x = 12</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","","src"],"ptr":{"5":["i"]}}],"vars":[["target","2",0],["i","5",1],["x","12",1]],"stack":[]},{"caption":"<code>if x == target:</code> &rarr; <strong>false</strong> (target = 2, x = 12)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","","src"],"ptr":{"5":["i"]}}],"vars":[["target","2",0],["i","5",0],["x","12",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","","src"],"ptr":{"5":["i"]}}],"vars":[["target","2",0],["i","5",0],["x","12",0]],"stack":[]},{"caption":"<code>return -1</code> &mdash; returns <code>-1</code>. <strong>Result: -1</strong>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","","src"],"ptr":{"5":["i"]}}],"vars":[["target","2",0],["i","5",0],["x","12",0]],"stack":[]}]},{"title":"Recursive binary search","code":"def search(nums, target):\n    def go(lo, hi):\n        if lo > hi:\n            return -1\n        mid = (lo + hi) // 2\n        if nums[mid] == target:\n            return mid\n        return go(mid + 1, hi) if nums[mid] < target else go(lo, mid - 1)\n    return go(0, len(nums) - 1)","frames":[{"caption":"<strong>Recursive binary search</strong> &mdash; O(log n) time, O(log n) extra space. Input: <code>search(nums=[-1, 0, 3, 5, 9, 12], target=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","",""]}],"vars":[["target","2",0]],"stack":[]},{"caption":"<code>def go(lo, hi):</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","",""]}],"vars":[["target","2",0]],"stack":[]},{"caption":"<code>return go(0, len(nums) - 1)</code> &mdash; calls <code>go(lo=0, hi=5)</code>","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","2",0],["lo","0",1],["hi","5",1]],"stack":["search(nums, target=2)","go(lo=0, hi=5)"]},{"caption":"<code>if lo &gt; hi:</code> &rarr; <strong>false</strong> (hi = 5, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","2",0],["lo","0",0],["hi","5",0]],"stack":["search(nums, target=2)","go(lo=0, hi=5)"]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 2</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","src","","","src"],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","5",0],["mid","2",1]],"stack":["search(nums, target=2)","go(lo=0, hi=5)"]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 2, target = 2)","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","src","","","src"],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","5",0],["mid","2",0]],"stack":["search(nums, target=2)","go(lo=0, hi=5)"]},{"caption":"<code>return go(mid + 1, hi) if nums[mid] &lt; target else go(lo, mid - 1)</code> &mdash; calls <code>go(lo=0, hi=1)</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","src","","",""],"ptr":{"1":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",1],["mid","2",0]],"stack":["search(nums, target=2)","go(lo=0, hi=5)","go(lo=0, hi=1)"]},{"caption":"<code>if lo &gt; hi:</code> &rarr; <strong>false</strong> (hi = 1, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","src","","",""],"ptr":{"1":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",0],["mid","2",0]],"stack":["search(nums, target=2)","go(lo=0, hi=5)","go(lo=0, hi=1)"]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 0</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","","","",""],"ptr":{"1":["hi"],"0":["lo","mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",0],["mid","0",1]],"stack":["search(nums, target=2)","go(lo=0, hi=5)","go(lo=0, hi=1)"]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 0, target = 2)","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","","","",""],"ptr":{"1":["hi"],"0":["lo","mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",0],["mid","0",0]],"stack":["search(nums, target=2)","go(lo=0, hi=5)","go(lo=0, hi=1)"]},{"caption":"<code>return go(mid + 1, hi) if nums[mid] &lt; target else go(lo, mid - 1)</code> &mdash; calls <code>go(lo=1, hi=1)</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","","","",""],"ptr":{"1":["hi","lo"],"0":["mid"]}}],"vars":[["target","2",0],["lo","1",1],["hi","1",0],["mid","0",0]],"stack":["search(nums, target=2)","go(lo=0, hi=5)","go(lo=0, hi=1)","go(lo=1, hi=1)"]},{"caption":"<code>if lo &gt; hi:</code> &rarr; <strong>false</strong> (hi = 1, lo = 1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","","","",""],"ptr":{"1":["hi","lo"],"0":["mid"]}}],"vars":[["target","2",0],["lo","1",0],["hi","1",0],["mid","0",0]],"stack":["search(nums, target=2)","go(lo=0, hi=5)","go(lo=0, hi=1)","go(lo=1, hi=1)"]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 1</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","src","","","",""],"ptr":{"1":["hi","lo","mid"]}}],"vars":[["target","2",0],["lo","1",0],["hi","1",0],["mid","1",1]],"stack":["search(nums, target=2)","go(lo=0, hi=5)","go(lo=0, hi=1)","go(lo=1, hi=1)"]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 1, target = 2)","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","src","","","",""],"ptr":{"1":["hi","lo","mid"]}}],"vars":[["target","2",0],["lo","1",0],["hi","1",0],["mid","1",0]],"stack":["search(nums, target=2)","go(lo=0, hi=5)","go(lo=0, hi=1)","go(lo=1, hi=1)"]},{"caption":"<code>return go(mid + 1, hi) if nums[mid] &lt; target else go(lo, mid - 1)</code> &mdash; calls <code>go(lo=2, hi=1)</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","src","src","","",""],"ptr":{"1":["hi","mid"],"2":["lo"]}}],"vars":[["target","2",0],["lo","2",1],["hi","1",0],["mid","1",0]],"stack":["search(nums, target=2)","go(lo=0, hi=5)","go(lo=0, hi=1)","go(lo=1, hi=1)","go(lo=2, hi=1)"]},{"caption":"<code>if lo &gt; hi:</code> &rarr; <strong>true</strong> (hi = 1, lo = 2)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","src","src","","",""],"ptr":{"1":["hi","mid"],"2":["lo"]}}],"vars":[["target","2",0],["lo","2",0],["hi","1",0],["mid","1",0]],"stack":["search(nums, target=2)","go(lo=0, hi=5)","go(lo=0, hi=1)","go(lo=1, hi=1)","go(lo=2, hi=1)"]},{"caption":"<code>return -1</code> &mdash; <code>go</code> returns <code>-1</code> to <code>go</code>. <strong>Result: -1</strong>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","src","src","","",""],"ptr":{"1":["hi","mid"],"2":["lo"]}}],"vars":[["target","2",0],["lo","2",0],["hi","1",0],["mid","1",0]],"stack":["search(nums, target=2)","go(lo=0, hi=5)","go(lo=0, hi=1)","go(lo=1, hi=1)","go(lo=2, hi=1)"]}]},{"title":"Iterative binary search","code":"def search(nums, target):\n    lo, hi = 0, len(nums) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if nums[mid] == target:\n            return mid\n        if nums[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return -1","frames":[{"caption":"<strong>Iterative binary search</strong> &mdash; O(log n) time, O(1) extra space. Input: <code>search(nums=[-1, 0, 3, 5, 9, 12], target=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["","","","","",""]}],"vars":[["target","2",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(nums) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 5</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","2",0],["lo","0",1],["hi","5",1]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 5, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","","","","src"],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["target","2",0],["lo","0",0],["hi","5",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 2</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","src","","","src"],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","5",0],["mid","2",1]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 2, target = 2)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","src","","","src"],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","5",0],["mid","2",0]],"stack":[]},{"caption":"<code>if nums[mid] &lt; target:</code> &rarr; <strong>false</strong> (mid = 2, target = 2)","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","","src","","","src"],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","5",0],["mid","2",0]],"stack":[]},{"caption":"<code>hi = mid - 1</code> &mdash; <code>hi = 1</code>","line":10,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","src","","",""],"ptr":{"1":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",1],["mid","2",0]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 1, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","src","","",""],"ptr":{"1":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",0],["mid","2",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 0</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","","","",""],"ptr":{"1":["hi"],"0":["lo","mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",0],["mid","0",1]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 0, target = 2)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","","","",""],"ptr":{"1":["hi"],"0":["lo","mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",0],["mid","0",0]],"stack":[]},{"caption":"<code>if nums[mid] &lt; target:</code> &rarr; <strong>true</strong> (mid = 0, target = 2)","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","","","",""],"ptr":{"1":["hi"],"0":["lo","mid"]}}],"vars":[["target","2",0],["lo","0",0],["hi","1",0],["mid","0",0]],"stack":[]},{"caption":"<code>lo = mid + 1</code> &mdash; <code>lo = 1</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","0","3","5","9","12"],"cls":["src","src","","","",""],"ptr":{"1":["hi","lo"],"0":["mid"]}}],"vars":[["target","2",0],["lo","1",1],["hi","1",0],["mid","0",0]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 1, lo = 1)","line":3,"panels":[{"t":