{"chapters":[{"title":"Extend from every start","code":"def max_turbulence_size(arr):\n    best = 1\n    for i in range(len(arr)):\n        j = i + 1\n        while j < len(arr) and arr[j] != arr[j - 1] and (j == i + 1 or (arr[j] > arr[j - 1]) != (arr[j - 1] > arr[j - 2])):\n            j += 1\n        best = max(best, j - i)\n    return best","frames":[{"caption":"<strong>Extend from every start</strong> &mdash; O(n&sup2;) time, O(1) extra space. Input: <code>max_turbulence_size(arr=[9, 4, 2, 10, 7, 8, 8, 1, …])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"arr","label":"arr","v":["9","4","2","10","7","8","8","1","9"],"cls":["","","","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>best = 1</code> &mdash; <code>best = 1</code>","line":2,"panels":[{"t":"arr","id":"arr","label":"arr","v":["9","4","2","10","7","8","8","1","9"],"cls":["","","","","","","","",""]}],"vars":[["best","1",1]],"stack":[]},{"caption":"<code>for i in range(len(arr)):</code> &mdash; <code>i = 0</code>","line":3,"panels":[{"t":"arr","id":"arr","label":"arr","v":["9","4","2","10","7","8","8","1","9"],"cls":["src","","","","","","","",""],"ptr":{"0":["i"]}}],"vars":[["best","1",0],["i","0",1]],"stack":[]},{"caption":"<code>j = i + 1</code> &mdash; <code>j = 1</code>","line":4,"panels":[{"t":"arr","id":"arr","label":"arr","v":["9","4","2","10","7","8","8","1","9"],"cls":["src","src","","","","","","",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["best","1",0],["i","0",0],["j","1",1]],"stack":[]},{"caption":"<code>while j &lt; len(arr) and arr[j] != arr[j - 1] and (j == i + 1 or (arr[j] &gt; arr[j - 1]) != (arr[j - 1] &gt; arr[j - 2])):</code> &rarr; <strong>true</strong> (i = 0, j = 1)","line":5,"panels":[{"t":"arr","id":"arr","label":"arr","v":["9","4","2","10","7","8","8","1","9"],"cls":["src","src","","","","","","",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["best","1",0],["i","0",0],["j","1",0]],"stack":[]},{"caption":"<code>j += 1</cod