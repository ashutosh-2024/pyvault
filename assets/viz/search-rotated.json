{"chapters":[{"title":"Linear scan","code":"def search_rotated(nums, target):\n    return nums.index(target) if target in nums else -1","frames":[{"caption":"<strong>Linear scan</strong> &mdash; O(n) time, O(1) extra space. Input: <code>search_rotated(nums=[4, 5, 6, 7, 0, 1, 2], target=0)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","","",""]}],"vars":[["target","0",0]],"stack":[]},{"caption":"<code>return nums.index(target) if target in nums else -1</code> &mdash; returns <code>4</code>. <strong>Result: 4</strong>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","","",""]}],"vars":[["target","0",0]],"stack":[]}]},{"title":"Find the rotation point, then search one side","code":"def search_rotated(nums, target):\n    lo, hi = 0, len(nums) - 1\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if nums[mid] > nums[hi]:\n            lo = mid + 1\n        else:\n            hi = mid\n    pivot = lo\n    if nums[pivot] <= target <= nums[-1]:\n        lo, hi = pivot, len(nums)\n    else:\n        lo, hi = 0, pivot\n    i = bisect.bisect_left(nums, target, lo, hi)\n    return i if i < len(nums) and nums[i] == target else -1","frames":[{"caption":"<strong>Find the rotation point, then search one side</strong> &mdash; O(log n) time, O(1) extra space. Input: <code>search_rotated(nums=[4, 5, 6, 7, 0, 1, 2], target=1)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","","",""]}],"vars":[["target","1",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(nums) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 6</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","","","","src"],"ptr":{"6":["hi"],"0":["lo"]}}],"vars":[["target","1",0],["lo","0",1],["hi","6",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","","","","src"],"ptr":{"6":["hi"],"0":["lo"]}}],"vars":[["target","1",0],["lo","0",0],["hi","6",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 3</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","1",0],["lo","0",0],["hi","6",0],["mid","3",1]],"stack":[]},{"caption":"<code>if nums[mid] &gt; nums[hi]:</code> &rarr; <strong>true</strong> (hi = 6, mid = 3)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","1",0],["lo","0",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>lo = mid + 1</code> &mdash; <code>lo = 4</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","src","src","","src"],"ptr":{"6":["hi"],"4":["lo"],"3":["mid"]}}],"vars":[["target","1",0],["lo","4",1],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 4)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","src","src","","src"],"ptr":{"6":["hi"],"4":["lo"],"3":["mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 5</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src","src"],"ptr":{"6":["hi"],"4":["lo"],"5":["mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","6",0],["mid","5",1]],"stack":[]},{"caption":"<code>if nums[mid] &gt; nums[hi]:</code> &rarr; <strong>false</strong> (hi = 6, mid = 5)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src","src"],"ptr":{"6":["hi"],"4":["lo"],"5":["mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","6",0],["mid","5",0]],"stack":[]},{"caption":"<code>hi = mid</code> &mdash; <code>hi = 5</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src",""],"ptr":{"5":["hi","mid"],"4":["lo"]}}],"vars":[["target","1",0],["lo","4",0],["hi","5",1],["mid","5",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 5, lo = 4)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src",""],"ptr":{"5":["hi","mid"],"4":["lo"]}}],"vars":[["target","1",0],["lo","4",0],["hi","5",0],["mid","5",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 4</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src",""],"ptr":{"5":["hi"],"4":["lo","mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","5",0],["mid","4",1]],"stack":[]},{"caption":"<code>if nums[mid] &gt; nums[hi]:</code> &rarr; <strong>false</strong> (hi = 5, mid = 4)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src",""],"ptr":{"5":["hi"],"4":["lo","mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","5",0],["mid","4",0]],"stack":[]},{"caption":"<code>hi = mid</code> &mdash; <code>hi = 4</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","",""],"ptr":{"4":["hi","lo","mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","4",1],["mid","4",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>false</strong> (hi = 4, lo = 4)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","",""],"ptr":{"4":["hi","lo","mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","4",0],["mid","4",0]],"stack":[]},{"caption":"<code>pivot = lo</code> &mdash; <code>pivot = 4</code>","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","",""],"ptr":{"4":["hi","lo","mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","4",0],["mid","4",0],["pivot","4",1]],"stack":[]},{"caption":"<code>if nums[pivot] &lt;= target &lt;= nums[-1]:</code> &rarr; <strong>true</strong> (pivot = 4, target = 1)","line":10,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","",""],"ptr":{"4":["hi","lo","mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","4",0],["mid","4",0],["pivot","4",0]],"stack":[]},{"caption":"<code>lo, hi = pivot, len(nums)</code> &mdash; <code>hi = 7</code>","line":11,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","",""],"ptr":{"7":["hi"],"4":["lo","mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","7",1],["mid","4",0],["pivot","4",0]],"stack":[]},{"caption":"<code>i = bisect.bisect_left(nums, target, lo, hi)</code> &mdash; <code>i = 5</code>","line":14,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src",""],"ptr":{"7":["hi"],"5":["i"],"4":["lo","mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","7",0],["mid","4",0],["pivot","4",0],["i","5",1]],"stack":[]},{"caption":"<code>return i if i &lt; len(nums) and nums[i] == target else -1</code> &mdash; returns <code>5</code>. <strong>Result: 5</strong>","line":15,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src",""],"ptr":{"7":["hi"],"5":["i"],"4":["lo","mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","7",0],["mid","4",0],["pivot","4",0],["i","5",0]],"stack":[]}],"example":1},{"title":"One pass: decide which half is sorted","code":"def search_rotated(nums, target):\n    lo, hi = 0, len(nums) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if nums[mid] == target:\n            return mid\n        if nums[lo] <= nums[mid]:                       # left half sorted\n            if nums[lo] <= target < nums[mid]:\n                hi = mid - 1\n            else:\n                lo = mid + 1\n        else:                                           # right half sorted\n            if nums[mid] < target <= nums[hi]:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n    return -1","frames":[{"caption":"<strong>One pass: decide which half is sorted</strong> &mdash; O(log n) time, O(1) extra space. Input: <code>search_rotated(nums=[4, 5, 6, 7, 0, 1, 2], target=1)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","","",""]}],"vars":[["target","1",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(nums) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 6</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","","","","src"],"ptr":{"6":["hi"],"0":["lo"]}}],"vars":[["target","1",0],["lo","0",1],["hi","6",1]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 0)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","","","","src"],"ptr":{"6":["hi"],"0":["lo"]}}],"vars":[["target","1",0],["lo","0",0],["hi","6",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 3</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","1",0],["lo","0",0],["hi","6",0],["mid","3",1]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>false</strong> (mid = 3, target = 1)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","1",0],["lo","0",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>if nums[lo] &lt;= nums[mid]:</code> &rarr; <strong>true</strong> (lo = 0, mid = 3) <em>(left half sorted)</em>","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","1",0],["lo","0",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>if nums[lo] &lt;= target &lt; nums[mid]:</code> &rarr; <strong>false</strong> (lo = 0, mid = 3, target = 1)","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["src","","","src","","","src"],"ptr":{"6":["hi"],"0":["lo"],"3":["mid"]}}],"vars":[["target","1",0],["lo","0",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>lo = mid + 1</code> &mdash; <code>lo = 4</code>","line":11,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","src","src","","src"],"ptr":{"6":["hi"],"4":["lo"],"3":["mid"]}}],"vars":[["target","1",0],["lo","4",1],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 4)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","src","src","","src"],"ptr":{"6":["hi"],"4":["lo"],"3":["mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 5</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src","src"],"ptr":{"6":["hi"],"4":["lo"],"5":["mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","6",0],["mid","5",1]],"stack":[]},{"caption":"<code>if nums[mid] == target:</code> &rarr; <strong>true</strong> (mid = 5, target = 1)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src","src"],"ptr":{"6":["hi"],"4":["lo"],"5":["mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","6",0],["mid","5",0]],"stack":[]},{"caption":"<code>return mid</code> &mdash; returns <code>5</code>. <strong>Result: 5</strong>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["4","5","6","7","0","1","2"],"cls":["","","","","src","src","src"],"ptr":{"6":["hi"],"4":["lo"],"5":["mid"]}}],"vars":[["target","1",0],["lo","4",0],["hi","6",0],["mid","5",0]],"stack":[]}],"example":1}]}