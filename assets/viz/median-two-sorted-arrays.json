{"chapters":[{"title":"Merge fully, pick the middle","code":"def find_median_sorted_arrays(a, b):\n    merged, i, j = [], 0, 0\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]:\n            merged.append(a[i]); i += 1\n        else:\n            merged.append(b[j]); j += 1\n    merged += a[i:] + b[j:]\n    n = len(merged)\n    return merged[n // 2] if n % 2 else (merged[n // 2 - 1] + merged[n // 2]) / 2","frames":[{"caption":"<strong>Merge fully, pick the middle</strong> &mdash; O(m + n) time, O(m + n) extra space. Input: <code>find_median_sorted_arrays(a=[1, 3], b=[2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["",""]},{"t":"arr","id":"b","label":"b","v":["2"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>merged, i, j = [], 0, 0</code> &mdash; <code>merged = []</code>; <code>i = 0</code>; <code>j = 0</code>","line":2,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"b","label":"b","v":["2"],"cls":["src"],"ptr":{"0":["j"]}},{"t":"arr","id":"merged","label":"merged","v":[],"cls":[],"noidx":true}],"vars":[["i","0",1],["j","0",1]],"stack":[]},{"caption":"<code>while i &lt; len(a) and j &lt; len(b):</code> &rarr; <strong>true</strong> (i = 0, j = 0)","line":3,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"b","label":"b","v":["2"],"cls":["src"],"ptr":{"0":["j"]}},{"t":"arr","id":"merged","label":"merged","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["j","0",0]],"stack":[]},{"caption":"<code>if a[i] &lt;= b[j]:</code> &rarr; <strong>true</strong> (i = 0, j = 0)","line":4,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"b","label":"b","v":["2"],"cls":["src"],"ptr":{"0":["j"]}},{"t":"arr","id":"merged","label":"merged","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["j","0",0]],"stack":[]},{"caption":"<code>merged.append(a[i]); i += 1</code> &mdash; <code>merged</code> gets <code>1</code> appended; <code>i = 1</code>","line":5,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["2"],"cls":["src"],"ptr":{"0":["j"]}},{"t":"arr","id":"merged","label":"merged","v":["1"],"cls":["cur"]}],"vars":[["i","1",1],["j","0",0]],"stack":[]},{"caption":"<code>while i &lt; len(a) and j &lt; len(b):</code> &rarr; <strong>true</strong> (i = 1, j = 0)","line":3,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["2"],"cls":["src"],"ptr":{"0":["j"]}},{"t":"arr","id":"merged","label":"merged","v":["1"],"cls":[""]}],"vars":[["i","1",0],["j","0",0]],"stack":[]},{"caption":"<code>if a[i] &lt;= b[j]:</code> &rarr; <strong>false</strong> (i = 1, j = 0)","line":4,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["2"],"cls":["src"],"ptr":{"0":["j"]}},{"t":"arr","id":"merged","label":"merged","v":["1"],"cls":[""]}],"vars":[["i","1",0],["j","0",0]],"stack":[]},{"caption":"<code>merged.append(b[j]); j += 1</code> &mdash; <code>merged</code> gets <code>2</code> appended; <code>j = 1</code>","line":7,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["2"],"cls":[""],"ptr":{"1":["j"]}},{"t":"arr","id":"merged","label":"merged","v":["1","2"],"cls":["","cur"]}],"vars":[["i","1",0],["j","1",1]],"stack":[]},{"caption":"<code>while i &lt; len(a) and j &lt; len(b):</code> &rarr; <strong>false</strong> (i = 1, j = 1)","line":3,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["2"],"cls":[""],"ptr":{"1":["j"]}},{"t":"arr","id":"merged","label":"merged","v":["1","2"],"cls":["",""]}],"vars":[["i","1",0],["j","1",0]],"stack":[]},{"caption":"<code>merged += a[i:] + b[j:]</code> &mdash; <code>merged</code> gets <code>3</code> appended","line":8,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["2"],"cls":[""],"ptr":{"1":["j"]}},{"t":"arr","id":"merged","label":"merged","v":["1","2","3"],"cls":["","","cur"]}],"vars":[["i","1",0],["j","1",0]],"stack":[]},{"caption":"<code>n = len(merged)</code> &mdash; <code>n = 3</code>","line":9,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["2"],"cls":[""],"ptr":{"1":["j"]}},{"t":"arr","id":"merged","label":"merged","v":["1","2","3"],"cls":["","",""]}],"vars":[["i","1",0],["j","1",0],["n","3",1]],"stack":[]},{"caption":"<code>return merged[n // 2] if n % 2 else (merged[n // 2 - 1] + merged[n // 2]) / 2</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":10,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["2"],"cls":[""],"ptr":{"1":["j"]}},{"t":"arr","id":"merged","label":"merged","v":["1","2","3"],"cls":["","",""]}],"vars":[["i","1",0],["j","1",0],["n","3",0]],"stack":[]}]},{"title":"Walk to the middle without storing","code":"def find_median_sorted_arrays(a, b):\n    total = len(a) + len(b)\n    i = j = 0\n    prev = cur = 0\n    for _ in range(total // 2 + 1):\n        prev = cur\n        if j >= len(b) or (i < len(a) and a[i] <= b[j]):\n            cur = a[i]; i += 1\n        else:\n            cur = b[j]; j += 1\n    return cur if total % 2 else (prev + cur) / 2","frames":[{"caption":"<strong>Walk to the middle without storing</strong> &mdash; O(m + n) time, O(1) extra space. Input: <code>find_median_sorted_arrays(a=[1, 2], b=[3, 4])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["",""]},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>total = len(a) + len(b)</code> &mdash; <code>total = 4</code>","line":2,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["",""]},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["",""]}],"vars":[["total","4",1]],"stack":[]},{"caption":"<code>i = j = 0</code> &mdash; <code>i = 0</code>; <code>j = 0</code>","line":3,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","0",1],["j","0",1]],"stack":[]},{"caption":"<code>prev = cur = 0</code> &mdash; <code>prev = 0</code>; <code>cur = 0</code>","line":4,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","0",0],["j","0",0],["prev","0",1],["cur","0",1]],"stack":[]},{"caption":"<code>for _ in range(total // 2 + 1):</code> &mdash; <code>_ = 0</code>","line":5,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","0",0],["j","0",0],["prev","0",0],["cur","0",0],["_","0",1]],"stack":[]},{"caption":"<code>prev = cur</code>","line":6,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","0",0],["j","0",0],["prev","0",0],["cur","0",0],["_","0",0]],"stack":[]},{"caption":"<code>if j &gt;= len(b) or (i &lt; len(a) and a[i] &lt;= b[j]):</code> &rarr; <strong>true</strong> (i = 0, j = 0)","line":7,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","0",0],["j","0",0],["prev","0",0],["cur","0",0],["_","0",0]],"stack":[]},{"caption":"<code>cur = a[i]; i += 1</code> &mdash; <code>i = 1</code>; <code>cur = 1</code>","line":8,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","1",1],["j","0",0],["prev","0",0],["cur","1",1],["_","0",0]],"stack":[]},{"caption":"<code>for _ in range(total // 2 + 1):</code> &mdash; <code>_ = 1</code>","line":5,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","1",0],["j","0",0],["prev","0",0],["cur","1",0],["_","1",1]],"stack":[]},{"caption":"<code>prev = cur</code> &mdash; <code>prev = 1</code>","line":6,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","1",0],["j","0",0],["prev","1",1],["cur","1",0],["_","1",0]],"stack":[]},{"caption":"<code>if j &gt;= len(b) or (i &lt; len(a) and a[i] &lt;= b[j]):</code> &rarr; <strong>true</strong> (i = 1, j = 0)","line":7,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["","src"],"ptr":{"1":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","1",0],["j","0",0],["prev","1",0],["cur","1",0],["_","1",0]],"stack":[]},{"caption":"<code>cur = a[i]; i += 1</code> &mdash; <code>i = 2</code>; <code>cur = 2</code>","line":8,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["",""],"ptr":{"2":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","2",1],["j","0",0],["prev","1",0],["cur","2",1],["_","1",0]],"stack":[]},{"caption":"<code>for _ in range(total // 2 + 1):</code> &mdash; <code>_ = 2</code>","line":5,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["",""],"ptr":{"2":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","2",0],["j","0",0],["prev","1",0],["cur","2",0],["_","2",1]],"stack":[]},{"caption":"<code>prev = cur</code> &mdash; <code>prev = 2</code>","line":6,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["",""],"ptr":{"2":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","2",0],["j","0",0],["prev","2",1],["cur","2",0],["_","2",0]],"stack":[]},{"caption":"<code>if j &gt;= len(b) or (i &lt; len(a) and a[i] &lt;= b[j]):</code> &rarr; <strong>false</strong> (i = 2, j = 0)","line":7,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["",""],"ptr":{"2":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["src",""],"ptr":{"0":["j"]}}],"vars":[["total","4",0],["i","2",0],["j","0",0],["prev","2",0],["cur","2",0],["_","2",0]],"stack":[]},{"caption":"<code>cur = b[j]; j += 1</code> &mdash; <code>j = 1</code>; <code>cur = 3</code>","line":10,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["",""],"ptr":{"2":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["","src"],"ptr":{"1":["j"]}}],"vars":[["total","4",0],["i","2",0],["j","1",1],["prev","2",0],["cur","3",1],["_","2",0]],"stack":[]},{"caption":"<code>for _ in range(total // 2 + 1):</code>","line":5,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["",""],"ptr":{"2":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["","src"],"ptr":{"1":["j"]}}],"vars":[["total","4",0],["i","2",0],["j","1",0],["prev","2",0],["cur","3",0],["_","2",0]],"stack":[]},{"caption":"<code>return cur if total % 2 else (prev + cur) / 2</code> &mdash; returns <code>2.5</code>. <strong>Result: 2.5</strong>","line":11,"panels":[{"t":"arr","id":"a","label":"a","v":["1","2"],"cls":["",""],"ptr":{"2":["i"]}},{"t":"arr","id":"b","label":"b","v":["3","4"],"cls":["","src"],"ptr":{"1":["j"]}}],"vars":[["total","4",0],["i","2",0],["j","1",0],["prev","2",0],["cur","3",0],["_","2",0]],"stack":[]}]},{"title":"Binary search the partition of the shorter array","code":"def find_median_sorted_arrays(a, b):\n    if len(a) > len(b):\n        a, b = b, a                              # search the shorter one\n    m, n = len(a), len(b)\n    half = (m + n + 1) // 2\n    lo, hi = 0, m\n    INF = float(\"inf\")\n    while True:\n        i = (lo + hi) // 2\n        j = half - i\n        a_left = a[i - 1] if i > 0 else -INF\n        a_right = a[i] if i < m else INF\n        b_left = b[j - 1] if j > 0 else -INF\n        b_right = b[j] if j < n else INF\n        if a_left <= b_right and b_left <= a_right:\n            if (m + n) % 2:\n                return max(a_left, b_left)\n            return (max(a_left, b_left) + min(a_right, b_right)) / 2\n        if a_left > b_right:\n            hi = i - 1                           # took too many from a\n        else:\n            lo = i + 1","frames":[{"caption":"<strong>Binary search the partition of the shorter array</strong> &mdash; O(log min(m, n)) time, O(1) extra space. Input: <code>find_median_sorted_arrays(a=[1, 3], b=[2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["",""]},{"t":"arr","id":"b","label":"b","v":["2"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>if len(a) &gt; len(b):</code> &rarr; <strong>true</strong>","line":2,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3"],"cls":["",""]},{"t":"arr","id":"b","label":"b","v":["2"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>a, b = b, a</code> &mdash; <code>a</code> is now <code>[2]</code>; <code>b</code> is now <code>[1, 3]</code> <em>(search the shorter o