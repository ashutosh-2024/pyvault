{"chapters":[{"title":"Merge fully, pick the middle","code":"def find_median_sorted_arrays(a, b):\n    merged, i, j = [], 0, 0\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]:\n            merged.append(a[i]); i += 1\n        else:\n            merged.append(b[j]); j += 1\n    merged += a[i:] + b[j:]\n    n = len(merged)\n    return merged[n // 2] if n % 2 else (merged[n // 2 - 1] + merged[n // 2]) / 2","frames":[{"caption":"<strong>Merge fully, pick the middle</strong> &mdash; O(m + n) time, O(m + n) extra space. Input: <code>find_median_sorted_arrays(a=[1, 3, 8, 9], b=[2, 5, 7])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3","8","9"],"cls":["","","",""]},{"t":"arr","id":"b","label":"b","v":["2","5","7"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>merged, i, j = [], 0, 0</code> &mdash; <code>merged = []</code>; <code>i = 0</code>; <code>j = 0</code>","line":2,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3","8","9"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"b","label":"b","v":["2","5","7"],"cls":["src","",""],"ptr":{"0":["j"]}},{"t":"arr","id":"merged","label":"merged","v":[],"cls":[],"noidx":true}],"vars":[["i","0",1],["j","0",1]],"stack":[]},{"caption":"<code>while i &lt; len(a) and j &lt; len(b):</code> &rarr; <strong>true</strong> (i = 0, j = 0)","line":3,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3","8","9"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"b","label":"b","v":["2","5","7"],"cls":["src","",""],"ptr":{"0":["j"]}},{"t":"arr","id":"merged","label":"merged","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["j","0",0]],"stack":[]},{"caption":"<code>if a[i] &lt;= b[j]:</code> &rarr; <strong>true</strong> (i = 0, j = 0)","line":4,"panels":[{"t":"arr","id":"a","label":"a","v":["1","3","8","9"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"b","label":"b","v":["2","5","7"],"cls":["src","",""],"