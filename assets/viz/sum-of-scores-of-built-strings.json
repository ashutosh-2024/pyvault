}],"vars":[["s","'azbazbzaz'",0],["total","14",0],["n","9",0],["i","8",0],["k","0",0]],"stack":[]},{"caption":"<code>for i in range(n):</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["a","z","b","a","z","b","z","a","z"],"cls":["src","","","","","","","",""],"ptr":{"0":["k"]}}],"vars":[["s","'azbazbzaz'",0],["total","14",0],["n","9",0],["i","8",0],["k","0",0]],"stack":[]},{"caption":"<code>return total</code> &mdash; returns <code>14</code>. <strong>Result: 14</strong>","line":8,"panels":[{"t":"arr","id":"s","label":"s","v":["a","z","b","a","z","b","z","a","z"],"cls":["src","","","","","","","",""],"ptr":{"0":["k"]}}],"vars":[["s","'azbazbzaz'",0],["total","14",0],["n","9",0],["i","8",0],["k","0",0]],"stack":[]}]},{"title":"Z-function","code":"def sum_scores(s):\n    n = len(s)\n    z, l, r = [0] * n, 0, 0\n    z[0] = n\n    for i in range(1, n):\n        if i < r:\n            z[i] = min(r - i, z[i - l])\n        while i + z[i] < n and s[z[i]] == s[i + z[i]]:\n            z[i] += 1\n        if i + z[i] > r:\n            l, r = i, i + z[i]\n    return sum(z)","frames":[{"caption":"<strong>Z-function</strong> &mdash; O(n) time, O(n) extra space. Input: <code>sum_scores(s='azbazbzaz')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["a","z","b","a","z","b","z","a","z"],"cls":["","","","","","","","",""]}],"vars":[["s","'azbazbzaz'",0]],"stack":[]},{"caption":"<code>n = len(s)</code> &mdash; <code>n = 9</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["a","z","b","a","z","b","z","a","z"],"cls":["","","","","","","","",""]}],"vars":[["s","'azbazbzaz'",0],["n","9",1]],"stack":[]},{"caption":"<code>z, l, r = [0] * n, 0, 0</code> &mdash; <code>z = [0, 0, 0, 0, 0, 0, 0, 0, …]</code>; <code>l = 0</code>; <code>r = 0</code>","line":3,"panels":[{"t":"arr","id":"z","label":"z","v":["0","0","0","0","0","0","0","0","0"],"cls":["src","","","","","","","",""],"ptr":{"0":["l","r"]}}],"v