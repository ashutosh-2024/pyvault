{"chapters":[{"title":"Recursive generation over value ranges, memoised","code":"from functools import cache\n\n\ndef generate_trees(n):\n    @cache\n    def gen(lo, hi):\n        if lo > hi:\n            return [None]\n        out = []\n        for root in range(lo, hi + 1):\n            for left in gen(lo, root - 1):\n                for right in gen(root + 1, hi):\n                    out.append(TreeNode(root, left, right))\n        return out\n\n    return gen(1, n) if n else []","frames":[{"caption":"<strong>Recursive generation over value ranges, memoised</strong> &mdash; O(n &middot; C<sub>n</sub>) time, O(n &middot; C<sub>n</sub>) extra space. Input: <code>generate_trees(n=2)</code>. Step through to watch the code work on this input.","line":4,"panels":[],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>@cache</code>","line":5,"panels":[],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>def gen(lo, hi):</code>","line":6,"panels":[],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>@cache</code>","line":5,"panels":[],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>def gen(lo, hi):</code>","line":6,"panels":[],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>return gen(1, n) if n else []</code> &mdash; calls <code>gen(lo=1, hi=2)</code>","line":16,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["1","2"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["n","2",0],["lo","1",1],["hi","2",1]],"stack":["generate_trees(n=2)","gen(lo=1, hi=2)"]},{"caption":"<code>if lo &gt; hi:</code> &rarr; <strong>false</strong> (hi = 2, lo = 1)","line":7,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["1","2"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["n","2",0],["lo","1",0],["hi","2",0]],"stack":["generate_trees(n=2)","gen(lo=1, hi=2)"]},{"caption":"<code>out = []</code> &mdash; <code>out = []</code>","line":9,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"range:lo","label":"search range","v":[