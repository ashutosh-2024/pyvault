{"chapters":[{"title":"Factors in non-decreasing order, up to √n","code":"def get_factors(n):\n    out, path = [], []\n\n    def dfs(n, start):\n        f = start\n        while f * f <= n:\n            if n % f == 0:\n                out.append(path + [f, n // f])     # stop here: f * (n / f)\n                path.append(f)\n                dfs(n // f, f)                    # or split n / f further\n                path.pop()\n            f += 1\n\n    dfs(n, 2)\n    return out","frames":[{"caption":"<strong>Factors in non-decreasing order, up to √n</strong> &mdash; O(&radic;n &middot; F) time, O(log n) extra space. Input: <code>get_factors(n=12)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","12",0]],"stack":[]},{"caption":"<code>out, path = [], []</code> &mdash; <code>out = []</code>; <code>path = []</code>","line":2,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","12",0]],"stack":[]},{"caption":"<code>def dfs(n, start):</code>","line":4,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","12",0]],"stack":[]},{"caption":"<code>dfs(n, 2)</code> &mdash; calls <code>dfs(n=12, start=2)</code>","line":14,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","12",0],["start","2",1]],"stack":["get_factors(n=12)","dfs(n=12, start=2)"]},{"caption":"<code>f = start</code> &mdash; <code>f = 2</code>","line":5,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","12",0],["start","2",0],["f","2",1]],"stack":["get_factors(n=12)","dfs(n=12, start=2)"]},{"caption":"<code>while f * f &lt;= n:</code> &rarr; <strong>true</strong> (f = 2, n = 12)","line":6,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","12",0],["start","2",0],["f","2",0]],"stack":["get_factors(n=12)","dfs(n=12, start=2)"]},{"caption":"<code>if n % f == 0:</code> &rarr; <strong>true</strong> (f = 2, n = 12)","line":7,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","12",0],["start","2",0],["f","2",0]],"stack":["get_factors(n=12)","dfs(n=12, start=2)"]},{"caption":"<code>out.append(path + [f, n // f])</code> &mdash; <code>out</code> gets <code>[2, 6]</code> appended <em>(stop here: f * (n / f))</em>","line":8,"panels":[{"t":"arr","id":"out","label":"out","v":["2,6"],"cls":["cur"]},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","12",0],["start","2",0],["f","2",0]],"stack":["get_factors(n=12)","dfs(n=12, start=2)"]},{"caption":"<code>path.append(f)</code> &mdash; <code>path</code> gets <code>2</code> appended","line":9,"panels":[{"t":"arr","id":"out","label":"out","v":["2,6"],"cls":[""]},{"t":"arr","id":"path","label":"path","v":["2"],"cls":["cur"]}],"vars":[["n","12",0],["start","2",0],["f","2",0]],"stack":["get_factors(n=12)","dfs(n=12, start=2)"]},{"caption":"<code>dfs(n // f, f)</code> &mdash; calls <code>dfs(n=6, start=2)</code> <em>(or split n / f further)</em>","line":10,"panels":[{"t":"arr","id":"out","label":"out","v":["2,6"],"cls":[""]},{"t":"arr","id":"path","label":"path","v":["2"],"cls":[""]}],"vars":[["n","6",1],["start","2",0],["f","2",0]],"stack":["get_factors(n=12)","dfs(n=12, start=2)","dfs(n=6, start=2)"]},{"caption":"<code>f = start</code>","line":5,"panels":[{"t":"arr","id":"out","label":"out","v":["2,6"],"cls":[""]},{"t":"arr","id":"path","label":"path","v":["2"],"cls":[""]}],"vars":[["n","6",0],["start","2",0],["f","2",0]],"stack":["get_factors(