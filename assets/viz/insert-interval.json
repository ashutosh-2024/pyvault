{"chapters":[{"title":"Append, then Merge Intervals","code":"def insert(intervals, new):\n    merged = []\n    for s, e in sorted(intervals + [new]):\n        if merged and s <= merged[-1][1]:\n            merged[-1][1] = max(merged[-1][1], e)\n        else:\n            merged.append([s, e])\n    return merged","frames":[{"caption":"<strong>Append, then Merge Intervals</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>insert(intervals=[[1, 2], [3, 5], [6, 7], [8, 10], [12, 16]], new=[4, 8])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","","","",""]},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>merged = []</code> &mdash; <code>merged = []</code>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","","","",""]},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"merged","label":"merged","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>for s, e in sorted(intervals + [new]):</code> &mdash; <code>s = 1</code>; <code>e = 2</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","","","",""]},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"merged","label":"merged","v":[],"cls":[],"noidx":true}],"vars":[["s","1",1],["e","2",1]],"stack":[]},{"caption":"<code>if merged and s &lt;= merged[-1][1]:</code> &rarr; <strong>false</strong> (s = 1)","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","","","",""]},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"merged","label":"merged","v":[],"cls":[],"noidx":true}],"vars":[["s","1",0],["e","2",0]],"stack":[]},{"caption"