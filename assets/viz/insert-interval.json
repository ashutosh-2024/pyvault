line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","","","",""]},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"merged","label":"merged","v":["1,2","3,10"],"cls":["",""]}],"vars":[["s","12",0],["e","16",0]],"stack":[]},{"caption":"<code>merged.append([s, e])</code> &mdash; <code>merged</code> gets <code>[12, 16]</code> appended","line":7,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","","","",""]},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"merged","label":"merged","v":["1,2","3,10","12,16"],"cls":["","","cur"]}],"vars":[["s","12",0],["e","16",0]],"stack":[]},{"caption":"<code>for s, e in sorted(intervals + [new]):</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","","","",""]},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"merged","label":"merged","v":["1,2","3,10","12,16"],"cls":["","",""]}],"vars":[["s","12",0],["e","16",0]],"stack":[]},{"caption":"<code>return merged</code> &mdash; returns <code>[[1, 2], [3, 10], [12, 16]]</code>. <strong>Result: [[1, 2], [3, 10], [12, 16]]</strong>","line":8,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","","","",""]},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"merged","label":"merged","v":["1,2","3,10","12,16"],"cls":["","",""]},{"t":"arr","id":"result","label":"result","v":["1,2","3,10","12,16"],"cls":["answer","answer","answer"]}],"vars":[["s","12",0],["e","16",0]],"stack":[]}],"example":1},{"title":"Three-phase linear scan","code":"def insert(intervals, new):\n    out, i, n = [], 0, len(intervals)\n    start, end = new\n    while i < n and intervals[i][1] < start:          # before\n        out.append(intervals[i]); i += 1\n    while i < n and intervals[i][0] <= end:           # overlapping\n        start = min(start, intervals[i][0])\n        end = max(end, intervals[i][1])\n        i += 1\n    out.append([start, end])\n    return out + intervals[i:]                        # after","frames":[{"caption":"<strong>Three-phase linear scan</strong> &mdash; O(n) time, O(n) extra space. Input: <code>insert(intervals=[[1, 2], [3, 5], [6, 7], [8, 10], [12, 16]], new=[4, 8])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","","","",""]},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>out, i, n = [], 0, len(intervals)</code> &mdash; <code>out = []</code>; <code>i = 0</code>; <code>n = 5</code>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["src","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",1],["n","5",1]],"stack":[]},{"caption":"<code>start, end = new</code> &mdash; <code>start = 4</code>; <code>end = 8</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["src","","","","src"],"ptr":{"0":["i"],"4":["start"]}},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["n","5",0],["start","4",1],["end","8",1]],"stack":[]},{"caption":"<code>while i &lt; n and intervals[i][1] &lt; start:</code> &rarr; <strong>true</strong> (i = 0, n = 5, start = 4) <em>(before)</em>","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["src","","","","src"],"ptr":{"0":["i"],"4":["start"]}},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["i","0",0],["n","5",0],["start","4",0],["end","8",0]],"stack":[]},{"caption":"<code>out.append(intervals[i]); i += 1</code> &mdash; <code>out</code> gets <code>[1, 2]</code> appended; <code>i = 1</code>","line":5,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","src","","","src"],"ptr":{"1":["i"],"4":["start"]}},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"out","label":"out","v":["1,2"],"cls":["cur"]}],"vars":[["i","1",1],["n","5",0],["start","4",0],["end","8",0]],"stack":[]},{"caption":"<code>while i &lt; n and intervals[i][1] &lt; start:</code> &rarr; <strong>false</strong> (i = 1, n = 5, start = 4) <em>(before)</em>","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","src","","","src"],"ptr":{"1":["i"],"4":["start"]}},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"out","label":"out","v":["1,2"],"cls":[""]}],"vars":[["i","1",0],["n","5",0],["start","4",0],["end","8",0]],"stack":[]},{"caption":"<code>while i &lt; n and intervals[i][0] &lt;= end:</code> &rarr; <strong>true</strong> (end = 8, i = 1, n = 5) <em>(overlapping)</em>","line":6,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","src","","","src"],"ptr":{"1":["i"],"4":["start"]}},{"t":"arr","id":"new","label":"new","v":["4","8"],"cls":["",""]},{"t":"arr","id":"out","label":"out","v":["1,2"],"cls":[""]}],"vars":[["i","1",0],["n","5",0],["start","4",0],["end","8",0]],"stack":[]},{"caption":"<code>start = min(start, intervals[i][0])</code> &mdash; <code>start = 3</code>","line":7,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["1,2","3,5","6,7","8,10","12,16"],"cls":["","src","","src",""],"ptr":{"1":["i"],"3":["start"]}},{"t":"arr","id":"new