{"chapters":[{"title":"Controlled stack of the left spine","code":"class BSTIterator:\n    def __init__(self, root):\n        self.stack = []\n        self._push_left(root)\n\n    def _push_left(self, node):\n        while node is not None:\n            self.stack.append(node)\n            node = node.left\n\n    def next(self):\n        node = self.stack.pop()\n        self._push_left(node.right)\n        return node.val\n\n    def hasNext(self):\n        return bool(self.stack)","frames":[{"caption":"<strong>Controlled stack of the left spine</strong> &mdash; O(1) amortised per call time, O(h) extra space. Running <code>it = BSTIterator(build([7, 3, 15, None, None, 9, 20])); while it.hasNext():; out.append(it.next())</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4420708112","3",0.0,1.25,"",[]],["n4424045904","7",1.0,0.0,"cur",["root"]],["n4424319664","9",2.0,2.5,"",[]],["n4420708752","15",3.0,1.25,"",[]],["n4424320272","20",4.0,2.5,"",[]]],"edges":[["n4424045904","n4420708112","",""],["n4424045904","n4420708752","",""],["n4420708752","n4424319664","",""],["n4420708752","n4424320272","",""]],"dir":false}],"vars":[["self","'BSTIterator'",0]],"stack":[]},{"caption":"<code>self.stack = []</code> &mdash; <code>self.stack = []</code>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4420708112","3",0.0,1.25,"",[]],["n4424045904","7",1.0,0.0,"cur",["root"]],["n4424319664","9",2.0,2.5,"",[]],["n4420708752","15",3.0,1.25,"",[]],["n4424320272","20",4.0,2.5,"",[]]],"edges":[["n4424045904","n4420708112","",""],["n4424045904","n4420708752","",""],["n4420708752","n4424319664","",""],["n4420708752","n4424320272","",""]],"dir":false},{"t":"arr","id":"self.stack","label":"self.stack","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self._push_left(root)</code> &mdash; calls <code>_push_left(node=(7))</code>","line":4,"panels":[{"t":"net","id":"tree0","labe