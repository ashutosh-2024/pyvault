{"chapters":[{"title":"Postorder gain with a global best","code":"def max_path_sum(root):\n    best = float(\"-inf\")\n\n    def gain(node):\n        nonlocal best\n        if node is None:\n            return 0\n        left = max(gain(node.left), 0)         # a negative arm is not worth taking\n        right = max(gain(node.right), 0)\n        best = max(best, node.val + left + right)   # bend here: the answer\n        return node.val + max(left, right)          # one arm: for the parent\n\n    gain(root)\n    return best","frames":[{"caption":"<strong>Postorder gain with a global best</strong> &mdash; O(n) time, O(h) extra space. Input: <code>max_path_sum(root=tree (-10))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4395165136","9",0.0,1.25,"",[]],["n4395395328","-10",1.0,0.0,"cur",["root"]],["n4395263568","15",2.0,2.5,"",[]],["n4395168016","20",3.0,1.25,"",[]],["n4395262960","7",4.0,2.5,"",[]]],"edges":[["n4395395328","n4395165136","",""],["n4395395328","n4395168016","",""],["n4395168016","n4395263568","",""],["n4395168016","n4395262960","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>best = float(\"-inf\")</code> &mdash; <code>best = -∞</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4395165136","9",0.0,1.25,"",[]],["n4395395328","-10",1.0,0.0,"cur",["root"]],["n4395263568","15",2.0,2.5,"",[]],["n4395168016","20",3.0,1.25,"",[]],["n4395262960","7",4.0,2.5,"",[]]],"edges":[["n4395395328","n4395165136","",""],["n4395395328","n4395168016","",""],["n4395168016","n4395263568","",""],["n4395168016","n4395262960","",""]],"dir":false}],"vars":[["best","-∞",1]],"stack":[]},{"caption":"<code>def gain(node):</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4395165136","9",0.0,1.25,"",[]],["n4395395328","-10",1.0,0.0,"cur",["root"]],["n4395263568","15",2.0,2.5,"",[]],["n4395168016","20",3.0,1.25,"",[]],["n4395262960",