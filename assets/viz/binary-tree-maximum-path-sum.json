16","20",3.0,1.25,"done",[]],["n4395262960","7",4.0,2.5,"done",[]]],"edges":[["n4395395328","n4395165136","",""],["n4395395328","n4395168016","",""],["n4395168016","n4395263568","",""],["n4395168016","n4395262960","",""]],"dir":false}],"vars":[["best","42",0]],"stack":[]}],"example":1},{"title":"Brute force: every node as the bend, recomputed","code":"def max_path_sum(root):\n    def arm(node):\n        if node is None:\n            return 0\n        return node.val + max(0, arm(node.left), arm(node.right))\n\n    best = float(\"-inf\")\n    stack = [root]\n    while stack:\n        node = stack.pop()\n        bend = node.val + max(0, arm(node.left)) + max(0, arm(node.right))\n        best = max(best, bend)\n        stack += [c for c in (node.left, node.right) if c is not None]\n    return best","frames":[{"caption":"<strong>Brute force: every node as the bend, recomputed</strong> &mdash; O(n&sup2;) time, O(h) extra space. Input: <code>max_path_sum(root=tree (-2))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4395160336","-1",0.0,1.25,"",[]],["n4395396672","-2",1.0,0.0,"cur",["root"]]],"edges":[["n4395396672","n4395160336","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>def arm(node):</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4395160336","-1",0.0,1.25,"",[]],["n4395396672","-2",1.0,0.0,"cur",["root"]]],"edges":[["n4395396672","n4395160336","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>best = float(\"-inf\")</code> &mdash; <code>best = -∞</code>","line":7,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4395160336","-1",0.0,1.25,"",[]],["n4395396672","-2",1.0,0.0,"cur",["root"]]],"edges":[["n4395396672","n4395160336","",""]],"dir":false}],"vars":[["best","-∞",1]],"stack":[]},{"caption":"<code>stack = [root]</code> &mdash; <code>stack = [(-2)]</code>","line":8,"panels":[{"t":"net","id":"tree0","label":"tree",