{"chapters":[{"title":"Counting formula","code":"def least_interval(tasks, n):\n    counts = Counter(tasks)\n    most = max(counts.values())\n    tied = sum(1 for c in counts.values() if c == most)\n    return max(len(tasks), (most - 1) * (n + 1) + tied)","frames":[{"caption":"<strong>Counting formula</strong> &mdash; O(n) time, O(1) extra space. Input: <code>least_interval(tasks=['A', 'A', 'A', 'B', 'B', 'B'], n=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>counts = Counter(tasks)</code> &mdash; <code>counts = {'A': 3, 'B': 3}</code>","line":2,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","3"],"cls":["",""],"keys":["A","B"]}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>most = max(counts.values())</code> &mdash; <code>most = 3</code>","line":3,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","3"],"cls":["",""],"keys":["A","B"]}],"vars":[["n","2",0],["most","3",1]],"stack":[]},{"caption":"<code>tied = sum(1 for c in counts.values() if c == most)</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":4,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","3"],"cls":["",""],"keys":["A","B"]}],"vars":[["n","2",0],["most","3",0]],"stack":["least_interval(tasks, n=2)","<genexpr>()"]},{"caption":"<code>tied = sum(1 for c in counts.values() if c == most)</code> &mdash; yields <code>1</code>; <code>c = 3</code>","line":4,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","3"],"cls":["",""],"keys":["A","B"]}],"vars":[["n","2",0],["most","3",0],["c","3",1]],"stack":["least_interval(tasks, n=2)","<genexpr>()"]},{"caption":"<code>tied = sum(1 for c in counts.values() if c == most)</code> &mdash; yields <code>1</code>","line":4,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","3"],"cls":["",""],"keys":["A","B"]}],"vars":[["n","2",0],["most","3",0],["c","3",0]],"stack":["least_interval(tasks, n=2)","<genexpr>()"]},{"caption":"<code>tied = sum(1 for c in counts.values() if c == most)</code> &mdash; yields <code>None</code>","line":4,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","3"],"cls":["",""],"keys":["A","B"]}],"vars":[["n","2",0],["most","3",0],["c","3",0]],"stack":["least_interval(tasks, n=2)","<genexpr>()"]},{"caption":"<code>return max(len(tasks), (most - 1) * (n + 1) + tied)</code> &mdash; returns <code>8</code>; <code>tied = 2</code>. <strong>Result: 8</strong>","line":5,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]},{"t":"arr","id":"counts","label":"counts (Counter)","v":["3","3"],"cls":["",""],"keys":["A","B"]}],"vars":[["n","2",0],["tied","2",1],["most","3",0]],"stack":[]}],"example":1},{"title":"Max-heap with a cooldown queue","code":"def least_interval(tasks, n):\n    heap = [-c for c in Counter(tasks).values()]\n    heapq.heapify(heap)\n\n    time = 0\n    cooling = deque()          # (ready_at, remaining_count)\n    while heap or cooling:\n        time += 1\n        if heap:\n            remaining = heapq.heappop(heap) + 1     # negative counts\n            if remaining:\n                cooling.append((time + n, remaining))\n        if cooling and cooling[0][0] == time:\n            heapq.heappush(heap, cooling.popleft()[1])\n    return time","frames":[{"caption":"<strong>Max-heap with a cooldown queue</strong> &mdash; O(N log 26) = O(N) time, O(1) extra space. Input: <code>least_interval(tasks=['A', 'A', 'A', 'B', 'B', 'B'], n=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>heap = [-c for c in Counter(tasks).values()]</code> &mdash; <code>c = 3</code>","line":2,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]}],"vars":[["n","2",0],["c","3",1]],"stack":[]},{"caption":"<code>heap = [-c for c in Counter(tasks).values()]</code>","line":2,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]}],"vars":[["n","2",0],["c","3",0]],"stack":[]},{"caption":"<code>heap = [-c for c in Counter(tasks).values()]</code> &mdash; <code>heap = [-3, -3]</code>","line":2,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]},{"t":"arr","id":"heap","label":"heap","v":["-3","-3"],"cls":["",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h1","-3",0.0,1.25,"",[]],["h0","-3",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"heap"}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>heapq.heapify(heap)</code>","line":3,"panels":[{"t":"arr","id":"tasks","label":"tasks","v":["A","A","A","B","B","B"],"cls":["","","","","",""]},{"t":"arr","id":"heap","label":"heap","v":["-3","-3"],"cls":["",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h1","-3",0.0,1.25,"",[]],["h0","-3",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"heap"}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>time = 0</code> &mdash; <code>time = 0</code>","line":5