 O(1) extra space. Input: <code>kth_smallest(root=tree (5), k=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4441196880","1",0.0,3.75,"",[]],["n4432636384","2",1.0,2.5,"",[]],["n4432540240","3",2.0,1.25,"",[]],["n4432634560","4",3.0,2.5,"",[]],["n4432761520","5",4.0,0.0,"cur",["root"]],["n4432538000","6",5.0,1.25,"",[]]],"edges":[["n4432761520","n4432540240","",""],["n4432540240","n4432636384","",""],["n4432636384","n4441196880","",""],["n4432540240","n4432634560","",""],["n4432761520","n4432538000","",""]],"dir":false}],"vars":[["k","3",0]],"stack":[]},{"caption":"<code>answer, node = None, root</code> &mdash; <code>answer = None</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4441196880","1",0.0,3.75,"",[]],["n4432636384","2",1.0,2.5,"",[]],["n4432540240","3",2.0,1.25,"",[]],["n4432634560","4",3.0,2.5,"",[]],["n4432761520","5",4.0,0.0,"cur",["root","node"]],["n4432538000","6",5.0,1.25,"",[]]],"edges":[["n4432761520","n4432540240","",""],["n4432540240","n4432636384","",""],["n4432636384","n4441196880","",""],["n4432540240","n4432634560","",""],["n4432761520","n4432538000","",""]],"dir":false}],"vars":[["k","3",0],["answer","None",1]],"stack":[]},{"caption":"<code>while node is not None:</code> &rarr; <strong>true</strong>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4441196880","1",0.0,3.75,"",[]],["n4432636384","2",1.0,2.5,"",[]],["n4432540240","3",2.0,1.25,"",[]],["n4432634560","4",3.0,2.5,"",[]],["n4432761520","5",4.0,0.0,"cur",["root","node"]],["n4432538000","6",5.0,1.25,"",[]]],"edges":[["n4432761520","n4432540240","",""],["n4432540240","n4432636384","",""],["n4432636384","n4441196880","",""],["n4432540240","n4432634560","",""],["n4432761520","n4432538000","",""]],"dir":false}],"vars":[["k","3",0],["answer","None",0]],"stack":[]},{"caption":"<code>if node.left is None:</code> &rarr; <strong>false</strong>","line":4,"pane