{"chapters":[{"title":"Iterative inorder, stop at k","code":"def kth_smallest(root, k):\n    stack, node = [], root\n    while True:\n        while node is not None:\n            stack.append(node)\n            node = node.left\n        node = stack.pop()\n        k -= 1\n        if k == 0:\n            return node.val\n        node = node.right","frames":[{"caption":"<strong>Iterative inorder, stop at k</strong> &mdash; O(h + k) time, O(h) extra space. Input: <code>kth_smallest(root=tree (5), k=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4440236272","1",0.0,3.75,"",[]],["n4432634560","2",1.0,2.5,"",[]],["n4432538000","3",2.0,1.25,"",[]],["n4432635472","4",3.0,2.5,"",[]],["n4432761520","5",4.0,0.0,"cur",["root"]],["n4432540240","6",5.0,1.25,"",[]]],"edges":[["n4432761520","n4432538000","",""],["n4432538000","n4432634560","",""],["n4432634560","n4440236272","",""],["n4432538000","n4432635472","",""],["n4432761520","n4432540240","",""]],"dir":false}],"vars":[["k","3",0]],"stack":[]},{"caption":"<code>stack, node = [], root</code> &mdash; <code>stack = []</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4440236272","1",0.0,3.75,"",[]],["n4432634560","2",1.0,2.5,"",[]],["n4432538000","3",2.0,1.25,"",[]],["n4432635472","4",3.0,2.5,"",[]],["n4432761520","5",4.0,0.0,"cur",["root","node"]],["n4432540240","6",5.0,1.25,"",[]]],"edges":[["n4432761520","n4432538000","",""],["n4432538000","n4432634560","",""],["n4432634560","n4440236272","",""],["n4432538000","n4432635472","",""],["n4432761520","n4432540240","",""]],"dir":false},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["k","3",0]],"stack":[]},{"caption":"<code>while True:</code> &rarr; <strong>true</strong>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4440236272","1",0.0,3.75,"",[]],["n4432634560","2",1.0,2.5,"",[]],["n4432538000","3",2.0,1.25,"",[]