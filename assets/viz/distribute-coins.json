{"chapters":[{"title":"Postorder excess flow","code":"def distribute_coins(root):\n    moves = 0\n\n    def excess(node):\n        nonlocal moves\n        if node is None:\n            return 0\n        left, right = excess(node.left), excess(node.right)\n        moves += abs(left) + abs(right)       # coins crossing the two child edges\n        return node.val + left + right - 1    # what this subtree sends upward\n\n    excess(root)\n    return moves","frames":[{"caption":"<strong>Postorder excess flow</strong> &mdash; O(n) time, O(h) extra space. Input: <code>distribute_coins(root=tree (3))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4428724048","0",0.0,1.25,"",[]],["n4431923248","3",1.0,0.0,"cur",["root"]],["n4428720208","0",2.0,1.25,"",[]]],"edges":[["n4431923248","n4428724048","",""],["n4431923248","n4428720208","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>moves = 0</code> &mdash; <code>moves = 0</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4428724048","0",0.0,1.25,"",[]],["n4431923248","3",1.0,0.0,"cur",["root"]],["n4428720208","0",2.0,1.25,"",[]]],"edges":[["n4431923248","n4428724048","",""],["n4431923248","n4428720208","",""]],"dir":false}],"vars":[["moves","0",1]],"stack":[]},{"caption":"<code>def excess(node):</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4428724048","0",0.0,1.25,"",[]],["n4431923248","3",1.0,0.0,"cur",["root"]],["n4428720208","0",2.0,1.25,"",[]]],"edges":[["n4431923248","n4428724048","",""],["n4431923248","n4428720208","",""]],"dir":false}],"vars":[["moves","0",0]],"stack":[]},{"caption":"<code>excess(root)</code> &mdash; calls <code>excess(node=(3))</code>","line":12,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4428724048","0",0.0,1.25,"",[]],["n4431923248","3",1.0,0.0,"cur",["node"]],["n4428720208","0",2.0,1.25,"",[]]],"edges":[["n4431923248","n4428724048