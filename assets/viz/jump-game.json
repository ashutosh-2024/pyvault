el":"good","v":["T","T","T","T","T"],"cls":["cur","","","",""],"ptr":{"0":["i"]}}],"vars":[["n","5",0],["i","0",0]],"stack":[]},{"caption":"<code>return good[0]</code> &mdash; returns <code>T</code>. <strong>Result: T</strong>","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","3","1","1","4"],"cls":["src","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"good","label":"good","v":["T","T","T","T","T"],"cls":["src","","","",""],"ptr":{"0":["i"]}}],"vars":[["n","5",0],["i","0",0]],"stack":[]}],"example":1},{"title":"Greedy: pull the goal backwards","code":"def can_jump(nums):\n    goal = len(nums) - 1\n    for i in range(len(nums) - 2, -1, -1):\n        if i + nums[i] >= goal:\n            goal = i\n    return goal == 0","frames":[{"caption":"<strong>Greedy: pull the goal backwards</strong> &mdash; O(n) time, O(1) extra space. Input: <code>can_jump(nums=[2, 3, 1, 1, 4])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","3","1","1","4"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>goal = len(nums) - 1</code> &mdash; <code>goal = 4</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","3","1","1","4"],"cls":["","","","",""]}],"vars":[["goal","4",1]],"stack":[]},{"caption":"<code>for i in range(len(nums) - 2, -1, -1):</code> &mdash; <code>i = 3</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","3","1","1","4"],"cls":["","","","src",""],"ptr":{"3":["i"]}}],"vars":[["goal","4",0],["i","3",1]],"stack":[]},{"caption":"<code>if i + nums[i] &gt;= goal:</code> &rarr; <strong>true</strong> (goal = 4, i = 3)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","3","1","1","4"],"cls":["","","","src",""],"ptr":{"3":["i"]}}],"vars":[["goal","4",0],["i","3",0]],"stack":[]},{"caption":"<code>goal = i</code> &mdash; <code>goal = 3</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","3","1","1","4"]