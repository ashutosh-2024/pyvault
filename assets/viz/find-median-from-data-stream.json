{"chapters":[{"title":"Max-heap of the low half, min-heap of the high half","code":"class MedianFinder:\n    def __init__(self):\n        self.small = []      # max-heap (negated): the lower half\n        self.large = []      # min-heap: the upper half\n\n    def add_num(self, num):\n        heapq.heappush(self.small, -num)\n        # hand the largest of the low half up\n        heapq.heappush(self.large, -heapq.heappop(self.small))\n        # keep small the same size or one bigger\n        if len(self.large) > len(self.small):\n            heapq.heappush(self.small, -heapq.heappop(self.large))\n\n    def find_median(self):\n        if len(self.small) > len(self.large):\n            return float(-self.small[0])\n        return (-self.small[0] + self.large[0]) / 2.0","frames":[{"caption":"<strong>Max-heap of the low half, min-heap of the high half</strong> &mdash; O(log n) add, O(1) find time, O(n) extra space. Running <code>mf = MedianFinder(); __ex = ([mf.add_num(x) or mf.find_median() for x in (5, 15, 1, 3)])</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","e","d","i","a","n","F","i","n","d","e","r"],"cls":["","","","","","","","","","","",""]}],"vars":[["self","'MedianFinder'",0]],"stack":[]},{"caption":"<code>self.small = []</code> &mdash; <code>self.small = []</code> <em>(max-heap (negated): the lower half)</em>","line":3,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.large = []</code> &mdash; returns <code>None</code>; <code>self.large = []</code> <em>(min-heap: the upper half)</em>","line":4,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.large","label":"self.large","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>heapq.heappush(self.small, -num)</code> &mdash; <code>self.small</code> gets <code>-5</code> appended; <code>num = 5</code>","line":7,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5"],"cls":["cur"]},{"t":"arr","id":"self.large","label":"self.large","v":[],"cls":[],"noidx":true}],"vars":[["num","5",1]],"stack":[]},{"caption":"<code>heapq.heappush(self.large, -heapq.heappop(self.small))</code> &mdash; <code>-5</code> popped off the end of <code>self.small</code>; <code>self.large</code> gets <code>5</code> appended","line":9,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.large","label":"self.large","v":["5"],"cls":["cur"]}],"vars":[["num","5",0]],"stack":[]},{"caption":"<code>if len(self.large) &gt; len(self.small):</code> &rarr; <strong>true</strong>","line":11,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.large","label":"self.large","v":["5"],"cls":[""]}],"vars":[["num","5",0]],"stack":[]},{"caption":"<code>heapq.heappush(self.small, -heapq.heappop(self.large))</code> &mdash; returns <code>None</code>; <code>self.small</code> gets <code>-5</code> appended; <code>5</code> popped off the end of <code>self.large</code>","line":12,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5"],"cls":["cur"]},{"t":"arr","id":"self.large","label":"self.large","v":[],"cls":[],"noidx":true}],"vars":[["num","5",0]],"stack":[]},{"caption":"<code>if len(self.small) &gt; len(self.large):</code> &rarr; <strong>true</strong>","line":15,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5"],"cls":[""]},{"t":"arr","id":"self.large","label":"self.large","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>return float(-self.small[0])</code> &mdash; returns <code>5</code>","line":16,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5"],"cls":[""]},{"t":"arr","id":"self.large","label":"self.large","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>heapq.heappush(self.small, -num)</code> &mdash; <code>-15</code> pushed on the front of <code>self.small</code>; <code>num = 15</code>","line":7,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-15","-5"],"cls":["cur","cur"]},{"t":"net","id":"heap:self.small","label":"self.small drawn as a tree","nodes":[["h1","-5",0.0,1.25,"cur",[]],["h0","-15",1.0,0.0,"cur",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.small"},{"t":"arr","id":"self.large","label":"self.large","v":[],"cls":[],"noidx":true}],"vars":[["num","15",1]],"stack":[]},{"caption":"<code>heapq.heappush(self.large, -heapq.heappop(self.small))</code> &mdash; <code>-15</code> taken from the front of <code>self.small</code>; <code>self.large</code> gets <code>15</code> appended","line":9,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5"],"cls":["cur"]},{"t":"arr","id":"self.large","label":"self.large","v":["15"],"cls":["cur"]}],"vars":[["num","15",0]],"stack":[]},{"caption":"<code>if len(self.large) &gt; len(self.small):</code> &rarr; <strong>false</strong> &mdash; returns <code>None</code>","line":11,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5"],"cls":[""]},{"t":"arr","id":"self.large","label":"self.large","v":["15"],"cls":[""]}],"vars":[["num","15",0]],"stack":[]},{"caption":"<code>if len(self.small) &gt; len(self.large):</code> &rarr; <strong>false</strong>","line":15,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5"],"cls":[""]},{"t":"arr","id":"self.large","label":"self.large","v":["15"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>return (-self.small[0] + self.large[0]) / 2.0</code> &mdash; returns <code>10</code>","line":17,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5"],"cls":[""]},{"t":"arr","id":"self.large","label":"self.large","v":["15"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>heapq.heappush(self.small, -num)</code> &mdash; <code>self.small</code> gets <code>-1</code> appended; <code>num = 1</code>","line":7,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5","-1"],"cls":["","cur"]},{"t":"net","id":"heap:self.small","label":"self.small drawn as a tree","nodes":[["h1","-1",0.0,1.25,"cur",[]],["h0","-5",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.small"},{"t":"arr","id":"self.large","label":"self.large","v":["15"],"cls":[""]}],"vars":[["num","1",1]],"stack":[]},{"caption":"<code>heapq.heappush(self.large, -heapq.heappop(self.small))</code> &mdash; <code>-5</code> taken from the front of <code>self.small</code>; <code>5</code> pushed on the front of <code>self.large</code>","line":9,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-1"],"cls":["cur"]},{"t":"arr","id":"self.large","label":"self.large","v":["5","15"],"cls":["cur","cur"]},{"t":"net","id":"heap:self.large","label":"self.large drawn as a tree","nodes":[["h1","15",0.0,1.25,"cur",[]],["h0","5",1.0,0.0,"cur",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.large"}],"vars":[["num","1",0]],"stack":[]},{"caption":"<code>if len(self.large) &gt; len(self.small):</code> &rarr; <strong>true</strong>","line":11,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-1"],"cls":[""]},{"t":"arr","id":"self.large","label":"self.large","v":["5","15"],"cls":["",""]},{"t":"net","id":"heap:self.large","label":"self.large drawn as a tree","nodes":[["h1","15",0.0,1.25,"",[]],["h0","5",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.large"}],"vars":[["num","1",0]],"stack":[]},{"caption":"<code>heapq.heappush(self.small, -heapq.heappop(self.large))</code> &mdash; returns <code>None</code>; <code>-5</code> pushed on the front of <code>self.small</code>; <code>5</code> taken from the front of <code>self.large</code>","line":12,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5","-1"],"cls":["cur","cur"]},{"t":"net","id":"heap:self.small","label":"self.small drawn as a tree","nodes":[["h1","-1",0.0,1.25,"cur",[]],["h0","-5",1.0,0.0,"cur",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.small"},{"t":"arr","id":"self.large","label":"self.large","v":["15"],"cls":["cur"]}],"vars":[["num","1",0]],"stack":[]},{"caption":"<code>if len(self.small) &gt; len(self.large):</code> &rarr; <strong>true</strong>","line":15,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5","-1"],"cls":["",""]},{"t":"net","id":"heap:self.small","label":"self.small drawn as a tree","nodes":[["h1","-1",0.0,1.25,"",[]],["h0","-5",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.small"},{"t":"arr","id":"self.large","label":"self.large","v":["15"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>return float(-self.small[0])</code> &mdash; returns <code>5</code>","line":16,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5","-1"],"cls":["",""]},{"t":"net","id":"heap:self.small","label":"self.small drawn as a tree","nodes":[["h1","-1",0.0,1.25,"",[]],["h0","-5",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.small"},{"t":"arr","id":"self.large","label":"self.large","v":["15"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>heapq.heappush(self.small, -num)</code> &mdash; <code>self.small</code> gets <code>-3</code> appended; <code>num = 3</code>","line":7,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-5","-1","-3"],"cls":["","","cur"]},{"t":"net","id":"heap:self.small","label":"self.small drawn as a tree","nodes":[["h1","-1",0.0,1.25,"",[]],["h0","-5",1.0,0.0,"",["top"]],["h2","-3",2.0,1.25,"cur",[]]],"edges":[["h0","h1","",""],["h0","h2","",""]],"dir":false,"mirror":"self.small"},{"t":"arr","id":"self.large","label":"self.large","v":["15"],"cls":[""]}],"vars":[["num","3",1]],"stack":[]},{"caption":"<code>heapq.heappush(self.large, -heapq.heappop(self.small))</code> &mdash; <code>self.small</code> is now <code>[-3, -1]</code>; <code>5</code> pushed on the front of <code>self.large</code>","line":9,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-3","-1"],"cls":["cur",""]},{"t":"net","id":"heap:self.small","label":"self.small drawn as a tree","nodes":[["h1","-1",0.0,1.25,"",[]],["h0","-3",1.0,0.0,"cur",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.small"},{"t":"arr","id":"self.large","label":"self.large","v":["5","15"],"cls":["cur","cur"]},{"t":"net","id":"heap:self.large","label":"self.large drawn as a tree","nodes":[["h1","15",0.0,1.25,"cur",[]],["h0","5",1.0,0.0,"cur",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.large"}],"vars":[["num","3",0]],"stack":[]},{"caption":"<code>if len(self.large) &gt; len(self.small):</code> &rarr; <strong>false</strong> &mdash; returns <code>None</code>","line":11,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-3","-1"],"cls":["",""]},{"t":"net","id":"heap:self.small","label":"self.small drawn as a tree","nodes":[["h1","-1",0.0,1.25,"",[]],["h0","-3",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.small"},{"t":"arr","id":"self.large","label":"self.large","v":["5","15"],"cls":["",""]},{"t":"net","id":"heap:self.large","label":"self.large drawn as a tree","nodes":[["h1","15",0.0,1.25,"",[]],["h0","5",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.large"}],"vars":[["num","3",0]],"stack":[]},{"caption":"<code>if len(self.small) &gt; len(self.large):</code> &rarr; <strong>false</strong>","line":15,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-3","-1"],"cls":["",""]},{"t":"net","id":"heap:self.small","label":"self.small drawn as a tree","nodes":[["h1","-1",0.0,1.25,"",[]],["h0","-3",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.small"},{"t":"arr","id":"self.large","label":"self.large","v":["5","15"],"cls":["",""]},{"t":"net","id":"heap:self.large","label":"self.large drawn as a tree","nodes":[["h1","15",0.0,1.25,"",[]],["h0","5",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.large"}],"vars":[],"stack":[]},{"caption":"<code>return (-self.small[0] + self.large[0]) / 2.0</code> &mdash; returns <code>4</code>. <strong>Result: 4</strong>","line":17,"panels":[{"t":"arr","id":"self.small","label":"self.small","v":["-3","-1"],"cls":["",""]},{"t":"net","id":"heap:self.small","label":"self.small drawn as a tree","nodes":[["h1","-1",0.0,1.25,"",[]],["h0","-3",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.small"},{"t":"arr","id":"self.large","label":"self.large","v":["5","15"],"cls":["",""]},{"t":"net","id":"heap:self.large","label":"self.large drawn as a tree","nodes":[["h1","15",0.0,1.25,"",[]],["h0","5",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"self.large"}],"vars":[],"stack":[]}],"example":1},{"title":"Sorted list with bisect","code":"import bisect\n\n\nclass MedianFinder:\n    def __init__(self):\n        self.data = []\n\n    def add_num(self, num):\n        bisect.insort(self.data, num)\n\n    def find_median(self):\n        n = len(self.data)\n        mid = n // 2\n        if n % 2:\n            return float(self.data[mid])\n        return (self.data[mid - 1] + self.data[mid]) / 2.0","frames":[{"caption":"<strong>Sorted list with bisect</strong> &mdash; O(n) add, O(1) find time, O(n) extra space. Running <code>mf = MedianFinder(); __ex = ([mf.add_num(x) or mf.find_median() for x in (5, 15, 1, 3)])</code>. Step through to watch the code work on this input.","line":5,"panels":[{"t":"arr","id":"self","label":"self","v":["M","e","d","i","a","n","F","i","n","d","e","r"],"cls":["","","","","","","","","","","",""]}],"vars":[["self","'MedianFinder'",0]],"stack":[]},{"caption":"<code>self.data = []</code> &mdash; returns <code>None</code>; <code>self.data = []</code>","line":6,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>bisect.insort(self.data, num)</code> &mdash; returns <code>None</code>; <code>self.data</code> gets <code>5</code> appended; <code>num = 5</code>","line":9,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["5"],"cls":["cur"]}],"vars":[["num","5",1]],"stack":[]},{"caption":"<code>n = len(self.data)</code> &mdash; <code>n = 1</code>","line":12,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["5"],"cls":[""]}],"vars":[["n","1",1]],"stack":[]},{"caption":"<code>mid = n // 2</code> &mdash; <code>mid = 0</code>","line":13,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["5"],"cls":["src"],"ptr":{"0":["mid"]}}],"vars":[["n","1",0],["mid","0",1]],"stack":[]},{"caption":"<code>if n % 2:</code> &rarr; <strong>true</strong> (n = 1)","line":14,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["5"],"cls":["src"],"ptr":{"0":["mid"]}}],"vars":[["n","1",0],["mid","0",0]],"stack":[]},{"caption":"<code>return float(self.data[mid])</code> &mdash; returns <code>5</code>","line":15,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["5"],"cls":["src"],"ptr":{"0":["mid"]}}],"vars":[["n","1",0],["mid","0",0]],"stack":[]},{"caption":"<code>bisect.insort(self.data, num)</code> &mdash; returns <code>None</code>; <code>self.data</code> gets <code>15</code> appended; <code>num = 15</code>","line":9,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["5","15"],"cls":["","cur"]}],"vars":[["num","15",1]],"stack":[]},{"caption":"<code>n = len(self.data)</code> &mdash; <code>n = 2</code>","line":12,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["5","15"],"cls":["",""]}],"vars":[["n","2",1]],"stack":[]},{"caption":"<code>mid = n // 2</code> &mdash; <code>mid = 1</code>","line":13,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["5","15"],"cls":["","src"],"ptr":{"1":["mid"]}}],"vars":[["n","2",0],["mid","1",1]],"stack":[]},{"caption":"<code>if n % 2:</code> &rarr; <strong>false</strong> (n = 2)","line":14,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["5","15"],"cls":["","src"],"ptr":{"1":["mid"]}}],"vars":[["n","2",0],["mid","1",0]],"stack":[]},{"caption":"<code>return (self.data[mid - 1] + self.data[mid]) / 2.0</code> &mdash; returns <code>10</code>","line":16,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["5","15"],"cls":["","src"],"ptr":{"1":["mid"]}}],"vars":[["n","2",0],["mid","1",0]],"stack":[]},{"caption":"<code>bisect.insort(self.data, num)</code> &mdash; returns <code>None</code>; <code>1</code> pushed on the front of <code>self.data</code>; <code>num = 1</code>","line":9,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["1","5","15"],"cls":["cur","cur","cur"]}],"vars":[["num","1",1]],"stack":[]},{"caption":"<code>n = len(self.data)</code> &mdash; <code>n = 3</code>","line":12,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["1","5","15"],"cls":["","",""]}],"vars":[["n","3",1]],"stack":[]},{"caption":"<code>mid = n // 2</code> &mdash; <code>mid = 1</code>","line":13,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["1","5","15"],"cls":["","src",""],"ptr":{"1":["mid"]}}],"vars":[["n","3",0],["mid","1",1]],"stack":[]},{"caption":"<code>if n % 2:</code> &rarr; <strong>true</strong> (n = 3)","line":14,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["1","5","15"],"cls":["","src",""],"ptr":{"1":["mid"]}}],"vars":[["n","3",0],["mid","1",0]],"stack":[]},{"caption":"<code>return float(self.data[mid])</code> &mdash; returns <code>5</code>","line":15,"panels":[{"t":"arr","id":"self.data","label":"self.data","v":["1","5","15"],"cls":["","src",""],"ptr":{"1":["mid"]}}],"vars":[["n","3",0],["mid","1",0]],"stack":[]},{"caption":"<code>bisect.insort(self.data, num)</code> &mdash; returns <code>None</code>; <code>self.data</code> is now <code>[1, 3, 5, 15]</code>; <code>num = 3</code>","line":9,"panels":[{"t":"arr","id":"self.data","label":