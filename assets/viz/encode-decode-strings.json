{"chapters":[{"title":"Escape the delimiter","code":"def encode(strs):\n    return \"\".join(s.replace(\"/\", \"//\") + \"/:\" for s in strs)\n\ndef decode(s):\n    out, cur, i = [], [], 0\n    while i < len(s):\n        if s[i] == \"/\":\n            if s[i + 1] == \"/\":\n                cur.append(\"/\")\n            else:                               # \"/:\" ends a string\n                out.append(\"\".join(cur))\n                cur = []\n            i += 2\n        else:\n            cur.append(s[i])\n            i += 1\n    return out","frames":[{"caption":"<strong>Escape the delimiter</strong> &mdash; O(n) time, O(n) extra space. Input: <code>decode(s='4#ab/:/://:x/:')</code>. Step through to watch the code work on this input.","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["4","#","a","b","/",":","/",":","/","/",":","x","/",":"],"cls":["","","","","","","","","","","","","",""]}],"vars":[["s","'4#ab/:/://:x/:'",0]],"stack":[]},{"caption":"<code>out, cur, i = [], [], 0</code> &mdash; <code>out = []</code>; <code>cur = []</code>; <code>i = 0</code>","line":5,"panels":[{"t":"arr","id":"s","label":"s","v":["4","#","a","b","/",":","/",":","/","/",":","x","/",":"],"cls":["src","","","","","","","","","","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"cur","label":"cur","v":[],"cls":[],"noidx":true}],"vars":[["s","'4#ab/:/://:x/:'",0],["i","0",1]],"stack":[]},{"caption":"<code>while i &lt; len(s):</code> &rarr; <strong>true</strong> (i = 0, s = '4#ab/:/://:x/:')","line":6,"panels":[{"t":"arr","id":"s","label":"s","v":["4","#","a","b","/",":","/",":","/","/",":","x","/",":"],"cls":["src","","","","","","","","","","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"cur","label":"cur","v":[],"cls":[],"noidx":true}],"vars":[["s","'4#ab/:/://:x/:'",0],["i","0",0]],"stack":[]},{"caption":"<code>if s[i] == \"/\":</code> &rarr; <s