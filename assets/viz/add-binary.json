{"chapters":[{"title":"Convert to integers","code":"def add_binary(a, b):\n    return bin(int(a, 2) + int(b, 2))[2:]","frames":[{"caption":"<strong>Convert to integers</strong> &mdash; O(n + m) time, O(n + m) extra space. Input: <code>add_binary(a='11', b='1')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"a","label":"a","v":["1","1"],"cls":["",""]}],"vars":[["a","'11'",0],["b","'1'",0]],"stack":[]},{"caption":"<code>return bin(int(a, 2) + int(b, 2))[2:]</code> &mdash; returns <code>'100'</code>. <strong>Result: '100'</strong>","line":2,"panels":[{"t":"arr","id":"a","label":"a","v":["1","1"],"cls":["",""]}],"vars":[["a","'11'",0],["b","'1'",0]],"stack":[]}]},{"title":"Digit by digit with a carry","code":"def add_binary(a, b):\n    i, j, carry, out = len(a) - 1, len(b) - 1, 0, []\n    while i >= 0 or j >= 0 or carry:\n        total = carry\n        if i >= 0:\n            total += int(a[i]); i -= 1\n        if j >= 0:\n            total += int(b[j]); j -= 1\n        out.append(str(total % 2))\n        carry = total // 2\n    return \"\".join(reversed(out))","frames":[{"caption":"<strong>Digit by digit with a carry</strong> &mdash; O(max(n, m)) time, O(max(n, m)) extra space. Input: <code>add_binary(a='1010', b='1011')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"a","label":"a","v":["1","0","1","0"],"cls":["","","",""]},{"t":"arr","id":"b","label":"b","v":["1","0","1","1"],"cls":["","","",""]}],"vars":[["a","'1010'",0],["b","'1011'",0]],"stack":[]},{"caption":"<code>i, j, carry, out = len(a) - 1, len(b) - 1, 0, []</code> &mdash; <code>i = 3</code>; <code>j = 3</code>; <code>carry = 0</code>; <code>out = []</code>","line":2,"panels":[{"t":"arr","id":"a","label":"a","v":["1","0","1","0"],"cls":["","","","src"],"ptr":{"3":["i"]}},{"t":"arr","id":"b","label":"b","v":["1","0","1","1"],"cls":["","","","src"],"ptr":{"3":["j"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":