{"chapters":[{"title":"Walk and insert, gcd by trial division","code":"def insert_greatest_common_divisors(head):\n    def gcd(a, b):\n        for d in range(min(a, b), 0, -1):\n            if a % d == 0 and b % d == 0:\n                return d\n\n    node = head\n    while node and node.next:\n        node.next = ListNode(gcd(node.val, node.next.val), node.next)\n        node = node.next.next\n    return head","frames":[{"caption":"<strong>Walk and insert, gcd by trial division</strong> &mdash; O(n &middot; min(a, b)) time, O(1) extra space. Input: <code>insert_greatest_common_divisors(head=list (18))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4406777552","18",0.0,0.0,"cur",["head"]],["n4406777872","6",1.7,0.0,"",[]],["n4391969776","10",3.4,0.0,"",[]],["n4391971296","3",5.1,0.0,"",[]]],"edges":[["n4406777552","n4406777872","",""],["n4406777872","n4391969776","",""],["n4391969776","n4391971296","",""]],"dir":true}],"vars":[],"stack":[]},{"caption":"<code>def gcd(a, b):</code>","line":2,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4406777552","18",0.0,0.0,"cur",["head"]],["n4406777872","6",1.7,0.0,"",[]],["n4391969776","10",3.4,0.0,"",[]],["n4391971296","3",5.1,0.0,"",[]]],"edges":[["n4406777552","n4406777872","",""],["n4406777872","n4391969776","",""],["n4391969776","n4391971296","",""]],"dir":true}],"vars":[],"stack":[]},{"caption":"<code>node = head</code>","line":7,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4406777552","18",0.0,0.0,"cur",["head","node"]],["n4406777872","6",1.7,0.0,"",[]],["n4391969776","10",3.4,0.0,"",[]],["n4391971296","3",5.1,0.0,"",[]]],"edges":[["n4406777552","n4406777872","",""],["n4406777872","n4391969776","",""],["n4391969776","n4391971296","",""]],"dir":true}],"vars":[],"stack":[]},{"caption":"<code>while node and node.next:</code> &rarr; <strong>true</strong>","line":8,"panels":[{"t":"net","id":"list