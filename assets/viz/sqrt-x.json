{"chapters":[{"title":"Count up","code":"def my_sqrt(x):\n    k = 0\n    while (k + 1) * (k + 1) <= x:\n        k += 1\n    return k","frames":[{"caption":"<strong>Count up</strong> &mdash; O(&radic;x) time, O(1) extra space. Input: <code>my_sqrt(x=30)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","30",0]],"stack":[]},{"caption":"<code>k = 0</code> &mdash; <code>k = 0</code>","line":2,"panels":[],"vars":[["x","30",0],["k","0",1]],"stack":[]},{"caption":"<code>while (k + 1) * (k + 1) &lt;= x:</code> &rarr; <strong>true</strong> (k = 0, x = 30)","line":3,"panels":[],"vars":[["x","30",0],["k","0",0]],"stack":[]},{"caption":"<code>k += 1</code> &mdash; <code>k = 1</code>","line":4,"panels":[],"vars":[["x","30",0],["k","1",1]],"stack":[]},{"caption":"<code>while (k + 1) * (k + 1) &lt;= x:</code> &rarr; <strong>true</strong> (k = 1, x = 30)","line":3,"panels":[],"vars":[["x","30",0],["k","1",0]],"stack":[]},{"caption":"<code>k += 1</code> &mdash; <code>k = 2</code>","line":4,"panels":[],"vars":[["x","30",0],["k","2",1]],"stack":[]},{"caption":"<code>while (k + 1) * (k + 1) &lt;= x:</code> &rarr; <strong>true</strong> (k = 2, x = 30)","line":3,"panels":[],"vars":[["x","30",0],["k","2",0]],"stack":[]},{"caption":"<code>k += 1</code> &mdash; <code>k = 3</code>","line":4,"panels":[],"vars":[["x","30",0],["k","3",1]],"stack":[]},{"caption":"<code>while (k + 1) * (k + 1) &lt;= x:</code> &rarr; <strong>true</strong> (k = 3, x = 30)","line":3,"panels":[],"vars":[["x","30",0],["k","3",0]],"stack":[]},{"caption":"<code>k += 1</code> &mdash; <code>k = 4</code>","line":4,"panels":[],"vars":[["x","30",0],["k","4",1]],"stack":[]},{"caption":"<code>while (k + 1) * (k + 1) &lt;= x:</code> &rarr; <strong>true</strong> (k = 4, x = 30)","line":3,"panels":[],"vars":[["x","30",0],["k","4",0]],"stack":[]},{"caption":"<code>k += 1</code> &mdash; <code>k = 5</code>","line":4,"panels":[],"vars":[["x","30",0],["k","5",1]],"stack":[]},{"caption":"<code>while (k + 1) * (k + 1) &lt;= x:</code> &rarr; <strong>false</strong> (k = 5, x = 30)","line":3,"panels":[],"vars":[["x","30",0],["k","5",0]],"stack":[]},{"caption":"<code>return k</code> &mdash; returns <code>5</code>. <strong>Result: 5</strong>","line":5,"panels":[],"vars":[["x","30",0],["k","5",0]],"stack":[]}],"example":1},{"title":"Binary search on the answer","code":"def my_sqrt(x):\n    lo, hi = 0, x\n    while lo < hi:\n        mid = (lo + hi + 1) // 2               # upper mid: avoids an infinite loop\n        if mid * mid <= x:\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo","frames":[{"caption":"<strong>Binary search on the answer</strong> &mdash; O(log x) time, O(1) extra space. Input: <code>my_sqrt(x=30)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","30",0]],"stack":[]},{"caption":"<code>lo, hi = 0, x</code> &mdash; <code>lo = 0</code>; <code>hi = 30</code>","line":2,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","30"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["x","30",0],["lo","0",1],["hi","30",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 30, lo = 0)","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","30"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["x","30",0],["lo","0",0],["hi","30",0]],"stack":[]},{"caption":"<code>mid = (lo + hi + 1) // 2</code> &mdash; <code>mid = 15</code> <em>(upper mid: avoids an infinite loop)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","15","30"],"cls":["","cur","cur"],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","0",0],["hi","30",0],["mid","15",1]],"stack":[]},{"caption":"<code>if mid * mid &lt;= x:</code> &rarr; <strong>false</strong> (mid = 15, x = 30)","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","15","30"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","0",0],["hi","30",0],["mid","15",0]],"stack":[]},{"caption":"<code>hi = mid - 1</code> &mdash; <code>hi = 14</code>","line":8,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","15","14"],"cls":["","","cur"],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","0",0],["hi","14",1],["mid","15",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 14, lo = 0)","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","15","14"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","0",0],["hi","14",0],["mid","15",0]],"stack":[]},{"caption":"<code>mid = (lo + hi + 1) // 2</code> &mdash; <code>mid = 7</code> <em>(upper mid: avoids an infinite loop)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","7","14"],"cls":["","cur",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","0",0],["hi","14",0],["mid","7",1]],"stack":[]},{"caption":"<code>if mid * mid &lt;= x:</code> &rarr; <strong>false</strong> (mid = 7, x = 30)","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","7","14"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","0",0],["hi","14",0],["mid","7",0]],"stack":[]},{"caption":"<code>hi = mid - 1</code> &mdash; <code>hi = 6</code>","line":8,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","7","6"],"cls":["","","cur"],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","0",0],["hi","6",1],["mid","7",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 0)","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","7","6"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","0",0],["hi","6",0],["mid","7",0]],"stack":[]},{"caption":"<code>mid = (lo + hi + 1) // 2</code> &mdash; <code>mid = 3</code> <em>(upper mid: avoids an infinite loop)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","3","6"],"cls":["","cur",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","0",0],["hi","6",0],["mid","3",1]],"stack":[]},{"caption":"<code>if mid * mid &lt;= x:</code> &rarr; <strong>true</strong> (mid = 3, x = 30)","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","3","6"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","0",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>lo = mid</code> &mdash; <code>lo = 3</code>","line":6,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["3","3","6"],"cls":["cur","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","3",1],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 3)","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["3","3","6"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","3",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>mid = (lo + hi + 1) // 2</code> &mdash; <code>mid = 5</code> <em>(upper mid: avoids an infinite loop)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["3","5","6"],"cls":["","cur",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","3",0],["hi","6",0],["mid","5",1]],"stack":[]},{"caption":"<code>if mid * mid &lt;= x:</code> &rarr; <strong>true</strong> (mid = 5, x = 30)","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["3","5","6"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","3",0],["hi","6",0],["mid","5",0]],"stack":[]},{"caption":"<code>lo = mid</code> &mdash; <code>lo = 5</code>","line":6,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["5","5","6"],"cls":["cur","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","5",1],["hi","6",0],["mid","5",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 5)","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["5","5","6"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","5",0],["hi","6",0],["mid","5",0]],"stack":[]},{"caption":"<code>mid = (lo + hi + 1) // 2</code> &mdash; <code>mid = 6</code> <em>(upper mid: avoids an infinite loop)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["5","6","6"],"cls":["","cur",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","5",0],["hi","6",0],["mid","6",1]],"stack":[]},{"caption":"<code>if mid * mid &lt;= x:</code> &rarr; <strong>false</strong> (mid = 6, x = 30)","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["5","6","6"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","5",0],["hi","6",0],["mid","6",0]],"stack":[]},{"caption":"<code>hi = mid - 1</code> &mdash; <code>hi = 5</code>","line":8,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["5","6","5"],"cls":["","","cur"],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","5",0],["hi","5",1],["mid","6",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>false</strong> (hi = 5, lo = 5)","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["5","6","5"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","5",0],["hi","5",0],["mid","6",0]],"stack":[]},{"caption":"<code>return lo</code> &mdash; returns <code>5</code>. <strong>Result: 5</strong>","line":9,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["5","6","5"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","30",0],["lo","5",0],["hi","5",0],["mid","6",0]],"stack":[]}],"example":1},{"title":"Newton's method on integers","code":"def my_sqrt(x):\n    if x < 2:\n        return x\n    k = x\n    while k * k > x:\n        k = (k + x // k) // 2\n    return k","frames":[{"caption":"<strong>Newton's method on integers</strong> &mdash; O(log log x) iterations time, O(1) extra space. Input: <code>my_sqrt(x=30)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","30",0]],"stack":[]},{"caption":"<code>if x &lt; 2:</code> &rarr; <strong>false</strong> (x = 30)","line":2,"panels":[],"vars":[["x","30",0]],"stack":[]},{"caption":"<code>k = x</code> &mdash; <code>k = 30</code>","line":4,"panels":[],"vars":[["x","30",0],["k","30",1]],"stack":[]},{"caption":"<code>while k * k &gt; x:</code> &rarr; <strong>true</strong> (k = 30, x = 30)","line":5,"panels":[],"vars":[["x","30",0],["k","30",0]],"stack":[]},{"caption":"<code>k = (k + x // k) // 2</code> &mdash; <code>k = 15</code>","line":6,"panels":[],"vars":[["x","30",0],["k","15",1]],"stack":[]},{"caption":"<code>while k * k &gt; x:</code> &rarr; <strong>true</strong> (k = 15, x = 30)","line":5,"panels":[],"vars":[["x","30",0],["k","15",0]],"stack":[]},{"caption":"<code>k = (k + x // k) // 2</code> &mdash; <code>k = 8</code>","line":6,"panels":[],"vars":[["x","30",0],["k","8",1]],"stack":[]},{"caption":"<code>while k * k &gt; x:</code> &rarr; <strong>true</strong> (k = 8, x = 30)","line":5,"panels":[],"vars":[["x","30",0],["k","8",0]],"stack":[]},{"caption":"<code>k = (k + x // k) // 2</code> &mdash; <code>k = 5</code>","line":6,"panels":[],"vars":[["x","30",0],["k","5",1]],"stack":[]},{"caption":"<code>while k * k &gt; x:</code> &rarr; <strong>false</strong> (k = 5, x = 30)","line":5,"panels":[],"vars":[["x","30",0],["k","5",0]],"stack":[]},{"caption":"<code>return k</code> &mdash; returns <code>5</code>. <strong>Result: 5</strong>","line":7,"panels":[],"vars":[["x","30",0],["k","5",0]],"stack":[]}],"example":1}]}