{"chapters":[{"title":"Count up","code":"def my_sqrt(x):\n    k = 0\n    while (k + 1) * (k + 1) <= x:\n        k += 1\n    return k","frames":[{"caption":"<strong>Count up</strong> &mdash; O(&radic;x) time, O(1) extra space. Input: <code>my_sqrt(x=4)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","4",0]],"stack":[]},{"caption":"<code>k = 0</code> &mdash; <code>k = 0</code>","line":2,"panels":[],"vars":[["x","4",0],["k","0",1]],"stack":[]},{"caption":"<code>while (k + 1) * (k + 1) &lt;= x:</code> &rarr; <strong>true</strong> (k = 0, x = 4)","line":3,"panels":[],"vars":[["x","4",0],["k","0",0]],"stack":[]},{"caption":"<code>k += 1</code> &mdash; <code>k = 1</code>","line":4,"panels":[],"vars":[["x","4",0],["k","1",1]],"stack":[]},{"caption":"<code>while (k + 1) * (k + 1) &lt;= x:</code> &rarr; <strong>true</strong> (k = 1, x = 4)","line":3,"panels":[],"vars":[["x","4",0],["k","1",0]],"stack":[]},{"caption":"<code>k += 1</code> &mdash; <code>k = 2</code>","line":4,"panels":[],"vars":[["x","4",0],["k","2",1]],"stack":[]},{"caption":"<code>while (k + 1) * (k + 1) &lt;= x:</code> &rarr; <strong>false</strong> (k = 2, x = 4)","line":3,"panels":[],"vars":[["x","4",0],["k","2",0]],"stack":[]},{"caption":"<code>return k</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":5,"panels":[],"vars":[["x","4",0],["k","2",0]],"stack":[]}]},{"title":"Binary search on the answer","code":"def my_sqrt(x):\n    lo, hi = 0, x\n    while lo < hi:\n        mid = (lo + hi + 1) // 2               # upper mid: avoids an infinite loop\n        if mid * mid <= x:\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo","frames":[{"caption":"<strong>Binary search on the answer</strong> &mdash; O(log x) time, O(1) extra space. Input: <code>my_sqrt(x=8)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","8",0]],"stack":[]},{"caption":"<code>lo, hi = 0, x</code> &mdash; <code>lo = 0</code>; <code>hi = 8</code>","line":2,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","8"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["x","8",0],["lo","0",1],["hi","8",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 8, lo = 0)","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","8"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["x","8",0],["lo","0",0],["hi","8",0]],"stack":[]},{"caption":"<code>mid = (lo + hi + 1) // 2</code> &mdash; <code>mid = 4</code> <em>(upper mid: avoids an infinite loop)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","4","8"],"cls":["","cur","cur"],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","0",0],["hi","8",0],["mid","4",1]],"stack":[]},{"caption":"<code>if mid * mid &lt;= x:</code> &rarr; <strong>false</strong> (mid = 4, x = 8)","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","4","8"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","0",0],["hi","8",0],["mid","4",0]],"stack":[]},{"caption":"<code>hi = mid - 1</code> &mdash; <code>hi = 3</code>","line":8,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","4","3"],"cls":["","","cur"],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","0",0],["hi","3",1],["mid","4",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 3, lo = 0)","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","4","3"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","0",0],["hi","3",0],["mid","4",0]],"stack":[]},{"caption":"<code>mid = (lo + hi + 1) // 2</code> &mdash; <code>mid = 2</code> <em>(upper mid: avoids an infinite loop)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","2","3"],"cls":["","cur",""],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","0",0],["hi","3",0],["mid","2",1]],"stack":[]},{"caption":"<code>if mid * mid &lt;= x:</code> &rarr; <strong>true</strong> (mid = 2, x = 8)","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","2","3"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","0",0],["hi","3",0],["mid","2",0]],"stack":[]},{"caption":"<code>lo = mid</code> &mdash; <code>lo = 2</code>","line":6,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["2","2","3"],"cls":["cur","",""],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","2",1],["hi","3",0],["mid","2",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 3, lo = 2)","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["2","2","3"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","2",0],["hi","3",0],["mid","2",0]],"stack":[]},{"caption":"<code>mid = (lo + hi + 1) // 2</code> &mdash; <code>mid = 3</code> <em>(upper mid: avoids an infinite loop)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["2","3","3"],"cls":["","cur",""],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","2",0],["hi","3",0],["mid","3",1]],"stack":[]},{"caption":"<code>if mid * mid &lt;= x:</code> &rarr; <strong>false</strong> (mid = 3, x = 8)","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["2","3","3"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","2",0],["hi","3",0],["mid","3",0]],"stack":[]},{"caption":"<code>hi = mid - 1</code> &mdash; <code>hi = 2</code>","line":8,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["2","3","2"],"cls":["","","cur"],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","2",0],["hi","2",1],["mid","3",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>false</strong> (hi = 2, lo = 2)","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["2","3","2"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","2",0],["hi","2",0],["mid","3",0]],"stack":[]},{"caption":"<code>return lo</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":9,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["2","3","2"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["x","8",0],["lo","2",0],["hi","2",0],["mid","3",0]],"stack":[]}]},{"title":"Newton's method on integers","code":"def my_sqrt(x):\n    if x < 2:\n        return x\n    k = x\n    while k * k > x:\n        k = (k + x // k) // 2\n    return k","frames":[{"caption":"<strong>Newton's method on integers</strong> &mdash; O(log log x) iterations time, O(1) extra space. Input: <code>my_sqrt(x=8)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["x","8",0]],"stack":[]},{"caption":"<code>if x &lt; 2:</code> &rarr; <strong>false</strong> (x = 8)","line":2,"panels":[],"vars":[["x","8",0]],"stack":[]},{"caption":"<code>k = x</code> &mdash; <code>k = 8</code>","line":4,"panels":[],"vars":[["x","8",0],["k","8",1]],"stack":[]},{"caption":"<code>while k * k &gt; x:</code> &rarr; <strong>true</strong> (k = 8, x = 8)","line":5,"panels":[],"vars":[["x","8",0],["k","8",0]],"stack":[]},{"caption":"<code>k = (k + x // k) // 2</code> &mdash; <code>k = 4</code>","line":6,"panels":[],"vars":[["x","8",0],["k","4",1]],"stack":[]},{"caption":"<code>while k * k &gt; x:</code> &rarr; <strong>true</strong> (k = 4, x = 8)","line":5,"panels":[],"vars":[["x","8",0],["k","4",0]],"stack":[]},{"caption":"<code>k = (k + x // k) // 2</code> &mdash; <code>k = 3</code>","line":6,"panels":[],"vars":[["x","8",0],["k","3",1]],"stack":[]},{"caption":"<code>while k * k &gt; x:</code> &rarr; <strong>true</strong> (k = 3, x = 8)","line":5,"panels":[],"vars":[["x","8",0],["k","3",0]],"stack":[]},{"caption":"<code>k = (k + x // k) // 2</code> &mdash; <code>k = 2</code>","line":6,"panels":[],"vars":[["x","8",0],["k","2",1]],"stack":[]},{"caption":"<code>while k * k &gt; x:</code> &rarr; <strong>false</strong> (k = 2, x = 8)","line":5,"panels":[],"vars":[["x","8",0],["k","2",0]],"stack":[]},{"caption":"<code>return k</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":7,"panels":[],"vars":[["x","8",0],["k","2",0]],"stack":[]}]}]}