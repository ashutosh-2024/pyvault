{"chapters":[{"title":"Count, then max-heap","code":"def frequency_sort(s):\n    counts = Counter(s)\n    heap = [(-freq, ch) for ch, freq in counts.items()]\n    heapq.heapify(heap)\n\n    out = []\n    while heap:\n        freq, ch = heapq.heappop(heap)\n        out.append(ch * -freq)\n    return \"\".join(out)","frames":[{"caption":"<strong>Count, then max-heap</strong> &mdash; O(n + d log d) time, O(n) extra space. Input: <code>frequency_sort(s='mississippi')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["m","i","s","s","i","s","s","i","p","p","i"],"cls":["","","","","","","","","","",""]}],"vars":[["s","'mississippi'",0]],"stack":[]},{"caption":"<code>counts = Counter(s)</code> &mdash; <code>counts = {'m': 1, 'i': 4, 's': 4, 'p': 2}</code>","line":2,"panels":[{"t":"arr","id":"counts","label":"counts (Counter)","v":["1","4","4","2"],"cls":["","","",""],"keys":["m","i","s","p"]}],"vars":[["s","'mississippi'",0]],"stack":[]},{"caption":"<code>heap = [(-freq, ch) for ch, freq in counts.items()]</code> &mdash; <code>ch = 'm'</code>; <code>freq = 1</code>","line":3,"panels":[{"t":"arr","id":"counts","label":"counts (Counter)","v":["1","4","4","2"],"cls":["","","",""],"keys":["m","i","s","p"]}],"vars":[["s","'mississippi'",0],["ch","'m'",1],["freq","1",1]],"stack":[]},{"caption":"<code>heap = [(-freq, ch) for ch, freq in counts.items()]</code> &mdash; <code>ch = 'i'</code>; <code>freq = 4</code>","line":3,"panels":[{"t":"arr","id":"counts","label":"counts (Counter)","v":["1","4","4","2"],"cls":["","","",""],"keys":["m","i","s","p"]}],"vars":[["s","'mississippi'",0],["ch","'i'",1],["freq","4",1]],"stack":[]},{"caption":"<code>heap = [(-freq, ch) for ch, freq in counts.items()]</code> &mdash; <code>ch = 's'</code>","line":3,"panels":[{"t":"arr","id":"counts","label":"counts (Counter)","v":["1","4","4","2"],"cls":["","","",""],"keys":["m","i","s","p"]}],"vars":[["s","'mississippi'",0],["ch","'s'",1],["