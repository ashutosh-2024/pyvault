{"chapters":[{"title":"Count, then max-heap","code":"def frequency_sort(s):\n    counts = Counter(s)\n    heap = [(-freq, ch) for ch, freq in counts.items()]\n    heapq.heapify(heap)\n\n    out = []\n    while heap:\n        freq, ch = heapq.heappop(heap)\n        out.append(ch * -freq)\n    return \"\".join(out)","frames":[{"caption":"<strong>Count, then max-heap</strong> &mdash; O(n + d log d) time, O(n) extra space. Input: <code>frequency_sort(s='bcacccb')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["b","c","a","c","c","c","b"],"cls":["","","","","","",""]}],"vars":[["s","'bcacccb'",0]],"stack":[]},{"caption":"<code>counts = Counter(s)</code> &mdash; <code>counts = {'b': 2, 'c': 4, 'a': 1}</code>","line":2,"panels":[{"t":"arr","id":"counts","label":"counts (Counter)","v":["2","4","1"],"cls":["","",""],"keys":["b","c","a"]}],"vars":[["s","'bcacccb'",0]],"stack":[]},{"caption":"<code>heap = [(-freq, ch) for ch, freq in counts.items()]</code> &mdash; <code>ch = 'b'</code>; <code>freq = 2</code>","line":3,"panels":[{"t":"arr","id":"counts","label":"counts (Counter)","v":["2","4","1"],"cls":["","",""],"keys":["b","c","a"]}],"vars":[["s","'bcacccb'",0],["ch","'b'",1],["freq","2",1]],"stack":[]},{"caption":"<code>heap = [(-freq, ch) for ch, freq in counts.items()]</code> &mdash; <code>ch = 'c'</code>; <code>freq = 4</code>","line":3,"panels":[{"t":"arr","id":"counts","label":"counts (Counter)","v":["2","4","1"],"cls":["","",""],"keys":["b","c","a"]}],"vars":[["s","'bcacccb'",0],["ch","'c'",1],["freq","4",1]],"stack":[]},{"caption":"<code>heap = [(-freq, ch) for ch, freq in counts.items()]</code> &mdash; <code>ch = 'a'</code>; <code>freq = 1</code>","line":3,"panels":[{"t":"arr","id":"counts","label":"counts (Counter)","v":["2","4","1"],"cls":["","",""],"keys":["b","c","a"]}],"vars":[["s","'bcacccb'",0],["ch","'a'",1],["freq","1",1]],"stack":[]},{"caption":"<code>heap = [(-freq, ch) for ch, freq in c