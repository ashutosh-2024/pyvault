{"chapters":[{"title":"Monotonic decreasing stack","code":"def construct_maximum_binary_tree(nums):\n    stack = []\n    for v in nums:\n        node, last = TreeNode(v), None\n        while stack and stack[-1].val < v:\n            last = stack.pop()\n        node.left = last                   # biggest of the smaller ones to our left\n        if stack:\n            stack[-1].right = node         # we are the max to its right, so far\n        stack.append(node)\n    return stack[0] if stack else None","frames":[{"caption":"<strong>Monotonic decreasing stack</strong> &mdash; O(n) time, O(n) extra space. Input: <code>construct_maximum_binary_tree(nums=[3, 2, 1, 6, 0, 5])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","6","0","5"],"cls":["","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>stack = []</code> &mdash; <code>stack = []</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","6","0","5"],"cls":["","","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>for v in nums:</code> &mdash; <code>v = 3</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","1","6","0","5"],"cls":["","","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["v","3",1]],"stack":[]},{"caption":"<code>node, last = TreeNode(v), None</code> &mdash; <code>last = None</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427060224","3",0.0,0.0,"cur",["node"]]],"edges":[],"dir":false},{"t":"arr","id":"nums","label":"nums","v":["3","2","1","6","0","5"],"cls":["","","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["v","3",0],["last","None",1]],"stack":[]},{"caption":"<code>while stack and stack[-1].val &lt; v:</code> &rarr; <strong>false</strong> (v = 3)","line":5,"panels":