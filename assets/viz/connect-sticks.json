{"chapters":[{"title":"Always merge the two shortest","code":"def connect_sticks(sticks):\n    heap = list(sticks)\n    heapq.heapify(heap)\n\n    total = 0\n    while len(heap) > 1:\n        a = heapq.heappop(heap)\n        b = heapq.heappop(heap)\n        total += a + b\n        heapq.heappush(heap, a + b)\n    return total","frames":[{"caption":"<strong>Always merge the two shortest</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>connect_sticks(sticks=[1, 2, 3, 4, 5])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"sticks","label":"sticks","v":["1","2","3","4","5"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>heap = list(sticks)</code> &mdash; <code>heap = [1, 2, 3, 4, 5]</code>","line":2,"panels":[{"t":"arr","id":"sticks","label":"sticks","v":["1","2","3","4","5"],"cls":["","","","",""]},{"t":"arr","id":"heap","label":"heap","v":["1","2","3","4","5"],"cls":["","","","",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h3","4",0.0,2.5,"",[]],["h1","2",1.0,1.25,"",[]],["h4","5",2.0,2.5,"",[]],["h0","1",3.0,0.0,"",["top"]],["h2","3",4.0,1.25,"",[]]],"edges":[["h0","h1","",""],["h1","h3","",""],["h1","h4","",""],["h0","h2","",""]],"dir":false,"mirror":"heap"}],"vars":[],"stack":[]},{"caption":"<code>heapq.heapify(heap)</code>","line":3,"panels":[{"t":"arr","id":"sticks","label":"sticks","v":["1","2","3","4","5"],"cls":["","","","",""]},{"t":"arr","id":"heap","label":"heap","v":["1","2","3","4","5"],"cls":["","","","",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h3","4",0.0,2.5,"",[]],["h1","2",1.0,1.25,"",[]],["h4","5",2.0,2.5,"",[]],["h0","1",3.0,0.0,"",["top"]],["h2","3",4.0,1.25,"",[]]],"edges":[["h0","h1","",""],["h1","h3","",""],["h1","h4","",""],["h0","h2","",""]],"dir":false,"mirror":"heap"}],"vars":[],"stack":[]},{"caption":"<code>total = 0</code> &mdash; <code>total = 0</code>","line":5,"panels":[{"t":"arr","id":"sticks