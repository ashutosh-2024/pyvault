{"chapters":[{"title":"Always merge the two shortest","frames":[{"caption":"Joining two sticks costs their combined length, and the new stick may be joined again. Short sticks get re-paid in every later join, so join the two shortest first (Huffman coding's idea).","trees":[{"label":"min-heap","v":["1","5","3","8"],"cls":["done","done","done","done"]}],"array":{"label":"array","v":["1","5","3","8"],"cls":["done","done","done","done"]}},{"caption":"Pop the shortest: 1.","formula":"cost so far = 0","trees":[{"label":"min-heap","v":["3","5","8"],"cls":["done","done","done"]}],"array":{"label":"array","v":["3","5","8"],"cls":["done","done","done"]}},{"caption":"Pop the next shortest, 3; join them for 4 and push the new stick back.","formula":"cost += 1 + 3  ->  4","trees":[{"label":"min-heap","v":["4","8","5"],"cls":["chosen","done","done"]}],"array":{"label":"array","v":["4","8","5"],"cls":["chosen","done","done"]}},{"caption":"Pop the shortest: 4.","formula":"cost so far = 4","trees":[{"label":"min-heap","v":["5","8"],"cls":["done","done"]}],"array":{"label":"array","v":["5","8"],"cls":["done","done"]}},{"caption":"Pop the next shortest, 5; join them for 9 and push the new stick back.","formula":"cost += 4 + 5  ->  13","trees":[{"label":"min-heap","v":["8","9"],"cls":["done","chosen"]}],"array":{"label":"array","v":["8","9"],"cls":["done","chosen"]}},{"caption":"Pop the shortest: 8.","formula":"cost so far = 13","trees":[{"label":"min-heap","v":["9"],"cls":["done"]}],"array":{"label":"array","v":["9"],"cls":["done"]}},{"caption":"Pop the next shortest, 9; join them for 17 and push the new stick back.","formula":"cost += 8 + 9  ->  30","trees":[{"label":"min-heap","v":["17"],"cls":["chosen"]}],"array":{"label":"array","v":["17"],"cls":["chosen"]}},{"caption":"One stick left. Total cost <strong>30</strong>.","formula":"answer = 30","trees":[{"label":"min-heap","v":["17"],"cls":["answer"]}],"array":{"label":"array","v":["17"],"cls":["answer"]}}]}]}