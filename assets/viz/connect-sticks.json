{"chapters":[{"title":"Always merge the two shortest","code":"def connect_sticks(sticks):\n    heap = list(sticks)\n    heapq.heapify(heap)\n\n    total = 0\n    while len(heap) > 1:\n        a = heapq.heappop(heap)\n        b = heapq.heappop(heap)\n        total += a + b\n        heapq.heappush(heap, a + b)\n    return total","frames":[{"caption":"<strong>Always merge the two shortest</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>connect_sticks(sticks=[1, 8, 3, 5])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"sticks","label":"sticks","v":["1","8","3","5"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>heap = list(sticks)</code> &mdash; <code>heap = [1, 8, 3, 5]</code>","line":2,"panels":[{"t":"arr","id":"sticks","label":"sticks","v":["1","8","3","5"],"cls":["","","",""]},{"t":"arr","id":"heap","label":"heap","v":["1","8","3","5"],"cls":["","","",""]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h3","5",0.0,2.5,"",[]],["h1","8",1.0,1.25,"",[]],["h0","1",2.0,0.0,"",["top"]],["h2","3",3.0,1.25,"",[]]],"edges":[["h0","h1","",""],["h1","h3","",""],["h0","h2","",""]],"dir":false,"mirror":"heap"}],"vars":[],"stack":[]},{"caption":"<code>heapq.heapify(heap)</code> &mdash; swap <code>heap[1]</code> and <code>heap[3]</code>","line":3,"panels":[{"t":"arr","id":"sticks","label":"sticks","v":["1","8","3","5"],"cls":["","","",""]},{"t":"arr","id":"heap","label":"heap","v":["1","5","3","8"],"cls":["","cur","","cur"]},{"t":"net","id":"heap:heap","label":"heap drawn as a tree","nodes":[["h3","8",0.0,2.5,"cur",[]],["h1","5",1.0,1.25,"cur",[]],["h0","1",2.0,0.0,"",["top"]],["h2","3",3.0,1.25,"",[]]],"edges":[["h0","h1","",""],["h1","h3","",""],["h0","h2","",""]],"dir":false,"mirror":"heap"}],"vars":[],"stack":[]},{"caption":"<code>total = 0</code> &mdash; <code>total = 0</code>","line":5,"panels":[{"t":"arr","id":"sticks","label":"sticks","v":["1","8","3","5"],"cls":["","",""