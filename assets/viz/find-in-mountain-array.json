{"chapters":[{"title":"Scan every index","code":"def find_in_mountain_array(target, mountain):\n    for i in range(mountain.length()):\n        if mountain.get(i) == target:\n            return i\n    return -1","frames":[{"caption":"<strong>Scan every index</strong> &mdash; O(n) calls time, O(1) extra space. Input: <code>find_in_mountain_array(target=3, mountain=MountainArray)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0]],"stack":[]},{"caption":"<code>for i in range(mountain.length()):</code> &mdash; <code>i = 0</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","0",1]],"stack":[]},{"caption":"<code>if mountain.get(i) == target:</code> &rarr; <strong>false</strong> (i = 0, target = 3)","line":3,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","0",0]],"stack":[]},{"caption":"<code>for i in range(mountain.length()):</code> &mdash; <code>i = 1</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","1",1]],"stack":[]},{"caption":"<code>if mountain.get(i) == target:</code> &rarr; <strong>false</strong> (i = 1, target = 3)","line":3,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","1",0]],"stack":[]},{"caption":"<code>for i in range(mountain.length()):</code> &mdash; <code>i = 2</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","2",1]],"stack":[]},{"caption":"<code>if mountain.get(i) == target:</code> &rarr; <strong>true</strong> (i = 2, target = 3)","line":3,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","2",0]],"stack":[]},{"caption":"<code>return i</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":4,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","2",0]],"stack":[]}],"example":1},{"title":"Peak search, then two binary searches","code":"def find_in_mountain_array(target, mountain):\n    n = mountain.length()\n    lo, hi = 0, n - 1\n    while lo < hi:                               # 1. find the peak\n        mid = (lo + hi) // 2\n        if mountain.get(mid) < mountain.get(mid + 1):\n            lo = mid + 1\n        else:\n            hi = mid\n    peak = lo\n\n    def search(lo, hi, ascending):\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            v = mountain.get(mid)\n            if v == target:\n                return mid\n            if (v < target) == ascending:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n        return -1\n\n    i = search(0, peak, True)                    # 2. the rising side first\n    return i if i != -1 else search(peak + 1, n - 1, False)","frames":[{"caption":"<strong>Peak search, then two binary searches</strong> &mdash; O(log n) calls time, O(1) extra space. Input: <code>find_in_mountain_array(target=3, mountain=MountainArray)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0]],"stack":[]},{"caption":"<code>n = mountain.length()</code> &mdash; <code>n = 7</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",1]],"stack":[]},{"caption":"<code>lo, hi = 0, n - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 6</code>","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","6"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","0",1],["hi","6",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 0) <em>(1. find the peak)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","6"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","0",0],["hi","6",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 3</code>","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","3","6"],"cls":["","cur","cur"],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","0",0],["hi","6",0],["mid","3",1]],"stack":[]},{"caption":"<code>if mountain.get(mid) &lt; mountain.get(mid + 1):</code> &rarr; <strong>true</strong> (mid = 3)","line":6,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","3","6"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","0",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>lo = mid + 1</code> &mdash; <code>lo = 4</code>","line":7,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","3","6"],"cls":["cur","",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",1],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 6, lo = 4) <em>(1. find the peak)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","3","6"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",0],["hi","6",0],["mid","3",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 5</code>","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","5","6"],"cls":["","cur",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",0],["hi","6",0],["mid","5",1]],"stack":[]},{"caption":"<code>if mountain.get(mid) &lt; mountain.get(mid + 1):</code> &rarr; <strong>false</strong> (mid = 5)","line":6,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","5","6"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",0],["hi","6",0],["mid","5",0]],"stack":[]},{"caption":"<code>hi = mid</code> &mdash; <code>hi = 5</code>","line":9,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","5","5"],"cls":["","","cur"],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",0],["hi","5",1],["mid","5",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 5, lo = 4) <em>(1. find the peak)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","5","5"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",0],["hi","5",0],["mid","5",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 4</code>","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","4","5"],"cls":["","cur",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",0],["hi","5",0],["mid","4",1]],"stack":[]},{"caption":"<code>if mountain.get(mid) &lt; mountain.get(mid + 1):</code> &rarr; <strong>false</strong> (mid = 4)","line":6,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","4","5"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",0],["hi","5",0],["mid","4",0]],"stack":[]},{"caption":"<code>hi = mid</code> &mdash; <code>hi = 4</code>","line":9,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","4","4"],"cls":["","","cur"],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",0],["hi","4",1],["mid","4",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>false</strong> (hi = 4, lo = 4) <em>(1. find the peak)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","4","4"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",0],["hi","4",0],["mid","4",0]],"stack":[]},{"caption":"<code>peak = lo</code> &mdash; <code>peak = 4</code>","line":10,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","4","4"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",0],["hi","4",0],["mid","4",0],["peak","4",1]],"stack":[]},{"caption":"<code>def search(lo, hi, ascending):</code>","line":12,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["4","4","4"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","4",0],["hi","4",0],["mid","4",0],["peak","4",0]],"stack":[]},{"caption":"<code>i = search(0, peak, True)</code> &mdash; calls <code>search(lo=0, hi=4, ascending=T)</code> <em>(2. the rising side first)</em>","line":24,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","4","4"],"cls":["cur","",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","0",1],["hi","4",0],["mid","4",0],["peak","4",0],["ascending","T",1]],"stack":["find_in_mountain_array(target=3, mountain)","search(lo=0, hi=4, ascending=T)"]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 4, lo = 0)","line":13,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","4","4"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","7",0],["lo","0",0],["hi","4",0],["mid","4",0],["peak","4",0],["ascending","T",0]],"stack":["find_in_mountain_array(target=3, mountain)","search(lo=0, hi=4, ascending=T)"]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 2</code>","line":14,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","2","4"],"cls":["","cur",""],"keys":["lo","mid","hi"]}],"vars":[["target","3