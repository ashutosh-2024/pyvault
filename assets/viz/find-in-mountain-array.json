{"chapters":[{"title":"Scan every index","code":"def find_in_mountain_array(target, mountain):\n    for i in range(mountain.length()):\n        if mountain.get(i) == target:\n            return i\n    return -1","frames":[{"caption":"<strong>Scan every index</strong> &mdash; O(n) calls time, O(1) extra space. Input: <code>find_in_mountain_array(target=3, mountain=MountainArray)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0]],"stack":[]},{"caption":"<code>for i in range(mountain.length()):</code> &mdash; <code>i = 0</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","0",1]],"stack":[]},{"caption":"<code>if mountain.get(i) == target:</code> &rarr; <strong>false</strong> (i = 0, target = 3) &mdash; <code>mountain = MountainArray</code>","line":3,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","0",0]],"stack":[]},{"caption":"<code>for i in range(mountain.length()):</code> &mdash; <code>i = 1</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","1",1]],"stack":[]},{"caption":"<code>if mountain.get(i) == target:</code> &rarr; <strong>false</strong> (i = 1, target = 3) &mdash; <code>mountain = MountainArray</code>","line":3,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","1",0]],"stack":[]},{"caption":"<code>for i in range(mountain.length()):</code> &mdash; <code>i = 2</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","2",1]],"stack":[]},{"caption":"<code>if mountain.get(i) == target:</code> &rarr; <strong>false</strong> (i = 2, target = 3) &mdash; <code>mountain = MountainArray</code>","line":3,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","2",0]],"stack":[]},{"caption":"<code>for i in range(mountain.length()):</code> &mdash; <code>i = 3</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","3",1]],"stack":[]},{"caption":"<code>if mountain.get(i) == target:</code> &rarr; <strong>false</strong> (i = 3, target = 3) &mdash; <code>mountain = MountainArray</code>","line":3,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","3",0]],"stack":[]},{"caption":"<code>for i in range(mountain.length()):</code> &mdash; <code>i = 4</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","4",1]],"stack":[]},{"caption":"<code>if mountain.get(i) == target:</code> &rarr; <strong>false</strong> (i = 4, target = 3) &mdash; <code>mountain = MountainArray</code>","line":3,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","4",0]],"stack":[]},{"caption":"<code>for i in range(mountain.length()):</code> &mdash; <code>i = 5</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","5",1]],"stack":[]},{"caption":"<code>if mountain.get(i) == target:</code> &rarr; <strong>false</strong> (i = 5, target = 3) &mdash; <code>mountain = MountainArray</code>","line":3,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","5",0]],"stack":[]},{"caption":"<code>for i in range(mountain.length()):</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","5",0]],"stack":[]},{"caption":"<code>return -1</code> &mdash; returns <code>-1</code>. <strong>Result: -1</strong>","line":5,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["i","5",0]],"stack":[]}]},{"title":"Peak search, then two binary searches","code":"def find_in_mountain_array(target, mountain):\n    n = mountain.length()\n    lo, hi = 0, n - 1\n    while lo < hi:                               # 1. find the peak\n        mid = (lo + hi) // 2\n        if mountain.get(mid) < mountain.get(mid + 1):\n            lo = mid + 1\n        else:\n            hi = mid\n    peak = lo\n\n    def search(lo, hi, ascending):\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            v = mountain.get(mid)\n            if v == target:\n                return mid\n            if (v < target) == ascending:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n        return -1\n\n    i = search(0, peak, True)                    # 2. the rising side first\n    return i if i != -1 else search(peak + 1, n - 1, False)","frames":[{"caption":"<strong>Peak search, then two binary searches</strong> &mdash; O(log n) calls time, O(1) extra space. Input: <code>find_in_mountain_array(target=3, mountain=MountainArray)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0]],"stack":[]},{"caption":"<code>n = mountain.length()</code> &mdash; <code>n = 6</code>","line":2,"panels":[],"vars":[["target","3",0],["mountain","MountainArray",0],["n","6",1]],"stack":[]},{"caption":"<code>lo, hi = 0, n - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 5</code>","line":3,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","5"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","6",0],["lo","0",1],["hi","5",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 5, lo = 0) <em>(1. find the peak)</em>","line":4,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","5"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","6",0],["lo","0",0],["hi","5",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 2</code>","line":5,"panels":[{"t":"arr","id":"range:lo","label":"search range","v":["0","2","5"],"cls":["","cur","cur"],"keys":["lo","mid","hi"]}],"vars":[["target","3",0],["mountain","MountainArray",0],["n","6",0],["lo","0",0],["hi","5",0],["mid","2",1]],"stack":[]},{"caption":"<code>if mountain.get(mid) &lt; mountain.get(mid + 1):</c