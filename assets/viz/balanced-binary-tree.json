{"chapters":[{"title":"Top-down, recomputing heights","code":"def is_balanced(root):\n    if root is None:\n        return True\n    if abs(height(root.left) - height(root.right)) > 1:\n        return False\n    return is_balanced(root.left) and is_balanced(root.right)\n\n\ndef height(node):\n    if node is None:\n        return 0\n    return 1 + max(height(node.left), height(node.right))","frames":[{"caption":"<strong>Top-down, recomputing heights</strong> &mdash; O(n log n) time, O(h) extra space. Input: <code>is_balanced(root=tree (1))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4389655312","3",0.0,2.5,"",[]],["n4389663632","2",1.0,1.25,"",[]],["n4389892320","1",2.0,0.0,"cur",["root"]]],"edges":[["n4389892320","n4389663632","",""],["n4389663632","n4389655312","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>if root is None:</code> &rarr; <strong>false</strong>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4389655312","3",0.0,2.5,"",[]],["n4389663632","2",1.0,1.25,"",[]],["n4389892320","1",2.0,0.0,"cur",["root"]]],"edges":[["n4389892320","n4389663632","",""],["n4389663632","n4389655312","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>if abs(height(root.left) - height(root.right)) &gt; 1:</code> &mdash; calls <code>height(node=(2))</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4389655312","3",0.0,2.5,"",[]],["n4389663632","2",1.0,1.25,"cur",["node"]],["n4389892320","1",2.0,0.0,"stack",[]]],"edges":[["n4389892320","n4389663632","",""],["n4389663632","n4389655312","",""]],"dir":false}],"vars":[],"stack":["is_balanced(root=(1))","height(node=(2))"]},{"caption":"<code>if node is None:</code> &rarr; <strong>false</strong>","line":10,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4389655312","3",0.0,2.5,"",[]],["n4389663632","2",1.0,1.25,"cur",["node"]],["n4389892320","1",2.0,0.0,"stack",[]