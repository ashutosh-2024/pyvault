["i","3",0]],"stack":[]},{"caption":"<code>for i in range(2, n + 1):</code> &mdash; <code>i = 4</code>","line":6,"panels":[{"t":"arr","id":"dp","label":"dp","v":["0","1","1","2","0","0","0"],"cls":["","","","","src","",""],"ptr":{"4":["i"]}}],"vars":[["n","6",0],["i","4",1]],"stack":[]},{"caption":"<code>dp[i] = dp[i - 1] + dp[i - 2]</code> &mdash; <code>dp[4]</code> becomes <code>3</code>","line":7,"panels":[{"t":"arr","id":"dp","label":"dp","v":["0","1","1","2","3","0","0"],"cls":["","","","","cur","",""],"ptr":{"4":["i"]}}],"vars":[["n","6",0],["i","4",0]],"stack":[]},{"caption":"<code>for i in range(2, n + 1):</code> &mdash; <code>i = 5</code>","line":6,"panels":[{"t":"arr","id":"dp","label":"dp","v":["0","1","1","2","3","0","0"],"cls":["","","","","","src",""],"ptr":{"5":["i"]}}],"vars":[["n","6",0],["i","5",1]],"stack":[]},{"caption":"<code>dp[i] = dp[i - 1] + dp[i - 2]</code> &mdash; <code>dp[5]</code> becomes <code>5</code>","line":7,"panels":[{"t":"arr","id":"dp","label":"dp","v":["0","1","1","2","3","5","0"],"cls":["","","","","","cur",""],"ptr":{"5":["i"]}}],"vars":[["n","6",0],["i","5",0]],"stack":[]},{"caption":"<code>for i in range(2, n + 1):</code> &mdash; <code>i = 6</code>","line":6,"panels":[{"t":"arr","id":"dp","label":"dp","v":["0","1","1","2","3","5","0"],"cls":["","","","","","","src"],"ptr":{"6":["i"]}}],"vars":[["n","6",0],["i","6",1]],"stack":[]},{"caption":"<code>dp[i] = dp[i - 1] + dp[i - 2]</code> &mdash; <code>dp[6]</code> becomes <code>8</code>","line":7,"panels":[{"t":"arr","id":"dp","label":"dp","v":["0","1","1","2","3","5","8"],"cls":["","","","","","","cur"],"ptr":{"6":["i"]}}],"vars":[["n","6",0],["i","6",0]],"stack":[]},{"caption":"<code>for i in range(2, n + 1):</code>","line":6,"panels":[{"t":"arr","id":"dp","label":"dp","v":["0","1","1","2","3","5","8"],"cls":["","","","","","","src"],"ptr":{"6":["i"]}}],"vars":[["n","6",0],["i","6",0]],"stack":[]},{"caption":"<code>return dp[n]</code> &mdash; returns <code>8</code>. <strong>Result: 8</strong>","line":8,"panels":[{"t":"arr","id":"dp","label":"dp","v":["0","1","1","2","3","5","8"],"cls":["","","","","","","src"],"ptr":{"6":["i"]}}],"vars":[["n","6",0],["i","6",0]],"stack":[]}],"example":1},{"title":"Two variables","code":"def fib(n):\n    a, b = 0, 1          # f(i), f(i+1)\n    for _ in range(n):\n        a, b = b, a + b\n    return a","frames":[{"caption":"<strong>Two variables</strong> &mdash; O(n) time, O(1) extra space. Input: <code>fib(n=6)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","6",0]],"stack":[]},{"caption":"<code>a, b = 0, 1</code> &mdash; <code>a = 0</code>; <code>b = 1</code> <em>(f(i), f(i+1))</em>","line":2,"panels":[],"vars":[["n","6",0],["a","0",1],["b","1",1]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 0</code>","line":3,"panels":[],"vars":[["n","6",0],["a","0",0],["b","1",0],["_","0",1]],"stack":[]},{"caption":"<code>a, b = b, a + b</code> &mdash; <code>a = 1</code>","line":4,"panels":[],"vars":[["n","6",0],["a","1",1],["b","1",0],["_","0",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 1</code>","line":3,"panels":[],"vars":[["n","6",0],["a","1",0],["b","1",0],["_","1",1]],"stack":[]},{"caption":"<code>a, b = b, a + b</code> &mdash; <code>b = 2</code>","line":4,"panels":[],"vars":[["n","6",0],["a","1",0],["b","2",1],["_","1",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 2</code>","line":3,"panels":[],"vars":[["n","6",0],["a","1",0],["b","2",0],["_","2",1]],"stack":[]},{"caption":"<code>a, b = b, a + b</code> &mdash; <code>a = 2</code>; <code>b = 3</code>","line":4,"panels":[],"vars":[["n","6",0],["a","2",1],["b","3",1],["_","2",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 3</code>","line":3,"panels":[],"vars":[["n","6",0],["a","2",0],["b","3",0],["_","3",1]],"stack":[]},{"caption":"<code>a, b = b, a + b</code> &mdash; <code>a = 3</code>; <code>b = 5</code>","line":4,"panels":[],"vars":[["n","6",0],["a","3",1],["b","5",1],["_","3",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 4</code>","line":3,"panels":[],"vars":[["n","6",0],["a","3",0],["b","5",0],["_","4",1]],"stack":[]},{"caption":"<code>a, b = b, a + b</code> &mdash; <code>a = 5</code>; <code>b = 8</code>","line":4,"panels":[],"vars":[["n","6",0],["a","5",1],["b","8",1],["_","4",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code> &mdash; <code>_ = 5</code>","line":3,"panels":[],"vars":[["n","6",0],["a","5",0],["b","8",0],["_","5",1]],"stack":[]},{"caption":"<code>a, b = b, a + b</code> &mdash; <code>a = 8</code>; <code>b = 13</code>","line":4,"panels":[],"vars":[["n","6",0],["a","8",1],["b","13",1],["_","5",0]],"stack":[]},{"caption":"<code>for _ in range(n):</code>","line":3,"panels":[],"vars":[["n","6",0],["a","8",0],["b","13",0],["_","5",0]],"stack":[]},{"caption":"<code>return a</code> &mdash; returns <code>8</code>. <strong>Result: 8</strong>","line":5,"panels":[],"vars":[["n","6",0],["a","8",0],["b","13",0],["_","5",0]],"stack":[]}],"example":1},{"title":"Fast doubling","code":"def fib(n):\n    def pair(k):                    # returns (F(k), F(k+1))\n        if k == 0:\n            return 0, 1\n        a, b = pair(k // 2)\n        c = a * (2 * b - a)\n        d = a * a + b * b\n        return (d, c + d) if k % 2 else (c, d)\n    return pair(n)[0]","frames":[{"caption":"<strong>Fast doubling</strong> &mdash; O(log n) time, O(log n) extra space. Input: <code>fib(n=6)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","6",0]],"stack":[]},{"caption":"<code>def pair(k):</code> <em>(returns (F(k), F(k+1)))</em>","line":2,"panels":[],"vars":[["n","6",0]],"stack":[]},{"caption":"<code>return pair(n)[0]</code> &mdash; calls <code>pair(k=6)</code>","line":9,"panels":[],"vars":[["n","6",0],["k","6",1]],"stack":["fib(n=6)","pair(k=6)"]},{"caption":"<code>if k == 0:</code> &rarr; <strong>false</strong> (k = 6)","line":3,"panels":[],"vars":[["n","6",0],["k","6",0]],"stack":["fib(n=6)","pair(k=6)"]},{"caption":"<code>a, b = pair(k // 2)</code> &mdash; calls <code>pair(k=3)</code>","line":5,"panels":[],"vars":[["n","6",0],["k","3",1]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)"]},{"caption":"<code>if k == 0:</code> &rarr; <strong>false</strong> (k = 3)","line":3,"panels":[],"vars":[["n","6",0],["k","3",0]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)"]},{"caption":"<code>a, b = pair(k // 2)</code> &mdash; calls <code>pair(k=1)</code>","line":5,"panels":[],"vars":[["n","6",0],["k","1",1]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)","pair(k=1)"]},{"caption":"<code>if k == 0:</code> &rarr; <strong>false</strong> (k = 1)","line":3,"panels":[],"vars":[["n","6",0],["k","1",0]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)","pair(k=1)"]},{"caption":"<code>a, b = pair(k // 2)</code> &mdash; calls <code>pair(k=0)</code>","line":5,"panels":[],"vars":[["n","6",0],["k","0",1]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)","pair(k=1)","pair(k=0)"]},{"caption":"<code>if k == 0:</code> &rarr; <strong>true</strong> (k = 0)","line":3,"panels":[],"vars":[["n","6",0],["k","0",0]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)","pair(k=1)","pair(k=0)"]},{"caption":"<code>return 0, 1</code> &mdash; <code>pair</code> returns <code>(0, 1)</code> to <code>pair</code>","line":4,"panels":[],"vars":[["n","6",0],["k","0",0]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)","pair(k=1)","pair(k=0)"]},{"caption":"<code>c = a * (2 * b - a)</code> &mdash; <code>k = 1</code>; <code>a = 0</code>; <code>b = 1</code>; <code>c = 0</code>","line":6,"panels":[],"vars":[["n","6",0],["k","1",1],["a","0",1],["b","1",1],["c","0",1]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)","pair(k=1)"]},{"caption":"<code>d = a * a + b * b</code> &mdash; <code>d = 1</code>","line":7,"panels":[],"vars":[["n","6",0],["k","1",0],["a","0",0],["b","1",0],["c","0",0],["d","1",1]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)","pair(k=1)"]},{"caption":"<code>return (d, c + d) if k % 2 else (c, d)</code> &mdash; <code>pair</code> returns <code>(1, 1)</code> to <code>pair</code>","line":8,"panels":[],"vars":[["n","6",0],["k","1",0],["a","0",0],["b","1",0],["c","0",0],["d","1",0]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)","pair(k=1)"]},{"caption":"<code>c = a * (2 * b - a)</code> &mdash; <code>k = 3</code>; <code>a = 1</code>; <code>c = 1</code>","line":6,"panels":[],"vars":[["n","6",0],["k","3",1],["a","1",1],["b","1",0],["c","1",1]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)"]},{"caption":"<code>d = a * a + b * b</code> &mdash; <code>d = 2</code>","line":7,"panels":[],"vars":[["n","6",0],["k","3",0],["a","1",0],["b","1",0],["c","1",0],["d","2",1]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)"]},{"caption":"<code>return (d, c + d) if k % 2 else (c, d)</code> &mdash; <code>pair</code> returns <code>(2, 3)</code> to <code>pair</code>","line":8,"panels":[],"vars":[["n","6",0],["k","3",0],["a","1",0],["b","1",0],["c","1",0],["d","2",0]],"stack":["fib(n=6)","pair(k=6)","pair(k=3)"]},{"caption":"<code>c = a * (2 * b - a)</code> &mdash; <code>k = 6</code>; <code>a = 2</code>; <code>b = 3</code>; <code>c = 8</code>","line":6,"panels":[],"vars":[["n","6",0],["k","6",1],["a","2",1],["b","3",1],["c","8",1]],"stack":["fib(n=6)","pair(k=6)"]},{"caption":"<code>d = a * a + b * b</code> &mdash; <code>d = 13</code>","line":7,"panels":[],"vars":[["n","6",0],["k","6",0],["a","2",0],["b","3",0],["c","8",0],["d","13",1]],"stack":["fib(n=6)","pair(k=6)"]},{"caption":"<code>return (d, c + d) if k % 2 else (c, d)</code> &mdash; <code>pair</code> returns <code>(8, 13)</code> to <code>fib</code>. <strong>Result: 8</strong>","line":8,"panels":[],"vars":[["n","6",0],["k","6",0],["a","2",0],["b","3",0],["c","8",0],["d","13",0]],"stack":["fib(n=6)","pair(k=6)"]}],"example":1}]}