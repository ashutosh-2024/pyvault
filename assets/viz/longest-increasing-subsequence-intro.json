{"chapters":[{"title":"O(n²) table","frames":[{"caption":"<code>lis[i]</code> = length of the longest strictly increasing subsequence that <strong>ends at index i</strong>. Every element alone is a subsequence of length 1.","grid":{"v":[["10","9","2","5","3","7","101","18"],["","","","","","","",""]],"cls":[["","","","","","","",""],["empty","empty","empty","empty","empty","empty","empty","empty"]],"rowLabels":["nums","lis"],"colLabels":["0","1","2","3","4","5","6","7"]}},{"caption":"Index 0 (10): it can extend any earlier subsequence ending in a smaller value &mdash; there are none.","grid":{"v":[["10","9","2","5","3","7","101","18"],["1","","","","","","",""]],"cls":[["src","","","","","","",""],["cur","empty","empty","empty","empty","empty","empty","empty"]],"rowLabels":["nums","lis"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"lis[0] = 1"},{"caption":"Index 1 (9): it can extend any earlier subsequence ending in a smaller value &mdash; there are none.","grid":{"v":[["10","9","2","5","3","7","101","18"],["1","1","","","","","",""]],"cls":[["","src","","","","","",""],["done","cur","empty","empty","empty","empty","empty","empty"]],"rowLabels":["nums","lis"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"lis[1] = 1"},{"caption":"Index 2 (2): it can extend any earlier subsequence ending in a smaller value &mdash; there are none.","grid":{"v":[["10","9","2","5","3","7","101","18"],["1","1","1","","","","",""]],"cls":[["","","src","","","","",""],["done","done","cur","empty","empty","empty","empty","empty"]],"rowLabels":["nums","lis"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"lis[2] = 1"},{"caption":"Index 3 (5): it can extend any earlier subsequence ending in a smaller value (indices [2]); the longest of those is 1.","grid":{"v":[["10","9","2","5","3","7","101","18"],["1","1","1","2","","","",""]],"cls":[["","","","src","","","",""],["done","done","src","cur","empty","empty","empty","empty"]],"rowLabels":["nums","lis"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"lis[3] = 1 + max(lis[j] for nums[j] < 5) = 2","arrows":[[1,2,1,3]]},{"caption":"Index 4 (3): it can extend any earlier subsequence ending in a smaller value (indices [2]); the longest of those is 1.","grid":{"v":[["10","9","2","5","3","7","101","18"],["1","1","1","2","2","","",""]],"cls":[["","","","","src","","",""],["done","done","src","done","cur","empty","empty","empty"]],"rowLabels":["nums","lis"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"lis[4] = 1 + max(lis[j] for nums[j] < 3) = 2","arrows":[[1,2,1,4]]},{"caption":"Index 5 (7): it can extend any earlier subsequence ending in a smaller value (indices [2, 3, 4]); the longest of those is 2.","grid":{"v":[["10","9","2","5","3","7","101","18"],["1","1","1","2","2","3","",""]],"cls":[["","","","","","src","",""],["done","done","src","src","src","cur","empty","empty"]],"rowLabels":["nums","lis"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"lis[5] = 1 + max(lis[j] for nums[j] < 7) = 3","arrows":[[1,3,1,5]]},{"caption":"Index 6 (101): it can extend any earlier subsequence ending in a smaller value (indices [0, 1, 2, 3, 4, 5]); the longest of those is 3.","grid":{"v":[["10","9","2","5","3","7","101","18"],["1","1","1","2","2","3","4",""]],"cls":[["","","","","","","src",""],["src","src","src","src","src","src","cur","empty"]],"rowLabels":["nums","lis"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"lis[6] = 1 + max(lis[j] for nums[j] < 101) = 4","arrows":[[1,5,1,6]]},{"caption":"Index 7 (18): it can extend any earlier subsequence ending in a smaller value (indices [0, 1, 2, 3, 4, 5]); the longest of those is 3.","grid":{"v":[["10","9","2","5","3","7","101","18"],["1","1","1","2","2","3","4","4"]],"cls":[["","","","","","","","src"],["src","src","src","src","src","src","done","cur"]],"rowLabels":["nums","lis"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"lis[7] = 1 + max(lis[j] for nums[j] < 18) = 4","arrows":[[1,5,1,7]]},{"caption":"The answer is the largest entry, <strong>4</strong>: e.g. [2, 5, 7, 101]. Each index looks back at every earlier one, so this is O(n&sup2;).","grid":{"v":[["10","9","2","5","3","7","101","18"],["1","1","1","2","2","3","4","4"]],"cls":[["","","chosen","chosen","","chosen","chosen",""],["done","done","done","done","done","done","answer","done"]],"rowLabels":["nums","lis"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"answer = max(lis) = 4"}]},{"title":"O(n log n): patience sorting","frames":[{"caption":"Read value 10. <code>tails</code> is empty, so 10 starts the first subsequence (length 1).","grid":{"v":[["10","9","2","5","3","7","101","18"],["10","","","","","","",""]],"cls":[["cur","","","","","","",""],["cur","empty","empty","empty","empty","empty","empty","empty"]],"rowLabels":["nums","tails"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"k = bisect_left(tails, 10) = 0;  tails = [10]","arrows":[[0,0,1,0]]},{"caption":"Read value 9. 9 <strong>replaces</strong> tails[0] = 10: a length-1 subsequence can now end in a smaller value, which leaves more room to grow later.","grid":{"v":[["10","9","2","5","3","7","101","18"],["9","","","","","","",""]],"cls":[["dim","cur","","","","","",""],["cur","empty","empty","empty","empty","empty","empty","empty"]],"rowLabels":["nums","tails"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"k = bisect_left(tails, 9) = 0;  tails = [9]","arrows":[[0,1,1,0]]},{"caption":"Read value 2. 2 <strong>replaces</strong> tails[0] = 9: a length-1 subsequence can now end in a smaller value, which leaves more room to grow later.","grid":{"v":[["10","9","2","5","3","7","101","18"],["2","","","","","","",""]],"cls":[["dim","dim","cur","","","","",""],["cur","empty","empty","empty","empty","empty","empty","empty"]],"rowLabels":["nums","tails"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"k = bisect_left(tails, 2) = 0;  tails = [2]","arrows":[[0,2,1,0]]},{"caption":"Read value 5. 5 is bigger than every tail, so it <strong>extends</strong> the longest subsequence (length 2).","grid":{"v":[["10","9","2","5","3","7","101","18"],["2","5","","","","","",""]],"cls":[["dim","dim","dim","cur","","","",""],["done","cur","empty","empty","empty","empty","empty","empty"]],"rowLabels":["nums","tails"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"k = bisect_left(tails, 5) = 1;  tails = [2, 5]","arrows":[[0,3,1,1]]},{"caption":"Read value 3. 3 <strong>replaces</strong> tails[1] = 5: a length-2 subsequence can now end in a smaller value, which leaves more room to grow later.","grid":{"v":[["10","9","2","5","3","7","101","18"],["2","3","","","","","",""]],"cls":[["dim","dim","dim","dim","cur","","",""],["done","cur","empty","empty","empty","empty","empty","empty"]],"rowLabels":["nums","tails"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"k = bisect_left(tails, 3) = 1;  tails = [2, 3]","arrows":[[0,4,1,1]]},{"caption":"Read value 7. 7 is bigger than every tail, so it <strong>extends</strong> the longest subsequence (length 3).","grid":{"v":[["10","9","2","5","3","7","101","18"],["2","3","7","","","","",""]],"cls":[["dim","dim","dim","dim","dim","cur","",""],["done","done","cur","empty","empty","empty","empty","empty"]],"rowLabels":["nums","tails"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"k = bisect_left(tails, 7) = 2;  tails = [2, 3, 7]","arrows":[[0,5,1,2]]},{"caption":"Read value 101. 101 is bigger than every tail, so it <strong>extends</strong> the longest subsequence (length 4).","grid":{"v":[["10","9","2","5","3","7","101","18"],["2","3","7","101","","","",""]],"cls":[["dim","dim","dim","dim","dim","dim","cur",""],["done","done","done","cur","empty","empty","empty","empty"]],"rowLabels":["nums","tails"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"k = bisect_left(tails, 101) = 3;  tails = [2, 3, 7, 101]","arrows":[[0,6,1,3]]},{"caption":"Read value 18. 18 <strong>replaces</strong> tails[3] = 101: a length-4 subsequence can now end in a smaller value, which leaves more room to grow later.","grid":{"v":[["10","9","2","5","3","7","101","18"],["2","3","7","18","","","",""]],"cls":[["dim","dim","dim","dim","dim","dim","dim","cur"],["done","done","done","cur","empty","empty","empty","empty"]],"rowLabels":["nums","tails"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"k = bisect_left(tails, 18) = 3;  tails = [2, 3, 7, 18]","arrows":[[0,7,1,3]]},{"caption":"The length of <code>tails</code> is the answer, <strong>4</strong>. Note that tails itself ([2, 3, 7, 18]) need not be a real subsequence &mdash; only its length is meaningful. Each step is one binary search.","grid":{"v":[["10","9","2","5","3","7","101","18"],["2","3","7","18","","","",""]],"cls":[["dim","dim","dim","dim","dim","dim","dim","dim"],["done","done","done","answer","empty","empty","empty","empty"]],"rowLabels":["nums","tails"],"colLabels":["0","1","2","3","4","5","6","7"]},"formula":"answer = len(tails) = 4"}]}]}