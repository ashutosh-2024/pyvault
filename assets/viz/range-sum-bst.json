{"chapters":[{"title":"DFS that prunes out-of-range subtrees","code":"def range_sum_bst(root, low, high):\n    total, stack = 0, [root]\n    while stack:\n        node = stack.pop()\n        if node is None:\n            continue\n        if node.val < low:\n            stack.append(node.right)          # everything on the left is smaller\n        elif node.val > high:\n            stack.append(node.left)\n        else:\n            total += node.val\n            stack += [node.left, node.right]\n    return total","frames":[{"caption":"<strong>DFS that prunes out-of-range subtrees</strong> &mdash; O(h + m) time, O(h) extra space. Input: <code>range_sum_bst(root=tree (10), low=7, high=15)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427018192","3",0.0,2.5,"",[]],["n4426921488","5",1.0,1.25,"",[]],["n4427015760","7",2.0,2.5,"",[]],["n4427145168","10",3.0,0.0,"cur",["root"]],["n4426922128","15",4.0,1.25,"",[]],["n4435156080","18",5.0,2.5,"",[]]],"edges":[["n4427145168","n4426921488","",""],["n4426921488","n4427018192","",""],["n4426921488","n4427015760","",""],["n4427145168","n4426922128","",""],["n4426922128","n4435156080","",""]],"dir":false},{"t":"arr","id":"range:low","label":"search range","v":["7","15"],"cls":["",""],"keys":["low","high"]}],"vars":[["low","7",0],["high","15",0]],"stack":[]},{"caption":"<code>total, stack = 0, [root]</code> &mdash; <code>total = 0</code>; <code>stack = [(10)]</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427018192","3",0.0,2.5,"",[]],["n4426921488","5",1.0,1.25,"",[]],["n4427015760","7",2.0,2.5,"",[]],["n4427145168","10",3.0,0.0,"cur",["root"]],["n4426922128","15",4.0,1.25,"",[]],["n4435156080","18",5.0,2.5,"",[]]],"edges":[["n4427145168","n4426921488","",""],["n4426921488","n4427018192","",""],["n4426921488","n4427015760","",""],["n4427145168","n4426922128","",""],["n4426922128","n4435156080","",""]],"dir":false}