{"chapters":[{"title":"LLRB: rotate and flip on the way up","code":"RED, BLACK = True, False\n\n\nclass RBNode:\n    __slots__ = (\"key\", \"left\", \"right\", \"color\")\n\n    def __init__(self, key):\n        self.key, self.left, self.right, self.color = key, None, None, RED\n\n\ndef is_red(n):\n    return n is not None and n.color is RED\n\n\ndef rotate_left(h):\n    x = h.right\n    h.right, x.left = x.left, h\n    x.color, h.color = h.color, RED\n    return x\n\n\ndef rotate_right(h):\n    x = h.left\n    h.left, x.right = x.right, h\n    x.color, h.color = h.color, RED\n    return x\n\n\ndef flip_colors(h):\n    h.color = not h.color\n    h.left.color = not h.left.color\n    h.right.color = not h.right.color\n\n\ndef fix_up(h):\n    if is_red(h.right) and not is_red(h.left):\n        h = rotate_left(h)                        # red links lean left\n    if is_red(h.left) and is_red(h.left.left):\n        h = rotate_right(h)                       # no two reds in a row\n    if is_red(h.left) and is_red(h.right):\n        flip_colors(h)                            # split a 4-node\n    return h\n\n\ndef move_red_left(h):\n    flip_colors(h)\n    if is_red(h.right.left):\n        h.right = rotate_right(h.right)\n        h = rotate_left(h)\n        flip_colors(h)\n    return h\n\n\ndef move_red_right(h):\n    flip_colors(h)\n    if is_red(h.left.left):\n        h = rotate_right(h)\n        flip_colors(h)\n    return h\n\n\nclass RedBlackTree:\n    def __init__(self):\n        self.root = None\n\n    def __contains__(self, key):\n        n = self.root\n        while n is not None and n.key != key:\n            n = n.left if key < n.key else n.right\n        return n is not None\n\n    def insert(self, key):\n        self.root = self._insert(self.root, key)\n        self.root.color = BLACK\n\n    def _insert(self, h, key):\n        if h is None:\n            return RBNode(key)\n        if key < h.key:\n            h.left = self._insert(h.left, key)\n        elif key > h.key:\n            h.right = self._insert(h.right, key)\n        return fix_up(h)\n\n    def delete(self, key):\n        if key not in self:\n            return\n        if not is_red(self.root.left) and not is_red(self.root.right):\n            self.root.color = RED\n        self.root = self._delete(self.root, key)\n        if self.root is not None:\n            self.root.color = BLACK\n\n    def _delete_min(self, h):\n        if h.left is None:\n            return None\n        if not is_red(h.left) and not is_red(h.left.left):\n            h = move_red_left(h)\n        h.left = self._delete_min(h.left)\n        return fix_up(h)\n\n    def _delete(self, h, key):\n        if key < h.key:\n            if not is_red(h.left) and not is_red(h.left.left):\n                h = move_red_left(h)\n            h.left = self._delete(h.left, key)\n        else:\n            if is_red(h.left):\n                h = rotate_right(h)\n            if key == h.key and h.right is None:\n                return None\n            if not is_red(h.right) and not is_red(h.right.left):\n                h = move_red_right(h)\n            if key == h.key:\n                m = h.right\n                while m.left is not None:\n                    m = m.left\n                h.key = m.key\n                h.right = self._delete_min(h.right)\n            else:\n                h.right = self._delete(h.right, key)\n        return fix_up(h)\n\n    def inorder(self):\n        out = []\n        def walk(n):\n            if n:\n                walk(n.left); out.append(n.key); walk(n.right)\n        walk(self.root)\n        return out","frames":[{"caption":"<strong>LLRB: rotate and flip on the way up</strong> &mdash; O(log n) per operation time, O(log n) recursion extra space. Running <code>t = RedBlackTree(); t.insert(k)</code>. Step through to watch the code work on this input.","line":63,"panels":[{"t":"arr","id":"self","label":"self","v":["R","e","d","B","l","a","c","k","T","r","e","e"],"cls":["","","","","","","","","","","",""]}],"vars":[["self","'RedBlackTree'",0]],"stack":[]},{"caption":"<code>self.root = None</code> &mdash; returns <code>None</code>; <code>self.root = None</code>","line":64,"panels":[],"vars":[["self.root","None",1]],"stack":[]},{"caption":"<code>self.root = self._insert(self.root, key)</code> &mdash; calls <code>_insert(h=None, key=1)</code>","line":73,"panels":[],"vars":[["self.root","None",0],["key","1",1],["h","None",1]],"stack":["insert(key=1)","_insert(h=None, key=1)"]},{"caption":"<code>if h is None:</code> &rarr; <strong>true</strong> (h = None)","line":77,"panels":[],"vars":[["self.root","None",0],["key","1",0],["h","None",0]],"stack":["insert(key=1)","_insert(h=None, key=1)"]},{"caption":"<code>return RBNode(key)</code> &mdash; calls <code>__init__(key=1)</code>","line":78,"panels":[{"t":"arr","id":"self","label":"self","v":["R","B","N","o","d","e"],"cls":["","cur","cur","cur","cur","cur"]}],"vars":[["self.root","None",0],["key","1",0],["h","None",0],["self","'RBNode'",1]],"stack":["insert(key=1)","_insert(h=None, key=1)","__init__(key=1)"]},{"caption":"<code>self.key, self.left, self.right, self.color = key, None, None, RED</code> &mdash; <code>__init__</code> returns <code>None</code> to <code>_insert</code>; <code>self</code> moves to <code>(1)</code>","line":8,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402368768","1",0.0,0.0,"cur",["self"]]],"edges":[],"dir":false}],"vars":[["self.root","None",0],["key","1",0],["h","None",0]],"stack":["insert(key=1)","_insert(h=None, key=1)","__init__(key=1)"]},{"caption":"<code>self.root.color = BLACK</code> &mdash; returns <code>None</code>; <code>self.root</code> moves to <code>(1)</code>","line":74,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402368768","1",0.0,0.0,"cur",["self.root"]]],"edges":[],"dir":false}],"vars":[["key","1",0]],"stack":[]},{"caption":"<code>self.root = self._insert(self.root, key)</code> &mdash; calls <code>_insert(h=(1), key=2)</code>","line":73,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402368768","1",0.0,0.0,"cur",["self.root","h"]]],"edges":[],"dir":false}],"vars":[["key","2",1]],"stack":["insert(key=2)","_insert(h=(1), key=2)"]},{"caption":"<code>if h is None:</code> &rarr; <strong>false</strong>","line":77,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402368768","1",0.0,0.0,"cur",["self.root","h"]]],"edges":[],"dir":false}],"vars":[["key","2",0]],"stack":["insert(key=2)","_insert(h=(1), key=2)"]},{"caption":"<code>if key &lt; h.key:</code> &rarr; <strong>false</strong> (key = 2)","line":79,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402368768","1",0.0,0.0,"cur",["self.root","h"]]],"edges":[],"dir":false}],"vars":[["key","2",0]],"stack":["insert(key=2)","_insert(h=(1), key=2)"]},{"caption":"<code>elif key &gt; h.key:</code> &rarr; <strong>true</strong> (key = 2)","line":81,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402368768","1",0.0,0.0,"cur",["self.root","h"]]],"edges":[],"dir":false}],"vars":[["key","2",0]],"stack":["insert(key=2)","_insert(h=(1), key=2)"]},{"caption":"<code>h.right = self._insert(h.right, key)</code> &mdash; calls <code>_insert(h=None, key=2)</code>","line":82,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402368768","1",0.0,0.0,"cur",["self.root"]]],"edges":[],"dir":false}],"vars":[["key","2",0],["h","None",1]],"stack":["insert(key=2)","_insert(h=(1), key=2)","_insert(h=None, key=2)"]},{"caption":"<code>if h is None:</code> &rarr; <strong>true</strong> (h = None)","line":77,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4402368768","1",0.0,0.0,"cur",["self.root"]]],"edges":[],"dir":false}],"vars":[["key","2",0],["h","None",0]],"stack":["insert(key=2)","_insert(h=(1), key=2)","_insert(h=None, key=2)"]},{"caption":"<code>return RBNode(key)</code> &mdash; calls <code>__init__(key=2)</code>","line":78,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n440