__init__(self, capacity):\n        self.cap, self.data = capacity, OrderedDict()\n\n    def get(self, key):\n        if key not in self.data:\n            return -1\n        self.data.move_to_end(key)\n        return self.data[key]\n\n    def put(self, key, value):\n        if key in self.data:\n            self.data.move_to_end(key)\n        self.data[key] = value\n        if len(self.data) > self.cap:\n            self.data.popitem(last=False)","frames":[{"caption":"<strong>OrderedDict</strong> &mdash; O(1) time, O(capacity) extra space. Running <code>c = LRUCache(2); c.put(1, 1); c.put(2, 2); assert c.get(1) == 1; c.put(3, 3) …</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["L","R","U","C","a","c","h","e"],"cls":["","","","","","","",""]}],"vars":[["self","'LRUCache'",0],["capacity","2",0]],"stack":[]},{"caption":"<code>self.cap, self.data = capacity, OrderedDict()</code> &mdash; returns <code>None</code>; <code>self.cap = 2</code>; <code>self.data = {}</code>","line":3,"panels":[{"t":"arr","id":"self.data","label":"self.data (OrderedDict)","v":[],"cls":[],"keys":[]}],"vars":[["self.cap","2",1],["capacity","2",0]],"stack":[]},{"caption":"<code>if key in self.data:</code> &rarr; <strong>false</strong> (key = 1) &mdash; <code>key = 1</code>; <code>value = 1</code>","line":12,"panels":[{"t":"arr","id":"self.data","label":"self.data (OrderedDict)","v":[],"cls":[],"keys":[]}],"vars":[["self.cap","2",0],["key","1",1],["value","1",1]],"stack":[]},{"caption":"<code>self.data[key] = value</code> &mdash; <code>self.data[1] = 1</code>","line":14,"panels":[{"t":"arr","id":"self.data","label":"self.data (OrderedDict)","v":["1"],"cls":["cur"],"keys":["1"]}],"vars":[["self.cap","2",0],["key","1",0],["value","1",0]],"stack":[]},{"caption":"<code>if len(self.data) &gt; self.cap:</code> &rarr; <strong>false</strong> &mdash; returns <code>None</code>","line":15,"panels":[{"t":"arr","id":"self.data","label":"