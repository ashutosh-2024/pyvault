'D'",0],["j","1",0]],"stack":[]},{"caption":"<code>j %= len(s)</code>","line":9,"panels":[{"t":"arr","id":"s","label":"s","v":["D","R"],"cls":["src","src"],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["senate","'DDRRR'",0],["i","0",0],["me","'D'",0],["j","1",0]],"stack":[]},{"caption":"<code>del s[j]</code> &mdash; <code>'R'</code> popped off the end of <code>s</code>","line":10,"panels":[{"t":"arr","id":"s","label":"s","v":["D"],"cls":["src"],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["senate","'DDRRR'",0],["i","0",0],["me","'D'",0],["j","1",0]],"stack":[]},{"caption":"<code>if j &lt; i:</code> &rarr; <strong>false</strong> (i = 0, j = 1)","line":11,"panels":[{"t":"arr","id":"s","label":"s","v":["D"],"cls":["src"],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["senate","'DDRRR'",0],["i","0",0],["me","'D'",0],["j","1",0]],"stack":[]},{"caption":"<code>i = (i + 1) % len(s)</code>","line":13,"panels":[{"t":"arr","id":"s","label":"s","v":["D"],"cls":["src"],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["senate","'DDRRR'",0],["i","0",0],["me","'D'",0],["j","1",0]],"stack":[]},{"caption":"<code>while len(set(s)) &gt; 1:</code> &rarr; <strong>false</strong>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["D"],"cls":["src"],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["senate","'DDRRR'",0],["i","0",0],["me","'D'",0],["j","1",0]],"stack":[]},{"caption":"<code>return \"Radiant\" if s[0] == \"R\" else \"Dire\"</code> &mdash; returns <code>'Dire'</code>. <strong>Result: 'Dire'</strong>","line":14,"panels":[{"t":"arr","id":"s","label":"s","v":["D"],"cls":["src"],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["senate","'DDRRR'",0],["i","0",0],["me","'D'",0],["j","1",0]],"stack":[]}],"example":1},{"title":"Two queues of turn indices","code":"def predict_party_victory(senate):\n    n = len(senate)\n    r = deque(i for i, c in enumerate(senate) if c == \"R\")\n    d = deque(i for i, c in enumerate(senate) if c == \"D\")\n    while r and d:\n        a, b = r.popleft(), d.popleft()\n        if a < b:\n            r.append(a + n)                      # R acts first and bans this D\n        else:\n            d.append(b + n)\n    return \"Radiant\" if r else \"Dire\"","frames":[{"caption":"<strong>Two queues of turn indices</strong> &mdash; O(n) time, O(n) extra space. Input: <code>predict_party_victory(senate='DDRRR')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"senate","label":"senate","v":["D","D","R","R","R"],"cls":["","","","",""]}],"vars":[["senate","'DDRRR'",0]],"stack":[]},{"caption":"<code>n = len(senate)</code> &mdash; <code>n = 5</code>","line":2,"panels":[{"t":"arr","id":"senate","label":"senate","v":["D","D","R","R","R"],"cls":["","","","",""]}],"vars":[["senate","'DDRRR'",0],["n","5",1]],"stack":[]},{"caption":"<code>r = deque(i for i, c in enumerate(senate) if c == \"R\")</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":3,"panels":[{"t":"arr","id":"senate","label":"senate","v":["D","D","R","R","R"],"cls":["","","","",""]}],"vars":[["senate","'DDRRR'",0],["n","5",0]],"stack":["predict_party_victory(senate='DDRRR')","<genexpr>()"]},{"caption":"<code>r = deque(i for i, c in enumerate(senate) if c == \"R\")</code> &mdash; <code>i = 0</code>; <code>c = 'D'</code>","line":3,"panels":[{"t":"arr","id":"senate","label":"senate","v":["D","D","R","R","R"],"cls":["src","","","",""],"ptr":{"0":["i"]}}],"vars":[["senate","'DDRRR'",0],["n","5",0],["i","0",1],["c","'D'",1]],"stack":["predict_party_victory(senate='DDRRR')","<genexpr>()"]},{"caption":"<code>r = deque(i for i, c in enumerate(senate) if c == \"R\")</code> &mdash; <code>i = 1</code>","line":3,"panels":[{"t":"arr","id":"senate","label":"senate","v":["D","D","R","R","R"],"cls":["","src","","",""],"ptr":{"1":["i"]}}],"vars":[["senate","'DDRRR'",0],["n","5",0],["i","1",1],["c","'D'",0]],"stack":["predict_party_victory(senate='DDRRR')","<genexpr>()"]},{"caption":"<code>r = deque(i for i, c in enumerate(senate) if c == \"R\")</code> &mdash; yields <code>2</cod