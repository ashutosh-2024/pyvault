{"chapters":[{"title":"Scan everything","code":"def search_matrix(matrix, target):\n    return any(target in row for row in matrix)","frames":[{"caption":"<strong>Scan everything</strong> &mdash; O(m &middot; n) time, O(1) extra space. Input: <code>search_matrix(matrix=[[1, 3, 5, 7], [10, 11, 16, 20], [23, 30, 34, 60]], target=16)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]}],"vars":[["target","16",0]],"stack":[]},{"caption":"<code>return any(target in row for row in matrix)</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]}],"vars":[["target","16",0]],"stack":["search_matrix(matrix, target=16)","<genexpr>()"]},{"caption":"<code>return any(target in row for row in matrix)</code> &mdash; yields <code>F</code>; <code>row = [1, 3, 5, 7]</code>","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["1","3","5","7"],"cls":["","","",""]}],"vars":[["target","16",0]],"stack":["search_matrix(matrix, target=16)","<genexpr>()"]},{"caption":"<code>return any(target in row for row in matrix)</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["1","3","5","7"],"cls":["","","",""]}],"vars":[["target","16",0]],"stack":["search_matrix(matrix, target=16)","<genexpr>()"]},{"caption":"<code>return any(target in row for row in matrix)</code> &mdash; yields <code>T</code>; <code>row</code> is now <code>[10, 11, 16, 20]</code>. <strong>Result: T</strong>","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["10","11","16","20"],"cls":["cur","cur","cur","cur"]}],"vars":[["target","16",0]],"stack":["search_matrix(matrix, target=16)","<genexpr>()"]}],"example":1},{"title":"Staircase from the top-right","code":"def search_matrix(matrix, target):\n    r, c = 0, len(matrix[0]) - 1\n    while r < len(matrix) and c >= 0:\n        v = matrix[r][c]\n        if v == target:\n            return True\n        if v > target:\n            c -= 1\n        else:\n            r += 1\n    return False","frames":[{"caption":"<strong>Staircase from the top-right</strong> &mdash; O(m + n) time, O(1) extra space. Input: <code>search_matrix(matrix=[[1, 3, 5, 7], [10, 11, 16, 20], [23, 30, 34, 60]], target=16)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","",""],["","","",""],["","","",""]]}],"vars":[["target","16",0]],"stack":[]},{"caption":"<code>r, c = 0, len(matrix[0]) - 1</code> &mdash; <code>r = 0</code>; <code>c = 3</code>","line":2,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","","src"],["","","",""],["","","",""]]}],"vars":[["target","16",0],["r","0",1],["c","3",1]],"stack":[]},{"caption":"<code>while r &lt; len(matrix) and c &gt;= 0:</code> &rarr; <strong>true</strong> (c = 3, r = 0)","line":3,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","","src"],["","","",""],["","","",""]]}],"vars":[["target","16",0],["r","0",0],["c","3",0]],"stack":[]},{"caption":"<code>v = matrix[r][c]</code> &mdash; <code>v = 7</code>","line":4,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","","src"],["","","",""],["","","",""]]}],"vars":[["target","16",0],["r","0",0],["c","3",0],["v","7",1]],"stack":[]},{"caption":"<code>if v == target:</code> &rarr; <strong>false</strong> (target = 16, v = 7)","line":5,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","","src"],["","","",""],["","","",""]]}],"vars":[["target","16",0],["r","0",0],["c","3",0],["v","7",0]],"stack":[]},{"caption":"<code>if v &gt; target:</code> &rarr; <strong>false</strong> (target = 16, v = 7)","line":7,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","","src"],["","","",""],["","","",""]]}],"vars":[["target","16",0],["r","0",0],["c","3",0],["v","7",0]],"stack":[]},{"caption":"<code>r += 1</code> &mdash; <code>r = 1</code>","line":10,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","",""],["","","","src"],["","","",""]]}],"vars":[["target","16",0],["r","1",1],["c","3",0],["v","7",0]],"stack":[]},{"caption":"<code>while r &lt; len(matrix) and c &gt;= 0:</code> &rarr; <strong>true</strong> (c = 3, r = 1)","line":3,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","",""],["","","","src"],["","","",""]]}],"vars":[["target","16",0],["r","1",0],["c","3",0],["v","7",0]],"stack":[]},{"caption":"<code>v = matrix[r][c]</code> &mdash; <code>v = 20</code>","line":4,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","",""],["","","","src"],["","","",""]]}],"vars":[["target","16",0],["r","1",0],["c","3",0],["v","20",1]],"stack":[]},{"caption":"<code>if v == target:</code> &rarr; <strong>false</strong> (target = 16, v = 20)","line":5,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","",""],["","","","src"],["","","",""]]}],"vars":[["target","16",0],["r","1",0],["c","3",0],["v","20",0]],"stack":[]},{"caption":"<code>if v &gt; target:</code> &rarr; <strong>true</strong> (target = 16, v = 20)","line":7,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","",""],["","","","src"],["","","",""]]}],"vars":[["target","16",0],["r","1",0],["c","3",0],["v","20",0]],"stack":[]},{"caption":"<code>c -= 1</code> &mdash; <code>c = 2</code>","line":8,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","",""],["","","src",""],["","","",""]]}],"vars":[["target","16",0],["r","1",0],["c","2",1],["v","20",0]],"stack":[]},{"caption":"<code>while r &lt; len(matrix) and c &gt;= 0:</code> &rarr; <strong>true</strong> (c = 2, r = 1)","line":3,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","",""],["","","src",""],["","","",""]]}],"vars":[["target","16",0],["r","1",0],["c","2",0],["v","20",0]],"stack":[]},{"caption":"<code>v = matrix[r][c]</code> &mdash; <code>v = 16</code>","line":4,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","",""],["","","src",""],["","","",""]]}],"vars":[["target","16",0],["r","1",0],["c","2",0],["v","16",1]],"stack":[]},{"caption":"<code>if v == target:</code> &rarr; <strong>true</strong> (target = 16, v = 16)","line":5,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","",""],["","","src",""],["","","",""]]}],"vars":[["target","16",0],["r","1",0],["c","2",0],["v","16",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>. <strong>Result: T</strong>","line":6,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","3","5","7"],["10","11","16","20"],["23","30","34","60"]],"cls":[["","","",""],["","","src",""],["","","",""]]}],"vars":[["target","16",0],["r","1",0],["c","2",0],["v","16",0]],"stack":[]}],"example":1},{"title":"Binary search the row, then the column","code":"def search_matrix(matrix, target):\n    firsts = [row[0] for row in matrix]\n    r = bisect.bisect_right(firsts, target) - 1\n    if r < 0:\n        return False\n    row = matrix[r]\n    i = bisect.bisect_left(row, target)\n    return i < len(row) and row[i] == target","frames":[{"caption":"<strong>Binary search the row, then the column</strong> &mdash; O(log m + log n) time, O(1) extra space. Input: <code>search_matrix(matrix=[[1, 3, 5, 7], [10, 11, 16, 20], [23, 30, 34, 60]], target=16)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]}],"vars":[["target","16",0]],"stack":[]},{"caption":"<code>firsts = [row[0] for row in matrix]</code> &mdash; <code>row = [1, 3, 5, 7]</code>","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["1","3","5","7"],"cls":["","","",""]}],"vars":[["target","16",0]],"stack":[]},{"caption":"<code>firsts = [row[0] for row in matrix]</code> &mdash; <code>row</code> is now <code>[10, 11, 16, 20]</code>","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["10","11","16","20"],"cls":["cur","cur","cur","cur"]}],"vars":[["target","16",0]],"stack":[]},{"caption":"<code>firsts = [row[0] for row in matrix]</code> &mdash; <code>row</code> is now <code>[23, 30, 34, 60]</code>","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["23","30","34","60"],"cls":["cur","cur","cur","cur"]}],"vars":[["target","16",0]],"stack":[]},{"caption":"<code>firsts = [row[0] for row in matrix]</code> &mdash; <code>firsts = [1, 10, 23]</code>","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"firsts","label":"firsts","v":["1","10","23"],"cls":["","",""]}],"vars":[["target","16",0]],"stack":[]},{"caption":"<code>r = bisect.bisect_right(firsts, target) - 1</code> &mdash; <code>r = 1</code>","line":3,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","src",""],"ptr":{"1":["r"]}},{"t":"arr","id":"firsts","label":"firsts","v":["1","10","23"],"cls":["","",""]}],"vars":[["target","16",0],["r","1",1]],"stack":[]},{"caption":"<code>if r &lt; 0:</code> &rarr; <strong>false</strong> (r = 1)","line":4,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","src",""],"ptr":{"1":["r"]}},{"t":"arr","id":"firsts","label":"firsts","v":["1","10","23"],"cls":["","",""]}],"vars":[["target","16",0],["r","1",0]],"stack":[]},{"caption":"<code>row = matrix[r]</code> &mdash; <code>row = [10, 11, 16, 20]</code>","line":6,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","src",""],"ptr":{"1":["r"]}},{"t":"arr","id":"row","label":"row","v":["10","11","16","20"],"cls":["cur","cur","cur","cur"],"ptr":{"1":["r"]}},{"t":"arr","id":"firsts","label":"firsts","v":["1","10","23"],"cls":["","",""]}],"vars":[["target","16",0],["r","1",0]],"stack":[]},{"caption":"<code>i = bisect.bisect_left(row, target)</code> &mdash; <code>i = 2</code>","line":7,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","src",""],"ptr":{"1":["r"]}},{"t":"arr","id":"row","label":"row","v":["10","11","16","20"],"cls":["","src","src",""],"ptr":{"2":["i"],"1":["r"]}},{"t":"arr","id":"firsts","label":"firsts","v":["1","10","23"],"cls":["","",""]}],"vars":[["target","16",0],["r","1",0],["i","2",1]],"stack":[]},{"caption":"<code>return i &lt; len(row) and row[i] == target</code> &mdash; returns <code>T</code>. <strong>Result: T</strong>","line":8,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","src",""],"ptr":{"1":["r"]}},{"t":"arr","id":"row","label":"row","v":["10","11","16","20"],"cls":["","src","src",""],"ptr":{"2":["i"],"1":["r"]}},{"t":"arr","id":"firsts","label":"firsts","v":["1","10","23"],"cls":["","",""]}],"vars":[["target","16",0],["r","1",0],["i","2",0]],"stack":[]}],"example":1},{"title":"One binary search over the flattened index","code":"def search_matrix(matrix, target):\n    m, n = len(matrix), len(matrix[0])\n    lo, hi = 0, m * n - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        v = matrix[mid // n][mid % n]\n        if v == target:\n            return True\n        if v < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return False","frames":[{"caption":"<strong>One binary search over the flattened index</strong> &mdash; O(log(m &middot; n)) time, O(1) extra space. Input: <code>search_matrix(matrix=[[1, 3, 5, 7], [10, 11, 16, 20], [23, 30, 34, 60]], target=16)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]}],"vars":[["target","16",0]],"stack":[]},{"caption":"<code>m, n = len(matrix), len(matrix[0])</code> &mdash; <code>m = 3</code>; <code>n = 4</code>","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]}],"vars":[["target","16",0],["m","3",1],["n","4",1]],"stack":[]},{"caption":"<code>lo, hi = 0, m * n - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 11</code>","line":3,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["0","11"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["target","16",0],["m","3",0],["n","4",0],["lo","0",1],["hi","11",1]],"stack":[]},{"caption":"<code>while lo &lt;= hi:</code> &rarr; <strong>true</strong> (hi = 11, lo = 0)","line":4,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["0","11"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["target","16",0],["m","3",0],["n","4",0],["lo","0",0],["hi","11",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 5</code>","line":5,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["0","5","11"],"cls":["","cur","cur"],"keys":["lo","mid","hi"]}],"vars":[["target","16",0],["m","3",0],["n","4",0],["lo","0",0],["hi","11",0],["mid","5",1]],"stack":[]},{"caption":"<code>v = matrix[mid // n][mid % n]</code> &mdash; <code>v = 11</code>","line":6,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["0","5","11"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["target","16",0],["m","3",0],["n","4",0],["lo","0",0],["hi","11",0],["mid","5",0],["v","11",1]],"stack":[]},{"caption":"<code>if v == target:</code> &rarr; <strong>false</strong> (target = 16, v = 11)","line":7,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["1,3,5,7","10,11,…","23,30,…"],"cls":["","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["0","5","11"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["target","16",0],["m","3",0],["n","4",0],["lo","0",0],["hi","11",0],["mid","5",0],["v","11",0]],"stack":[]},{"caption":"<code>if v &lt; target:</code> &rarr; <strong>true</strong> (target = 16, v = 11)","line":9,"panels":[{"t":"arr","id":"matrix","label":"matrix",