",0],["c","2",0]],"stack":[]},{"caption":"<code>for row in matrix:</code> &mdash; returns <code>None</code>. <strong>Result: None</strong>","line":6,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["7","4","1"],["8","5","2"],["9","6","3"]],"cls":[["","",""],["","",""],["","","src"]]},{"t":"arr","id":"row","label":"row","v":["9","6","3"],"cls":["","",""]}],"vars":[["n","3",0],["r","2",0],["c","2",0]],"stack":[]}],"example":1},{"title":"Rotate four cells at a time, layer by layer","code":"def rotate(matrix):\n    n = len(matrix)\n    for layer in range(n // 2):\n        first, last = layer, n - 1 - layer\n        for i in range(first, last):\n            off = i - first\n            top = matrix[first][i]\n            matrix[first][i] = matrix[last - off][first]     # left -> top\n            matrix[last - off][first] = matrix[last][last - off]  # bottom -> left\n            matrix[last][last - off] = matrix[i][last]       # right -> bottom\n            matrix[i][last] = top                            # top -> right","frames":[{"caption":"<strong>Rotate four cells at a time, layer by layer</strong> &mdash; O(n&sup2;) time, O(1) extra space. Input: <code>rotate(matrix=[[1, 2, 3], [4, 5, 6], [7, 8, 9]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","2","3"],["4","5","6"],["7","8","9"]],"cls":[["","",""],["","",""],["","",""]]}],"vars":[],"stack":[]},{"caption":"<code>n = len(matrix)</code> &mdash; <code>n = 3</code>","line":2,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","2","3"],["4","5","6"],["7","8","9"]],"cls":[["","",""],["","",""],["","",""]]}],"vars":[["n","3",1]],"stack":[]},{"caption":"<code>for layer in range(n // 2):</code> &mdash; <code>layer = 0</code>","line":3,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","2","3"],["4","5","6"],["7","8","9"]],"cls":[["","",""],["","",""],["","",""]]}],"vars":[["n","3",0],["layer","0",1]],"stack":[]},{"caption":"<code>first, last = layer, n - 1 - layer</code> &mdash; <code>first = 0</code>; <code>last = 2</code>","line":4,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","2","3"],["4","5","6"],["7","8","9"]],"cls":[["","",""],["","",""],["","",""]]}],"vars":[["n","3",0],["layer","0",0],["first","0",1],["last","2",1]],"stack":[]},{"caption":"<code>for i in range(first, last):</code> &mdash; <code>i = 0</code>","line":5,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","2","3"],["4","5","6"],["7","8","9"]],"cls":[["src","","src"],["","",""],["","",""]]}],"vars":[["n","3",0],["layer","0",0],["first","0",0],["last","2",0],["i","0",1]],"stack":[]},{"caption":"<code>off = i - first</code> &mdash; <code>off = 0</code>","line":6,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","2","3"],["4","5","6"],["7","8","9"]],"cls":[["src","","src"],["","",""],["","",""]]}],"vars":[["n","3",0],["layer","0",0],["first","0",0],["last","2",0],["i","0",0],["off","0",1]],"stack":[]},{"caption":"<code>top = matrix[first][i]</code> &mdash; <code>top = 1</code>","line":7,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["1","2","3"],["4","5","6"],["7","8","9"]],"cls":[["src","","src"],["","",""],["","",""]]}],"vars":[["n","3",0],["layer","0",0],["first","0",0],["last","2",0],["i","0",0],["off","0",0],["top","1",1]],"stack":[]},{"caption":"<code>matrix[first][i] = matrix[last - off][first]</code> &mdash; <code>matrix[0][0]</code> becomes <code>7</code> <em>(left -&gt; top)</em>","line":8,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["7","2","3"],["4","5","6"],["7","8","9"]],"cls":[["cur","","src"],["","",""],["","",""]]}],"vars":[["n","3",0],["layer","0",0],["first","0",0],["last","2",0],["i","0",0],["off","0",0],["top","1",0]],"stack":[]},{"caption":"<code>matrix[last - off][first] = matrix[last][last - off]</code> &mdash; <code>matrix[2][0]</code> becomes <code>9</code> <em>(bottom -&gt; left)</em>","line":9,"panels":[{"t