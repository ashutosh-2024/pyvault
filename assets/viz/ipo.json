{"chapters":[{"title":"Two heaps: affordable by capital, best by profit","code":"def find_maximized_capital(k, w, profits, capital):\n    projects = sorted(zip(capital, profits))\n    affordable = []                 # max-heap of profits, negated\n    i = 0\n\n    for _ in range(k):\n        while i < len(projects) and projects[i][0] <= w:\n            heapq.heappush(affordable, -projects[i][1])\n            i += 1\n        if not affordable:\n            break                   # nothing reachable, capital cannot grow\n        w -= heapq.heappop(affordable)\n    return w","frames":[{"caption":"<strong>Two heaps: affordable by capital, best by profit</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>find_maximized_capital(k=3, w=0, profits=[1, 2, 3], capital=[0, 1, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"profits","label":"profits","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"capital","label":"capital","v":["0","1","2"],"cls":["","",""]}],"vars":[["k","3",0],["w","0",0]],"stack":[]},{"caption":"<code>projects = sorted(zip(capital, profits))</code> &mdash; <code>projects = [(0, 1), (1, 2), (2, 3)]</code>","line":2,"panels":[{"t":"arr","id":"profits","label":"profits","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"capital","label":"capital","v":["0","1","2"],"cls":["","",""]},{"t":"arr","id":"projects","label":"projects","v":["0,1","1,2","2,3"],"cls":["","",""]}],"vars":[["k","3",0],["w","0",0]],"stack":[]},{"caption":"<code>affordable = []</code> &mdash; <code>affordable = []</code> <em>(max-heap of profits, negated)</em>","line":3,"panels":[{"t":"arr","id":"profits","label":"profits","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"capital","label":"capital","v":["0","1","2"],"cls":["","",""]},{"t":"arr","id":"projects","label":"projects","v":["0,1","1,2","2,3"],"cls":["","",""]},{"t":"arr","id":"affordable","label":"affordable","v":[],"cls":[],"noidx":true}],"vars":[["k","3"