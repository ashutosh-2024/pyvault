{"chapters":[{"title":"Set, then sort back in","code":"def remove_duplicates(nums):\n    uniq = sorted(set(nums))\n    nums[:len(uniq)] = uniq\n    return len(uniq)","frames":[{"caption":"<strong>Set, then sort back in</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>remove_duplicates(nums=[1, 1, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","2"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>uniq = sorted(set(nums))</code> &mdash; <code>uniq = [1, 2]</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","1","2"],"cls":["","",""]},{"t":"arr","id":"uniq","label":"uniq","v":["1","2"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>nums[:len(uniq)] = uniq</code> &mdash; <code>nums[1]</code> becomes <code>2</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","2"],"cls":["","cur",""]},{"t":"arr","id":"uniq","label":"uniq","v":["1","2"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>return len(uniq)</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","2"],"cls":["","",""]},{"t":"arr","id":"uniq","label":"uniq","v":["1","2"],"cls":["",""]}],"vars":[],"stack":[]}]},{"title":"Write pointer","code":"def remove_duplicates(nums):\n    k = 1\n    for x in nums[1:]:\n        if x != nums[k - 1]:\n            nums[k] = x\n            k += 1\n    return k","frames":[{"caption":"<strong>Write pointer</strong> &mdash; O(n) time, O(1) extra space. Input: <code>remove_duplicates(nums=[0, 0, 1, 1, 1, 2, 2, 3, …])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","0","1","1","1","2","2","3","3","4"],"cls":["","","","","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>k = 1</code> &mdash; <code>k = 1</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","0","1","1","1","2","2","3","3","4"],"cls":["","src","","","","","","","",""],"ptr":{"1":["k"]}}],"vars":[["k","1",1]],"stack":[]},{"caption":"<code>for x in nums[1:]:</code> &mdash; <code>x = 0</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","0","1","1","1","2","2","3","3","4"],"cls":["","src","","","","","","","",""],"ptr":{"1":["k"]}}],"vars":[["k","1",0],["x","0",1]],"stack":[]},{"caption":"<code>if x != nums[k - 1]:</code> &rarr; <strong>false</strong> (k = 1, x = 0)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","0","1","1","1","2","2","3","3","4"],"cls":["","src","","","","","","","",""],"ptr":{"1":["k"]}}],"vars":[["k","1",0],["x","0",0]],"stack":[]},{"caption":"<code>for x in nums[1:]:</code> &mdash; <code>x = 1</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","0","1","1","1","2","2","3","3","4"],"cls":["","src","","","","","","","",""],"ptr":{"1":["k"]}}],"vars":[["k","1",0],["x","1",1]],"stack":[]},{"caption":"<code>if x != nums[k - 1]:</code> &rarr; <strong>true</strong> (k = 1, x = 1)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","0","1","1","1","2","2","3","3","4"],"cls":["","src","","","","","","","",""],"ptr":{"1":["k"]}}],"vars":[["k","1",0],["x","1",0]],"stack":[]},{"caption":"<code>nums[k] = x</code> &mdash; <code>nums[1]</code> becomes <code>1</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","1","1","1","1","2","2","3","3","4"],"cls":["","cur","","","","","","","",""],"ptr":{"1":["k"]}}],"vars":[["k","1",0],["x","1",0]],"stack":[]},{"caption":"<code>k += 1</code> &mdash; <code>k = 2</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","1","1","1","1","2","2","3","3","4"],"cls":["","","src","","","","","","",""],"ptr":{"2":["k"]}}],"vars":[["k","2",1],["x","1",0]],"stack":[]},{"caption":"<code>for x in nums[1:]:</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["