18000=27000; k=3: 6000+0+6000=12000","arrows":[[1,3,1,4],[3,4,1,4]]},{"caption":"Interval [0, 4]: try each split point k in between and keep the cheapest. Best is k = 3.","grid":{"v":[["","0","24000","14000","26000"],["","","0","6000","12000"],["","","","0","9000"],["","","","","0"],["","","","",""]],"cls":[["none","base","done","src","cur"],["none","none","base","done","done"],["none","none","none","base","done"],["none","none","none","none","src"],["none","none","none","none","none"]],"rowLabels":["d0=40","d1=20","d2=30","d3=10","d4=30"],"colLabels":["d0=40","d1=20","d2=30","d3=10","d4=30"]},"formula":"k=1: 0+12000+24000=36000; k=2: 24000+9000+36000=69000; k=3: 14000+0+12000=26000","arrows":[[0,3,0,4],[3,4,0,4]]},{"caption":"Cheapest total <strong>26,000</strong> multiplications; the worst order would cost 69,000 (2.7&times; more). Interval DP tries every split of every interval exactly once, O(n&sup3;).","grid":{"v":[["","0","24000","14000","26000"],["","","0","6000","12000"],["","","","0","9000"],["","","","","0"],["","","","",""]],"cls":[["none","base","done","done","answer"],["none","none","base","done","done"],["none","none","none","base","done"],["none","none","none","none","base"],["none","none","none","none","none"]],"rowLabels":["d0=40","d1=20","d2=30","d3=10","d4=30"],"colLabels":["d0=40","d1=20","d2=30","d3=10","d4=30"]},"formula":"answer = dp[0][4] = 26000"}]}]}