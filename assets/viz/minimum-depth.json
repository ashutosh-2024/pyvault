88","20",3.0,1.25,"done",[]],["n4427916272","7",4.0,2.5,"done",[]]],"edges":[["n4428046960","n4427819408","",""],["n4428046960","n4427820688","",""],["n4427820688","n4427916576","",""],["n4427820688","n4427916272","",""]],"dir":false},{"t":"arr","id":"range:left","label":"search range","v":["1","2"],"cls":["","cur"],"keys":["left","right"]}],"vars":[["left","1",0],["right","2",1]],"stack":[]},{"caption":"<code>return 1 + min(left, right)</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":7,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427819408","9",0.0,1.25,"done",[]],["n4428046960","3",1.0,0.0,"cur",["root"]],["n4427916576","15",2.0,2.5,"done",[]],["n4427820688","20",3.0,1.25,"done",[]],["n4427916272","7",4.0,2.5,"done",[]]],"edges":[["n4428046960","n4427819408","",""],["n4428046960","n4427820688","",""],["n4427820688","n4427916576","",""],["n4427820688","n4427916272","",""]],"dir":false},{"t":"arr","id":"range:left","label":"search range","v":["1","2"],"cls":["",""],"keys":["left","right"]}],"vars":[["left","1",0],["right","2",0]],"stack":[]}],"example":1},{"title":"BFS with early exit","code":"def min_depth(root):\n    if root is None:\n        return 0\n    depth, queue = 1, deque([root])\n    while queue:\n        for _ in range(len(queue)):\n            node = queue.popleft()\n            if node.left is None and node.right is None:\n                return depth               # first leaf wins\n            if node.left is not None:\n                queue.append(node.left)\n            if node.right is not None:\n                queue.append(node.right)\n        depth += 1\n    return depth","frames":[{"caption":"<strong>BFS with early exit</strong> &mdash; O(n) worst case time, O(w) extra space. Input: <code>min_depth(root=tree (3))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427821648","9",0.0,1.25,"",[]],["n4428047632","3",1.0,0.0,"c