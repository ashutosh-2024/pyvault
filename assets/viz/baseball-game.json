{"chapters":[{"title":"Stack of valid scores","code":"def cal_points(operations):\n    stack = []\n    for op in operations:\n        if op == \"+\":\n            stack.append(stack[-1] + stack[-2])\n        elif op == \"D\":\n            stack.append(2 * stack[-1])\n        elif op == \"C\":\n            stack.pop()\n        else:\n            stack.append(int(op))\n    return sum(stack)","frames":[{"caption":"<strong>Stack of valid scores</strong> &mdash; O(n) time, O(n) extra space. Input: <code>cal_points(operations=['5', '-2', '4', 'C', 'D', '9', '+', '+'])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"operations","label":"operations","v":["5","-2","4","C","D","9","+","+"],"cls":["","","","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>stack = []</code> &mdash; <code>stack = []</code>","line":2,"panels":[{"t":"arr","id":"operations","label":"operations","v":["5","-2","4","C","D","9","+","+"],"cls":["","","","","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>for op in operations:</code> &mdash; <code>op = '5'</code>","line":3,"panels":[{"t":"arr","id":"operations","label":"operations","v":["5","-2","4","C","D","9","+","+"],"cls":["","","","","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["op","'5'",1]],"stack":[]},{"caption":"<code>if op == \"+\":</code> &rarr; <strong>false</strong> (op = '5')","line":4,"panels":[{"t":"arr","id":"operations","label":"operations","v":["5","-2","4","C","D","9","+","+"],"cls":["","","","","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["op","'5'",0]],"stack":[]},{"caption":"<code>elif op == \"D\":</code> &rarr; <strong>false</strong> (op = '5')","line":6,"panels":[{"t":"arr","id":"operations","label":"operations","v":["5","-2","4","C","D","9","+","+"],"cls":["","","","","","","",""]},{"t":"arr","id":"stac