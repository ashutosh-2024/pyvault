/code>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["o","l","l","e","h"],"cls":["","","","","cur"],"ptr":{"4":["i"]}},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["i","4",0]],"stack":[]},{"caption":"<code>for i in range(len(s)):</code> &mdash; returns <code>None</code>. <strong>Result: None</strong>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["o","l","l","e","h"],"cls":["","","","","src"],"ptr":{"4":["i"]}},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["i","4",0]],"stack":[]}],"example":1},{"title":"Recursive swap of the ends","code":"def reverse_string(s):\n    def go(lo, hi):\n        if lo < hi:\n            s[lo], s[hi] = s[hi], s[lo]\n            go(lo + 1, hi - 1)\n    go(0, len(s) - 1)","frames":[{"caption":"<strong>Recursive swap of the ends</strong> &mdash; O(n) time, O(n) extra space. Input: <code>reverse_string(s=['h', 'e', 'l', 'l', 'o'])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["h","e","l","l","o"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>def go(lo, hi):</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["h","e","l","l","o"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>go(0, len(s) - 1)</code> &mdash; calls <code>go(lo=0, hi=4)</code>","line":6,"panels":[{"t":"arr","id":"s","label":"s","v":["h","e","l","l","o"],"cls":["src","","","","src"],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["lo","0",1],["hi","4",1]],"stack":["reverse_string(s)","go(lo=0, hi=4)"]},{"caption":"<code>if lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 4, lo = 0)","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["h","e","l","l","o"],"cls":["src","","","","src"],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["lo","0",0],["hi","4",0]],"stack":["reverse_string(s)","go(lo=0, hi=4)"]},{"caption":"<code>s[lo], s[hi] = s[hi], s[lo]</code> &mdash; swap <code>s[0]</