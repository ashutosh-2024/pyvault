{"chapters":[{"title":"Push onto a stack, pop back","code":"def reverse_string(s):\n    stack = list(s)\n    for i in range(len(s)):\n        s[i] = stack.pop()","frames":[{"caption":"<strong>Push onto a stack, pop back</strong> &mdash; O(n) time, O(n) extra space. Input: <code>reverse_string(s=['h', 'e', 'l', 'l', 'o'])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["h","e","l","l","o"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>stack = list(s)</code> &mdash; <code>stack = ['h', 'e', 'l', 'l', 'o']</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["h","e","l","l","o"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":["h","e","l","l","o"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>for i in range(len(s)):</code> &mdash; <code>i = 0</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["h","e","l","l","o"],"cls":["src","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"stack","label":"stack","v":["h","e","l","l","o"],"cls":["","","","",""]}],"vars":[["i","0",1]],"stack":[]},{"caption":"<code>s[i] = stack.pop()</code> &mdash; <code>s[0]</code> becomes <code>'o'</code>; <code>'o'</code> popped off the end of <code>stack</code>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["o","e","l","l","o"],"cls":["cur","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"stack","label":"stack","v":["h","e","l","l"],"cls":["","","",""]}],"vars":[["i","0",0]],"stack":[]},{"caption":"<code>for i in range(len(s)):</code> &mdash; <code>i = 1</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["o","e","l","l","o"],"cls":["","src","","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"stack","label":"stack","v":["h","e","l","l"],"cls":["","","",""]}],"vars":[["i","1",1]],"stack":[]},{"caption":"<code>s[i] = stack.pop()</code> &mdash; <code>s[1]</code> becomes <code>'l'</code>; <code>'l'</code> popped off the end of <code>stack</c