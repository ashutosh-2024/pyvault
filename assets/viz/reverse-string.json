hi], s[lo]</code> &mdash; swap <code>s[1]</code> and <code>s[3]</code>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["o","l","l","e","h"],"cls":["","cur","","cur",""],"ptr":{"3":["hi"],"1":["lo"]}}],"vars":[["lo","1",0],["hi","3",0]],"stack":[]},{"caption":"<code>lo, hi = lo + 1, hi - 1</code> &mdash; <code>lo = 2</code>; <code>hi = 2</code>","line":5,"panels":[{"t":"arr","id":"s","label":"s","v":["o","l","l","e","h"],"cls":["","","src","",""],"ptr":{"2":["hi","lo"]}}],"vars":[["lo","2",1],["hi","2",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>false</strong> (hi = 2, lo = 2) &mdash; returns <code>None</code>. <strong>Result: None</strong>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["o","l","l","e","h"],"cls":["","","src","",""],"ptr":{"2":["hi","lo"]}}],"vars":[["lo","2",0],["hi","2",0]],"stack":[]}],"example":1}]}