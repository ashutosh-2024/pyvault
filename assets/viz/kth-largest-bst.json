{"chapters":[{"title":"Reverse inorder, stop at k","code":"def kth_largest(root, k):\n    stack, node = [], root\n    while True:\n        while node is not None:\n            stack.append(node)\n            node = node.right                # mirror of inorder\n        node = stack.pop()\n        k -= 1\n        if k == 0:\n            return node.val\n        node = node.left","frames":[{"caption":"<strong>Reverse inorder, stop at k</strong> &mdash; O(h + k) time, O(h) extra space. Input: <code>kth_largest(root=tree (5), k=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455411024","1",0.0,3.75,"",[]],["n4455296672","2",1.0,2.5,"",[]],["n4455197072","3",2.0,1.25,"",[]],["n4455295152","4",3.0,2.5,"",[]],["n4455424288","5",4.0,0.0,"cur",["root"]],["n4455201552","6",5.0,1.25,"",[]]],"edges":[["n4455424288","n4455197072","",""],["n4455197072","n4455296672","",""],["n4455296672","n4455411024","",""],["n4455197072","n4455295152","",""],["n4455424288","n4455201552","",""]],"dir":false}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>stack, node = [], root</code> &mdash; <code>stack = []</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455411024","1",0.0,3.75,"",[]],["n4455296672","2",1.0,2.5,"",[]],["n4455197072","3",2.0,1.25,"",[]],["n4455295152","4",3.0,2.5,"",[]],["n4455424288","5",4.0,0.0,"cur",["root","node"]],["n4455201552","6",5.0,1.25,"",[]]],"edges":[["n4455424288","n4455197072","",""],["n4455197072","n4455296672","",""],["n4455296672","n4455411024","",""],["n4455197072","n4455295152","",""],["n4455424288","n4455201552","",""]],"dir":false},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["k","2",0]],"stack":[]},{"caption":"<code>while True:</code> &rarr; <strong>true</strong>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455411024","1",0.0,3.75,"",[]],["n4455296672","2",1.0,2.5,"",[]],["n4