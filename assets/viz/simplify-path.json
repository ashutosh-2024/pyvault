{"chapters":[{"title":"Split on '/', stack of directory names","code":"def simplify_path(path):\n    stack = []\n    for part in path.split(\"/\"):\n        if part == \"..\":\n            if stack:\n                stack.pop()\n        elif part and part != \".\":\n            stack.append(part)\n    return \"/\" + \"/\".join(stack)","frames":[{"caption":"<strong>Split on '/', stack of directory names</strong> &mdash; O(n) time, O(n) extra space. Input: <code>simplify_path(path='/.../a/../b/c/../d/./')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"path","label":"path","v":["/",".",".",".","/","a","/",".",".","/","b","/","c","/",".",".","/","d","/",".","/"],"cls":["","","","","","","","","","","","","","","","","","","","",""]}],"vars":[["path","'/.../a/../b/c/../d/./'",0]],"stack":[]},{"caption":"<code>stack = []</code> &mdash; <code>stack = []</code>","line":2,"panels":[{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["path","'/.../a/../b/c/../d/./'",0]],"stack":[]},{"caption":"<code>for part in path.split(\"/\"):</code> &mdash; <code>part = ''</code>","line":3,"panels":[{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["path","'/.../a/../b/c/../d/./'",0],["part","''",1]],"stack":[]},{"caption":"<code>if part == \"..\":</code> &rarr; <strong>false</strong> (part = '')","line":4,"panels":[{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["path","'/.../a/../b/c/../d/./'",0],["part","''",0]],"stack":[]},{"caption":"<code>elif part and part != \".\":</code> &rarr; <strong>false</strong> (part = '')","line":7,"panels":[{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["path","'/.../a/../b/c/../d/./'",0],["part","''",0]],"stack":[]},{"caption":"<code>for part in path.split(\"/\"):</code> &mdash; <code>part = '...'</code>","line":3,"panels":[{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx