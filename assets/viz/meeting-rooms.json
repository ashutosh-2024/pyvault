{"chapters":[{"title":"Sort by start, compare neighbours","code":"def can_attend_meetings(intervals):\n    intervals.sort()\n    for i in range(1, len(intervals)):\n        if intervals[i][0] < intervals[i - 1][1]:\n            return False\n    return True","frames":[{"caption":"<strong>Sort by start, compare neighbours</strong> &mdash; O(n log n) time, O(1) extra space. Input: <code>can_attend_meetings(intervals=[[7, 10], [2, 4], [4, 7]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["7,10","2,4","4,7"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>intervals.sort()</code> &mdash; <code>intervals</code> is now <code>[[2, 4], [4, 7], [7, 10]]</code>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["2,4","4,7","7,10"],"cls":["cur","cur","cur"]}],"vars":[],"stack":[]},{"caption":"<code>for i in range(1, len(intervals)):</code> &mdash; <code>i = 1</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["2,4","4,7","7,10"],"cls":["","src",""],"ptr":{"1":["i"]}}],"vars":[["i","1",1]],"stack":[]},{"caption":"<code>if intervals[i][0] &lt; intervals[i - 1][1]:</code> &rarr; <strong>false</strong> (i = 1)","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["2,4","4,7","7,10"],"cls":["","src",""],"ptr":{"1":["i"]}}],"vars":[["i","1",0]],"stack":[]},{"caption":"<code>for i in range(1, len(intervals)):</code> &mdash; <code>i = 2</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["2,4","4,7","7,10"],"cls":["","","src"],"ptr":{"2":["i"]}}],"vars":[["i","2",1]],"stack":[]},{"caption":"<code>if intervals[i][0] &lt; intervals[i - 1][1]:</code> &rarr; <strong>false</strong> (i = 2)","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["2,4","4,7","7,10"],"cls":["","","src"],"ptr":{"2":["i"]}}],"vars":[["i","2",0]],"stack":[]},{"caption":"<code>for i in range(1, len(intervals)):</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["2,4","4,7","7,10"],"cls":["","","src"],"ptr":{"2":["i"]}}],"vars":[["i","2",0]],"stack":[]},{"caption":"<code>return True</code> &mdash; returns <code>T</code>. <strong>Result: T</strong>","line":6,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["2,4","4,7","7,10"],"cls":["","","src"],"ptr":{"2":["i"]}}],"vars":[["i","2",0]],"stack":[]}],"example":1}]}