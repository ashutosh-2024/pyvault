esent (set)","v":["1","2","3","4","100","200"],"cls":["","","","","",""],"noidx":true}],"vars":[["best","4",0],["x","2",0],["length","3",1]],"stack":[]},{"caption":"<code>while x + length in present:</code> &rarr; <strong>false</strong> (length = 3, x = 2)","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["100","4","200","1","3","2"],"cls":["","","","","",""]},{"t":"arr","id":"present","label":"present (set)","v":["1","2","3","4","100","200"],"cls":["","","","","",""],"noidx":true}],"vars":[["best","4",0],["x","2",0],["length","3",0]],"stack":[]},{"caption":"<code>best = max(best, length)</code>","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["100","4","200","1","3","2"],"cls":["","","","","",""]},{"t":"arr","id":"present","label":"present (set)","v":["1","2","3","4","100","200"],"cls":["","","","","",""],"noidx":true}],"vars":[["best","4",0],["x","2",0],["length","3",0]],"stack":[]},{"caption":"<code>for x in nums:</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["100","4","200","1","3","2"],"cls":["","","","","",""]},{"t":"arr","id":"present","label":"present (set)","v":["1","2","3","4","100","200"],"cls":["","","","","",""],"noidx":true}],"vars":[["best","4",0],["x","2",0],["length","3",0]],"stack":[]},{"caption":"<code>return best</code> &mdash; returns <code>4</code>. <strong>Result: 4</strong>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["100","4","200","1","3","2"],"cls":["","","","","",""]},{"t":"arr","id":"present","label":"present (set)","v":["1","2","3","4","100","200"],"cls":["","","","","",""],"noidx":true}],"vars":[["best","4",0],["x","2",0],["length","3",0]],"stack":[]}],"example":1},{"title":"Sort and scan","code":"def longest_consecutive(nums):\n    if not nums:\n        return 0\n    nums = sorted(nums)\n    best = cur = 1\n    for a, b in zip(nums, nums[1:]):\n        if b == a + 1:\n            cur += 1\n            best = max(best, cur)\n        elif b != a:\n            cur = 1\