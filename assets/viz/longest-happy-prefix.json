{"chapters":[{"title":"Try every length, longest first","code":"def longest_prefix(s):\n    for L in range(len(s) - 1, 0, -1):\n        if s[:L] == s[-L:]:\n            return s[:L]\n    return \"\"","frames":[{"caption":"<strong>Try every length, longest first</strong> &mdash; O(n&sup2;) time, O(n) extra space. Input: <code>longest_prefix(s='level')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["l","e","v","e","l"],"cls":["","","","",""]}],"vars":[["s","'level'",0]],"stack":[]},{"caption":"<code>for L in range(len(s) - 1, 0, -1):</code> &mdash; <code>L = 4</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["l","e","v","e","l"],"cls":["","","","",""]}],"vars":[["s","'level'",0],["L","4",1]],"stack":[]},{"caption":"<code>if s[:L] == s[-L:]:</code> &rarr; <strong>false</strong> (L = 4, s = 'level')","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["l","e","v","e","l"],"cls":["","","","",""]}],"vars":[["s","'level'",0],["L","4",0]],"stack":[]},{"caption":"<code>for L in range(len(s) - 1, 0, -1):</code> &mdash; <code>L = 3</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["l","e","v","e","l"],"cls":["","","","",""]}],"vars":[["s","'level'",0],["L","3",1]],"stack":[]},{"caption":"<code>if s[:L] == s[-L:]:</code> &rarr; <strong>false</strong> (L = 3, s = 'level')","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["l","e","v","e","l"],"cls":["","","","",""]}],"vars":[["s","'level'",0],["L","3",0]],"stack":[]},{"caption":"<code>for L in range(len(s) - 1, 0, -1):</code> &mdash; <code>L = 2</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["l","e","v","e","l"],"cls":["","","","",""]}],"vars":[["s","'level'",0],["L","2",1]],"stack":[]},{"caption":"<code>if s[:L] == s[-L:]:</code> &rarr; <strong>false</strong> (L = 2, s = 'level')","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["l","e","v","e","l"],"cls":["","","","",""]}],"vars":[["s","'level'",0],["L","2",0]],"stack":[]},{"caption":"<code>for L in range(len(s) - 1, 0, -1):</code> &mdash; <code>L = 1</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["l","e","v","e","l"],"cls":["","","","",""]}],"vars":[["s","'level'",0],["L","1",1]],"stack":[]},{"caption":"<code>if s[:L] == s[-L:]:</code> &rarr; <strong>true</strong> (L = 1, s = 'level')","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["l","e","v","e","l"],"cls":["","","","",""]}],"vars":[["s","'level'",0],["L","1",0]],"stack":[]},{"caption":"<code>return s[:L]</code> &mdash; returns <code>'l'</code>. <strong>Result: 'l'</strong>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["l","e","v","e","l"],"cls":["","","","",""]}],"vars":[["s","'level'",0],["L","1",0]],"stack":[]}]},{"title":"Prefix function","code":"def longest_prefix(s):\n    pi, k = [0] * len(s), 0\n    for i in range(1, len(s)):\n        while k and s[i] != s[k]:\n            k = pi[k - 1]\n        if s[i] == s[k]:\n            k += 1\n        pi[i] = k\n    return s[:pi[-1]] if s else \"\"","frames":[{"caption":"<strong>Prefix function</strong> &mdash; O(n) time, O(n) extra space. Input: <code>longest_prefix(s='ababab')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","a","b","a","b"],"cls":["","","","","",""]}],"vars":[["s","'ababab'",0]],"stack":[]},{"caption":"<code>pi, k = [0] * len(s), 0</code> &mdash; <code>pi = [0, 0, 0, 0, 0, 0]</code>; <code>k = 0</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","a","b","a","b"],"cls":["src","","","","",""],"ptr":{"0":["k"]}},{"t":"arr","id":"pi","label":"pi","v":["0","0","0","0","0","0"],"cls":["src","","","","",""],"ptr":{"0":["k"]}}],"vars":[["s","'ababab'",0],["k","0",1]],"stack":[]},{"caption":"<code>for i in range(1, len(s)):</code> &mdash; <code>i = 1</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","a","b","a","b"],"cls":["src","src","","","",""],"ptr":{"1":["i"],"0":["k"]}},{"t":"arr","id":"pi","label":"pi","v":["0","0","0","0","0","0"],"cls":["src","src","","","",""],"ptr":{"1":["i"],"0":["k"]}}],"vars":[["s","'ababab'",0],["k","0",0],["i","1",1]],"stack":[]},{"caption":"<code>while k and s[i] != s[k]:</code> &rarr; <strong>false</strong> (i = 1, k = 0, s = 'ababab')","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","a","b","a","b"],"cls":["src","src","","","",""],"ptr":{"1":["i"],"0":["k"]}},{"t":"arr","id":"pi","label":"pi","v":["0","0","0","0","0","0"],"cls":["src","src","","","",""],"ptr":{"1":["i"],"0":["k"]}}],"vars":[["s","'ababab'",0],["k","0",0],["i","1",0]],"stack":[]},{"caption":"<code>if s[i] == s[k]:</code> &rarr; <strong>false</strong> (i = 1, k = 0, s = 'ababab')","line":6,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","a","b","a","b"],"cls":["src","src","","","",""],"ptr":{"1":["i"],"0":["k"]}},{"t":"arr","id":"pi","label":"pi","v":["0","0","0","0","0","0"],"cls":["src","src","","","",""],"ptr":{"1":["i"],"0":["k"]}}],"vars":[["s","'ababab'",0],["k","0",0],["i","1",0]],"stack":[]},{"caption":"<code>pi[i] = k</code>","line":8,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","a","b","a","b"],"cls":["src","src","","","",""],"ptr":{"1":["i"],"0":["k"]}},{"t":"arr","id":"pi","label":"pi","v":["0","0","0","0","0","0"],"cls":["src","src","","","",""],"ptr":{"1":["i"],"0":["k"]}}],"vars":[["s","'ababab'",0],["k","0",0],["i","1",0]],"stack":[]},{"caption":"<code>for i in range(1, len(s)):</code> &mdash; <code>i = 2</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","a","b","a","b"],"cls":["src","","src","","",""],"ptr":{"2":["i"],"0":["k"]}},{"t":"arr","id":"pi","label":"pi","v":["0","0","0","0","0","0"],"cls":["src","","src","","",""],"ptr":{"2":["i"],"0":["k"]}}],"vars":[["s","'ababab'",0],["k","0",0],["i","2",1]],"stack":[]},{"caption":"<code>while k and s[i] != s[k]:</code> &rarr; <strong>false</strong> (i = 2, k = 0, s = 'ababab')","line":4,"p