{"chapters":[{"title":"Scan for the minimum","code":"class MinStack:\n    def __init__(self):\n        self.s = []\n\n    def push(self, val):\n        self.s.append(val)\n\n    def pop(self):\n        self.s.pop()\n\n    def top(self):\n        return self.s[-1]\n\n    def getMin(self):\n        return min(self.s)","frames":[{"caption":"<strong>Scan for the minimum</strong> &mdash; getMin O(n) time, O(n) extra space. Running <code>m = MinStack(); m.push(-2); m.push(0); m.push(-3); assert m.getMin() == -3; m.pop() …</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","i","n","S","t","a","c","k"],"cls":["","","","","","","",""]}],"vars":[["self","'MinStack'",0]],"stack":[]},{"caption":"<code>self.s = []</code> &mdash; returns <code>None</code>; <code>self.s = []</code>","line":3,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>-2</code> appended; <code>val = -2</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2"],"cls":["cur"]}],"vars":[["val","-2",1]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>0</code> appended; <code>val = 0</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0"],"cls":["","cur"]}],"vars":[["val","0",1]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>-3</code> appended; <code>val = -3</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0","-3"],"cls":["","","cur"]}],"vars":[["val","-3",1]],"stack":[]},{"caption":"<code>return min(self.s)</code> &mdash; returns <code>-3</code>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0","-3"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>self.s.pop()</code> &mdash; returns <code>None</code>; <code>-3</code> popped off the end of <code>self.s</code>","line":9,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.s[-1]</code> &mdash; returns <code>0</code>","line":12,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>return min(self.s)</code> &mdash; returns <code>-2</code>. <strong>Result: -2</strong>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0"],"cls":["",""]}],"vars":[],"stack":[]}]},{"title":"Store (value, min so far) pairs","code":"class MinStack:\n    def __init__(self):\n        self.s = []                                  # (value, min so far)\n\n    def push(self, val):\n        self.s.append((val, min(val, self.s[-1][1]) if self.s else val))\n\n    def pop(self):\n        self.s.pop()\n\n    def top(self):\n        return self.s[-1][0]\n\n    def getMin(self):\n        return self.s[-1][1]","frames":[{"caption":"<strong>Store (value, min so far) pairs</strong> &mdash; O(1) all time, O(n) extra space. Running <code>m = MinStack(); m.push(-2); m.push(0); m.push(-3); assert m.getMin() == -3; m.pop() …</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","i","n","S","t","a","c","k"],"cls":["","","","","","","",""]}],"vars":[["self","'MinStack'",0]],"stack":[]},{"caption":"<code>self.s = []</code> &mdash; returns <code>None</code>; <code>self.s = []</code> <em>((value, min so far))</em>","line":3,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.s.append((val, min(val, self.s[-1][1]) if self.s else val))</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>(-2, -2)</code> appended; <code>val = -2</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2,-2"],"cls":["cur"]}],"vars":[["val","-2",1]],"stack":[]},{"caption":"<code>self.s.append((val, min(val, self.s[-1][1]) if self.s else val))</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>(0, -2)</code> appended; <code>val = 0</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2,-2","0,-2"],"cls":["","cur"]}],"vars":[["val","0",1]],"stack":[]},{"caption":"<code>self.s.append((val, min(val, self.s[-1][1]) if self.s else val))</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>(-3, -3)</code> appended; <code>val = -3</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2,-2","0,-2","-3,-3"],"cls":["","","cur"]}],"vars":[["val","-3",1]],"stack":[]},{"caption":"<code>return self.s[-1][1]</code> &mdash; returns <code>-3</code>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2,-2","0,-2","-3,-3"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>self.s.pop()</code> &mdash; returns <code>None</code>; <code>(-3, -3)</code> popped off the end of <code>self.s</code>","line":9,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2,-2","0,-2"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.s[-1][0]</code> &mdash; returns <code>0</code>","line":12,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2,-2","0,-2"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.s[-1][1]</code> &mdash; returns <code>-2</code>. <strong>Result: -2</strong>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2,-2","0,-2"],"cls":["",""]}],"vars":[],"stack":[]}]},{"title":"Second stack of minimums, pushed only when needed","code":"class MinStack:\n    def __init__(self):\n        self.s, self.mins = [], []\n\n    def push(self, val):\n        self.s.append(val)\n        if not self.mins or val <= self.mins[-1]:\n            self.mins.append(val)\n\n    def pop(self):\n        if self.s.pop() == self.mins[-1]:\n            self.mins.pop()\n\n    def top(self):\n        return self.s[-1]\n\n    def getMin(self):\n        return self.mins[-1]","frames":[{"caption":"<strong>Second stack of minimums, pushed only when needed</strong> &mdash; O(1) all time, O(n) worst, less in practice extra space. Running <code>m = MinStack(); m.push(-2); m.push(0); m.push(-3); assert m.getMin() == -3; m.pop() …</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","i","n","S","t","a","c","k"],"cls":["","","","","","","",""]}],"vars":[["self","'MinStack'",0]],"stack":[]},{"caption":"<code>self.s, self.mins = [], []</code> &mdash; returns <code>None</code>; <code>self.s = []</code>; <code>self.mins = []</code>","line":3,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.mins","label":"self.mins","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; <code>self.s</code> gets <code>-2</code> appended; <code>val = -2</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2"],"cls":["cur"]},{"t":"arr","id":"self.mins","label":"self.mins","v":[],"cls":[],"noidx":true}],"vars":[["val","-2",1]],"stack":[]},{"caption":"<code>if not self.mins or val &lt;= self.mins[-1]:</code> &rarr; <strong>true</strong> (val = -2)","line":7,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2"],"cls":[""]},{"t":"arr","id":"self.mins","label":"self.mins","v":[],"cls":[],"noidx":true}],"vars":[["val","-2",0]],"stack":[]},{"caption":"<code>self.mins.append(val)</code> &mdash; returns <code>None</code>; <code>self.mins</code> gets <code>-2</code> appended","line":8,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2"],"cls":[""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["-2"],"cls":["cur"]}],"vars":[["val","-2",0]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; <code>self.s</code> gets <code>0</code> appended; <code>val = 0</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0"],"cls":["","cur"]},{"t":"arr","id":"self.mins","label":"self.mins","v":["-2"],"cls":[""]}],"vars":[["val","0",1]],"stack":[]},{"caption":"<code>if not self.mins or val &lt;= self.mins[-1]:</code> &rarr; <strong>false</strong> (val = 0) &mdash; returns <code>None</code>","line":7,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0"],"cls":["",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["-2"],"cls":[""]}],"vars":[["val","0",0]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; <code>self.s</code> gets <code>-3</code> appended; <code>val = -3</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0","-3"],"cls":["","","cur"]},{"t":"arr","id":"self.mins","label":"self.mins","v":["-2"],"cls":[""]}],"vars":[["val","-3",1]],"stack":[]},{"caption":"<code>if not self.mins or val &lt;= self.mins[-1]:</code> &rarr; <strong>true</strong> (val = -3)","line":7,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0","-3"],"cls":["","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["-2"],"cls":[""]}],"vars":[["val","-3",0]],"stack":[]},{"caption":"<code>self.mins.append(val)</code> &mdash; returns <code>None</code>; <code>self.mins</code> gets <code>-3</code> appended","line":8,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0","-3"],"cls":["","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["-2","-3"],"cls":["","cur"]}],"vars":[["val","-3",0]],"stack":[]},{"caption":"<code>return self.mins[-1]</code> &mdash; returns <code>-3</code>","line":18,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0","-3"],"cls":["","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["-2","-3"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>if self.s.pop() == self.mins[-1]:</code> &mdash; <code>-3</code> popped off the end of <code>self.s</code>","line":11,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0"],"cls":["",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["-2","-3"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>self.mins.pop()</code> &mdash; returns <code>None</code>; <code>-3</code> popped off the end of <code>self.mins</code>","line":12,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0"],"cls":["",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["-2"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>return self.s[-1]</code> &mdash; returns <code>0</code>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0"],"cls":["",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["-2"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>return self.mins[-1]</code> &mdash; returns <code>-2</code>. <strong>Result: -2</strong>","line":18,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["-2","0"],"cls":["",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["-2"],"cls":[""]}],"vars":[],"stack":[]}]},{"title":"One stack of differences from the minimum","code":"class MinStack:\n    def __init__(self):\n        self.s, self.min = [], None\n\n    def push(self, val):\n        if not self.s:\n            self.s.append(0)\n            self.min = val\n        else:\n            self.s.append(val - self.min)\n            if val < self.min:\n                self.min = val                         # diff < 0 marks a new min\n\n    def pop(self):\n        diff = self.s.pop()\n        if diff < 0:\n            self.min -= diff                           # restore the previous min\n        if not self.s:\n            self.min = None\n\n    def top(self):\n        diff = self.s[-1]\n        return self.min if diff < 0 else self.min + diff\n\n    def getMin(self):\n        return self.min","frames":[{"caption":"<strong>One stack of differences from the minimum</strong> &mdash; O(1) all time, O(1) extra beyond the values extra space. Running <code>m = MinStack(); m.push(-2); m.push(0); m.push(-3); assert m.getMin() == -3; m.pop() …</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","i","n","S","t","a","c","k"],"cls":["","","","","","","",""]}],"vars":[["self","'MinStack'",0]],"stack":[]},{"caption":"<code>self.s, self.min = [], None</code> &mdash; returns <code>None</code>; <code>self.s = []</code>; <code>self.min = None</code>","line":3,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true}],"vars":[["self.min","None",1]],"stack":[]},{"caption":"<code>if not self.s:</code> &rarr; <strong>true</strong> &mdash; <code>val = -2</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true}],"vars":[["self.min","None",0],["val","-2",1]],"stack":[]},{"caption":"<code>self.s.append(0)</code> &mdash; <code>self.s</code> gets <code>0</code> appended","line":7,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0"],"cls":["cur"]}],"vars":[["self.min","None",0],["val","-2",0]],"stack":[]},{"caption":"<code>self.min = val</code> &mdash; returns <code>None</code>; <code>self.min = -2</code>","line":8,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0"],"cls":[""]}],"vars":[["self.min","-2",1],["val","-2",0]],"stack":[]},{"caption":"<code>if not self.s:</code> &rarr; <strong>false</strong> &mdash; <code>val = 0</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0"],"cls":[""]}],"vars":[["self.min","-2",0],["val","0",1]],"stack":[]},{"caption":"<code>self.s.append(val - self.min)</code> &mdash; <code>self.s</code> gets <code>2</code> appended","line":10,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2"],"cls":["","cur"]}],"vars":[["self.min","-2",0],["val","0",0]],"stack":[]},{"caption":"<code>if val &lt; self.min:</code> &rarr; <strong>false</strong> (val = 0) &mdash; returns <code>None</code>","line":11,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2"],"cls":["",""]}],"vars":[["self.min","-2",0],["val","0",0]],"stack":[]},{"caption":"<code>if not self.s:</code> &rarr; <strong>false</strong> &mdash; <code>val = -3</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2"],"cls":["",""]}],"vars":[["self.min","-2",0],["val","-3",1]],"stack":[]},{"caption":"<code>self.s.append(val - self.min)</code> &mdash; <code>self.s</code> gets <code>-1</code> appended","line":10,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2","-1"],"cls":["","","cur"]}],"vars":[["self.min","-2",0],["val","-3",0]],"stack":[]},{"caption":"<code>if val &lt; self.min:</code> &rarr; <strong>true</strong> (val = -3)","line":11,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2","-1"],"cls":["","",""]}],"vars":[["self.min","-2",0],["val","-3",0]],"stack":[]},{"caption":"<code>self.min = val</code> &mdash; returns <code>None</code>; <code>self.min = -3</code> <em>(diff &lt; 0 marks a new min)</em>","line":12,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2","-1"],"cls":["","",""]}],"vars":[["self.min","-3",1],["val","-3",0]],"stack":[]},{"caption":"<code>return self.min</code> &mdash; returns <code>-3</code>","line":26,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2","-1"],"cls":["","",""]}],"vars":[["self.min","-3",0]],"stack":[]},{"caption":"<code>diff = self.s.pop()</code> &mdash; <code>-1</code> popped off the end of <code>self.s</code>; <code>diff = -1</code>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2"],"cls":["",""]}],"vars":[["self.min","-3",0],["diff","-1",1]],"stack":[]},{"caption":"<code>if diff &lt; 0:</code> &rarr; <strong>true</strong> (diff = -1)","line":16,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2"],"cls":["",""]}],"vars":[["self.min","-3",0],["diff","-1",0]],"stack":[]},{"caption":"<code>self.min -= diff</code> &mdash; <code>self.min = -2</code> <em>(restore the previous min)</em>","line":17,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2"],"cls":["",""]}],"vars":[["self.min","-2",1],["diff","-1",0]],"stack":[]},{"caption":"<code>if not self.s:</code> &rarr; <strong>false</strong> &mdash; returns <code>None</code>","line":18,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2"],"cls":["",""]}],"vars":[["self.min","-2",0],["diff","-1",0]],"stack":[]},{"caption":"<code>diff = self.s[-1]</code> &mdash; <code>diff = 2</code>","line":22,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2"],"cls":["",""]}],"vars":[["self.min","-2",0],["diff","2",1]],"stack":[]},{"caption":"<code>return self.min if diff &lt; 0 else self.min + diff</code> &mdash; returns <code>0</code>","line":23,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2"],"cls":["",""]}],"vars":[["self.min","-2",0],["diff","2",0]],"stack":[]},{"caption":"<code>return self.min</code> &mdash; returns <code>-2</code>. <strong>Result: -2</strong>","line":26,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","2"],"cls":["",""]}],"vars":[["self.min","-2",0]],"stack":[]}]}]}