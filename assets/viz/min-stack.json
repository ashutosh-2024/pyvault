{"chapters":[{"title":"Scan for the minimum","code":"class MinStack:\n    def __init__(self):\n        self.s = []\n\n    def push(self, val):\n        self.s.append(val)\n\n    def pop(self):\n        self.s.pop()\n\n    def top(self):\n        return self.s[-1]\n\n    def getMin(self):\n        return min(self.s)","frames":[{"caption":"<strong>Scan for the minimum</strong> &mdash; getMin O(n) time, O(n) extra space. Running <code>m = MinStack(); m.push(v); __ex = ([m.getMin(), m.pop(), m.getMin(), m.pop(), m.getMin(), m.top()])</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","i","n","S","t","a","c","k"],"cls":["","","","","","","",""]}],"vars":[["self","'MinStack'",0]],"stack":[]},{"caption":"<code>self.s = []</code> &mdash; returns <code>None</code>; <code>self.s = []</code>","line":3,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>5</code> appended; <code>val = 5</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5"],"cls":["cur"]}],"vars":[["val","5",1]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>3</code> appended; <code>val = 3</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3"],"cls":["","cur"]}],"vars":[["val","3",1]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>7</code> appended; <code>val = 7</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7"],"cls":["","","cur"]}],"vars":[["val","7",1]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>3</code> appended; <code>val = 3</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3"],"cls":["","","","cur"]}],"vars":[["val","3",1]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>1</code> appended; <code>val = 1</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3","1"],"cls":["","","","","cur"]}],"vars":[["val","1",1]],"stack":[]},{"caption":"<code>return min(self.s)</code> &mdash; returns <code>1</code>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3","1"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>self.s.pop()</code> &mdash; returns <code>None</code>; <code>1</code> popped off the end of <code>self.s</code>","line":9,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>return min(self.s)</code> &mdash; returns <code>3</code>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>self.s.pop()</code> &mdash; returns <code>None</code>; <code>3</code> popped off the end of <code>self.s</code>","line":9,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>return min(self.s)</code> &mdash; returns <code>3</code>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.s[-1]</code> &mdash; returns <code>7</code>. <strong>Result: 7</strong>","line":12,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7"],"cls":["","",""]}],"vars":[],"stack":[]}],"example":1},{"title":"Store (value, min so far) pairs","code":"class MinStack:\n    def __init__(self):\n        self.s = []                                  # (value, min so far)\n\n    def push(self, val):\n        self.s.append((val, min(val, self.s[-1][1]) if self.s else val))\n\n    def pop(self):\n        self.s.pop()\n\n    def top(self):\n        return self.s[-1][0]\n\n    def getMin(self):\n        return self.s[-1][1]","frames":[{"caption":"<strong>Store (value, min so far) pairs</strong> &mdash; O(1) all time, O(n) extra space. Running <code>m = MinStack(); m.push(v); __ex = ([m.getMin(), m.pop(), m.getMin(), m.pop(), m.getMin(), m.top()])</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","i","n","S","t","a","c","k"],"cls":["","","","","","","",""]}],"vars":[["self","'MinStack'",0]],"stack":[]},{"caption":"<code>self.s = []</code> &mdash; returns <code>None</code>; <code>self.s = []</code> <em>((value, min so far))</em>","line":3,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.s.append((val, min(val, self.s[-1][1]) if self.s else val))</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>(5, 5)</code> appended; <code>val = 5</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5,5"],"cls":["cur"]}],"vars":[["val","5",1]],"stack":[]},{"caption":"<code>self.s.append((val, min(val, self.s[-1][1]) if self.s else val))</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>(3, 3)</code> appended; <code>val = 3</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5,5","3,3"],"cls":["","cur"]}],"vars":[["val","3",1]],"stack":[]},{"caption":"<code>self.s.append((val, min(val, self.s[-1][1]) if self.s else val))</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>(7, 3)</code> appended; <code>val = 7</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5,5","3,3","7,3"],"cls":["","","cur"]}],"vars":[["val","7",1]],"stack":[]},{"caption":"<code>self.s.append((val, min(val, self.s[-1][1]) if self.s else val))</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>(3, 3)</code> appended; <code>val = 3</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5,5","3,3","7,3","3,3"],"cls":["","","","cur"]}],"vars":[["val","3",1]],"stack":[]},{"caption":"<code>self.s.append((val, min(val, self.s[-1][1]) if self.s else val))</code> &mdash; returns <code>None</code>; <code>self.s</code> gets <code>(1, 1)</code> appended; <code>val = 1</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5,5","3,3","7,3","3,3","1,1"],"cls":["","","","","cur"]}],"vars":[["val","1",1]],"stack":[]},{"caption":"<code>return self.s[-1][1]</code> &mdash; returns <code>1</code>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5,5","3,3","7,3","3,3","1,1"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>self.s.pop()</code> &mdash; returns <code>None</code>; <code>(1, 1)</code> popped off the end of <code>self.s</code>","line":9,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5,5","3,3","7,3","3,3"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.s[-1][1]</code> &mdash; returns <code>3</code>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5,5","3,3","7,3","3,3"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>self.s.pop()</code> &mdash; returns <code>None</code>; <code>(3, 3)</code> popped off the end of <code>self.s</code>","line":9,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5,5","3,3","7,3"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.s[-1][1]</code> &mdash; returns <code>3</code>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5,5","3,3","7,3"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.s[-1][0]</code> &mdash; returns <code>7</code>. <strong>Result: 7</strong>","line":12,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5,5","3,3","7,3"],"cls":["","",""]}],"vars":[],"stack":[]}],"example":1},{"title":"Second stack of minimums, pushed only when needed","code":"class MinStack:\n    def __init__(self):\n        self.s, self.mins = [], []\n\n    def push(self, val):\n        self.s.append(val)\n        if not self.mins or val <= self.mins[-1]:\n            self.mins.append(val)\n\n    def pop(self):\n        if self.s.pop() == self.mins[-1]:\n            self.mins.pop()\n\n    def top(self):\n        return self.s[-1]\n\n    def getMin(self):\n        return self.mins[-1]","frames":[{"caption":"<strong>Second stack of minimums, pushed only when needed</strong> &mdash; O(1) all time, O(n) worst, less in practice extra space. Running <code>m = MinStack(); m.push(v); __ex = ([m.getMin(), m.pop(), m.getMin(), m.pop(), m.getMin(), m.top()])</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","i","n","S","t","a","c","k"],"cls":["","","","","","","",""]}],"vars":[["self","'MinStack'",0]],"stack":[]},{"caption":"<code>self.s, self.mins = [], []</code> &mdash; returns <code>None</code>; <code>self.s = []</code>; <code>self.mins = []</code>","line":3,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.mins","label":"self.mins","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; <code>self.s</code> gets <code>5</code> appended; <code>val = 5</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5"],"cls":["cur"]},{"t":"arr","id":"self.mins","label":"self.mins","v":[],"cls":[],"noidx":true}],"vars":[["val","5",1]],"stack":[]},{"caption":"<code>if not self.mins or val &lt;= self.mins[-1]:</code> &rarr; <strong>true</strong> (val = 5)","line":7,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5"],"cls":[""]},{"t":"arr","id":"self.mins","label":"self.mins","v":[],"cls":[],"noidx":true}],"vars":[["val","5",0]],"stack":[]},{"caption":"<code>self.mins.append(val)</code> &mdash; returns <code>None</code>; <code>self.mins</code> gets <code>5</code> appended","line":8,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5"],"cls":[""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5"],"cls":["cur"]}],"vars":[["val","5",0]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; <code>self.s</code> gets <code>3</code> appended; <code>val = 3</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3"],"cls":["","cur"]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5"],"cls":[""]}],"vars":[["val","3",1]],"stack":[]},{"caption":"<code>if not self.mins or val &lt;= self.mins[-1]:</code> &rarr; <strong>true</strong> (val = 3)","line":7,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3"],"cls":["",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5"],"cls":[""]}],"vars":[["val","3",0]],"stack":[]},{"caption":"<code>self.mins.append(val)</code> &mdash; returns <code>None</code>; <code>self.mins</code> gets <code>3</code> appended","line":8,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3"],"cls":["",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3"],"cls":["","cur"]}],"vars":[["val","3",0]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; <code>self.s</code> gets <code>7</code> appended; <code>val = 7</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7"],"cls":["","","cur"]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3"],"cls":["",""]}],"vars":[["val","7",1]],"stack":[]},{"caption":"<code>if not self.mins or val &lt;= self.mins[-1]:</code> &rarr; <strong>false</strong> (val = 7) &mdash; returns <code>None</code>","line":7,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7"],"cls":["","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3"],"cls":["",""]}],"vars":[["val","7",0]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; <code>self.s</code> gets <code>3</code> appended; <code>val = 3</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3"],"cls":["","","","cur"]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3"],"cls":["",""]}],"vars":[["val","3",1]],"stack":[]},{"caption":"<code>if not self.mins or val &lt;= self.mins[-1]:</code> &rarr; <strong>true</strong> (val = 3)","line":7,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3"],"cls":["","","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3"],"cls":["",""]}],"vars":[["val","3",0]],"stack":[]},{"caption":"<code>self.mins.append(val)</code> &mdash; returns <code>None</code>; <code>self.mins</code> gets <code>3</code> appended","line":8,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3"],"cls":["","","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3","3"],"cls":["","","cur"]}],"vars":[["val","3",0]],"stack":[]},{"caption":"<code>self.s.append(val)</code> &mdash; <code>self.s</code> gets <code>1</code> appended; <code>val = 1</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3","1"],"cls":["","","","","cur"]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3","3"],"cls":["","",""]}],"vars":[["val","1",1]],"stack":[]},{"caption":"<code>if not self.mins or val &lt;= self.mins[-1]:</code> &rarr; <strong>true</strong> (val = 1)","line":7,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3","1"],"cls":["","","","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3","3"],"cls":["","",""]}],"vars":[["val","1",0]],"stack":[]},{"caption":"<code>self.mins.append(val)</code> &mdash; returns <code>None</code>; <code>self.mins</code> gets <code>1</code> appended","line":8,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3","1"],"cls":["","","","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3","3","1"],"cls":["","","","cur"]}],"vars":[["val","1",0]],"stack":[]},{"caption":"<code>return self.mins[-1]</code> &mdash; returns <code>1</code>","line":18,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3","1"],"cls":["","","","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3","3","1"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>if self.s.pop() == self.mins[-1]:</code> &mdash; <code>1</code> popped off the end of <code>self.s</code>","line":11,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3"],"cls":["","","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3","3","1"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>self.mins.pop()</code> &mdash; returns <code>None</code>; <code>1</code> popped off the end of <code>self.mins</code>","line":12,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3"],"cls":["","","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3","3"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.mins[-1]</code> &mdash; returns <code>3</code>","line":18,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7","3"],"cls":["","","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3","3"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>if self.s.pop() == self.mins[-1]:</code> &mdash; <code>3</code> popped off the end of <code>self.s</code>","line":11,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7"],"cls":["","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3","3"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>self.mins.pop()</code> &mdash; returns <code>None</code>; <code>3</code> popped off the end of <code>self.mins</code>","line":12,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7"],"cls":["","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.mins[-1]</code> &mdash; returns <code>3</code>","line":18,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7"],"cls":["","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>return self.s[-1]</code> &mdash; returns <code>7</code>. <strong>Result: 7</strong>","line":15,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["5","3","7"],"cls":["","",""]},{"t":"arr","id":"self.mins","label":"self.mins","v":["5","3"],"cls":["",""]}],"vars":[],"stack":[]}],"example":1},{"title":"One stack of differences from the minimum","code":"class MinStack:\n    def __init__(self):\n        self.s, self.min = [], None\n\n    def push(self, val):\n        if not self.s:\n            self.s.append(0)\n            self.min = val\n        else:\n            self.s.append(val - self.min)\n            if val < self.min:\n                self.min = val                         # diff < 0 marks a new min\n\n    def pop(self):\n        diff = self.s.pop()\n        if diff < 0:\n            self.min -= diff                           # restore the previous min\n        if not self.s:\n            self.min = None\n\n    def top(self):\n        diff = self.s[-1]\n        return self.min if diff < 0 else self.min + diff\n\n    def getMin(self):\n        return self.min","frames":[{"caption":"<strong>One stack of differences from the minimum</strong> &mdash; O(1) all time, O(1) extra beyond the values extra space. Running <code>m = MinStack(); m.push(v); __ex = ([m.getMin(), m.pop(), m.getMin(), m.pop(), m.getMin(), m.top()])</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","i","n","S","t","a","c","k"],"cls":["","","","","","","",""]}],"vars":[["self","'MinStack'",0]],"stack":[]},{"caption":"<code>self.s, self.min = [], None</code> &mdash; returns <code>None</code>; <code>self.s = []</code>; <code>self.min = None</code>","line":3,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true}],"vars":[["self.min","None",1]],"stack":[]},{"caption":"<code>if not self.s:</code> &rarr; <strong>true</strong> &mdash; <code>val = 5</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true}],"vars":[["self.min","None",0],["val","5",1]],"stack":[]},{"caption":"<code>self.s.append(0)</code> &mdash; <code>self.s</code> gets <code>0</code> appended","line":7,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0"],"cls":["cur"]}],"vars":[["self.min","None",0],["val","5",0]],"stack":[]},{"caption":"<code>self.min = val</code> &mdash; returns <code>None</code>; <code>self.min = 5</code>","line":8,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0"],"cls":[""]}],"vars":[["self.min","5",1],["val","5",0]],"stack":[]},{"caption":"<code>if not self.s:</code> &rarr; <strong>false</strong> &mdash; <code>val = 3</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0"],"cls":[""]}],"vars":[["self.min","5",0],["val","3",1]],"stack":[]},{"caption":"<code>self.s.append(val - self.min)</code> &mdash; <code>self.s</code> gets <code>-2</code> appended","line":10,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","-2"],"cls":["","cur"]}],"vars":[["self.min","5",0],["val","3",0]],"stack":[]},{"caption":"<code>if val &lt; self.min:</code> &rarr; <strong>true</strong> (val = 3)","line":11,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","-2"],"cls":["",""]}],"vars":[["self.min","5",0],["val","3",0]],"stack":[]},{"caption":"<code>self.min = val</code> &mdash; returns <code>None</code>; <code>self.min = 3</code> <em>(diff &lt; 0 marks a new min)</em>","line":12,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["0","-2"],"cls":["",""]}],"vars":[["self.min","3",1],["val","3",0]],"stack":[]},{"caption":"<code>if not self.s:</code> &rarr