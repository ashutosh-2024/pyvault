ion":"<code>while node is not None:</code> &rarr; <strong>false</strong> (node = None)","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455897072","1",0.0,3.75,"",[]],["n4454445616","2",1.0,2.5,"",[]],["n4454344144","3",2.0,1.25,"done",[]],["n4454445312","4",3.0,2.5,"cur",["p"]],["n4454572656","5",4.0,0.0,"cur",["root","succ"]],["n4454347024","6",5.0,1.25,"",[]]],"edges":[["n4454572656","n4454344144","",""],["n4454344144","n4454445616","",""],["n4454445616","n4455897072","",""],["n4454344144","n4454445312","",""],["n4454572656","n4454347024","",""]],"dir":false}],"vars":[["node","None",0]],"stack":[]},{"caption":"<code>return succ</code> &mdash; returns <code>(5)</code>. <strong>Result: (5)</strong>","line":9,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455897072","1",0.0,3.75,"",[]],["n4454445616","2",1.0,2.5,"",[]],["n4454344144","3",2.0,1.25,"done",[]],["n4454445312","4",3.0,2.5,"cur",["p"]],["n4454572656","5",4.0,0.0,"cur",["root","succ"]],["n4454347024","6",5.0,1.25,"",[]]],"edges":[["n4454572656","n4454344144","",""],["n4454344144","n4454445616","",""],["n4454445616","n4455897072","",""],["n4454344144","n4454445312","",""],["n4454572656","n4454347024","",""]],"dir":false}],"vars":[["node","None",0]],"stack":[]}],"example":1},{"title":"Inorder traversal, return the node after p","code":"def inorder_successor(root, p):\n    stack, node, seen_p = [], root, False\n    while stack or node:\n        while node:\n            stack.append(node)\n            node = node.left\n        node = stack.pop()\n        if seen_p:\n            return node\n        seen_p = node is p\n        node = node.right\n    return None","frames":[{"caption":"<strong>Inorder traversal, return the node after p</strong> &mdash; O(n) time, O(h) extra space. Input: <code>inorder_successor(root=tree (5), p=tree (4))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455900240