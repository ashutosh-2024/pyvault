{"chapters":[{"title":"Descend from the root, remember the last left turn","code":"def inorder_successor(root, p):\n    succ, node = None, root\n    while node is not None:\n        if node.val > p.val:\n            succ = node                  # a candidate; look for a smaller one\n            node = node.left\n        else:\n            node = node.right\n    return succ","frames":[{"caption":"<strong>Descend from the root, remember the last left turn</strong> &mdash; O(h) time, O(1) extra space. Input: <code>inorder_successor(root=tree (5), p=tree (4))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455897072","1",0.0,3.75,"",[]],["n4454445616","2",1.0,2.5,"",[]],["n4454344144","3",2.0,1.25,"",[]],["n4454445312","4",3.0,2.5,"cur",["p"]],["n4454572656","5",4.0,0.0,"cur",["root"]],["n4454347024","6",5.0,1.25,"",[]]],"edges":[["n4454572656","n4454344144","",""],["n4454344144","n4454445616","",""],["n4454445616","n4455897072","",""],["n4454344144","n4454445312","",""],["n4454572656","n4454347024","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>succ, node = None, root</code> &mdash; <code>succ = None</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455897072","1",0.0,3.75,"",[]],["n4454445616","2",1.0,2.5,"",[]],["n4454344144","3",2.0,1.25,"",[]],["n4454445312","4",3.0,2.5,"cur",["p"]],["n4454572656","5",4.0,0.0,"cur",["root","node"]],["n4454347024","6",5.0,1.25,"",[]]],"edges":[["n4454572656","n4454344144","",""],["n4454344144","n4454445616","",""],["n4454445616","n4455897072","",""],["n4454344144","n4454445312","",""],["n4454572656","n4454347024","",""]],"dir":false}],"vars":[["succ","None",1]],"stack":[]},{"caption":"<code>while node is not None:</code> &rarr; <strong>true</strong>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455897072","1",0.0,3.75,"",[]],["n4454445616","2",1.0,2.5,"",[]],["n4454344144","3",2.0,1