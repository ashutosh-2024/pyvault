{"chapters":[{"title":"Check every pair","code":"def two_sum(nums, target):\n    for i in range(len(nums)):\n        for j in range(i + 1, len(nums)):\n            if nums[i] + nums[j] == target:\n                return [i, j]","frames":[{"caption":"<strong>Check every pair</strong> &mdash; O(n&sup2;) time, O(1) extra space. Input: <code>two_sum(nums=[3, 2, 4], target=6)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["","",""]}],"vars":[["target","6",0]],"stack":[]},{"caption":"<code>for i in range(len(nums)):</code> &mdash; <code>i = 0</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["src","",""],"ptr":{"0":["i"]}}],"vars":[["target","6",0],["i","0",1]],"stack":[]},{"caption":"<code>for j in range(i + 1, len(nums)):</code> &mdash; <code>j = 1</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["src","src",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["target","6",0],["i","0",0],["j","1",1]],"stack":[]},{"caption":"<code>if nums[i] + nums[j] == target:</code> &rarr; <strong>false</strong> (i = 0, j = 1, target = 6)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["src","src",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["target","6",0],["i","0",0],["j","1",0]],"stack":[]},{"caption":"<code>for j in range(i + 1, len(nums)):</code> &mdash; <code>j = 2</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["src","","src"],"ptr":{"0":["i"],"2":["j"]}}],"vars":[["target","6",0],["i","0",0],["j","2",1]],"stack":[]},{"caption":"<code>if nums[i] + nums[j] == target:</code> &rarr; <strong>false</strong> (i = 0, j = 2, target = 6)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["src","","src"],"ptr":{"0":["i"],"2":["j"]}}],"vars":[["target","6",0],["i","0",0],["j","2",0]],"stack":[]},{"caption":"<code>for j in range(i + 1, len(nums)):</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["src","","src"],"ptr":{"0":["i"],"2":["j"]}}],"vars":[["target","6",0],["i","0",0],["j","2",0]],"stack":[]},{"caption":"<code>for i in range(len(nums)):</code> &mdash; <code>i = 1</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["","src","src"],"ptr":{"1":["i"],"2":["j"]}}],"vars":[["target","6",0],["i","1",1],["j","2",0]],"stack":[]},{"caption":"<code>for j in range(i + 1, len(nums)):</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["","src","src"],"ptr":{"1":["i"],"2":["j"]}}],"vars":[["target","6",0],["i","1",0],["j","2",0]],"stack":[]},{"caption":"<code>if nums[i] + nums[j] == target:</code> &rarr; <strong>true</strong> (i = 1, j = 2, target = 6)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["","src","src"],"ptr":{"1":["i"],"2":["j"]}}],"vars":[["target","6",0],["i","1",0],["j","2",0]],"stack":[]},{"caption":"<code>return [i, j]</code> &mdash; returns <code>[1, 2]</code>. <strong>Result: [1, 2]</strong>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["","src","src"],"ptr":{"1":["i"],"2":["j"]}},{"t":"arr","id":"result","label":"result","v":["1","2"],"cls":["answer","answer"]}],"vars":[["target","6",0],["i","1",0],["j","2",0]],"stack":[]}]},{"title":"Sort indices, two pointers","code":"def two_sum(nums, target):\n    order = sorted(range(len(nums)), key=nums.__getitem__)\n    lo, hi = 0, len(order) - 1\n    while lo < hi:\n        total = nums[order[lo]] + nums[order[hi]]\n        if total == target:\n            return sorted([order[lo], order[hi]])\n        if total < target:\n            lo += 1\n        else:\n            hi -= 1","frames":[{"caption":"<strong>Sort indices, two pointers</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>two_sum(nums=[2, 7, 11, 15], target=9)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>order = sorted(range(len(nums)), key=nums.__getitem__)</code> &mdash; <code>order = [0, 1, 2, 3]</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(order) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 3</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",1],["hi","3",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 3, lo = 0)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",0]],"stack":[]},{"caption":"<code>total = nums[order[lo]] + nums[order[hi]]</code> &mdash; <code>total = 17</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",0],["total","17",1]],"stack":[]},{"caption":"<code>if total == target:</code> &rarr; <strong>false</strong> (target = 9, total = 17)","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",0],["total","17",0]],"stack":[]},{"caption":"<code>if total &lt; target:</code> &rarr; <strong>false</strong> (target = 9, total = 17)","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","","","src"],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",0],["total","17",0]],"stack":[]},{"caption":"<code>hi -= 1</code> &mdash; <code>hi = 2</code>","line":11,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","2",1],["total","17",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 2, lo = 0)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","2",0],["total","17",0]],"stack":[]},{"caption":"<code>total = nums[order[lo]] + nums[order[hi]]</code> &mdash; <code>total = 13</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","2",0],["total","13",1]],"stack":[]},{"caption":"<code>if total == target:</code> &rarr; <strong>false</strong> (target = 9, total = 13)","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","2",0],["total","13",0]],"stack":[]},{"caption":"<code>if total &lt; target:</code> &rarr; <strong>false</strong> (target = 9, total = 13)","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","","src",""],"ptr":{"2":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","2",0],["total","13",0]],"stack":[]},{"caption":"<code>hi -= 1</code> &mdash; <code>hi = 1</code>","line":11,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","1",1],["total","13",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 1, lo = 0)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","1",0],["total","13",0]],"stack":[]},{"caption":"<code>total = nums[order[lo]] + nums[order[hi]]</code> &mdash; <code>total = 9</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","1",0],["total","9",1]],"stack":[]},{"caption":"<code>if total == target:</code> &rarr; <strong>true</strong> (target = 9, total = 9)","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","1",0],["total","9",0]],"stack":[]},{"caption":"<code>return sorted([order[lo], order[hi]])</code> &mdash; returns <code>[0, 1]</code>. <strong>Result: [0, 1]</strong>","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","7","11","15"],"cls":["","","",""]},{"t":"arr","id":"order","label":"order","v":["0","1","2","3"],"cls":["src","src","",""],"ptr":{"1":["hi"],"0":["lo"]}},{"t":"arr","id":"result","label":"result","v":["0","1"],"cls":["answer","answer"]}],"vars":[["target","9",0],["lo","0",0],["hi","1",0],["total","9",0]],"stack":[]}]},{"title":"One-pass hash map","code":"def two_sum(nums, target):\n    index = {}\n    for i, x in enumerate(nums):\n        if target - x in index:\n            return [index[target - x], i]\n        index[x] = i","frames":[{"caption":"<strong>One-pass hash map</strong> &mdash; O(n) time, O(n) extra space. Input: <code>two_sum(nums=[3, 2, 4], target=6)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["","",""]}],"vars":[["target","6",0]],"stack":[]},{"caption":"<code>index = {}</code> &mdash; <code>index = {}</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["","",""]},{"t":"arr","id":"index","label":"index","v":[],"cls":[],"keys":[]}],"vars":[["target","6",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 0</code>; <code>x = 3</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["src","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"index","label":"index","v":[],"cls":[],"keys":[]}],"vars":[["target","6",0],["i","0",1],["x","3",1]],"stack":[]},{"caption":"<code>if target - x in index:</code> &rarr; <strong>false</strong> (target = 6, x = 3)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["src","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"index","label":"index","v":[],"cls"