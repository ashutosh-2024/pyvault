{"chapters":[{"title":"Check every pair","code":"def two_sum(nums, target):\n    for i in range(len(nums)):\n        for j in range(i + 1, len(nums)):\n            if nums[i] + nums[j] == target:\n                return [i, j]","frames":[{"caption":"<strong>Check every pair</strong> &mdash; O(n&sup2;) time, O(1) extra space. Input: <code>two_sum(nums=[3, 9, 2, 7, 5], target=9)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>for i in range(len(nums)):</code> &mdash; <code>i = 0</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["src","","","",""],"ptr":{"0":["i"]}}],"vars":[["target","9",0],["i","0",1]],"stack":[]},{"caption":"<code>for j in range(i + 1, len(nums)):</code> &mdash; <code>j = 1</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["src","src","","",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["target","9",0],["i","0",0],["j","1",1]],"stack":[]},{"caption":"<code>if nums[i] + nums[j] == target:</code> &rarr; <strong>false</strong> (i = 0, j = 1, target = 9)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["src","src","","",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["target","9",0],["i","0",0],["j","1",0]],"stack":[]},{"caption":"<code>for j in range(i + 1, len(nums)):</code> &mdash; <code>j = 2</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["src","","src","",""],"ptr":{"0":["i"],"2":["j"]}}],"vars":[["target","9",0],["i","0",0],["j","2",1]],"stack":[]},{"caption":"<code>if nums[i] + nums[j] == target:</code> &rarr; <strong>false</strong> (i = 0, j = 2, target = 9)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["src","","src","",""],"ptr":{"0":["i"],"2":["j"]}