"","src"],"ptr":{"2":["i"]}},{"t":"arr","id":"index","label":"index","v":["0","1"],"cls":["",""],"keys":["3","2"]}],"vars":[["target","6",0],["i","2",0],["x","4",0]],"stack":[]},{"caption":"<code>return [index[target - x], i]</code> &mdash; returns <code>[1, 2]</code>. <strong>Result: [1, 2]</strong>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","2","4"],"cls":["","","src"],"ptr":{"2":["i"]}},{"t":"arr","id":"index","label":"index","v":["0","1"],"cls":["",""],"keys":["3","2"]},{"t":"arr","id":"result","label":"result","v":["1","2"],"cls":["answer","answer"]}],"vars":[["target","6",0],["i","2",0],["x","4",0]],"stack":[]}]}]}