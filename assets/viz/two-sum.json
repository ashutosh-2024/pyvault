code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","src","","src"],"ptr":{"2":["i"],"4":["j"]}}],"vars":[["target","9",0],["i","2",1],["j","4",0]],"stack":[]},{"caption":"<code>for j in range(i + 1, len(nums)):</code> &mdash; <code>j = 3</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","src","src",""],"ptr":{"2":["i"],"3":["j"]}}],"vars":[["target","9",0],["i","2",0],["j","3",1]],"stack":[]},{"caption":"<code>if nums[i] + nums[j] == target:</code> &rarr; <strong>true</strong> (i = 2, j = 3, target = 9)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","src","src",""],"ptr":{"2":["i"],"3":["j"]}}],"vars":[["target","9",0],["i","2",0],["j","3",0]],"stack":[]},{"caption":"<code>return [i, j]</code> &mdash; returns <code>[2, 3]</code>. <strong>Result: [2, 3]</strong>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","src","src",""],"ptr":{"2":["i"],"3":["j"]}},{"t":"arr","id":"result","label":"result","v":["2","3"],"cls":["answer","answer"]}],"vars":[["target","9",0],["i","2",0],["j","3",0]],"stack":[]}],"example":1},{"title":"Sort indices, two pointers","code":"def two_sum(nums, target):\n    order = sorted(range(len(nums)), key=nums.__getitem__)\n    lo, hi = 0, len(order) - 1\n    while lo < hi:\n        total = nums[order[lo]] + nums[order[hi]]\n        if total == target:\n            return sorted([order[lo], order[hi]])\n        if total < target:\n            lo += 1\n        else:\n            hi -= 1","frames":[{"caption":"<strong>Sort indices, two pointers</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>two_sum(nums=[3, 9, 2, 7, 5], target=9)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>order = sorted(range(len(nums)), key=nums.__getitem__)</code> &mdash; <code>order = [2, 0, 4, 3, 1]</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"order","label":"order","v":["2","0","4","3","1"],"cls":["","","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(order) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 4</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"order","label":"order","v":["2","0","4","3","1"],"cls":["src","","","","src"],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",1],["hi","4",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 4, lo = 0)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"order","label":"order","v":["2","0","4","3","1"],"cls":["src","","","","src"],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","4",0]],"stack":[]},{"caption":"<code>total = nums[order[lo]] + nums[order[hi]]</code> &mdash; <code>total = 11</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"order","label":"order","v":["2","0","4","3","1"],"cls":["src","","","","src"],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","4",0],["total","11",1]],"stack":[]},{"caption":"<code>if total == target:</code> &rarr; <strong>false</strong> (target = 9, total = 11)","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"order","label":"order","v":["2","0","4","3","1"],"cls":["src","","","","src"],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","4",0],["total","11",0]],"stack":[]},{"caption":"<code>if total &lt; target:</code> &rarr; <strong>false</strong> (target = 9, total = 11)","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"order","label":"order","v":["2","0","4","3","1"],"cls":["src","","","","src"],"ptr":{"4":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","4",0],["total","11",0]],"stack":[]},{"caption":"<code>hi -= 1</code> &mdash; <code>hi = 3</code>","line":11,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"order","label":"order","v":["2","0","4","3","1"],"cls":["src","","","src",""],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",1],["total","11",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 3, lo = 0)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"order","label":"order","v":["2","0","4","3","1"],"cls":["src","","","src",""],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",0],["total","11",0]],"stack":[]},{"caption":"<code>total = nums[order[lo]] + nums[order[hi]]</code> &mdash; <code>total = 9</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"order","label":"order","v":["2","0","4","3","1"],"cls":["src","","","src",""],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",0],["total","9",1]],"stack":[]},{"caption":"<code>if total == target:</code> &rarr; <strong>true</strong> (target = 9, total = 9)","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"order","label":"order","v":["2","0","4","3","1"],"cls":["src","","","src",""],"ptr":{"3":["hi"],"0":["lo"]}}],"vars":[["target","9",0],["lo","0",0],["hi","3",0],["total","9",0]],"stack":[]},{"caption":"<code>return sorted([order[lo], order[hi]])</code> &mdash; returns <code>[2, 3]</code>. <strong>Result: [2, 3]</strong>","line":7,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"order","label":"order","v":["2","0","4","3","1"],"cls":["src","","","src",""],"ptr":{"3":["hi"],"0":["lo"]}},{"t":"arr","id":"result","label":"result","v":["2","3"],"cls":["answer","answer"]}],"vars":[["target","9",0],["lo","0",0],["hi","3",0],["total","9",0]],"stack":[]}],"example":1},{"title":"One-pass hash map","code":"def two_sum(nums, target):\n    index = {}\n    for i, x in enumerate(nums):\n        if target - x in index:\n            return [index[target - x], i]\n        index[x] = i","frames":[{"caption":"<strong>One-pass hash map</strong> &mdash; O(n) time, O(n) extra space. Input: <code>two_sum(nums=[3, 9, 2, 7, 5], target=9)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>index = {}</code> &mdash; <code>index = {}</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["","","","",""]},{"t":"arr","id":"index","label":"index","v":[],"cls":[],"keys":[]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>for i, x in enumerate(nums):</code> &mdash; <code>i = 0</code>; <code>x = 3</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["src","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"index","label":"index","v":[],"cls":[],"keys":[]}],"vars":[["target","9",0],["i","0",1],["x","3",1]],"stack":[]},{"caption":"<code>if target - x in index:</code> &rarr; <strong>false</strong> (target = 9, x = 3)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","9","2","7","5"],"cls":["src","","","",""],"ptr":{"0":["i"]}},{"t":"arr","