{"chapters":[{"title":"Preorder values only, rebuild with bounds","code":"class Codec:\n    def serialize(self, root):\n        out = []\n\n        def walk(node):\n            if node is not None:\n                out.append(str(node.val))\n                walk(node.left)\n                walk(node.right)\n\n        walk(root)\n        return \" \".join(out)\n\n    def deserialize(self, data):\n        values = [int(x) for x in data.split()]\n        i = 0\n\n        def make(lo, hi):\n            nonlocal i\n            if i == len(values) or not lo < values[i] < hi:\n                return None\n            node = TreeNode(values[i]); i += 1\n            node.left = make(lo, node.val)\n            node.right = make(node.val, hi)\n            return node\n\n        return make(float(\"-inf\"), float(\"inf\"))","frames":[{"caption":"<strong>Preorder values only, rebuild with bounds</strong> &mdash; O(n) time, O(n) extra space. Running <code>__ex = (codec.deserialize(codec.serialize(None)))</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["C","o","d","e","c"],"cls":["","","","",""]}],"vars":[["self","'Codec'",0],["root","None",0]],"stack":[]},{"caption":"<code>out = []</code> &mdash; <code>out = []</code>","line":3,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["self","'Codec'",0],["root","None",0]],"stack":[]},{"caption":"<code>def walk(node):</code>","line":5,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["self","'Codec'",0],["root","None",0]],"stack":[]},{"caption":"<code>walk(root)</code> &mdash; calls <code>walk(node=None)</code>","line":11,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["self","'Codec'",0],["root","None",0],["node","None",1]],"stack":["serialize(root=None)","walk(node=None)"]},{"caption":"<code>if node is not None:</code> &rarr; <strong>false</strong> (node = None) &mdash; <code>walk</code> returns <code>None</code> to <code>serialize</code>","line":6,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["self","'Codec'",0],["root","None",0],["node","None",0]],"stack":["serialize(root=None)","walk(node=None)"]},{"caption":"<code>return \" \".join(out)</code> &mdash; returns <code>''</code>","line":12,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["self","'Codec'",0],["root","None",0]],"stack":[]},{"caption":"<code>values = [int(x) for x in data.split()]</code> &mdash; <code>data = ''</code>; <code>values = []</code>","line":15,"panels":[{"t":"arr","id":"values","label":"values","v":[],"cls":[],"noidx":true}],"vars":[["self","'Codec'",0],["data","''",1]],"stack":[]},{"caption":"<code>i = 0</code> &mdash; <code>i = 0</code>","line":16,"panels":[{"t":"arr","id":"values","label":"values","v":[],"cls":[],"noidx":true}],"vars":[["self","'Codec'",0],["data","''",0],["i","0",1]],"stack":[]},{"caption":"<code>def make(lo, hi):</code>","line":18,"panels":[{"t":"arr","id":"values","label":"values","v":[],"cls":[],"noidx":true}],"vars":[["self","'Codec'",0],["data","''",0],["i","0",0]],"stack":[]},{"caption":"<code>return make(float(\"-inf\"), float(\"inf\"))</code> &mdash; calls <code>make(lo=-∞, hi=∞)</code>","line":27,"panels":[{"t":"arr","id":"values","label":"values","v":[],"cls":[],"noidx":true}],"vars":[["self","'Codec'",0],["data","''",0],["i","0",0],["lo","-∞",1],["hi","∞",1]],"stack":["deserialize(data='')","make(lo=-∞, hi=∞)"]},{"caption":"<code>if i == len(values) or not lo &lt; values[i] &lt; hi:</code> &rarr; <strong>true</strong> (hi = ∞, i = 0, lo = -∞)","line":20,"panels":[{"t":"arr","id":"values","label":"values","v":[],"cls":[],"noidx":true}],"vars":[["self","'Codec'",0],["data","''",0],["i","0",0],["lo","-∞",0],["hi","∞",0]],"stack":["deserialize(data='')","make(lo=-∞, hi=∞)"]},{"caption":"<code>return None</code> &mdash; <code>make</code> r