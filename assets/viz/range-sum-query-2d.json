(self, matrix):\n        m, n = len(matrix), len(matrix[0])\n        P = [[0] * (n + 1) for _ in range(m + 1)]\n        for r in range(m):\n            for c in range(n):\n                P[r + 1][c + 1] = matrix[r][c] + P[r][c + 1] + P[r + 1][c] - P[r][c]\n        self.P = P\n\n    def sumRegion(self, r1, c1, r2, c2):\n        P = self.P\n        return P[r2 + 1][c2 + 1] - P[r1][c2 + 1] - P[r2 + 1][c1] + P[r1][c1]","frames":[{"caption":"<strong>2-D prefix sums</strong> &mdash; O(m &middot; n) build, O(1) per query time, O(m &middot; n) extra space. Running <code>nm = NumMatrix([[3, 0, 1], [5, 6, 3], [1, 2, 0]]); __ex = ([nm.sumRegion(1, 1, 2, 2), nm.sumRegion(0, 0, 1, 1)])</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["3","0","1"],["5","6","3"],["1","2","0"]],"cls":[["","",""],["","",""],["","",""]]}],"vars":[["self","'NumMatrix'",0]],"stack":[]},{"caption":"<code>m, n = len(matrix), len(matrix[0])</code> &mdash; <code>m = 3</code>; <code>n = 3</code>","line":3,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["3","0","1"],["5","6","3"],["1","2","0"]],"cls":[["","",""],["","",""],["","",""]]}],"vars":[["self","'NumMatrix'",0],["m","3",1],["n","3",1]],"stack":[]},{"caption":"<code>P = [[0] * (n + 1) for _ in range(m + 1)]</code> &mdash; <code>_ = 0</code>","line":4,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["3","0","1"],["5","6","3"],["1","2","0"]],"cls":[["","",""],["","",""],["","",""]]}],"vars":[["self","'NumMatrix'",0],["m","3",0],["n","3",0],["_","0",1]],"stack":[]},{"caption":"<code>P = [[0] * (n + 1) for _ in range(m + 1)]</code> &mdash; <code>_ = 1</code>","line":4,"panels":[{"t":"grid","id":"matrix","label":"matrix","v":[["3","0","1"],["5","6","3"],["1","2","0"]],"cls":[["","",""],["","",""],["","",""]]}],"vars":[["self","'NumMatrix'",0],["m","3",0],["n","3",0],["_","1",1]],"stack":[]},{"caption":"<code>P = [[0] * (n + 1) for _ in range(m + 1)]</code> 