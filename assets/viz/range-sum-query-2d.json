{"chapters":[{"title":"Sum the rectangle per query","code":"class NumMatrix:\n    def __init__(self, matrix):\n        self.m = matrix\n\n    def sumRegion(self, r1, c1, r2, c2):\n        return sum(sum(self.m[r][c1:c2 + 1]) for r in range(r1, r2 + 1))","frames":[{"caption":"<strong>Sum the rectangle per query</strong> &mdash; O(1) build, O(m &middot; n) per query time, O(1) extra space. Running <code>nm = NumMatrix([[3, 0, 1], [5, 6, 3], [1, 2, 0]]); __ex = ([nm.sumRegion(1, 1, 2, 2), nm.sumRegion(0, 0, 1, 1)])</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]}],"vars":[["self","'NumMatrix'",0]],"stack":[]},{"caption":"<code>self.m = matrix</code> &mdash; returns <code>None</code>; <code>self.m = [[3, 0, 1], [5, 6, 3], [1, 2, 0]]</code>","line":3,"panels":[{"t":"arr","id":"self.m","label":"self.m","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]},{"t":"arr","id":"matrix","label":"matrix","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>return sum(sum(self.m[r][c1:c2 + 1]) for r in range(r1, r2 + 1))</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":6,"panels":[{"t":"arr","id":"self.m","label":"self.m","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]}],"vars":[["r1","1",1],["c1","1",1],["r2","2",1],["c2","2",1]],"stack":["sumRegion(r1=1, c1=1, r2=2, c2=2)","<genexpr>()"]},{"caption":"<code>return sum(sum(self.m[r][c1:c2 + 1]) for r in range(r1, r2 + 1))</code> &mdash; yields <code>9</code>; <code>r = 1</code>","line":6,"panels":[{"t":"arr","id":"self.m","label":"self.m","v":["3,0,1","5,6,3","1,2,0"],"cls":["","src",""],"ptr":{"1":["r"]}}],"vars":[["r1","1",0],["c1","1",0],["r2","2",0],["c2","2",0],["r","1",1]],"stack":["sumRegion(r1=1, c1=1, r2=2, c2=2)","<genexpr>()"]},{"caption":"<code>return sum(sum(self.m[r][c1:c2 + 1]) for r in range(r1, r2 + 1))</code> &mdash; yields <code>2</code>; <code>r = 2</code>","line":6,"panels":[{"t":"arr","id":"self.m","label":"self.m","v":["3,0,1","5,6,3","1,2,0"],"cls":["","","src"],"ptr":{"2":["r"]}}],"vars":[["r1","1",0],["c1","1",0],["r2","2",0],["c2","2",0],["r","2",1]],"stack":["sumRegion(r1=1, c1=1, r2=2, c2=2)","<genexpr>()"]},{"caption":"<code>return sum(sum(self.m[r][c1:c2 + 1]) for r in range(r1, r2 + 1))</code> &mdash; yields <code>None</code>","line":6,"panels":[{"t":"arr","id":"self.m","label":"self.m","v":["3,0,1","5,6,3","1,2,0"],"cls":["","","src"],"ptr":{"2":["r"]}}],"vars":[["r1","1",0],["c1","1",0],["r2","2",0],["c2","2",0],["r","2",0]],"stack":["sumRegion(r1=1, c1=1, r2=2, c2=2)","<genexpr>()"]},{"caption":"<code>return sum(sum(self.m[r][c1:c2 + 1]) for r in range(r1, r2 + 1))</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":6,"panels":[{"t":"arr","id":"self.m","label":"self.m","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]}],"vars":[["r1","0",1],["c1","0",1],["r2","1",1],["c2","1",1]],"stack":["sumRegion(r1=0, c1=0, r2=1, c2=1)","<genexpr>()"]},{"caption":"<code>return sum(sum(self.m[r][c1:c2 + 1]) for r in range(r1, r2 + 1))</code> &mdash; yields <code>3</code>; <code>r = 0</code>","line":6,"panels":[{"t":"arr","id":"self.m","label":"self.m","v":["3,0,1","5,6,3","1,2,0"],"cls":["src","",""],"ptr":{"0":["r"]}}],"vars":[["r1","0",0],["c1","0",0],["r2","1",0],["c2","1",0],["r","0",1]],"stack":["sumRegion(r1=0, c1=0, r2=1, c2=1)","<genexpr>()"]},{"caption":"<code>return sum(sum(self.m[r][c1:c2 + 1]) for r in range(r1, r2 + 1))</code> &mdash; yields <code>11</code>; <code>r = 1</code>","line":6,"panels":[{"t":"arr","id":"self.m","label":"self.m","v":["3,0,1","5,6,3","1,2,0"],"cls":["","src",""],"ptr":{"1":["r"]}}],"vars":[["r1","0",0],["c1","0",0],["r2","1",0],["c2","1",0],["r","1",1]],"stack":["sumRegion(r1=0, c1=0, r2=1, c2=1)","<genexpr>()"]},{"caption":"<code>return sum(sum(self.m[r][c1:c2 + 1]) for r in range(r1, r2 + 1))</code> &mdash; yields <code>None</code>. <strong>Result: 14</strong>","line":6,"panels":[{"t":"arr","id":"self.m","label":"self.m","v":["3,0,1","5,6,3","1,2,0"],"cls":["","src",""],"ptr":{"1":["r"]}}],"vars":[["r1","0",0],["c1","0",0],["r2","1",0],["c2","1",0],["r","1",0]],"stack":["sumRegion(r1=0, c1=0, r2=1, c2=1)","<genexpr>()"]}],"example":1},{"title":"Prefix sums per row","code":"class NumMatrix:\n    def __init__(self, matrix):\n        self.rows = []\n        for row in matrix:\n            acc = [0]\n            for v in row:\n                acc.append(acc[-1] + v)\n            self.rows.append(acc)\n\n    def sumRegion(self, r1, c1, r2, c2):\n        return sum(self.rows[r][c2 + 1] - self.rows[r][c1] for r in range(r1, r2 + 1))","frames":[{"caption":"<strong>Prefix sums per row</strong> &mdash; O(m &middot; n) build, O(m) per query time, O(m &middot; n) extra space. Running <code>nm = NumMatrix([[3, 0, 1], [5, 6, 3], [1, 2, 0]]); __ex = ([nm.sumRegion(1, 1, 2, 2), nm.sumRegion(0, 0, 1, 1)])</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]}],"vars":[["self","'NumMatrix'",0]],"stack":[]},{"caption":"<code>self.rows = []</code> &mdash; <code>self.rows = []</code>","line":3,"panels":[{"t":"arr","id":"self.rows","label":"self.rows","v":[],"cls":[],"noidx":true},{"t":"arr","id":"matrix","label":"matrix","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>for row in matrix:</code> &mdash; <code>row = [3, 0, 1]</code>","line":4,"panels":[{"t":"arr","id":"self.rows","label":"self.rows","v":[],"cls":[],"noidx":true},{"t":"arr","id":"matrix","label":"matrix","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["3","0","1"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>acc = [0]</code> &mdash; <code>acc = [0]</code>","line":5,"panels":[{"t":"arr","id":"self.rows","label":"self.rows","v":[],"cls":[],"noidx":true},{"t":"arr","id":"matrix","label":"matrix","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["3","0","1"],"cls":["","",""]},{"t":"arr","id":"acc","label":"acc","v":["0"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>for v in row:</code> &mdash; <code>v = 3</code>","line":6,"panels":[{"t":"arr","id":"self.rows","label":"self.rows","v":[],"cls":[],"noidx":true},{"t":"arr","id":"matrix","label":"matrix","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["3","0","1"],"cls":["","",""]},{"t":"arr","id":"acc","label":"acc","v":["0"],"cls":[""]}],"vars":[["v","3",1]],"stack":[]},{"caption":"<code>acc.append(acc[-1] + v)</code> &mdash; <code>acc</code> gets <code>3</code> appended","line":7,"panels":[{"t":"arr","id":"self.rows","label":"self.rows","v":[],"cls":[],"noidx":true},{"t":"arr","id":"matrix","label":"matrix","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["3","0","1"],"cls":["","",""]},{"t":"arr","id":"acc","label":"acc","v":["0","3"],"cls":["","cur"]}],"vars":[["v","3",0]],"stack":[]},{"caption":"<code>for v in row:</code> &mdash; <code>v = 0</code>","line":6,"panels":[{"t":"arr","id":"self.rows","label":"self.rows","v":[],"cls":[],"noidx":true},{"t":"arr","id":"matrix","label":"matrix","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["3","0","1"],"cls":["","",""]},{"t":"arr","id":"acc","label":"acc","v":["0","3"],"cls":["",""]}],"vars":[["v","0",1]],"stack":[]},{"caption":"<code>acc.append(acc[-1] + v)</code> &mdash; <code>acc</code> gets <code>3</code> appended","line":7,"panels":[{"t":"arr","id":"self.rows","label":"self.rows","v":[],"cls":[],"noidx":true},{"t":"arr","id":"matrix","label":"matrix","v":["3,0,1","5,6,3","1,2,0"],"cls":["","",""]},{"t":"arr","id":"row","label":"row","v":["3","0","1"],"cls":["","",""]},{"t":"arr","id":"acc","label":"acc","v":["0","3","3"],"cls":["","","cur"]}],"vars":[["v","0",0]],"stack":[]},{"captio