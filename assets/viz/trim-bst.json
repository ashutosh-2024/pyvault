{"chapters":[{"title":"Recursive, return the trimmed subtree","code":"def trim_bst(root, low, high):\n    if root is None:\n        return None\n    if root.val < low:\n        return trim_bst(root.right, low, high)     # drop root and its left side\n    if root.val > high:\n        return trim_bst(root.left, low, high)\n    root.left = trim_bst(root.left, low, high)\n    root.right = trim_bst(root.right, low, high)\n    return root","frames":[{"caption":"<strong>Recursive, return the trimmed subtree</strong> &mdash; O(n) time, O(h) extra space. Input: <code>trim_bst(root=tree (3), low=1, high=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4426921168","0",0.0,1.25,"",[]],["n4427015152","1",1.0,3.75,"",[]],["n4427017280","2",2.0,2.5,"",[]],["n4427144160","3",3.0,0.0,"cur",["root"]],["n4426922128","4",4.0,1.25,"",[]]],"edges":[["n4427144160","n4426921168","",""],["n4426921168","n4427017280","",""],["n4427017280","n4427015152","",""],["n4427144160","n4426922128","",""]],"dir":false},{"t":"arr","id":"range:low","label":"search range","v":["1","3"],"cls":["",""],"keys":["low","high"]}],"vars":[["low","1",0],["high","3",0]],"stack":[]},{"caption":"<code>if root is None:</code> &rarr; <strong>false</strong>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4426921168","0",0.0,1.25,"",[]],["n4427015152","1",1.0,3.75,"",[]],["n4427017280","2",2.0,2.5,"",[]],["n4427144160","3",3.0,0.0,"cur",["root"]],["n4426922128","4",4.0,1.25,"",[]]],"edges":[["n4427144160","n4426921168","",""],["n4426921168","n4427017280","",""],["n4427017280","n4427015152","",""],["n4427144160","n4426922128","",""]],"dir":false},{"t":"arr","id":"range:low","label":"search range","v":["1","3"],"cls":["",""],"keys":["low","high"]}],"vars":[["low","1",0],["high","3",0]],"stack":[]},{"caption":"<code>if root.val &lt; low:</code> &rarr; <strong>false</strong> (low = 1)","line":4,"panels":[{"t":"net","id":