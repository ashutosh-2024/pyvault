{"chapters":[{"title":"Hash set of values seen","code":"def is_happy(n):\n    def step(x):\n        return sum(int(d) ** 2 for d in str(x))\n\n    seen = set()\n    while n != 1 and n not in seen:\n        seen.add(n)\n        n = step(n)\n    return n == 1","frames":[{"caption":"<strong>Hash set of values seen</strong> &mdash; O(log n) time, O(log n) extra space. Input: <code>is_happy(n=19)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","19",0]],"stack":[]},{"caption":"<code>def step(x):</code>","line":2,"panels":[],"vars":[["n","19",0]],"stack":[]},{"caption":"<code>seen = set()</code> &mdash; <code>seen = set()</code>","line":5,"panels":[],"vars":[["n","19",0],["seen","set()",1]],"stack":[]},{"caption":"<code>while n != 1 and n not in seen:</code> &rarr; <strong>true</strong> (n = 19)","line":6,"panels":[],"vars":[["n","19",0],["seen","set()",0]],"stack":[]},{"caption":"<code>seen.add(n)</code> &mdash; <code>19</code> added to <code>seen</code>","line":7,"panels":[{"t":"arr","id":"seen","label":"seen (set)","v":["19"],"cls":[""],"noidx":true}],"vars":[["n","19",0]],"stack":[]},{"caption":"<code>n = step(n)</code> &mdash; calls <code>step(x=19)</code>","line":8,"panels":[{"t":"arr","id":"seen","label":"seen (set)","v":["19"],"cls":[""],"noidx":true}],"vars":[["n","19",0],["x","19",1]],"stack":["is_happy(n=19)","step(x=19)"]},{"caption":"<code>return sum(int(d) ** 2 for d in str(x))</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":3,"panels":[{"t":"arr","id":"seen","label":"seen (set)","v":["19"],"cls":[""],"noidx":true}],"vars":[["n","19",0],["x","19",0]],"stack":["is_happy(n=19)","step(x=19)","<genexpr>()"]},{"caption":"<code>return sum(int(d) ** 2 for d in str(x))</code> &mdash; yields <code>1</code>; <code>d = '1'</code>","line":3,"panels":[{"t":"arr","id":"seen","label":"seen (set)","v":["19"],"cls":[""],"noidx":true}],"vars":[["n","19",0],["x","19",0],["d","'1'",1]],"stack":["is_happy(n=19)","step(x=19