 * d\n        return total\n\n    slow, fast = n, step(n)\n    while fast != 1 and slow != fast:\n        slow = step(slow)\n        fast = step(step(fast))\n    return fast == 1","frames":[{"caption":"<strong>Floyd's cycle detection</strong> &mdash; O(log n) time, O(1) extra space. Input: <code>is_happy(n=19)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","19",0]],"stack":[]},{"caption":"<code>def step(x):</code>","line":2,"panels":[],"vars":[["n","19",0]],"stack":[]},{"caption":"<code>slow, fast = n, step(n)</code> &mdash; calls <code>step(x=19)</code>","line":9,"panels":[],"vars":[["n","19",0],["x","19",1]],"stack":["is_happy(n=19)","step(x=19)"]},{"caption":"<code>total = 0</code> &mdash; <code>total = 0</code>","line":3,"panels":[],"vars":[["n","19",0],["x","19",0],["total","0",1]],"stack":["is_happy(n=19)","step(x=19)"]},{"caption":"<code>while x:</code> &rarr; <strong>true</strong> (x = 19)","line":4,"panels":[],"vars":[["n","19",0],["x","19",0],["total","0",0]],"stack":["is_happy(n=19)","step(x=19)"]},{"caption":"<code>x, d = divmod(x, 10)</code> &mdash; <code>x = 1</code>; <code>d = 9</code>","line":5,"panels":[],"vars":[["n","19",0],["x","1",1],["total","0",0],["d","9",1]],"stack":["is_happy(n=19)","step(x=1)"]},{"caption":"<code>total += d * d</code> &mdash; <code>total = 81</code>","line":6,"panels":[],"vars":[["n","19",0],["x","1",0],["total","81",1],["d","9",0]],"stack":["is_happy(n=19)","step(x=1)"]},{"caption":"<code>while x:</code> &rarr; <strong>true</strong> (x = 1)","line":4,"panels":[],"vars":[["n","19",0],["x","1",0],["total","81",0],["d","9",0]],"stack":["is_happy(n=19)","step(x=1)"]},{"caption":"<code>x, d = divmod(x, 10)</code> &mdash; <code>x = 0</code>; <code>d = 1</code>","line":5,"panels":[],"vars":[["n","19",0],["x","0",1],["total","81",0],["d","1",1]],"stack":["is_happy(n=19)","step(x=0)"]},{"caption":"<code>total += d * d</code> &mdash; <code>total = 82</code>","line":6,"panels":[],"vars"