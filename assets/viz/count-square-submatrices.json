{"chapters":[{"title":"Check every square","code":"def count_squares(matrix):\n    m, n, total = len(matrix), len(matrix[0]), 0\n    for r in range(m):\n        for c in range(n):\n            for k in range(1, min(m - r, n - c) + 1):\n                if all(matrix[r + i][c + j] for i in range(k) for j in range(k)):\n                    total += 1\n                else:\n                    break\n    return total","frames":[{"caption":"<strong>Check every square</strong> &mdash; O(m&middot;n&middot;min(m,n)<sup>3</sup>) time, O(1) extra space. Input: <code>count_squares(matrix=[[0]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["0"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>m, n, total = len(matrix), len(matrix[0]), 0</code> &mdash; <code>m = 1</code>; <code>n = 1</code>; <code>total = 0</code>","line":2,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["0"],"cls":[""]}],"vars":[["m","1",1],["n","1",1],["total","0",1]],"stack":[]},{"caption":"<code>for r in range(m):</code> &mdash; <code>r = 0</code>","line":3,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["0"],"cls":[""]}],"vars":[["m","1",0],["n","1",0],["total","0",0],["r","0",1]],"stack":[]},{"caption":"<code>for c in range(n):</code> &mdash; <code>c = 0</code>","line":4,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["0"],"cls":[""]}],"vars":[["m","1",0],["n","1",0],["total","0",0],["c","0",1],["r","0",0]],"stack":[]},{"caption":"<code>for k in range(1, min(m - r, n - c) + 1):</code> &mdash; <code>k = 1</code>","line":5,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["0"],"cls":[""]}],"vars":[["m","1",0],["n","1",0],["total","0",0],["c","0",0],["k","1",1],["r","0",0]],"stack":[]},{"caption":"<code>if all(matrix[r + i][c + j] for i in range(k) for j in range(k)):</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":6,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["0"],"cls":[""]}],"vars":[["m","1",0],["n","1",0],["total","0",0],["c","0",0],["k","1",0],["r","0",0]],"stack":["count_squares(matrix)","<genexpr>()"]},{"caption":"<code>if all(matrix[r + i][c + j] for i in range(k) for j in range(k)):</code> &mdash; yields <code>0</code>; <code>i = 0</code>; <code>j = 0</code>","line":6,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["0"],"cls":[""]}],"vars":[["m","1",0],["n","1",0],["total","0",0],["c","0",0],["k","1",0],["r","0",0],["i","0",1],["j","0",1]],"stack":["count_squares(matrix)","<genexpr>()"]},{"caption":"<code>break</code>","line":9,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["0"],"cls":[""]}],"vars":[["m","1",0],["n","1",0],["total","0",0],["c","0",0],["k","1",0],["r","0",0]],"stack":[]},{"caption":"<code>for c in range(n):</code>","line":4,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["0"],"cls":[""]}],"vars":[["m","1",0],["n","1",0],["total","0",0],["c","0",0],["k","1",0],["r","0",0]],"stack":[]},{"caption":"<code>for r in range(m):</code>","line":3,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["0"],"cls":[""]}],"vars":[["m","1",0],["n","1",0],["total","0",0],["c","0",0],["k","1",0],["r","0",0]],"stack":[]},{"caption":"<code>return total</code> &mdash; returns <code>0</code>. <strong>Result: 0</strong>","line":10,"panels":[{"t":"arr","id":"matrix","label":"matrix","v":["0"],"cls":[""]}],"vars":[["m","1",0],["n","1",0],["total","0",0],["c","0",0],["k","1",0],["r","0",0]],"stack":[]}]},{"title":"In-place DP","code":"def count_squares(matrix):\n    for r in range(1, len(matrix)):\n        for c in range(1, len(matrix[0])):\n            if matrix[r][c]:\n                matrix[r][c] = 1 + min(matrix[r - 1][c], matrix[r][c - 1], matrix[r - 1][c - 1])\n    return sum(map(sum, matrix))","frames":[{"caption":"<strong>In-place DP</strong> &mdash; O(m&middot;n) time, O(1) extra space. Input: <code>count_squares(matrix=[[0, 1, 1, 1], [1, 1, 1, 1], [0, 1, 1, 1]])</code>. Step through to wa