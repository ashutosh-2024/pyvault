</code>","line":3,"panels":[],"vars":[["m","3",0],["n","4",0]],"stack":[]},{"caption":"<code>@cache</code>","line":2,"panels":[],"vars":[["m","3",0],["n","4",0]],"stack":[]},{"caption":"<code>def f(r, c):</code>","line":3,"panels":[],"vars":[["m","3",0],["n","4",0]],"stack":[]},{"caption":"<code>return f(m - 1, n - 1)</code> &mdash; calls <code>f(r=2, c=3)</code>","line":7,"panels":[],"vars":[["m","3",0],["n","4",0],["r","2",1],["c","3",1]],"stack":["unique_paths(m=3, n=4)","f(r=2, c=3)"]},{"caption":"<code>if r == 0 or c == 0:</code> &rarr; <strong>false</strong> (c = 3, r = 2)","line":4,"panels":[],"vars":[["m","3",0],["n","4",0],["r","2",0],["c","3",0]],"stack":["unique_paths(m=3, n=4)","f(r=2, c=3)"]},{"caption":"<code>return f(r - 1, c) + f(r, c - 1)</code> &mdash; calls <code>f(r=1, c=3)</code>","line":6,"panels":[],"vars":[["m","3",0],["n","4",0],["r","1",1],["c","3",0]],"stack":["unique_paths(m=3, n=4)","f(r=2, c=3)","f(r=1, c=3)"]},{"caption":"<code>if r == 0 or c == 0:</code> &rarr; <strong>false</strong> (c = 3, r = 1)","line":4,"panels":[],"vars":[["m","3",0],["n","4",0],["r","1",0],["c","3",0]],"stack":["unique_paths(m=3, n=4)","f(r=2, c=3)","f(r=1, c=3)"]},{"caption":"<code>return f(r - 1, c) + f(r, c - 1)</code> &mdash; calls <code>f(r=0, c=3)</code>","line":6,"panels":[],"vars":[["m","3",0],["n","4",0],["r","0",1],["c","3",0]],"stack":["unique_paths(m=3, n=4)","f(r=2, c=3)","f(r=1, c=3)","f(r=0, c=3)"]},{"caption":"<code>if r == 0 or c == 0:</code> &rarr; <strong>true</strong> (c = 3, r = 0)","line":4,"panels":[],"vars":[["m","3",0],["n","4",0],["r","0",0],["c","3",0]],"stack":["unique_paths(m=3, n=4)","f(r=2, c=3)","f(r=1, c=3)","f(r=0, c=3)"]},{"caption":"<code>return 1</code> &mdash; <code>f</code> returns <code>1</code> to <code>f</code>","line":5,"panels":[],"vars":[["m","3",0],["n","4",0],["r","0",0],["c","3",0]],"stack":["unique_paths(m=3, n=4)","f(r=2, c=3)","f(r=1, c=3)","f(r=0, c=3)"]},{"caption":"<code>if r == 0 or c == 0:</code> &rarr; <s