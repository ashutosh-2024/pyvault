{"chapters":[{"title":"Try 1, 2, 3, … with a linear search","code":"def first_missing_positive(nums):\n    x = 1\n    while x in nums:\n        x += 1\n    return x","frames":[{"caption":"<strong>Try 1, 2, 3, … with a linear search</strong> &mdash; O(n&sup2;) time, O(1) extra space. Input: <code>first_missing_positive(nums=[3, 4, -1, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>x = 1</code> &mdash; <code>x = 1</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["x","1",1]],"stack":[]},{"caption":"<code>while x in nums:</code> &rarr; <strong>true</strong> (x = 1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["x","1",0]],"stack":[]},{"caption":"<code>x += 1</code> &mdash; <code>x = 2</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["x","2",1]],"stack":[]},{"caption":"<code>while x in nums:</code> &rarr; <strong>false</strong> (x = 2)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>return x</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["x","2",0]],"stack":[]}],"example":1},{"title":"Sort, then walk","code":"def first_missing_positive(nums):\n    want = 1\n    for x in sorted(nums):\n        if x == want:\n            want += 1\n    return want","frames":[{"caption":"<strong>Sort, then walk</strong> &mdash; O(n log n) time, O(1) or O(n) extra space. Input: <code>first_missing_positive(nums=[3, 4, -1, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>want = 1</code> &mdash; <code>want = 1</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","1",1]],"stack":[]},{"caption":"<code>for x in sorted(nums):</code> &mdash; <code>x = -1</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","1",0],["x","-1",1]],"stack":[]},{"caption":"<code>if x == want:</code> &rarr; <strong>false</strong> (want = 1, x = -1)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","1",0],["x","-1",0]],"stack":[]},{"caption":"<code>for x in sorted(nums):</code> &mdash; <code>x = 1</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","1",0],["x","1",1]],"stack":[]},{"caption":"<code>if x == want:</code> &rarr; <strong>true</strong> (want = 1, x = 1)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","1",0],["x","1",0]],"stack":[]},{"caption":"<code>want += 1</code> &mdash; <code>want = 2</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","2",1],["x","1",0]],"stack":[]},{"caption":"<code>for x in sorted(nums):</code> &mdash; <code>x = 3</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","2",0],["x","3",1]],"stack":[]},{"caption":"<code>if x == want:</code> &rarr; <strong>false</strong> (want = 2, x = 3)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","2",0],["x","3",0]],"stack":[]},{"caption":"<code>for x in sorted(nums):</code> &mdash; <code>x = 4</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","2",0],["x","4",1]],"stack":[]},{"caption":"<code>if x == want:</code> &rarr; <strong>false</strong> (want = 2, x = 4)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","2",0],["x","4",0]],"stack":[]},{"caption":"<code>for x in sorted(nums):</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","2",0],["x","4",0]],"stack":[]},{"caption":"<code>return want</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["want","2",0],["x","4",0]],"stack":[]}],"example":1},{"title":"Hash set","code":"def first_missing_positive(nums):\n    present = set(nums)\n    x = 1\n    while x in present:\n        x += 1\n    return x","frames":[{"caption":"<strong>Hash set</strong> &mdash; O(n) time, O(n) extra space. Input: <code>first_missing_positive(nums=[3, 4, -1, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>present = set(nums)</code> &mdash; <code>present = {-1, 1, 3, 4}</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]},{"t":"arr","id":"present","label":"present (set)","v":["-1","1","3","4"],"cls":["","","",""],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>x = 1</code> &mdash; <code>x = 1</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]},{"t":"arr","id":"present","label":"present (set)","v":["-1","1","3","4"],"cls":["","","",""],"noidx":true}],"vars":[["x","1",1]],"stack":[]},{"caption":"<code>while x in present:</code> &rarr; <strong>true</strong> (x = 1)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]},{"t":"arr","id":"present","label":"present (set)","v":["-1","1","3","4"],"cls":["","","",""],"noidx":true}],"vars":[["x","1",0]],"stack":[]},{"caption":"<code>x += 1</code> &mdash; <code>x = 2</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]},{"t":"arr","id":"present","label":"present (set)","v":["-1","1","3","4"],"cls":["","","",""],"noidx":true}],"vars":[["x","2",1]],"stack":[]},{"caption":"<code>while x in present:</code> &rarr; <strong>false</strong> (x = 2)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]},{"t":"arr","id":"present","label":"present (set)","v":["-1","1","3","4"],"cls":["","","",""],"noidx":true}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>return x</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]},{"t":"arr","id":"present","label":"present (set)","v":["-1","1","3","4"],"cls":["","","",""],"noidx":true}],"vars":[["x","2",0]],"stack":[]}],"example":1},{"title":"Cyclic sort: put each value at its own index","code":"def first_missing_positive(nums):\n    n = len(nums)\n    for i in range(n):\n        while 1 <= nums[i] <= n and nums[nums[i] - 1] != nums[i]:\n            j = nums[i] - 1\n            nums[i], nums[j] = nums[j], nums[i]      # send nums[i] home\n    for i in range(n):\n        if nums[i] != i + 1:\n            return i + 1\n    return n + 1","frames":[{"caption":"<strong>Cyclic sort: put each value at its own index</strong> &mdash; O(n) time, O(1) extra space. Input: <code>first_missing_positive(nums=[3, 4, -1, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>n = len(nums)</code> &mdash; <code>n = 4</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["","","",""]}],"vars":[["n","4",1]],"stack":[]},{"caption":"<code>for i in range(n):</code> &mdash; <code>i = 0</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["src","","",""],"ptr":{"0":["i"]}}],"vars":[["n","4",0],["i","0",1]],"stack":[]},{"caption":"<code>while 1 &lt;= nums[i] &lt;= n and nums[nums[i] - 1] != nums[i]:</code> &rarr; <strong>true</strong> (i = 0, n = 4)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["src","","",""],"ptr":{"0":["i"]}}],"vars":[["n","4",0],["i","0",0]],"stack":[]},{"caption":"<code>j = nums[i] - 1</code> &mdash; <code>j = 2</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","4","-1","1"],"cls":["src","","src",""],"ptr":{"0":["i"],"2":["j"]}}],"vars":[["n","4",0],["i","0",0],["j","2",1]],"stack":[]},{"caption":"<code>nums[i], nums[j] = nums[j], nums[i]</code> &mdash; swap <code>nums[0]</code> and <code>nums[2]</code> <em>(send nums[i] home)</em>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","4","3","1"],"cls":["cur","","cur",""],"ptr":{"0":["i"],"2":["j"]}}],"vars":[["n","4",0],["i","0",0],["j","2",0]],"stack":[]},{"caption":"<code>while 1 &lt;= nums[i] &lt;= n and nums[nums[i] - 1] != nums[i]:</code> &rarr; <strong>false</strong> (i = 0, n = 4)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","4","3","1"],"cls":["src","","src",""],"ptr":{"0":["i"],"2":["j"]}}],"vars":[["n","4",0],["i","0",0],["j","2",0]],"stack":[]},{"caption":"<code>for i in range(n):</code> &mdash; <code>i = 1</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["-1","4","3","1"],"cls":["","src","src",""],"ptr":{"1":["i"],"2":["j"]}}],"vars":[["n","4",0],["i","1",1],["j","2",0]],"stack":[]},{"caption":"<code>while 1 &lt;= nums