{"chapters":[{"title":"Build a filtered copy, write it back","code":"def remove_element(nums, val):\n    kept = [x for x in nums if x != val]\n    nums[:len(kept)] = kept\n    return len(kept)","frames":[{"caption":"<strong>Build a filtered copy, write it back</strong> &mdash; O(n) time, O(n) extra space. Input: <code>remove_element(nums=[0, 1, 2, 2, 3, 0, 4, 2], val=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","1","2","2","3","0","4","2"],"cls":["","","","","","","",""]}],"vars":[["val","2",0]],"stack":[]},{"caption":"<code>kept = [x for x in nums if x != val]</code> &mdash; <code>x = 0</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","1","2","2","3","0","4","2"],"cls":["","","","","","","",""]}],"vars":[["val","2",0],["x","0",1]],"stack":[]},{"caption":"<code>kept = [x for x in nums if x != val]</code> &mdash; <code>x = 1</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","1","2","2","3","0","4","2"],"cls":["","","","","","","",""]}],"vars":[["val","2",0],["x","1",1]],"stack":[]},{"caption":"<code>kept = [x for x in nums if x != val]</code> &mdash; <code>x = 2</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","1","2","2","3","0","4","2"],"cls":["","","","","","","",""]}],"vars":[["val","2",0],["x","2",1]],"stack":[]},{"caption":"<code>kept = [x for x in nums if x != val]</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","1","2","2","3","0","4","2"],"cls":["","","","","","","",""]}],"vars":[["val","2",0],["x","2",0]],"stack":[]},{"caption":"<code>kept = [x for x in nums if x != val]</code> &mdash; <code>x = 3</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["0","1","2","2","3","0","4","2"],"cls":["","","","","","","",""]}],"vars":[["val","2",0],["x","3",1]],"stack":[]},{"caption":"<code>kept = [x for x in nums if x != val]</code> &mdash; <code>x = 0</code>","line":2,"