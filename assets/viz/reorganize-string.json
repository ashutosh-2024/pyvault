er)","v":["2","1"],"cls":["",""],"keys":["a","b"]},{"t":"arr","id":"heap","label":"heap","v":["-1,a"],"cls":[""]},{"t":"arr","id":"out","label":"out","v":["a","b"],"cls":["",""]}],"vars":[["s","'aab'",0],["c1","-2",0],["ch1","'a'",0],["c2","-1",0],["ch2","'b'",0]],"stack":[]},{"caption":"<code>out.append(heap[0][1])</code> &mdash; <code>out</code> gets <code>'a'</code> appended","line":20,"panels":[{"t":"arr","id":"counts","label":"counts (Counter)","v":["2","1"],"cls":["",""],"keys":["a","b"]},{"t":"arr","id":"heap","label":"heap","v":["-1,a"],"cls":[""]},{"t":"arr","id":"out","label":"out","v":["a","b","a"],"cls":["","","cur"]}],"vars":[["s","'aab'",0],["c1","-2",0],["ch1","'a'",0],["c2","-1",0],["ch2","'b'",0]],"stack":[]},{"caption":"<code>return \"\".join(out)</code> &mdash; returns <code>'aba'</code>. <strong>Result: 'aba'</strong>","line":21,"panels":[{"t":"arr","id":"counts","label":"counts (Counter)","v":["2","1"],"cls":["",""],"keys":["a","b"]},{"t":"arr","id":"heap","label":"heap","v":["-1,a"],"cls":[""]},{"t":"arr","id":"out","label":"out","v":["a","b","a"],"cls":["","",""]}],"vars":[["s","'aab'",0],["c1","-2",0],["ch1","'a'",0],["c2","-1",0],["ch2","'b'",0]],"stack":[]}]},{"title":"Fill even slots, then odd","code":"def reorganize_string(s):\n    counts = Counter(s)\n    if max(counts.values()) > (len(s) + 1) // 2:\n        return \"\"\n\n    out = [\"\"] * len(s)\n    i = 0\n    for ch, freq in counts.most_common():       # most frequent first\n        for _ in range(freq):\n            if i >= len(s):\n                i = 1                           # switch to the odd slots\n            out[i] = ch\n            i += 2\n    return \"\".join(out)","frames":[{"caption":"<strong>Fill even slots, then odd</strong> &mdash; O(n log 26) = O(n) time, O(n) extra space. Input: <code>reorganize_string(s='aab')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a","b"],"cls":["","",""]}],"vars"