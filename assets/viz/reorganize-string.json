{"chapters":[{"title":"Max-heap, never the same letter twice","frames":[{"caption":"Rearrange <code>aaabbc</code> so no two neighbours are equal. Greedy: always place the most frequent letter, but hold it back for one step so it cannot be placed twice in a row.","grid":{"v":[["","","","","",""]],"cls":[["empty","empty","empty","empty","empty","empty"]],"rowLabels":["output"],"colLabels":["0","1","2","3","4","5"]},"trees":[{"label":"max-heap by count","v":["a×3","b×2","c×1"],"cls":["done","done","done"]},{"label":"held back","v":[],"cls":[],"flat":true}]},{"caption":"Place 'a', the most frequent available letter (2 left). Hold 'a' back for one step.","grid":{"v":[["a","","","","",""]],"cls":[["cur","empty","empty","empty","empty","empty"]],"rowLabels":["output"],"colLabels":["0","1","2","3","4","5"]},"trees":[{"label":"max-heap by count","v":["b×2","c×1"],"cls":["done","done"]},{"label":"held back","v":["a×2"],"cls":["dim"],"flat":true}]},{"caption":"Place 'b', the most frequent available letter (1 left). The held-back 'a' may be used again, so it returns to the heap. Hold 'b' back for one step.","grid":{"v":[["a","b","","","",""]],"cls":[["done","cur","empty","empty","empty","empty"]],"rowLabels":["output"],"colLabels":["0","1","2","3","4","5"]},"trees":[{"label":"max-heap by count","v":["a×2","c×1"],"cls":["done","done"]},{"label":"held back","v":["b×1"],"cls":["dim"],"flat":true}]},{"caption":"Place 'a', the most frequent available letter (1 left). The held-back 'b' may be used again, so it returns to the heap. Hold 'a' back for one step.","grid":{"v":[["a","b","a","","",""]],"cls":[["done","done","cur","empty","empty","empty"]],"rowLabels":["output"],"colLabels":["0","1","2","3","4","5"]},"trees":[{"label":"max-heap by count","v":["b×1","c×1"],"cls":["done","done"]},{"label":"held back","v":["a×1"],"cls":["dim"],"flat":true}]},{"caption":"Place 'b', the most frequent available letter, its last copy. The held-back 'a' may be used again, so it returns to the heap."