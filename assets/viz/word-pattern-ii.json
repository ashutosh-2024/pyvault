{"chapters":[{"title":"Backtrack over the length of each new mapping","code":"def word_pattern_match(pattern, s):\n    mapping, claimed = {}, set()\n\n    def dfs(i, j):\n        if i == len(pattern):\n            return j == len(s)\n        ch = pattern[i]\n        if ch in mapping:                            # forced: must match\n            w = mapping[ch]\n            return s.startswith(w, j) and dfs(i + 1, j + len(w))\n        last = len(s) - (len(pattern) - i - 1)       # leave 1 char per later letter\n        for end in range(j + 1, last + 1):\n            w = s[j:end]\n            if w in claimed:\n                continue                             # bijection\n            mapping[ch] = w\n            claimed.add(w)\n            if dfs(i + 1, end):\n                return True\n            del mapping[ch]\n            claimed.discard(w)\n        return False\n\n    return dfs(0, 0)","frames":[{"caption":"<strong>Backtrack over the length of each new mapping</strong> &mdash; O(n<sup>p</sup>) worst time, O(p) extra space. Input: <code>word_pattern_match(pattern='ab', s='aa')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"pattern","label":"pattern","v":["a","b"],"cls":["",""]}],"vars":[["pattern","'ab'",0],["s","'aa'",0]],"stack":[]},{"caption":"<code>mapping, claimed = {}, set()</code> &mdash; <code>claimed = set()</code>; <code>mapping = {}</code>","line":2,"panels":[{"t":"arr","id":"pattern","label":"pattern","v":["a","b"],"cls":["",""]},{"t":"arr","id":"mapping","label":"mapping","v":[],"cls":[],"keys":[]}],"vars":[["pattern","'ab'",0],["s","'aa'",0],["claimed","set()",1]],"stack":[]},{"caption":"<code>def dfs(i, j):</code>","line":4,"panels":[{"t":"arr","id":"pattern","label":"pattern","v":["a","b"],"cls":["",""]},{"t":"arr","id":"mapping","label":"mapping","v":[],"cls":[],"keys":[]}],"vars":[["pattern","'ab'",0],["s","'aa'",0],["claimed","set()",0]],"stack":[]},{"caption":"<code>return dfs(0, 0)</code> &mdash; calls <code>dfs(i=0, j=0)</code>","line":24,"panels":[{"t":"arr","id":"pattern","label":"pattern","v":["a","b"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"mapping","label":"mapping","v":[],"cls":[],"keys":[]}],"vars":[["pattern","'ab'",0],["s","'aa'",0],["claimed","set()",0],["i","0",1],["j","0",1]],"stack":["word_pattern_match(pattern='ab', s='aa')","dfs(i=0, j=0)"]},{"caption":"<code>if i == len(pattern):</code> &rarr; <strong>false</strong> (i = 0, pattern = 'ab')","line":5,"panels":[{"t":"arr","id":"pattern","label":"pattern","v":["a","b"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"mapping","label":"mapping","v":[],"cls":[],"keys":[]}],"vars":[["pattern","'ab'",0],["s","'aa'",0],["claimed","set()",0],["i","0",0],["j","0",0]],"stack":["word_pattern_match(pattern='ab', s='aa')","dfs(i=0, j=0)"]},{"caption":"<code>ch = pattern[i]</code> &mdash; <code>ch = 'a'</code>","line":7,"panels":[{"t":"arr","id":"pattern","label":"pattern","v":["a","b"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"mapping","label":"mapping","v":[],"cls":[],"keys":[]}],"vars":[["pattern","'ab'",0],["s","'aa'",0],["claimed","set()",0],["i","0",0],["j","0",0],["ch","'a'",1]],"stack":["word_pattern_match(pattern='ab', s='aa')","dfs(i=0, j=0)"]},{"caption":"<code>if ch in mapping:</code> &rarr; <strong>false</strong> (ch = 'a') <em>(forced: must match)</em>","line":8,"panels":[{"t":"arr","id":"pattern","label":"pattern","v":["a","b"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"mapping","label":"mapping","v":[],"cls":[],"keys":[]}],"vars":[["pattern","'ab'",0],["s","'aa'",0],["claimed","set()",0],["i","0",0],["j","0",0],["ch","'a'",0]],"stack":["word_pattern_match(pattern='ab', s='aa')","dfs(i=0, j=0)"]},{"caption":"<code>last = len(s) - (len(pattern) - i - 1)</code> &mdash; <code>last = 1</code> <em>(leave 1 char per later letter)</em>","line":11,"panels":[{"t":"arr","id":"pattern","label":"pattern","v":["a","b"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":