{"chapters":[{"title":"Memoised recursion over sizes","code":"from functools import cache\n\n\n@cache\ndef all_possible_fbt(n):\n    if n % 2 == 0:\n        return []\n    if n == 1:\n        return [TreeNode(0)]\n    out = []\n    for left in range(1, n, 2):\n        for l in all_possible_fbt(left):\n            for r in all_possible_fbt(n - 1 - left):\n                out.append(TreeNode(0, l, r))\n    return out","frames":[{"caption":"<strong>Memoised recursion over sizes</strong> &mdash; O(2<sup>n/2</sup>) time, O(2<sup>n/2</sup>) extra space. Input: <code>all_possible_fbt(n=5)</code>. Step through to watch the code work on this input.","line":4,"panels":[],"vars":[["n","5",0]],"stack":[]},{"caption":"<code>if n % 2 == 0:</code> &rarr; <strong>false</strong> (n = 5)","line":6,"panels":[],"vars":[["n","5",0]],"stack":[]},{"caption":"<code>if n == 1:</code> &rarr; <strong>false</strong> (n = 5)","line":8,"panels":[],"vars":[["n","5",0]],"stack":[]},{"caption":"<code>out = []</code> &mdash; <code>out = []</code>","line":10,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["n","5",0]],"stack":[]},{"caption":"<code>for left in range(1, n, 2):</code> &mdash; <code>left = 1</code>","line":11,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["n","5",0],["left","1",1]],"stack":[]},{"caption":"<code>for l in all_possible_fbt(left):</code> &mdash; calls <code>all_possible_fbt(n=1)</code>","line":12,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["n","1",1],["left","1",0]],"stack":["all_possible_fbt(n=5)","all_possible_fbt(n=1)"]},{"caption":"<code>if n % 2 == 0:</code> &rarr; <strong>false</strong> (n = 1)","line":6,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true}],"vars":[["n","1",0],["left","1",0]],"stack":["all_possible_fbt(n=5)","all_possible_fbt(n=1)"]},{"caption":"<code>if n == 1:</code> &rarr; <strong>true</strong> (n = 1)","line":