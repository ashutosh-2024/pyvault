{"chapters":[{"title":"Plain recursion","code":"def min_extra_char(s, dictionary):\n    words = set(dictionary)\n\n    def best(i):\n        if i == len(s):\n            return 0\n        result = 1 + best(i + 1)\n        for j in range(i + 1, len(s) + 1):\n            if s[i:j] in words:\n                result = min(result, best(j))\n        return result\n\n    return best(0)","frames":[{"caption":"<strong>Plain recursion</strong> &mdash; O(2<sup>n</sup>) time, O(n) extra space. Input: <code>min_extra_char(s='abc', dictionary=[])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c"],"cls":["","",""]},{"t":"arr","id":"dictionary","label":"dictionary","v":[],"cls":[],"noidx":true}],"vars":[["s","'abc'",0]],"stack":[]},{"caption":"<code>words = set(dictionary)</code> &mdash; <code>words = set()</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c"],"cls":["","",""]},{"t":"arr","id":"dictionary","label":"dictionary","v":[],"cls":[],"noidx":true}],"vars":[["s","'abc'",0],["words","set()",1]],"stack":[]},{"caption":"<code>def best(i):</code>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c"],"cls":["","",""]},{"t":"arr","id":"dictionary","label":"dictionary","v":[],"cls":[],"noidx":true}],"vars":[["s","'abc'",0],["words","set()",0]],"stack":[]},{"caption":"<code>return best(0)</code> &mdash; calls <code>best(i=0)</code>","line":13,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c"],"cls":["","",""]},{"t":"arr","id":"dictionary","label":"dictionary","v":[],"cls":[],"noidx":true}],"vars":[["s","'abc'",0],["words","set()",0],["i","0",1]],"stack":["min_extra_char(s='abc', dictionary)","best(i=0)"]},{"caption":"<code>if i == len(s):</code> &rarr; <strong>false</strong> (i = 0, s = 'abc')","line":5,"panels":[{"t":"arr","id":"s","label":"s","v":["a","b","c"],"cls":["","",""]},{"t":"arr","id":"dictionary","label":"dictionary","v":[],"cls":[],"noidx":true}