</code> &mdash; <code>dp = [0, 0, 0, 0]</code>","line":3,"panels":[{"t":"arr","id":"dictionary","label":"dictionary","v":[],"cls":[],"noidx":true},{"t":"arr","id":"dp","label":"dp","v":["0","0","0","0"],"cls":["","","",""]}],"vars":[["s","'abc'",0],["words","set()",0],["n","3",0]],"stack":[]},{"caption":"<code>for i in range(n - 1, -1, -1):</code> &mdash; <code>i = 2</code>","line":4,"panels":[{"t":"arr","id":"dictionary","label":"dictionary","v":[],"cls":[],"noidx":true},{"t":"arr","id":"dp","label":"dp","v":["0","0","0","0"],"cls":["","","src",""],"ptr":{"2":["i"]}}],"vars":[["s","'abc'",0],["words","set()",0],["n","3",0],["i","2",1]],"stack":[]},{"caption":"<code>dp[i] = 1 + dp[i + 1]</code> &mdash; <code>dp[2]</code> becomes <code>1</code>","line":5,"panels":[{"t":"arr","id":"dictionary","label":"dictionary","v":[],"cls":[],"noidx":true},{"t":"arr","id":"dp","label":"dp","v":["0","0","1","0"],"cls":["","","cur",""],"ptr":{"2":["i"]}}],"vars":[["s","'abc'",0],["words","set()",0],["n","3",0],["i","2",0]],"stack":[]},{"caption":"<code>for j in range(i + 1, n + 1):</code> &mdash; <code>j = 3</code>","line":6,"panels":[{"t":"arr","id":"dictionary","label":"dictionary","v":[],"cls":[],"noidx":true},{"t":"arr","id":"dp","label":"dp","v":["0","0","1","0"],"cls":["","","src","src"],"ptr":{"2":["i"],"3":["j"]}}],"vars":[["s","'abc'",0],["words","set()",0],["n","3",0],["i","2",0],["j","3",1]],"stack":[]},{"caption":"<code>if s[i:j] in words:</code> &rarr; <strong>false</strong> (i = 2, j = 3, s = 'abc')","line":7,"panels":[{"t":"arr","id":"dictionary","label":"dictionary","v":[],"cls":[],"noidx":true},{"t":"arr","id":"dp","label":"dp","v":["0","0","1","0"],"cls":["","","src","src"],"ptr":{"2":["i"],"3":["j"]}}],"vars":[["s","'abc'",0],["words","set()",0],["n","3",0],["i","2",0],["j","3",0]],"stack":[]},{"caption":"<code>for j in range(i + 1, n + 1):</code>","line":6,"panels":[{"t":"arr","id":"dictionary","label":"dictionary","v":[],"cls":[],"noidx":true},{"t":"arr","id":"d