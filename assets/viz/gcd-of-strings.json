{"chapters":[{"title":"Try every prefix length, longest first","code":"def gcd_of_strings(str1, str2):\n    for L in range(min(len(str1), len(str2)), 0, -1):\n        if len(str1) % L == 0 and len(str2) % L == 0:\n            x = str1[:L]\n            if x * (len(str1) // L) == str1 and x * (len(str2) // L) == str2:\n                return x\n    return \"\"","frames":[{"caption":"<strong>Try every prefix length, longest first</strong> &mdash; O(min(m, n) &middot; (m + n)) time, O(m + n) extra space. Input: <code>gcd_of_strings(str1='ABABAB', str2='ABAB')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"str1","label":"str1","v":["A","B","A","B","A","B"],"cls":["","","","","",""]},{"t":"arr","id":"str2","label":"str2","v":["A","B","A","B"],"cls":["","","",""]}],"vars":[["str1","'ABABAB'",0],["str2","'ABAB'",0]],"stack":[]},{"caption":"<code>for L in range(min(len(str1), len(str2)), 0, -1):</code> &mdash; <code>L = 4</code>","line":2,"panels":[{"t":"arr","id":"str1","label":"str1","v":["A","B","A","B","A","B"],"cls":["","","","","",""]},{"t":"arr","id":"str2","label":"str2","v":["A","B","A","B"],"cls":["","","",""]}],"vars":[["str1","'ABABAB'",0],["str2","'ABAB'",0],["L","4",1]],"stack":[]},{"caption":"<code>if len(str1) % L == 0 and len(str2) % L == 0:</code> &rarr; <strong>false</strong> (L = 4, str1 = 'ABABAB', str2 = 'ABAB')","line":3,"panels":[{"t":"arr","id":"str1","label":"str1","v":["A","B","A","B","A","B"],"cls":["","","","","",""]},{"t":"arr","id":"str2","label":"str2","v":["A","B","A","B"],"cls":["","","",""]}],"vars":[["str1","'ABABAB'",0],["str2","'ABAB'",0],["L","4",0]],"stack":[]},{"caption":"<code>for L in range(min(len(str1), len(str2)), 0, -1):</code> &mdash; <code>L = 3</code>","line":2,"panels":[{"t":"arr","id":"str1","label":"str1","v":["A","B","A","B","A","B"],"cls":["","","","","",""]},{"t":"arr","id":"str2","label":"str2","v":["A","B","A","B"],"cls":["","","",""]}],"vars":[["str1","'ABABAB'",0],["str2","'ABAB'",0],["L","3",1]],"stack":[]},{"caption":"<code>if len(str1) % L == 0 and len(str2) % L == 0:</code> &rarr; <strong>false</strong> (L = 3, str1 = 'ABABAB', str2 = 'ABAB')","line":3,"panels":[{"t":"arr","id":"str1","label":"str1","v":["A","B","A","B","A","B"],"cls":["","","","","",""]},{"t":"arr","id":"str2","label":"str2","v":["A","B","A","B"],"cls":["","","",""]}],"vars":[["str1","'ABABAB'",0],["str2","'ABAB'",0],["L","3",0]],"stack":[]},{"caption":"<code>for L in range(min(len(str1), len(str2)), 0, -1):</code> &mdash; <code>L = 2</code>","line":2,"panels":[{"t":"arr","id":"str1","label":"str1","v":["A","B","A","B","A","B"],"cls":["","","","","",""]},{"t":"arr","id":"str2","label":"str2","v":["A","B","A","B"],"cls":["","","",""]}],"vars":[["str1","'ABABAB'",0],["str2","'ABAB'",0],["L","2",1]],"stack":[]},{"caption":"<code>if len(str1) % L == 0 and len(str2) % L == 0:</code> &rarr; <strong>true</strong> (L = 2, str1 = 'ABABAB', str2 = 'ABAB')","line":3,"panels":[{"t":"arr","id":"str1","label":"str1","v":["A","B","A","B","A","B"],"cls":["","","","","",""]},{"t":"arr","id":"str2","label":"str2","v":["A","B","A","B"],"cls":["","","",""]}],"vars":[["str1","'ABABAB'",0],["str2","'ABAB'",0],["L","2",0]],"stack":[]},{"caption":"<code>x = str1[:L]</code> &mdash; <code>x = 'AB'</code>","line":4,"panels":[{"t":"arr","id":"str1","label":"str1","v":["A","B","A","B","A","B"],"cls":["","","","","",""]},{"t":"arr","id":"str2","label":"str2","v":["A","B","A","B"],"cls":["","","",""]},{"t":"arr","id":"x","label":"x","v":["A","B"],"cls":["",""]}],"vars":[["str1","'ABABAB'",0],["str2","'ABAB'",0],["L","2",0],["x","'AB'",1]],"stack":[]},{"caption":"<code>if x * (len(str1) // L) == str1 and x * (len(str2) // L) == str2:</code> &rarr; <strong>true</strong> (L = 2, str1 = 'ABABAB', str2 = 'ABAB', x = 'AB')","line":5,"panels":[{"t":"arr","id":"str1","label":"str1","v":["A","B","A","B","A","B"],"cls":["","","","","",""]},{"t":"arr","id":"str2","label":"str2","v":["A","B","A","B"