een","set()",0],["x","1",1]],"stack":[]},{"caption":"<code>if x in seen:</code> &rarr; <strong>false</strong> (x = 1)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]}],"vars":[["seen","set()",0],["x","1",0]],"stack":[]},{"caption":"<code>seen.add(x)</code> &mdash; <code>1</code> added to <code>seen</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1"],"cls":[""],"noidx":true}],"vars":[["x","1",0]],"stack":[]},{"caption":"<code>for x in nums:</code> &mdash; <code>x = 3</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1"],"cls":[""],"noidx":true}],"vars":[["x","3",1]],"stack":[]},{"caption":"<code>if x in seen:</code> &rarr; <strong>false</strong> (x = 3)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1"],"cls":[""],"noidx":true}],"vars":[["x","3",0]],"stack":[]},{"caption":"<code>seen.add(x)</code> &mdash; <code>3</code> added to <code>seen</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1","3"],"cls":["","cur"],"noidx":true}],"vars":[["x","3",0]],"stack":[]},{"caption":"<code>for x in nums:</code> &mdash; <code>x = 4</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1","3"],"cls":["",""],"noidx":true}],"vars":[["x","4",1]],"stack":[]},{"caption":"<code>if x in seen:</code> &rarr; <strong>false</strong> (x = 4)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1","3"],"cls":["",""],"noidx":true}],"vars":[["x","4",0]],"stack":[]},{"caption":"<code>seen.add(x)</code> &mdash; <code>4</code> added to <code>seen</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1","3","4"],"cls":["","","cur"],"noidx":true}],"vars":[["x","4",0]],"stack":[]},{"caption":"<code>for x in nums:</code> &mdash; <code>x = 2</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1","3","4"],"cls":["","",""],"noidx":true}],"vars":[["x","2",1]],"stack":[]},{"caption":"<code>if x in seen:</code> &rarr; <strong>false</strong> (x = 2)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1","3","4"],"cls":["","",""],"noidx":true}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>seen.add(x)</code> &mdash; <code>2</code> added to <code>seen</code>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1","2","3","4"],"cls":["","cur","cur","cur"],"noidx":true}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>for x in nums:</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1","2","3","4"],"cls":["","","",""],"noidx":true}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>if x in seen:</code> &rarr; <strong>true</strong> (x = 2)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1","2","3","4"],"cls":["","","",""],"noidx":true}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>return x</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"seen","label":"seen (set)","v":["1","2","3","4"],"cls":["","","",""],"noidx":true}],"vars":[["x","2",0]],"stack":[]}]},{"title":"Binary search on the value, counting","code":"def find_duplicate(nums):\n    lo, hi = 1, len(nums) - 1\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if sum(x <= mid for x in nums) > mid:\n            hi = mid                           # too many small values: dup <= mid\n        else:\n            lo = mid + 1\n    return lo","frames":[{"caption":"<strong>Binary search on the value, counting</strong> &mdash; O(n log n) time, O(1) extra space. Input: <code>find_duplicate(nums=[1, 3, 4, 2, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>lo, hi = 1, len(nums) - 1</code> &mdash; <code>lo = 1</code>; <code>hi = 4</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","4"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["lo","1",1],["hi","4",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 4, lo = 1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","4"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["lo","1",0],["hi","4",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 2</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","2","4"],"cls":["","cur","cur"],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","4",0],["mid","2",1]],"stack":[]},{"caption":"<code>if sum(x &lt;= mid for x in nums) &gt; mid:</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","2","4"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","4",0],["mid","2",0]],"stack":["find_duplicate(nums)","<genexpr>()"]},{"caption":"<code>if sum(x &lt;= mid for x in nums) &gt; mid:</code> &mdash; yields <code>T</code>; <code>x = 1</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","2","4"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","4",0],["mid","2",0],["x","1",1]],"stack":["find_duplicate(nums)","<genexpr>()"]},{"caption":"<code>if sum(x &lt;= mid for x in nums) &gt; mid:</code> &mdash; yields <code>F</code>; <code>x = 3</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","2","4"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","4",0],["mid","2",0],["x","3",1]],"stack":["find_duplicate(nums)","<genexpr>()"]},{"caption":"<code>if sum(x &lt;= mid for x in nums) &gt; mid:</code> &mdash; yields <code>F</code>; <code>x = 4</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","2","4"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","4",0],["mid","2",0],["x","4",1]],"stack":["find_duplicate(nums)","<genexpr>()"]},{"caption":"<code>if sum(x &lt;= mid for x in nums) &gt; mid:</code> &mdash; yields <code>T</code>; <code>x = 2</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","2","4"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","4",0],["mid","2",0],["x","2",1]],"stack":["find_duplicate(nums)","<genexpr>()"]},{"caption":"<code>if sum(x &lt;= mid for x in nums) &gt; mid:</code> &mdash; yields <code>T</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","2","4"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","4",0],["mid","2",0],["x","2",0]],"stack":["find_duplicate(nums)","<genexpr>()"]},{"caption":"<code>if sum(x &lt;= mid for x in nums) &gt; mid:</code> &mdash; yields <code>None</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","2","4"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","4",0],["mid","2",0],["x","2",0]],"stack":["find_duplicate(nums)","<genexpr>()"]},{"caption":"<code>hi = mid</code> &mdash; <code>hi = 2</code> <em>(too many small values: dup &lt;= mid)</em>","line":6,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","2","2"],"cls":["","","cur"],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","2",1],["mid","2",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 2, lo = 1)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","2","2"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","2",0],["mid","2",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 1</code>","lin