",1]],"stack":["find_duplicate(nums)","<genexpr>()"]},{"caption":"<code>if sum(x &lt;= mid for x in nums) &gt; mid:</code> &mdash; yields <code>F</code>; <code>x = 2</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","1","2"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","2",0],["mid","1",0],["x","2",1]],"stack":["find_duplicate(nums)","<genexpr>()"]},{"caption":"<code>if sum(x &lt;= mid for x in nums) &gt; mid:</code> &mdash; yields <code>F</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","1","2"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","2",0],["mid","1",0],["x","2",0]],"stack":["find_duplicate(nums)","<genexpr>()"]},{"caption":"<code>if sum(x &lt;= mid for x in nums) &gt; mid:</code> &mdash; yields <code>None</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","1","2"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","1",0],["hi","2",0],["mid","1",0],["x","2",0]],"stack":["find_duplicate(nums)","<genexpr>()"]},{"caption":"<code>lo = mid + 1</code> &mdash; <code>lo = 2</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["2","1","2"],"cls":["cur","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","2",1],["hi","2",0],["mid","1",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>false</strong> (hi = 2, lo = 2)","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["2","1","2"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","2",0],["hi","2",0],["mid","1",0]],"stack":[]},{"caption":"<code>return lo</code> &mdash; returns <code>2</code>. <strong>Result: 2</strong>","line":9,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["2","1","2"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["lo","2",0],["hi","2",0],["mid","1",0]],"stack":[]}]},{"title":"Floyd's cycle detection on i → nums[i]","code":"def find_duplicate(nums):\n    slow = fast = 0\n    while True:\n        slow = nums[slow]\n        fast = nums[nums[fast]]\n        if slow == fast:\n            break\n    slow = 0\n    while slow != fast:                        # both walk to the cycle entrance\n        slow, fast = nums[slow], nums[fast]\n    return slow","frames":[{"caption":"<strong>Floyd's cycle detection on i → nums[i]</strong> &mdash; O(n) time, O(1) extra space. Input: <code>find_duplicate(nums=[1, 3, 4, 2, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>slow = fast = 0</code> &mdash; <code>slow = 0</code>; <code>fast = 0</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["src","","","",""],"ptr":{"0":["fast","slow"]}}],"vars":[["slow","0",1],["fast","0",1]],"stack":[]},{"caption":"<code>while True:</code> &rarr; <strong>true</strong>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["src","","","",""],"ptr":{"0":["fast","slow"]}}],"vars":[["slow","0",0],["fast","0",0]],"stack":[]},{"caption":"<code>slow = nums[slow]</code> &mdash; <code>slow = 1</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","3","4","2","2"],"cls":["src","src","","",""],"ptr":{"0":["fast"],"1":["slow"]}}],"vars":[["slow","1",1],["fast","0",0