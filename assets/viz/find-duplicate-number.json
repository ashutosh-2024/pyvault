{"chapters":[{"title":"Sort and look for neighbours","code":"def find_duplicate(nums):\n    s = sorted(nums)\n    for a, b in zip(s, s[1:]):\n        if a == b:\n            return a","frames":[{"caption":"<strong>Sort and look for neighbours</strong> &mdash; O(n log n) time, O(1)&ndash;O(n) extra space. Input: <code>find_duplicate(nums=[3, 1, 3, 4, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","1","3","4","2"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>s = sorted(nums)</code> &mdash; <code>s = [1, 2, 3, 3, 4]</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","1","3","4","2"],"cls":["","","","",""]},{"t":"arr","id":"s","label":"s","v":["1","2","3","3","4"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>for a, b in zip(s, s[1:]):</code> &mdash; <code>a = 1</code>; <code>b = 2</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","1","3","4","2"],"cls":["","","","",""]},{"t":"arr","id":"s","label":"s","v":["1","2","3","3","4"],"cls":["","","","",""]}],"vars":[["a","1",1],["b","2",1]],"stack":[]},{"caption":"<code>if a == b:</code> &rarr; <strong>false</strong> (a = 1, b = 2)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","1","3","4","2"],"cls":["","","","",""]},{"t":"arr","id":"s","label":"s","v":["1","2","3","3","4"],"cls":["","","","",""]}],"vars":[["a","1",0],["b","2",0]],"stack":[]},{"caption":"<code>for a, b in zip(s, s[1:]):</code> &mdash; <code>a = 2</code>; <code>b = 3</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","1","3","4","2"],"cls":["","","","",""]},{"t":"arr","id":"s","label":"s","v":["1","2","3","3","4"],"cls":["","","","",""]}],"vars":[["a","2",1],["b","3",1]],"stack":[]},{"caption":"<code>if a == b:</code> &rarr; <strong>false</strong> (a = 2, b = 3)","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["3","1","3","4","2"],"cls":