ed 4 times so far.","grid":{"v":[["2","4","3","2","1","1","1"]],"cls":[["heat2","cur","stack","stack","heat1","stack","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 14"},{"caption":"Call <code>fib(0)</code> &mdash; base case. Computed 3 times so far.","grid":{"v":[["3","4","3","2","1","1","1"]],"cls":[["cur","heat4","stack","stack","heat1","stack","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 15"},{"caption":"Call <code>fib(1)</code> &mdash; base case. Computed 5 times so far.","grid":{"v":[["3","5","3","2","1","1","1"]],"cls":[["heat3","cur","heat3","stack","heat1","stack","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 16"},{"caption":"Call <code>fib(4)</code>. Computed 2 times so far.","grid":{"v":[["3","5","3","2","2","1","1"]],"cls":[["heat3","heat5","heat3","heat2","cur","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 17"},{"caption":"Call <code>fib(3)</code>. Computed 3 times so far.","grid":{"v":[["3","5","3","3","2","1","1"]],"cls":[["heat3","heat5","heat3","cur","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 18"},{"caption":"Call <code>fib(2)</code>. Computed 4 times so far.","grid":{"v":[["3","5","4","3","2","1","1"]],"cls":[["heat3","heat5","cur","stack","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 19"},{"caption":"Call <code>fib(1)</code> &mdash; base case. Computed 6 times so far.","grid":{"v":[["3","6","4","3","2","1","1"]],"cls":[["heat3","cur","stack","stack","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 20"},{"caption":"Call <code>fib(0)</code> &mdash; base case. Computed 4 times so far.","grid":{"v":[["4","6","4","3","2","1","1"]],"cls":[["cur","heat5","stack","stack","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 21"},{"caption":"Call <code>fib(1)</code> &mdash; base case. Computed 7 times so far.","grid":{"v":[["4","7","4","3","2","1","1"]],"cls":[["heat4","cur","heat4","stack","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 22"},{"caption":"Call <code>fib(2)</code>. Computed 5 times so far.","grid":{"v":[["4","7","5","3","2","1","1"]],"cls":[["heat4","heat5","cur","heat3","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 23"},{"caption":"Call <code>fib(1)</code> &mdash; base case. Computed 8 times so far.","grid":{"v":[["4","8","5","3","2","1","1"]],"cls":[["heat4","cur","stack","heat3","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 24"},{"caption":"Call <code>fib(0)</code> &mdash; base case. Computed 5 times so far.","grid":{"v":[["5","8","5","3","2","1","1"]],"cls":[["cur","heat5","stack","heat3","stack","heat1","stack"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"calls so far: 25"},{"caption":"<strong>25 calls</strong> for 7 different values. <code>fib(1)</code> alone was computed 8 times; the count roughly doubles with every +1 to n.","grid":{"v":[["5","8","5","3","2","1","1"]],"cls":[["heat5","heat5","heat5","heat3","heat2","heat1","heat1"]],"rowLabels":["calls"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"25 calls vs 7 distinct sub-problems"}]},{"title":"Bottom-up table","frames":[{"caption":"Start from the two base cases, <code>fib(0) = 0</code> and <code>fib(1) = 1</code>, and build upwards.","grid":{"v":[["0","1","","","","",""]],"cls":[["base","base","empty","empty","empty","empty","empty"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"fib[0] = 0,  fib[1] = 1"},{"caption":"<code>fib[2]</code> reads the two entries just before it, both already computed.","grid":{"v":[["0","1","1","","","",""]],"cls":[["src","src","cur","empty","empty","empty","empty"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"fib[2] = fib[1] + fib[0] = 1 + 0 = 1","arrows":[[0,1,0,2],[0,0,0,2]]},{"caption":"<code>fib[3]</code> reads the two entries just before it, both already computed.","grid":{"v":[["0","1","1","2","","",""]],"cls":[["base","src","src","cur","empty","empty","empty"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"fib[3] = fib[2] + fib[1] = 1 + 1 = 2","arrows":[[0,2,0,3],[0,1,0,3]]},{"caption":"<code>fib[4]</code> reads the two entries just before it, both already computed.","grid":{"v":[["0","1","1","2","3","",""]],"cls":[["base","base","src","src","cur","empty","empty"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"fib[4] = fib[3] + fib[2] = 2 + 1 = 3","arrows":[[0,3,0,4],[0,2,0,4]]},{"caption":"<code>fib[5]</code> reads the two entries just before it, both already computed.","grid":{"v":[["0","1","1","2","3","5",""]],"cls":[["base","base","done","src","src","cur","empty"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"fib[5] = fib[4] + fib[3] = 3 + 2 = 5","arrows":[[0,4,0,5],[0,3,0,5]]},{"caption":"<code>fib[6]</code> reads the two entries just before it, both already computed.","grid":{"v":[["0","1","1","2","3","5","8"]],"cls":[["base","base","done","done","src","src","cur"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"fib[6] = fib[5] + fib[4] = 5 + 3 = 8","arrows":[[0,5,0,6],[0,4,0,6]]},{"caption":"Each value computed once: <strong>5 additions</strong> instead of 25 calls.","grid":{"v":[["0","1","1","2","3","5","8"]],"cls":[["base","base","done","done","done","done","answer"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"fib(6) = 8"}]},{"title":"Keep two numbers","frames":[{"caption":"Step 0: only <code>fib[0]</code> will ever be read again; everything faded can be forgotten.","grid":{"v":[["0","","","","","",""]],"cls":[["cur","empty","empty","empty","empty","empty","empty"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"kept in memory: 0"},{"caption":"Step 1: only <code>fib[0]</code>, <code>fib[1]</code> will ever be read again; everything faded can be forgotten.","grid":{"v":[["0","1","","","","",""]],"cls":[["done","cur","empty","empty","empty","empty","empty"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"kept in memory: 0, 1"},{"caption":"Step 2: only <code>fib[1]</code>, <code>fib[2]</code> will ever be read again; everything faded can be forgotten.","grid":{"v":[["0","1","1","","","",""]],"cls":[["dim","done","cur","empty","empty","empty","empty"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"kept in memory: 1, 1"},{"caption":"Step 3: only <code>fib[2]</code>, <code>fib[3]</code> will ever be read again; everything faded can be forgotten.","grid":{"v":[["0","1","1","2","","",""]],"cls":[["dim","dim","done","cur","empty","empty","empty"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"kept in memory: 1, 2"},{"caption":"Step 4: only <code>fib[3]</code>, <code>fib[4]</code> will ever be read again; everything faded can be forgotten.","grid":{"v":[["0","1","1","2","3","",""]],"cls":[["dim","dim","dim","done","cur","empty","empty"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"kept in memory: 2, 3"},{"caption":"Step 5: only <code>fib[4]</code>, <code>fib[5]</code> will ever be read again; everything faded can be forgotten.","grid":{"v":[["0","1","1","2","3","5",""]],"cls":[["dim","dim","dim","dim","done","cur","empty"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"kept in memory: 3, 5"},{"caption":"Step 6: only <code>fib[5]</code>, <code>fib[6]</code> will ever be read again; everything faded can be forgotten.","grid":{"v":[["0","1","1","2","3","5","8"]],"cls":[["dim","dim","dim","dim","dim","done","cur"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"kept in memory: 5, 8"},{"caption":"Two variables, <code>a, b = b, a + b</code>, give the same <strong>8</strong> in O(1) space.","grid":{"v":[["0","1","1","2","3","5","8"]],"cls":[["dim","dim","dim","dim","dim","dim","answer"]],"rowLabels":["fib"],"colLabels":["0","1","2","3","4","5","6"]},"formula":"answer = 8"}]}]}