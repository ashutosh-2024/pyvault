ra space. Input: <code>min_eating_speed(piles=[3, 6, 7, 11], h=8)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"piles","label":"piles","v":["3","6","7","11"],"cls":["","","",""]}],"vars":[["h","8",0]],"stack":[]},{"caption":"<code>def hours(k):</code>","line":2,"panels":[{"t":"arr","id":"piles","label":"piles","v":["3","6","7","11"],"cls":["","","",""]}],"vars":[["h","8",0]],"stack":[]},{"caption":"<code>lo, hi = 1, max(piles)</code> &mdash; <code>lo = 1</code>; <code>hi = 11</code>","line":5,"panels":[{"t":"arr","id":"piles","label":"piles","v":["3","6","7","11"],"cls":["","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","11"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["h","8",0],["lo","1",1],["hi","11",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 11, lo = 1)","line":6,"panels":[{"t":"arr","id":"piles","label":"piles","v":["3","6","7","11"],"cls":["","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","11"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["h","8",0],["lo","1",0],["hi","11",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 6</code>","line":7,"panels":[{"t":"arr","id":"piles","label":"piles","v":["3","6","7","11"],"cls":["","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","6","11"],"cls":["","cur","cur"],"keys":["lo","mid","hi"]}],"vars":[["h","8",0],["lo","1",0],["hi","11",0],["mid","6",1]],"stack":[]},{"caption":"<code>if hours(mid) &lt;= h:</code> &mdash; calls <code>hours(k=6)</code>","line":8,"panels":[{"t":"arr","id":"piles","label":"piles","v":["3","6","7","11"],"cls":["","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","6","11"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["h","8",0],["lo","1",0],["hi","11",0],["mid","6",0],["k","6",1]],"stack":["min_eating_speed(piles, h=8)","hours(k=6)"]},{"caption":"<code>return sum((p + k - 1) // k for p in piles)</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":3,"panels":[{"t":"arr","id":"piles","label":"piles","v":["3","6","7","11"],"cls":["","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","6","11"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["h","8",0],["lo","1",0],["hi","11",0],["mid","6",0],["k","6",0]],"stack":["min_eating_speed(piles, h=8)","hours(k=6)","<genexpr>()"]},{"caption":"<code>return sum((p + k - 1) // k for p in piles)</code> &mdash; yields <code>1</code>; <code>p = 3</code>","line":3,"panels":[{"t":"arr","id":"piles","label":"piles","v":["3","6","7","11"],"cls":["","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","6","11"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["h","8",0],["lo","1",0],["hi","11",0],["mid","6",0],["k","6",0],["p","3",1]],"stack":["min_eating_speed(piles, h=8)","hours(k=6)","<genexpr>()"]},{"caption":"<code>return sum((p + k - 1) // k for p in piles)</code> &mdash; yields <code>1</code>; <code>p = 6</code>","line":3,"panels":[{"t":"arr","id":"piles","label":"piles","v":["3","6","7","11"],"cls":["","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","6","11"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["h","8",0],["lo","1",0],["hi","11",0],["mid","6",0],["k","6",0],["p","6",1]],"stack":["min_eating_speed(piles, h=8)","hours(k=6)","<genexpr>()"]},{"caption":"<code>return sum((p + k - 1) // k for p in piles)</code> &mdash; yields <code>2</code>; <code>p = 7</code>","line":3,"panels":[{"t":"arr","id":"piles","label":"piles","v":["3","6","7","11"],"cls":["","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","6","11"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["h","8",0],["lo","1",0],["hi","11",0],["mid","6",0],["k","6",0],["p","7",1]],"stack":["min_eating_speed(piles, h=8)","hours(k=6)","<genexpr>()"]},{"caption":"<code>return sum((p + k - 1) // k for p in piles)</code> &mdash; yields <code>2</