put: <code>min_eating_speed(piles=[30, 11, 23, 4, 20], h=5)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"piles","label":"piles","v":["30","11","23","4","20"],"cls":["","","","",""]}],"vars":[["h","5",0]],"stack":[]},{"caption":"<code>def hours(k):</code>","line":2,"panels":[{"t":"arr","id":"piles","label":"piles","v":["30","11","23","4","20"],"cls":["","","","",""]}],"vars":[["h","5",0]],"stack":[]},{"caption":"<code>lo, hi = 1, max(piles)</code> &mdash; <code>lo = 1</code>; <code>hi = 30</code>","line":5,"panels":[{"t":"arr","id":"piles","label":"piles","v":["30","11","23","4","20"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","30"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["h","5",0],["lo","1",1],["hi","30",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 30, lo = 1)","line":6,"panels":[{"t":"arr","id":"piles","label":"piles","v":["30","11","23","4","20"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","30"],"cls":["",""],"keys":["lo","hi"]}],"vars":[["h","5",0],["lo","1",0],["hi","30",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 15</code>","line":7,"panels":[{"t":"arr","id":"piles","label":"piles","v":["30","11","23","4","20"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","15","30"],"cls":["","cur","cur"],"keys":["lo","mid","hi"]}],"vars":[["h","5",0],["lo","1",0],["hi","30",0],["mid","15",1]],"stack":[]},{"caption":"<code>if hours(mid) &lt;= h:</code> &mdash; calls <code>hours(k=15)</code>","line":8,"panels":[{"t":"arr","id":"piles","label":"piles","v":["30","11","23","4","20"],"cls":["","","","",""]},{"t":"arr","id":"range:lo","label":"search range","v":["1","15","30"],"cls":["","",""],"keys":["lo","mid","hi"]}],"vars":[["h","5",0],["lo","1",0],["hi","30",0],["mid","15",0],["k","15",1]],"stack":["min_eating_speed(piles, 