{"chapters":[{"title":"Postorder returning (is_bst, min, max, sum)","code":"def max_sum_bst(root):\n    best = 0\n    INF = float(\"inf\")\n\n    def dfs(node):\n        \"\"\"Return (is_bst, min, max, sum) for this subtree.\"\"\"\n        nonlocal best\n        if node is None:\n            return True, INF, -INF, 0\n        lb, lmin, lmax, lsum = dfs(node.left)\n        rb, rmin, rmax, rsum = dfs(node.right)\n        if lb and rb and lmax < node.val < rmin:\n            total = lsum + rsum + node.val\n            best = max(best, total)\n            return True, min(lmin, node.val), max(rmax, node.val), total\n        return False, 0, 0, 0\n\n    dfs(root)\n    return best","frames":[{"caption":"<strong>Postorder returning (is_bst, min, max, sum)</strong> &mdash; O(n) time, O(h) extra space. Input: <code>max_sum_bst(root=tree (5))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4456635728","3",0.0,2.5,"",[]],["n4456420432","4",1.0,1.25,"",[]],["n4456420272","5",2.0,0.0,"cur",["root"]],["n4456635856","6",3.0,2.5,"",[]],["n4453050576","8",4.0,1.25,"",[]],["n4455866544","3",5.0,2.5,"",[]]],"edges":[["n4456420272","n4456420432","",""],["n4456420432","n4456635728","",""],["n4456420272","n4453050576","",""],["n4453050576","n4456635856","",""],["n4453050576","n4455866544","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>best = 0</code> &mdash; <code>best = 0</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4456635728","3",0.0,2.5,"",[]],["n4456420432","4",1.0,1.25,"",[]],["n4456420272","5",2.0,0.0,"cur",["root"]],["n4456635856","6",3.0,2.5,"",[]],["n4453050576","8",4.0,1.25,"",[]],["n4455866544","3",5.0,2.5,"",[]]],"edges":[["n4456420272","n4456420432","",""],["n4456420432","n4456635728","",""],["n4456420272","n4453050576","",""],["n4453050576","n4456635856","",""],["n4453050576","n4455866544","",""]],"dir":false}],"vars":[["best","0",1]],"stack":[]