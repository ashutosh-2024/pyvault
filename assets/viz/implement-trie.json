,["n4436186096","p",0.0,3.75,"cur",["node"]],["n4436186528","p",0.0,2.5,"done",[]],["n4436190560","a",0.0,1.25,"done",[]],["n4436192336","",0.0,0.0,"cur",["self.root"]]],"edges":[["n4436192336","n4436190560","",""],["n4436190560","n4436186528","",""],["n4436186528","n4436186096","",""],["n4436186096","n4436183552","",""],["n4436183552","n4436185904","",""]],"dir":false}],"vars":[["word","'app'",0],["s","'app'",0],["ch","'p'",0]],"stack":["search(word='app')","_walk(s='app')"]},{"caption":"<code>for ch in s:</code>","line":21,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4436185904","e",0.0,6.25,"answer",[]],["n4436183552","l",0.0,5.0,"",[]],["n4436186096","p",0.0,3.75,"cur",["node"]],["n4436186528","p",0.0,2.5,"done",[]],["n4436190560","a",0.0,1.25,"done",[]],["n4436192336","",0.0,0.0,"cur",["self.root"]]],"edges":[["n4436192336","n4436190560","",""],["n4436190560","n4436186528","",""],["n4436186528","n4436186096","",""],["n4436186096","n4436183552","",""],["n4436183552","n4436185904","",""]],"dir":false}],"vars":[["word","'app'",0],["s","'app'",0],["ch","'p'",0]],"stack":["search(word='app')","_walk(s='app')"]},{"caption":"<code>return node</code> &mdash; <code>_walk</code> returns <code>node</code> to <code>search</code>","line":25,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4436185904","e",0.0,6.25,"answer",[]],["n4436183552","l",0.0,5.0,"",[]],["n4436186096","p",0.0,3.75,"cur",["node"]],["n4436186528","p",0.0,2.5,"done",[]],["n4436190560","a",0.0,1.25,"done",[]],["n4436192336","",0.0,0.0,"cur",["self.root"]]],"edges":[["n4436192336","n4436190560","",""],["n4436190560","n4436186528","",""],["n4436186528","n4436186096","",""],["n4436186096","n4436183552","",""],["n4436183552","n4436185904","",""]],"dir":false}],"vars":[["word","'app'",0],["s","'app'",0],["ch","'p'",0]],"stack":["search(word='app')","_walk(s='app')"]},{"caption":"<code>return node is not None and node.is_end</code> &mdash; returns <code>T</code>. <strong>Result: T</strong>","line":29,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4436185904","e",0.0,6.25,"answer",[]],["n4436183552","l",0.0,5.0,"",[]],["n4436186096","p",0.0,3.75,"cur",["node"]],["n4436186528","p",0.0,2.5,"done",[]],["n4436190560","a",0.0,1.25,"done",[]],["n4436192336","",0.0,0.0,"cur",["self.root"]]],"edges":[["n4436192336","n4436190560","",""],["n4436190560","n4436186528","",""],["n4436186528","n4436186096","",""],["n4436186096","n4436183552","",""],["n4436183552","n4436185904","",""]],"dir":false}],"vars":[["word","'app'",0]],"stack":[]}]},{"title":"Fixed array of 26 children","code":"class Trie:\n    def __init__(self):\n        self.children = [[None] * 26]     # node id -> child ids\n        self.is_end = [False]\n\n    def _child(self, node, ch, create):\n        i = ord(ch) - 97\n        nxt = self.children[node][i]\n        if nxt is None and create:\n            nxt = len(self.children)\n            self.children.append([None] * 26)\n            self.is_end.append(False)\n            self.children[node][i] = nxt\n        return nxt\n\n    def insert(self, word):\n        node = 0\n        for ch in word:\n            node = self._child(node, ch, True)\n        self.is_end[node] = True\n\n    def _walk(self, s):\n        node = 0\n        for ch in s:\n            node = self._child(node, ch, False)\n            if node is None:\n                return None\n        return node\n\n    def search(self, word):\n        node = self._walk(word)\n        return node is not None and self.is_end[node]\n\n    def startsWith(self, prefix):\n        return self._walk(prefix) is not None","frames":[{"caption":"<strong>Fixed array of 26 children</strong> &mdash; O(L) per operation time, O(26 &middot; nodes) extra space. Running <code>t = Trie(); t.insert(\"apple\"); assert t.search(\"apple\") is True and t.search(\"app\") is False and t.startsWith(\"app\") is True</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["T","r","i","e"],"cls":["","","",""]}],"vars":[["self","'Trie'",0]],"stack":[]},{"caption":"<code>self.children = [[None] * 26]</code> &mdash; <code>self</code> moves to <code>node</code> <em>(node id -&gt; child ids)</em>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4421959168","",0.0,0.0,"cur",["self"]]],"edges":[],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>self.is_end = [False]</code> &mdash; returns <code>None</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4421959168","",0.0,0.0,"cur",["self"]]],"edges":[],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>node = 0</code> &mdash; <code>word = 'apple'</code>; <code>node = 0</code>","line":17,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4421959168","",0.0,0.0,"cur",["self"]]],"edges":[],"dir":false}],"vars":[["word","'apple'",1],["node","0",1]],"stack":[]},{"caption":"<code>for ch in word:</code> &mdash; <code>ch = 'a'</code>","line":18,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4421959168","",0.0,0.0,"cur",["self"]]],"edges":[],"dir":false}],"vars":[["word","'apple'",0],["node","0",0],["ch","'a'",1]],"stack":[]},{"caption":"<code>node = self._child(node, ch, True)</code> &mdash; calls <code>_child(node=0, ch='a', create=T)</code>","line":19,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4421959168","",0.0,0.0,"cur",["self"]]],"edges":[],"dir":false}],"vars":[["word","'apple'",0],["node","0",0],["ch","'a'",0],["create","T",1]],"stack":["insert(word='apple')","_child(node=0, ch='a', create=T)"]},{"caption":"<code>i = ord(ch) - 97</code> &mdash; <code>i = 0</code>","line":7,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4421959168","",0.0,0.0,"cur",["self"]]],"edges":[],"dir":false}],"vars":[["word","'apple'",0],["node","0",0],["ch","'a'",0],["create","T",0],["i","0",1]],"stack":["insert(word='apple')","_child(node=0, ch='a', create=T)"]},{"caption":"<c