","75","85"],"cls":["","","","","","",""]}],"vars":[["price","85",0],["span","6",0],["p","100",1]],"stack":[]},{"caption":"<code>if p &gt; price:</code> &rarr; <strong>true</strong> (p = 100, price = 85)","line":9,"panels":[{"t":"arr","id":"self.prices","label":"self.prices","v":["100","80","60","70","60","75","85"],"cls":["","","","","","",""]}],"vars":[["price","85",0],["span","6",0],["p","100",0]],"stack":[]},{"caption":"<code>break</code>","line":10,"panels":[{"t":"arr","id":"self.prices","label":"self.prices","v":["100","80","60","70","60","75","85"],"cls":["","","","","","",""]}],"vars":[["price","85",0],["span","6",0],["p","100",0]],"stack":[]},{"caption":"<code>return span</code> &mdash; returns <code>6</code>. <strong>Result: 6</strong>","line":12,"panels":[{"t":"arr","id":"self.prices","label":"self.prices","v":["100","80","60","70","60","75","85"],"cls":["","","","","","",""]}],"vars":[["price","85",0],["span","6",0],["p","100",0]],"stack":[]}],"example":1},{"title":"Monotonic stack of (price, span)","code":"class StockSpanner:\n    def __init__(self):\n        self.stack = []                        # (price, span), prices decreasing\n\n    def next(self, price):\n        span = 1\n        while self.stack and self.stack[-1][0] <= price:\n            span += self.stack.pop()[1]        # absorb the covered days\n        self.stack.append((price, span))\n        return span","frames":[{"caption":"<strong>Monotonic stack of (price, span)</strong> &mdash; amortised O(1) per call time, O(n) extra space. Running <code>s = StockSpanner(); __ex = ([s.next(p) for p in [100, 80, 60, 70, 60, 75, 85]])</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["S","t","o","c","k","S","p","a","n","n","e","r"],"cls":["","","","","","","","","","","",""]}],"vars":[["self","'StockSpanner'",0]],"stack":[]},{"caption":"<code>self.stack = []</code> &mdash; returns <code>None</code>; <code>self.stack = []</code> 