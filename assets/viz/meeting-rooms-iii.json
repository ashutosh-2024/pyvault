s","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","1"],"cls":["","src"],"ptr":{"1":["r"],"2":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["10","5"],"cls":["","src"],"ptr":{"1":["r"],"2":["start"]}}],"vars":[["n","2",0],["end","7",0],["room","1",0],["start","2",0],["r","1",1]],"stack":["most_booked(n=2, meetings)","<genexpr>()"]},{"caption":"<code>room = next((r for r in range(n) if free_at[r] &lt;= start), None)</code> &mdash; yields <code>None</code>","line":4,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","1"],"cls":["","src"],"ptr":{"1":["r"],"2":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["10","5"],"cls":["","src"],"ptr":{"1":["r"],"2":["start"]}}],"vars":[["n","2",0],["end","7",0],["room","1",0],["start","2",0],["r","1",0]],"stack":["most_booked(n=2, meetings)","<genexpr>()"]},{"caption":"<code>if room is None:</code> &rarr; <strong>true</strong> (room = None) &mdash; <code>room = None</code>","line":5,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","1"],"cls":["",""],"ptr":{"2":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["10","5"],"cls":["",""],"ptr":{"2":["start"]}}],"vars":[["n","2",0],["end","7",0],["room","None",1],["start","2",0]],"stack":[]},{"caption":"<code>room = min(range(n), key=lambda r: (free_at[r], r))</code> &mdash; <code>room = 1</code>","line":6,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","1"],"cls":["",""],"ptr":{"2":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["10","5"],"cls":["",""],"ptr":{"2":["start"]}}],"vars":[["n","2",0],["end","7",0],["room","1",1],["start","2",0]],"stack":[]},{"caption":"<c