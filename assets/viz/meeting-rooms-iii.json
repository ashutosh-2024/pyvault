{"chapters":[{"title":"Simulate by scanning all rooms","code":"def most_booked(n, meetings):\n    free_at, count = [0] * n, [0] * n\n    for start, end in sorted(meetings):\n        room = next((r for r in range(n) if free_at[r] <= start), None)\n        if room is None:\n            room = min(range(n), key=lambda r: (free_at[r], r))\n            end += free_at[room] - start        # delayed, same duration\n        free_at[room] = end\n        count[room] += 1\n    return count.index(max(count))","frames":[{"caption":"<strong>Simulate by scanning all rooms</strong> &mdash; O(m log m + m &middot; n) time, O(n) extra space. Input: <code>most_booked(n=2, meetings=[[0, 10], [1, 5], [2, 7], [3, 4]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>free_at, count = [0] * n, [0] * n</code> &mdash; <code>count = [0, 0]</code>; <code>free_at = [0, 0]</code>","line":2,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["0","0"],"cls":["",""]},{"t":"arr","id":"free_at","label":"free_at","v":["0","0"],"cls":["",""]}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>for start, end in sorted(meetings):</code> &mdash; <code>end = 10</code>; <code>start = 0</code>","line":3,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["0","0"],"cls":["src",""],"ptr":{"0":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["0","0"],"cls":["src",""],"ptr":{"0":["start"]}}],"vars":[["n","2",0],["end","10",1],["start","0",1]],"stack":[]},{"caption":"<code>room = next((r for r in range(n) if free_at[r] &lt;= start), None)</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":4,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["0","0"],"cls":["src",""],"ptr":{"0":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["0","0"],"cls":["src",""],"ptr":{"0":["start"]}}],"vars":[["n","2",0],["end","10",0],["start","0",0]],"stack":["most_booked(n=2, meetings)","<genexpr>()"]},{"caption":"<code>room = next((r for r in range(n) if free_at[r] &lt;= start), None)</code> &mdash; yields <code>0</code>; <code>r = 0</code>","line":4,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["0","0"],"cls":["src",""],"ptr":{"0":["r","start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["0","0"],"cls":["src",""],"ptr":{"0":["r","start"]}}],"vars":[["n","2",0],["end","10",0],["start","0",0],["r","0",1]],"stack":["most_booked(n=2, meetings)","<genexpr>()"]},{"caption":"<code>if room is None:</code> &rarr; <strong>false</strong> (room = 0) &mdash; <code>room = 0</code>","line":5,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["0","0"],"cls":["src",""],"ptr":{"0":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["0","0"],"cls":["src",""],"ptr":{"0":["start"]}}],"vars":[["n","2",0],["end","10",0],["room","0",1],["start","0",0]],"stack":[]},{"caption":"<code>free_at[room] = end</code> &mdash; <code>free_at[0]</code> becomes <code>10</code>","line":8,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["0","0"],"cls":["src",""],"ptr":{"0":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["10","0"],"cls":["cur",""],"ptr":{"0":["start"]}}],"vars":[["n","2",0],["end","10",0],["room","0",0],["start","0",0]],"stack":[]},{"caption":"<code>count[room] += 1</code> &mdash; <code>count[0]</code> becomes <code>1</code>","line":9,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","0"],"cls":["cur",""],"ptr":{"0":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["10","0"],"cls":["src",""],"ptr":{"0":["start"]}}],"vars":[["n","2",0],["end","10",0],["room","0",0],["start","0",0]],"stack":[]},{"caption":"<code>for start, end in sorted(meetings):</code> &mdash; <code>end = 5</code>; <code>start = 1</code>","line":3,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","0"],"cls":["","src"],"ptr":{"1":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["10","0"],"cls":["","src"],"ptr":{"1":["start"]}}],"vars":[["n","2",0],["end","5",1],["room","0",0],["start","1",1]],"stack":[]},{"caption":"<code>room = next((r for r in range(n) if free_at[r] &lt;= start), None)</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":4,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","0"],"cls":["","src"],"ptr":{"1":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["10","0"],"cls":["","src"],"ptr":{"1":["start"]}}],"vars":[["n","2",0],["end","5",0],["room","0",0],["start","1",0]],"stack":["most_booked(n=2, meetings)","<genexpr>()"]},{"caption":"<code>room = next((r for r in range(n) if free_at[r] &lt;= start), None)</code> &mdash; <code>r = 0</code>","line":4,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","0"],"cls":["src","src"],"ptr":{"0":["r"],"1":["start"]}},{"t":"arr","id":"free_at","label":"free_at","v":["10","0"],"cls":["src","src"],"ptr":{"0":["r"],"1":["start"]}}],"vars":[["n","2",0],["end","5"