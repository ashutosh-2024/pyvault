["end","4",0],["room","1",0],["start","3",0],["r","1",0]],"stack":["most_booked(n=2, meetings)","<genexpr>()"]},{"caption":"<code>if room is None:</code> &rarr; <strong>true</strong> (room = None) &mdash; <code>room = None</code>","line":5,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","2"],"cls":["",""]},{"t":"arr","id":"free_at","label":"free_at","v":["10","10"],"cls":["",""]}],"vars":[["n","2",0],["end","4",0],["room","None",1],["start","3",0]],"stack":[]},{"caption":"<code>room = min(range(n), key=lambda r: (free_at[r], r))</code> &mdash; <code>room = 0</code>","line":6,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","2"],"cls":["",""]},{"t":"arr","id":"free_at","label":"free_at","v":["10","10"],"cls":["",""]}],"vars":[["n","2",0],["end","4",0],["room","0",1],["start","3",0]],"stack":[]},{"caption":"<code>end += free_at[room] - start</code> &mdash; <code>end = 11</code> <em>(delayed, same duration)</em>","line":7,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","2"],"cls":["",""]},{"t":"arr","id":"free_at","label":"free_at","v":["10","10"],"cls":["",""]}],"vars":[["n","2",0],["end","11",1],["room","0",0],["start","3",0]],"stack":[]},{"caption":"<code>free_at[room] = end</code> &mdash; <code>free_at[0]</code> becomes <code>11</code>","line":8,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["1","2"],"cls":["",""]},{"t":"arr","id":"free_at","label":"free_at","v":["11","10"],"cls":["cur",""]}],"vars":[["n","2",0],["end","11",0],["room","0",0],["start","3",0]],"stack":[]},{"caption":"<code>count[room] += 1</code> &mdash; <code>count[0]</code> becomes <code>2</code>","line":9,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["2","2"],"cls":["cur",""]},{"t":"arr","id":"free_at","label":"free_at","v":["11","10"],"cls":["",""]}],"vars":[["n","2",0],["end","11",0],["room","0",0],["start","3",0]],"stack":[]},{"caption":"<code>for start, end in sorted(meetings):</code>","line":3,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["2","2"],"cls":["",""]},{"t":"arr","id":"free_at","label":"free_at","v":["11","10"],"cls":["",""]}],"vars":[["n","2",0],["end","11",0],["room","0",0],["start","3",0]],"stack":[]},{"caption":"<code>return count.index(max(count))</code> &mdash; returns <code>0</code>. <strong>Result: 0</strong>","line":10,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"count","label":"count","v":["2","2"],"cls":["",""]},{"t":"arr","id":"free_at","label":"free_at","v":["11","10"],"cls":["",""]}],"vars":[["n","2",0],["end","11",0],["room","0",0],["start","3",0]],"stack":[]}],"example":1},{"title":"Two heaps: free rooms and busy rooms","code":"def most_booked(n, meetings):\n    free = list(range(n))                     # already a valid heap\n    busy, count = [], [0] * n                  # (end, room)\n    for start, end in sorted(meetings):\n        while busy and busy[0][0] <= start:\n            heapq.heappush(free, heapq.heappop(busy)[1])\n        if free:\n            room = heapq.heappop(free)\n            heapq.heappush(busy, (end, room))\n        else:\n            finish, room = heapq.heappop(busy)\n            heapq.heappush(busy, (finish + end - start, room))\n        count[room] += 1\n    return count.index(max(count))","frames":[{"caption":"<strong>Two heaps: free rooms and busy rooms</strong> &mdash; O(m log m + m log n) time, O(n) extra space. Input: <code>most_booked(n=2, meetings=[[0, 10], [1, 5], [2, 7], [3, 4]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>free = list(range(n))</code> &mdash; <code>free = [0, 1]</code> <em>(already a valid heap)</em>","line":2,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"free","label":"free","v":["0","1"],"cls":["",""]},{"t":"net","id":"heap:free","label":"free drawn as a tree","nodes":[["h1","1",0.0,1.25,"",[]],["h0","0",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"free"}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>busy, count = [], [0] * n</code> &mdash; <code>busy = []</code>; <code>count = [0, 0]</code> <em>((end, room))</em>","line":3,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"free","label":"free","v":["0","1"],"cls":["",""]},{"t":"net","id":"heap:free","label":"free drawn as a tree","nodes":[["h1","1",0.0,1.25,"",[]],["h0","0",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"free"},{"t":"arr","id":"busy","label":"busy","v":[],"cls":[],"noidx":true},{"t":"arr","id":"count","label":"count","v":["0","0"],"cls":["",""]}],"vars":[["n","2",0]],"stack":[]},{"caption":"<code>for start, end in sorted(meetings):</code> &mdash; <code>start = 0</code>; <code>end = 10</code>","line":4,"panels":[{"t":"arr","id":"meetings","label":"meetings","v":["0,10","1,5","2,7","3,4"],"cls":["","","",""]},{"t":"arr","id":"free","label":"free","v":["0","1"],"cls":["",""]},{"t":"net","id":"heap:free","label":"free drawn as a tree","nodes":[["h1","1",0.0,1.25,"",[]],["h0","0",1.0,0.0,"",["top"]]],"edges":[["h0","h1","",""]],"dir":false,"mirror":"free"},{"t":"arr","id":"