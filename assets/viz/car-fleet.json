{"chapters":[{"title":"Sort by position, stack of fleet arrival times","code":"def car_fleet(target, position, speed):\n    stack = []\n    for p, s in sorted(zip(position, speed), reverse=True):\n        t = (target - p) / s\n        if not stack or t > stack[-1]:\n            stack.append(t)                    # slower than the fleet ahead: new fleet\n    return len(stack)","frames":[{"caption":"<strong>Sort by position, stack of fleet arrival times</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>car_fleet(target=12, position=[10, 8, 0, 5, 3], speed=[2, 4, 1, 1, 3])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"position","label":"position","v":["10","8","0","5","3"],"cls":["","","","",""]},{"t":"arr","id":"speed","label":"speed","v":["2","4","1","1","3"],"cls":["","","","",""]}],"vars":[["target","12",0]],"stack":[]},{"caption":"<code>stack = []</code> &mdash; <code>stack = []</code>","line":2,"panels":[{"t":"arr","id":"position","label":"position","v":["10","8","0","5","3"],"cls":["","","","",""]},{"t":"arr","id":"speed","label":"speed","v":["2","4","1","1","3"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["target","12",0]],"stack":[]},{"caption":"<code>for p, s in sorted(zip(position, speed), reverse=True):</code> &mdash; <code>p = 10</code>; <code>s = 2</code>","line":3,"panels":[{"t":"arr","id":"position","label":"position","v":["10","8","0","5","3"],"cls":["","","","",""]},{"t":"arr","id":"speed","label":"speed","v":["2","4","1","1","3"],"cls":["","","","",""]},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["target","12",0],["p","10",1],["s","2",1]],"stack":[]},{"caption":"<code>t = (target - p) / s</code> &mdash; <code>t = 1</code>","line":4,"panels":[{"t":"arr","id":"position","label":"position","v":["10","8","0","5","3"],"cls":["","","","",""]},{"t":"arr","id":"speed","label":"speed","v":["2","4","1"