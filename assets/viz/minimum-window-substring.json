{"chapters":[{"title":"Check every substring","code":"def min_window(s, t):\n    need, best = Counter(t), \"\"\n    for i in range(len(s)):\n        have = Counter()\n        for j in range(i, len(s)):\n            have[s[j]] += 1\n            if all(have[c] >= n for c, n in need.items()):\n                if not best or j - i + 1 < len(best):\n                    best = s[i:j + 1]\n                break\n    return best","frames":[{"caption":"<strong>Check every substring</strong> &mdash; O(n&sup2; &middot; &Sigma;) time, O(&Sigma;) extra space. Input: <code>min_window(s='aa', t='aa')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["",""]}],"vars":[["s","'aa'",0],["t","'aa'",0]],"stack":[]},{"caption":"<code>need, best = Counter(t), \"\"</code> &mdash; <code>need = {'a': 2}</code>; <code>best = ''</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["",""]},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","''",1]],"stack":[]},{"caption":"<code>for i in range(len(s)):</code> &mdash; <code>i = 0</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","''",0],["i","0",1]],"stack":[]},{"caption":"<code>have = Counter()</code> &mdash; <code>have = {}</code>","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["src",""],"ptr":{"0":["i"]}},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]},{"t":"arr","id":"have","label":"have (Counter)","v":[],"cls":[],"keys":[]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","''",0],["i","0",0]],"stack":[]},{"caption":"<code>for j in range(i, len(s)):</code> &mdash; <code>j = 0</code>","line":5,"panels":[{"t":"arr","id