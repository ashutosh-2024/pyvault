r"],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","'aa'",0],["i","1",0],["j","1",0]],"stack":[]},{"caption":"<code>if all(have[c] &gt;= n for c, n in need.items()):</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":7,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["","src"],"ptr":{"1":["i","j"]}},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]},{"t":"arr","id":"have","label":"have (Counter)","v":["1"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","'aa'",0],["i","1",0],["j","1",0]],"stack":["min_window(s='aa', t='aa')","<genexpr>()"]},{"caption":"<code>if all(have[c] &gt;= n for c, n in need.items()):</code> &mdash; yields <code>F</code>; <code>c = 'a'</code>; <code>n = 2</code>","line":7,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["","src"],"ptr":{"1":["i","j"]}},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]},{"t":"arr","id":"have","label":"have (Counter)","v":["1"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","'aa'",0],["i","1",0],["j","1",0],["c","'a'",1],["n","2",1]],"stack":["min_window(s='aa', t='aa')","<genexpr>()"]},{"caption":"<code>for j in range(i, len(s)):</code>","line":5,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["","src"],"ptr":{"1":["i","j"]}},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]},{"t":"arr","id":"have","label":"have (Counter)","v":["1"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","'aa'",0],["i","1",0],["j","1",0]],"stack":[]},{"caption":"<code>for i in range(len(s)):</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["","src"],"ptr":{"1":["i","j"]}},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]},{"t":"arr","id":"have","label":"have (Counter)","v":["1"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","'aa'",0],["i","1",0],["j","1",0]],"stack":[]},{"caption":"<code>return best</code> &mdash; returns <code>'aa'</code>. <strong>Result: 'aa'</strong>","line":11,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["","src"],"ptr":{"1":["i","j"]}},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]},{"t":"arr","id":"have","label":"have (Counter)","v":["1"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","'aa'",0],["i","1",0],["j","1",0]],"stack":[]}]},{"title":"Sliding window with a 'formed' counter","code":"def min_window(s, t):\n    need = Counter(t)\n    have = defaultdict(int)\n    required, formed = len(need), 0\n    best, left = (float(\"inf\"), 0, 0), 0\n    for right, ch in enumerate(s):\n        have[ch] += 1\n        if have[ch] == need[ch]:\n            formed += 1\n        while formed == required:\n            if right - left + 1 < best[0]:\n                best = (right - left + 1, left, right + 1)\n            out = s[left]\n            have[out] -= 1\n            if have[out] < need[out]:\n                formed -= 1\n            left += 1\n    return \"\" if best[0] == float(\"inf\") else s[best[1]:best[2]]","frames":[{"caption":"<strong>Sliding window with a 'formed' counter</strong> &mdash; O(n + m) time, O(&Sigma;) extra space. Input: <code>min_window(s='aa', t='aa')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["",""]}],"vars":[["s","'aa'",0],["t","'aa'",0]],"stack":[]},{"caption":"<code>need = Counter(t)</code> &mdash; <code>need = {'a': 2}</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["",""]},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0]],"stack":[]},{"caption":"<code>have = defaultdict(int)</code> &mdash; <code>have = {}</code>","line":3,"panels":[{"t":"arr","id":"s","label":"s","v"