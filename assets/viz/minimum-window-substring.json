xpr&gt;()</code>","line":7,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["src","src"],"ptr":{"0":["i"],"1":["j"]}},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]},{"t":"arr","id":"have","label":"have (Counter)","v":["2"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","''",0],["i","0",0],["j","1",0],["c","'a'",0],["n","2",0]],"stack":["min_window(s='aa', t='aa')","<genexpr>()"]},{"caption":"<code>if all(have[c] &gt;= n for c, n in need.items()):</code> &mdash; yields <code>None</code>","line":7,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["src","src"],"ptr":{"0":["i"],"1":["j"]}},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]},{"t":"arr","id":"have","label":"have (Counter)","v":["2"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","''",0],["i","0",0],["j","1",0],["c","'a'",0],["n","2",0]],"stack":["min_window(s='aa', t='aa')","<genexpr>()"]},{"caption":"<code>if not best or j - i + 1 &lt; len(best):</code> &rarr; <strong>true</strong> (best = '', i = 0, j = 1)","line":8,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["src","src"],"ptr":{"0":["i"],"1":["j"]}},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]},{"t":"arr","id":"have","label":"have (Counter)","v":["2"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","''",0],["i","0",0],["j","1",0]],"stack":[]},{"caption":"<code>best = s[i:j + 1]</code> &mdash; <code>best = 'aa'</code>","line":9,"panels":[{"t":"arr","id":"s","label":"s","v":["a","a"],"cls":["src","src"],"ptr":{"0":["i"],"1":["j"]}},{"t":"arr","id":"need","label":"need (Counter)","v":["2"],"cls":[""],"keys":["a"]},{"t":"arr","id":"have","label":"have (Counter)","v":["2"],"cls":[""],"keys":["a"]}],"vars":[["s","'aa'",0],["t","'aa'",0],["best","'aa'",1],["i","0",0],["j","1",0]],"stack":[]},{"caption":"<code>break</code>","line":10,"panel