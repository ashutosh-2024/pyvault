ption":"<code>best = max(best, p - lowest)</code> <em>(sell today)</em>","line":4,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]}],"vars":[["lowest","1",0],["best","5",0],["p","4",0]],"stack":[]},{"caption":"<code>lowest = min(lowest, p)</code> <em>(or remember a better buy day)</em>","line":5,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]}],"vars":[["lowest","1",0],["best","5",0],["p","4",0]],"stack":[]},{"caption":"<code>for p in prices[1:]:</code>","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]}],"vars":[["lowest","1",0],["best","5",0],["p","4",0]],"stack":[]},{"caption":"<code>return best</code> &mdash; returns <code>5</code>. <strong>Result: 5</strong>","line":6,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]}],"vars":[["lowest","1",0],["best","5",0],["p","4",0]],"stack":[]}],"example":1},{"title":"Kadane on daily changes","code":"def max_profit(prices):\n    best = cur = 0\n    for a, b in zip(prices, prices[1:]):\n        cur = max(0, cur + b - a)          # extend the run of changes, or restart\n        best = max(best, cur)\n    return best","frames":[{"caption":"<strong>Kadane on daily changes</strong> &mdash; O(n) time, O(1) extra space. Input: <code>max_profit(prices=[7, 1, 5, 3, 6, 4])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>best = cur = 0</code> &mdash; <code>best = 0</code>; <code>cur = 0</code>","line":2,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]}],"vars":[["best","0",1],["cur","0",1]],"stack":[]},{"caption":"<code>for a, b in zip(prices, prices[1:]):</code> &mdas