{"chapters":[{"title":"Walk down until the values split","code":"def lowest_common_ancestor(root, p, q):\n    node = root\n    while node:\n        if p.val < node.val and q.val < node.val:\n            node = node.left\n        elif p.val > node.val and q.val > node.val:\n            node = node.right\n        else:\n            return node              # the paths to p and q split here","frames":[{"caption":"<strong>Walk down until the values split</strong> &mdash; O(h) time, O(1) extra space. Input: <code>lowest_common_ancestor(root=tree (6), p=tree (3), q=tree (5))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4394144592","0",0.0,2.5,"",[]],["n4389203600","2",1.0,1.25,"",[]],["n4391889072","3",2.0,3.75,"cur",["p"]],["n4394144288","4",3.0,2.5,"",[]],["n4391917136","5",4.0,3.75,"cur",["q"]],["n4392280688","6",5.0,0.0,"cur",["root"]],["n4393763472","7",6.0,2.5,"",[]],["n4389203920","8",7.0,1.25,"",[]],["n4391889344","9",8.0,2.5,"",[]]],"edges":[["n4392280688","n4389203600","",""],["n4389203600","n4394144592","",""],["n4389203600","n4394144288","",""],["n4394144288","n4391889072","",""],["n4394144288","n4391917136","",""],["n4392280688","n4389203920","",""],["n4389203920","n4393763472","",""],["n4389203920","n4391889344","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>node = root</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4394144592","0",0.0,2.5,"",[]],["n4389203600","2",1.0,1.25,"",[]],["n4391889072","3",2.0,3.75,"cur",["p"]],["n4394144288","4",3.0,2.5,"",[]],["n4391917136","5",4.0,3.75,"cur",["q"]],["n4392280688","6",5.0,0.0,"cur",["root","node"]],["n4393763472","7",6.0,2.5,"",[]],["n4389203920","8",7.0,1.25,"",[]],["n4391889344","9",8.0,2.5,"",[]]],"edges":[["n4392280688","n4389203600","",""],["n4389203600","n4394144592","",""],["n4389203600","n4394144288","",""],["n4394144288","n4391889072","",""],["n4394144288","n4391917136","",""