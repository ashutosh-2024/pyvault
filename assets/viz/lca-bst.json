{"chapters":[{"title":"Walk down until the values split","code":"def lowest_common_ancestor(root, p, q):\n    node = root\n    while node:\n        if p.val < node.val and q.val < node.val:\n            node = node.left\n        elif p.val > node.val and q.val > node.val:\n            node = node.right\n        else:\n            return node              # the paths to p and q split here","frames":[{"caption":"<strong>Walk down until the values split</strong> &mdash; O(h) time, O(1) extra space. Input: <code>lowest_common_ancestor(root=tree (6), p=tree (3), q=tree (5))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455295152","0",0.0,2.5,"",[]],["n4455199632","2",1.0,1.25,"",[]],["n4455680752","3",2.0,3.75,"cur",["p"]],["n4455294848","4",3.0,2.5,"",[]],["n4455250512","5",4.0,3.75,"cur",["q"]],["n4455426976","6",5.0,0.0,"cur",["root"]],["n4455405264","7",6.0,2.5,"",[]],["n4455191312","8",7.0,1.25,"",[]],["n4455682656","9",8.0,2.5,"",[]]],"edges":[["n4455426976","n4455199632","",""],["n4455199632","n4455295152","",""],["n4455199632","n4455294848","",""],["n4455294848","n4455680752","",""],["n4455294848","n4455250512","",""],["n4455426976","n4455191312","",""],["n4455191312","n4455405264","",""],["n4455191312","n4455682656","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>node = root</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4455295152","0",0.0,2.5,"",[]],["n4455199632","2",1.0,1.25,"",[]],["n4455680752","3",2.0,3.75,"cur",["p"]],["n4455294848","4",3.0,2.5,"",[]],["n4455250512","5",4.0,3.75,"cur",["q"]],["n4455426976","6",5.0,0.0,"cur",["root","node"]],["n4455405264","7",6.0,2.5,"",[]],["n4455191312","8",7.0,1.25,"",[]],["n4455682656","9",8.0,2.5,"",[]]],"edges":[["n4455426976","n4455199632","",""],["n4455199632","n4455295152","",""],["n4455199632","n4455294848","",""],["n4455294848","n4455680752","",""],["n4455294848","n4455250512","",""