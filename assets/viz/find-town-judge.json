code>-1</code>. <strong>Result: -1</strong>","line":9,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"indeg","label":"indeg","v":["0","1","0","2"],"cls":["","src","","src"],"ptr":{"1":["b"],"3":["p"]}},{"t":"arr","id":"outdeg","label":"outdeg","v":["0","1","1","1"],"cls":["","","","src"],"ptr":{"3":["a","p"]}}],"vars":[["n","3",0],["a","3",0],["b","1",0],["p","3",0]],"stack":[]}]},{"title":"One net-trust score","code":"def find_judge(n, trust):\n    score = [0] * (n + 1)\n    for a, b in trust:\n        score[a] -= 1\n        score[b] += 1\n    for p in range(1, n + 1):\n        if score[p] == n - 1:\n            return p\n    return -1","frames":[{"caption":"<strong>One net-trust score</strong> &mdash; O(n + t) time, O(n) extra space. Input: <code>find_judge(n=3, trust=[[1, 3], [2, 3], [3, 1]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]}],"vars":[["n","3",0]],"stack":[]},{"caption":"<code>score = [0] * (n + 1)</code> &mdash; <code>score = [0, 0, 0, 0]</code>","line":2,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"score","label":"score","v":["0","0","0","0"],"cls":["","","",""]}],"vars":[["n","3",0]],"stack":[]},{"caption":"<code>for a, b in trust:</code> &mdash; <code>a = 1</code>; <code>b = 3</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"score","label":"score","v":["0","0","0","0"],"cls":["","src","","src"],"ptr":{"1":["a"],"3":["b"]}}],"vars":[["n","3",0],["a","1",1],["b","3",1]],"stack":[]},{"caption":"<code>score[a] -= 1</code> &mdash; <code>score[1]</code> becomes <code>-1</code>","line":4,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"score","label":"score","v":["0","-1","0","0"],"cl