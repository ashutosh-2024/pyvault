trust if b == p) == n - 1:</code> &mdash; <code>b = 4</code>","line":5,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","1,4","2,3","2,4","4,3"],"cls":["","","","",""]}],"vars":[["n","4",0],["p","3",0],["a","2",0],["b","4",1]],"stack":["find_judge(n=4, trust)","<genexpr>()"]},{"caption":"<code>if sum(1 for a, b in trust if b == p) == n - 1:</code> &mdash; yields <code>1</code>; <code>a = 4</code>; <code>b = 3</code>","line":5,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","1,4","2,3","2,4","4,3"],"cls":["","","","",""]}],"vars":[["n","4",0],["p","3",0],["a","4",1],["b","3",1]],"stack":["find_judge(n=4, trust)","<genexpr>()"]},{"caption":"<code>if sum(1 for a, b in trust if b == p) == n - 1:</code> &mdash; yields <code>None</code>","line":5,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","1,4","2,3","2,4","4,3"],"cls":["","","","",""]}],"vars":[["n","4",0],["p","3",0],["a","4",0],["b","3",0]],"stack":["find_judge(n=4, trust)","<genexpr>()"]},{"caption":"<code>return p</code> &mdash; returns <code>3</code>. <strong>Result: 3</strong>","line":6,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","1,4","2,3","2,4","4,3"],"cls":["","","","",""]}],"vars":[["n","4",0],["p","3",0]],"stack":[]}],"example":1},{"title":"In-degree and out-degree arrays","code":"def find_judge(n, trust):\n    indeg, outdeg = [0] * (n + 1), [0] * (n + 1)\n    for a, b in trust:\n        outdeg[a] += 1\n        indeg[b] += 1\n    for p in range(1, n + 1):\n        if outdeg[p] == 0 and indeg[p] == n - 1:\n            return p\n    return -1","frames":[{"caption":"<strong>In-degree and out-degree arrays</strong> &mdash; O(n + t) time, O(n) extra space. Input: <code>find_judge(n=4, trust=[[1, 3], [1, 4], [2, 3], [2, 4], [4, 3]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","1,4","2,3","2,4","4,3"],"cls":["","","","",""]}],"vars":[["n","4",0]],"stack":[]},{"caption":"<c