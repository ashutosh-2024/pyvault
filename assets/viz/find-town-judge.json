"1"],"cls":["","","","src"],"ptr":{"3":["a"]}}],"vars":[["n","3",0],["a","3",0],["b","1",0]],"stack":[]},{"caption":"<code>for a, b in trust:</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"indeg","label":"indeg","v":["0","1","0","2"],"cls":["","src","",""],"ptr":{"1":["b"]}},{"t":"arr","id":"outdeg","label":"outdeg","v":["0","1","1","1"],"cls":["","","","src"],"ptr":{"3":["a"]}}],"vars":[["n","3",0],["a","3",0],["b","1",0]],"stack":[]},{"caption":"<code>for p in range(1, n + 1):</code> &mdash; <code>p = 1</code>","line":6,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"indeg","label":"indeg","v":["0","1","0","2"],"cls":["","src","",""],"ptr":{"1":["b","p"]}},{"t":"arr","id":"outdeg","label":"outdeg","v":["0","1","1","1"],"cls":["","src","","src"],"ptr":{"3":["a"],"1":["p"]}}],"vars":[["n","3",0],["a","3",0],["b","1",0],["p","1",1]],"stack":[]},{"caption":"<code>if outdeg[p] == 0 and indeg[p] == n - 1:</code> &rarr; <strong>false</strong> (n = 3, p = 1)","line":7,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"indeg","label":"indeg","v":["0","1","0","2"],"cls":["","src","",""],"ptr":{"1":["b","p"]}},{"t":"arr","id":"outdeg","label":"outdeg","v":["0","1","1","1"],"cls":["","src","","src"],"ptr":{"3":["a"],"1":["p"]}}],"vars":[["n","3",0],["a","3",0],["b","1",0],["p","1",0]],"stack":[]},{"caption":"<code>for p in range(1, n + 1):</code> &mdash; <code>p = 2</code>","line":6,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"indeg","label":"indeg","v":["0","1","0","2"],"cls":["","src","src",""],"ptr":{"1":["b"],"2":["p"]}},{"t":"arr","id":"outdeg","label":"outdeg","v":["0","1","1","1"],"cls":["","","src","src"],"ptr":{"3":["a"],"2":["p"]}}],"vars":[["n","3",0],["a","3",0],["b","1",0],["p","2",1]],"stack":[]},{"captio