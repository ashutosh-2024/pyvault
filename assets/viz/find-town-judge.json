{"chapters":[{"title":"Check each candidate against all trust pairs","code":"def find_judge(n, trust):\n    for p in range(1, n + 1):\n        if any(a == p for a, _ in trust):\n            continue\n        if sum(1 for a, b in trust if b == p) == n - 1:\n            return p\n    return -1","frames":[{"caption":"<strong>Check each candidate against all trust pairs</strong> &mdash; O(n &middot; t) time, O(1) extra space. Input: <code>find_judge(n=3, trust=[[1, 3], [2, 3]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0]],"stack":[]},{"caption":"<code>for p in range(1, n + 1):</code> &mdash; <code>p = 1</code>","line":2,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","1",1]],"stack":[]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","1",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; yields <code>T</code>; <code>a = 1</code>; <code>_ = 3</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","1",0],["a","1",1],["_","3",1]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>continue</code>","line":4,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","1",0]],"stack":[]},{"caption":"<code>for p in range(1, n + 1):</code> &mdash; <code>p = 2</code>","line":2,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","2",1]],"stack":[]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","2",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; yields <code>F</code>; <code>a = 1</code>; <code>_ = 3</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","2",0],["a","1",1],["_","3",1]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","2",0],["a","1",0],["_","3",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; yields <code>T</code>; <code>a = 2</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","2",0],["a","2",1],["_","3",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>continue</code>","line":4,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","2",0]],"stack":[]},{"caption":"<code>for p in range(1, n + 1):</code> &mdash; <code>p = 3</code>","line":2,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",1]],"stack":[]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; yields <code>F</code>; <code>a = 1</code>; <code>_ = 3</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",0],["a","1",1],["_","3",1]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",0],["a","1",0],["_","3",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; yields <code>F</code>; <code>a = 2</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",0],["a","2",1],["_","3",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",0],["a","2",0],["_","3",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if any(a == p for a, _ in trust):</code> &mdash; yields <code>None</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",0],["a","2",0],["_","3",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if sum(1 for a, b in trust if b == p) == n - 1:</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":5,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if sum(1 for a, b in trust if b == p) == n - 1:</code> &mdash; yields <code>1</code>; <code>a = 1</code>; <code>b = 3</code>","line":5,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",0],["a","1",1],["b","3",1]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if sum(1 for a, b in trust if b == p) == n - 1:</code> &mdash; yields <code>1</code>; <code>a = 2</code>","line":5,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",0],["a","2",1],["b","3",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>if sum(1 for a, b in trust if b == p) == n - 1:</code> &mdash; yields <code>None</code>","line":5,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",0],["a","2",0],["b","3",0]],"stack":["find_judge(n=3, trust)","<genexpr>()"]},{"caption":"<code>return p</code> &mdash; returns <code>3</code>. <strong>Result: 3</strong>","line":6,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3"],"cls":["",""]}],"vars":[["n","3",0],["p","3",0]],"stack":[]}]},{"title":"In-degree and out-degree arrays","code":"def find_judge(n, trust):\n    indeg, outdeg = [0] * (n + 1), [0] * (n + 1)\n    for a, b in trust:\n        outdeg[a] += 1\n        indeg[b] += 1\n    for p in range(1, n + 1):\n        if outdeg[p] == 0 and indeg[p] == n - 1:\n            return p\n    return -1","frames":[{"caption":"<strong>In-degree and out-degree arrays</strong> &mdash; O(n + t) time, O(n) extra space. Input: <code>find_judge(n=3, trust=[[1, 3], [2, 3], [3, 1]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]}],"vars":[["n","3",0]],"stack":[]},{"caption":"<code>indeg, outdeg = [0] * (n + 1), [0] * (n + 1)</code> &mdash; <code>indeg = [0, 0, 0, 0]</code>; <code>outdeg = [0, 0, 0, 0]</code>","line":2,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"indeg","label":"indeg","v":["0","0","0","0"],"cls":["","","",""]},{"t":"arr","id":"outdeg","label":"outdeg","v":["0","0","0","0"],"cls":["","","",""]}],"vars":[["n","3",0]],"stack":[]},{"caption":"<code>for a, b in trust:</code> &mdash; <code>a = 1</code>; <code>b = 3</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"indeg","label":"indeg","v":["0","0","0","0"],"cls":["","","","src"],"ptr":{"3":["b"]}},{"t":"arr","id":"outdeg","label":"outdeg","v":["0","0","0","0"],"cls":["","src","",""],"ptr":{"1":["a"]}}],"vars":[["n","3",0],["a","1",1],["b","3",1]],"stack":[]},{"caption":"<code>outdeg[a] += 1</code> &mdash; <code>outdeg[1]</code> becomes <code>1</code>","line":4,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"indeg","label":"indeg","v":["0","0","0","0"],"cls":["","","","src"],"ptr":{"3":["b"]}},{"t":"arr","id":"outdeg","label":"outdeg","v":["0","1","0","0"],"cls":["","cur","",""],"ptr":{"1":["a"]}}],"vars":[["n","3",0],["a","1",0],["b","3",0]],"stack":[]},{"caption":"<code>indeg[b] += 1</code> &mdash; <code>indeg[3]</code> becomes <code>1</code>","line":5,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"indeg","label":"indeg","v":["0","0","0","1"],"cls":["","","","cur"],"ptr":{"3":["b"]}},{"t":"arr","id":"outdeg","label":"outdeg","v":["0","1","0","0"],"cls":["","src","",""],"ptr":{"1":["a"]}}],"vars":[["n","3",0],["a","1",0],["b","3",0]],"stack":[]},{"caption":"<code>for a, b in trust:</code> &mdash; <code>a = 2</code>","line":3,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","id":"indeg","label":"indeg","v":["0","0","0","1"],"cls":["","","","src"],"ptr":{"3":["b"]}},{"t":"arr","id":"outdeg","label":"outdeg","v":["0","1","0","0"],"cls":["","","src",""],"ptr":{"2":["a"]}}],"vars":[["n","3",0],["a","2",1],["b","3",0]],"stack":[]},{"caption":"<code>outdeg[a] += 1</code> &mdash; <code>outdeg[2]</code> becomes <code>1</code>","line":4,"panels":[{"t":"arr","id":"trust","label":"trust","v":["1,3","2,3","3,1"],"cls":["","",""]},{"t":"arr","