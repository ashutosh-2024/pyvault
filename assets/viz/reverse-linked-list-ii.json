{"chapters":[{"title":"Copy the segment's values, write them back reversed","code":"def reverse_between(head, left, right):\n    node, vals = head, []\n    for i in range(1, right + 1):\n        if i >= left:\n            vals.append(node.val)\n        node = node.next\n    node = head\n    for i in range(1, right + 1):\n        if i >= left:\n            node.val = vals.pop()\n        node = node.next\n    return head","frames":[{"caption":"<strong>Copy the segment's values, write them back reversed</strong> &mdash; O(n) time, O(right - left) extra space. Input: <code>reverse_between(head=list (1), left=2, right=4)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4391878032","1",0.0,0.0,"cur",["head"]],["n4391872912","2",1.7,0.0,"",[]],["n4391972512","3",3.4,0.0,"",[]],["n4391969776","4",5.1,0.0,"",[]],["n4392707728","5",6.8,0.0,"",[]]],"edges":[["n4391878032","n4391872912","",""],["n4391872912","n4391972512","",""],["n4391972512","n4391969776","",""],["n4391969776","n4392707728","",""]],"dir":true},{"t":"arr","id":"range:left","label":"search range","v":["2","4"],"cls":["",""],"keys":["left","right"]}],"vars":[["left","2",0],["right","4",0]],"stack":[]},{"caption":"<code>node, vals = head, []</code> &mdash; <code>vals = []</code>","line":2,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4391878032","1",0.0,0.0,"cur",["head","node"]],["n4391872912","2",1.7,0.0,"",[]],["n4391972512","3",3.4,0.0,"",[]],["n4391969776","4",5.1,0.0,"",[]],["n4392707728","5",6.8,0.0,"",[]]],"edges":[["n4391878032","n4391872912","",""],["n4391872912","n4391972512","",""],["n4391972512","n4391969776","",""],["n4391969776","n4392707728","",""]],"dir":true},{"t":"arr","id":"vals","label":"vals","v":[],"cls":[],"noidx":true},{"t":"arr","id":"range:left","label":"search range","v":["2","4"],"cls":["",""],"keys":["left","right"]}],"vars":[["left","2",0],["right","4",0]],"stack":[]},{"captio