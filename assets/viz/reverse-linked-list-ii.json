,0.0,"done",[]],["n4391969776","2",5.1,0.0,"done",[]],["n4392707728","5",6.8,0.0,"cur",["node"]]],"edges":[["n4391878032","n4391872912","",""],["n4391872912","n4391972512","",""],["n4391972512","n4391969776","",""],["n4391969776","n4392707728","",""]],"dir":true},{"t":"arr","id":"vals","label":"vals","v":[],"cls":[],"noidx":true},{"t":"arr","id":"range:left","label":"search range","v":["2","4"],"cls":["",""],"keys":["left","right"]}],"vars":[["left","2",0],["right","4",0],["i","4",0]],"stack":[]},{"caption":"<code>for i in range(1, right + 1):</code>","line":8,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4391878032","1",0.0,0.0,"cur",["head"]],["n4391872912","4",1.7,0.0,"done",[]],["n4391972512","3",3.4,0.0,"done",[]],["n4391969776","2",5.1,0.0,"done",[]],["n4392707728","5",6.8,0.0,"cur",["node"]]],"edges":[["n4391878032","n4391872912","",""],["n4391872912","n4391972512","",""],["n4391972512","n4391969776","",""],["n4391969776","n4392707728","",""]],"dir":true},{"t":"arr","id":"vals","label":"vals","v":[],"cls":[],"noidx":true},{"t":"arr","id":"range:left","label":"search range","v":["2","4"],"cls":["",""],"keys":["left","right"]}],"vars":[["left","2",0],["right","4",0],["i","4",0]],"stack":[]},{"caption":"<code>return head</code> &mdash; returns <code>(1)</code>. <strong>Result: (1)</strong>","line":12,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4391878032","1",0.0,0.0,"cur",["head"]],["n4391872912","4",1.7,0.0,"done",[]],["n4391972512","3",3.4,0.0,"done",[]],["n4391969776","2",5.1,0.0,"done",[]],["n4392707728","5",6.8,0.0,"cur",["node"]]],"edges":[["n4391878032","n4391872912","",""],["n4391872912","n4391972512","",""],["n4391972512","n4391969776","",""],["n4391969776","n4392707728","",""]],"dir":true},{"t":"arr","id":"vals","label":"vals","v":[],"cls":[],"noidx":true},{"t":"arr","id":"range:left","label":"search range","v":["2","4"],"cls":["",""],"keys":["left","right"]}],"vars":[["left","2",0],["right","4",0],["i","4",0]],"stack":[]}],"example":1},{"title":"Head insertion in one pass","code":"def reverse_between(head, left, right):\n    dummy = ListNode(0, head)\n    prev = dummy\n    for _ in range(left - 1):\n        prev = prev.next\n    cur = prev.next                             # becomes the segment's tail\n    for _ in range(right - left):\n        move = cur.next\n        cur.next = move.next\n        move.next = prev.next                   # to the front of the segment\n        prev.next = move\n    return dummy.next","frames":[{"caption":"<strong>Head insertion in one pass</strong> &mdash; O(n) time, O(1) extra space. Input: <code>reverse_between(head=list (1), left=2, right=4)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4406774032","1",0.0,0.0,"cur",["head"]],["n4406774352","2",1.7,0.0,"",[]],["n4391967952","3",3.4,0.0,"",[]],["n4391970688","4",5.1,0.0,"",[]],["n4392707152","5",6.8,0.0,"",[]]],"edges":[["n4406774032","n4406774352","",""],["n4406774352","n4391967952","",""],["n4391967952","n4391970688","",""],["n4391970688","n4392707152","",""]],"dir":true},{"t":"arr","id":"range:left","label":"search range","v":["2","4"],"cls":["",""],"keys":["left","right"]}],"vars":[["left","2",0],["right","4",0]],"stack":[]},{"caption":"<code>dummy = ListNode(0, head)</code>","line":2,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4392372704","0",0.0,1.3,"cur",["dummy"]],["n4406774032","1",0.0,0.0,"cur",["head"]],["n4406774352","2",1.7,0.0,"",[]],["n4391967952","3",3.4,0.0,"",[]],["n4391970688","4",5.1,0.0,"",[]],["n4392707152","5",6.8,0.0,"",[]]],"edges":[["n4392372704","n4406774032","",""],["n4406774032","n4406774352","",""],["n4406774352","n4391967952","",""],["n4391967952","n4391970688","",""],["n4391970688","n4392707152","",""]],"dir":true},{"t":"arr","id":"range:left","label":"search range","v":["2","4"],"cls":["",""],"keys":["left","right"]}],"vars":[["left","2",0],