0]],"stack":[]}]},{"title":"Head insertion in one pass","code":"def reverse_between(head, left, right):\n    dummy = ListNode(0, head)\n    prev = dummy\n    for _ in range(left - 1):\n        prev = prev.next\n    cur = prev.next                             # becomes the segment's tail\n    for _ in range(right - left):\n        move = cur.next\n        cur.next = move.next\n        move.next = prev.next                   # to the front of the segment\n        prev.next = move\n    return dummy.next","frames":[{"caption":"<strong>Head insertion in one pass</strong> &mdash; O(n) time, O(1) extra space. Input: <code>reverse_between(head=list (1), left=2, right=4)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4420709392","1",0.0,0.0,"cur",["head"]],["n4420706192","2",1.7,0.0,"",[]],["n4420597488","3",3.4,0.0,"",[]],["n4424321488","4",5.1,0.0,"",[]],["n4424073872","5",6.8,0.0,"",[]]],"edges":[["n4420709392","n4420706192","",""],["n4420706192","n4420597488","",""],["n4420597488","n4424321488","",""],["n4424321488","n4424073872","",""]],"dir":true},{"t":"arr","id":"range:left","label":"search range","v":["2","4"],"cls":["",""],"keys":["left","right"]}],"vars":[["left","2",0],["right","4",0]],"stack":[]},{"caption":"<code>dummy = ListNode(0, head)</code>","line":2,"panels":[{"t":"net","id":"list","label":"linked list","nodes":[["n4423394144","0",0.0,1.3,"cur",["dummy"]],["n4420709392","1",0.0,0.0,"cur",["head"]],["n4420706192","2",1.7,0.0,"",[]],["n4420597488","3",3.4,0.0,"",[]],["n4424321488","4",5.1,0.0,"",[]],["n4424073872","5",6.8,0.0,"",[]]],"edges":[["n4423394144","n4420709392","",""],["n4420709392","n4420706192","",""],["n4420706192","n4420597488","",""],["n4420597488","n4424321488","",""],["n4424321488","n4424073872","",""]],"dir":true},{"t":"arr","id":"range:left","label":"search range","v":["2","4"],"cls":["",""],"keys":["left","right"]}],"vars":[["left","2",0],["right","4"