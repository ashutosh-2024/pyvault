id","id":"g","label":"g","v":[["0","2"]],"cls":[["",""]]}],"vars":[["minutes","0",0],["m","1",0],["n","2",0]],"stack":[]},{"caption":"<code>break</code>","line":10,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"arr","id":"rot","label":"rot","v":[],"cls":[],"noidx":true},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["",""]]}],"vars":[["minutes","0",0],["m","1",0],["n","2",0]],"stack":[]},{"caption":"<code>return -1 if any(1 in row for row in g) else minutes</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":14,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"arr","id":"rot","label":"rot","v":[],"cls":[],"noidx":true},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["",""]]}],"vars":[["minutes","0",0],["m","1",0],["n","2",0]],"stack":["oranges_rotting(grid)","<genexpr>()"]},{"caption":"<code>return -1 if any(1 in row for row in g) else minutes</code> &mdash; yields <code>F</code>; <code>row = [0, 2]</code>","line":14,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"arr","id":"rot","label":"rot","v":[],"cls":[],"noidx":true},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["",""]]},{"t":"arr","id":"row","label":"row","v":["0","2"],"cls":["",""]}],"vars":[["minutes","0",0],["m","1",0],["n","2",0]],"stack":["oranges_rotting(grid)","<genexpr>()"]},{"caption":"<code>return -1 if any(1 in row for row in g) else minutes</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":14,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"arr","id":"rot","label":"rot","v":[],"cls":[],"noidx":true},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["",""]]},{"t":"arr","id":"row","label":"row","v":["0","2"],"cls":["",""]}],"vars":[["minutes","0",0],["m","1",0],["n","2",0]],"stack":["oranges_rotting(grid)","<genexpr>()"]},{"caption":"<code>return -1 if any(1 in row for row in g) else minutes</code> &mdash; yields <code>None</code>. <strong>Result: 0</strong>","line":14,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"arr","id":"rot","label":"rot","v":[],"cls":[],"noidx":true},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["",""]]},{"t":"arr","id":"row","label":"row","v":["0","2"],"cls":["",""]}],"vars":[["minutes","0",0],["m","1",0],["n","2",0]],"stack":["oranges_rotting(grid)","<genexpr>()"]}]},{"title":"Multi-source BFS by levels","code":"def oranges_rotting(grid):\n    g = [row[:] for row in grid]\n    m, n = len(g), len(g[0])\n    queue = deque((r, c) for r in range(m) for c in range(n) if g[r][c] == 2)\n    fresh = sum(row.count(1) for row in g)\n    minutes = 0\n    while queue and fresh:\n        for _ in range(len(queue)):              # one minute\n            r, c = queue.popleft()\n            for a, b in ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)):\n                if 0 <= a < m and 0 <= b < n and g[a][b] == 1:\n                    g[a][b] = 2\n                    fresh -= 1\n                    queue.append((a, b))\n        minutes += 1\n    return -1 if fresh else minutes","frames":[{"caption":"<strong>Multi-source BFS by levels</strong> &mdash; O(m &middot; n) time, O(m &middot; n) extra space. Input: <code>oranges_rotting(grid=[[0, 2]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>g = [row[:] for row in grid]</code> &mdash; <code>row = [0, 2]</code>","line":2,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"arr","id":"row","label":"row","v":["0","2"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>g = [row[:] for row in grid]</code> &mdash; <code>g = [[0, 2]]</code>","line":2,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["",""]]}],"vars":[],"stack":[]},{"caption":"<code>m, n = len(g), len(g[0])</code> &mdash; <code>m = 1</code>; <code>n = 2</code>","line":3,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["",""]]}],"vars":[["m","1",1],["n","2",1]],"stack":[]},{"caption":"<code>queue = deque((r, c) for r in range(m) for c in range(n) if g[r][c] == 2)</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":4,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["",""]]}],"vars":[["m","1",0],["n","2",0]],"stack":["oranges_rotting(grid)","<genexpr>()"]},{"caption":"<code>queue = deque((r, c) for r in range(m) for c in range(n) if g[r][c] == 2)</code> &mdash; <code>r = 0</code>; <code>c = 0</code>","line":4,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["src",""]]}],"vars":[["m","1",0],["n","2",0],["r","0",1],["c","0",1]],"stack":["oranges_rotting(grid)","<genexpr>()"]},{"caption":"<code>queue = deque((r, c) for r in range(m) for c in range(n) if g[r][c] == 2)</code> &mdash; yields <code>(0, 1)</code>; <code>c = 1</code>","line":4,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["","src"]]}],"vars":[["m","1",0],["n","2",0],["r","0",0],["c","1",1]],"stack":["oranges_rotting(grid)","<genexpr>()"]},{"caption":"<code>queue = deque((r, c) for r in range(m) for c in range(n) if g[r][c] == 2)</code>","line":4,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["","src"]]}],"vars":[["m","1",0],["n","2",0],["r","0",0],["c","1",0]],"stack":["oranges_rotting(grid)","<genexpr>()"]},{"caption":"<code>queue = deque((r, c) for r in range(m) for c in range(n) if g[r][c] == 2)</code> &mdash; yields <code>None</code>","line":4,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["","src"]]}],"vars":[["m","1",0],["n","2",0],["r","0",0],["c","1",0]],"stack":["oranges_rotting(grid)","<genexpr>()"]},{"caption":"<code>fresh = sum(row.count(1) for row in g)</code> &mdash; calls <code>&lt;genexpr&gt;()</code>","line":5,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"arr","id":"queue","label":"queue (deque)","v":["0,1"],"cls":[""]},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["","stack"]]}],"vars":[["m","1",0],["n","2",0]],"stack":["oranges_rotting(grid)","<genexpr>()"]},{"caption":"<code>fresh = sum(row.count(1) for row in g)</code> &mdash; yields <code>0</code>; <code>row = [0, 2]</code>","line":5,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"arr","id":"queue","label":"queue (deque)","v":["0,1"],"cls":[""]},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["","stack"]]},{"t":"arr","id":"row","label":"row","v":["0","2"],"cls":["",""]}],"vars":[["m","1",0],["n","2",0]],"stack":["oranges_rotting(grid)","<genexpr>()"]},{"caption":"<code>fresh = sum(row.count(1) for row in g)</code> &mdash; yields <code>None</code>","line":5,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"arr","id":"queue","label":"queue (deque)","v":["0,1"],"cls":[""]},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["","stack"]]},{"t":"arr","id":"row","label":"row","v":["0","2"],"cls":["",""]}],"vars":[["m","1",0],["n","2",0]],"stack":["oranges_rotting(grid)","<genexpr>()"]},{"caption":"<code>minutes = 0</code> &mdash; <code>fresh = 0</code>; <code>minutes = 0</code>","line":6,"panels":[{"t":"arr","id":"grid","label":"grid","v":["0,2"],"cls":[""]},{"t":"arr","id":"queue","label":"queue (deque)","v":["0,1"],"cls":[""]},{"t":"grid","id":"g","label":"g","v":[["0","2"]],"cls":[["","stack"]]}],"vars":[["m","1",0],["fresh","0",1],["minutes","0",1],["n","2",0]],"stack":[]},{"caption":"<code>