{"chapters":[{"title":"Sort by distance","code":"def find_closest_elements(arr, k, x):\n    return sorted(sorted(arr, key=lambda a: (abs(a - x), a))[:k])","frames":[{"caption":"<strong>Sort by distance</strong> &mdash; O(n log n) time, O(n) extra space. Input: <code>find_closest_elements(arr=[1, 2, 3, 4, 5], k=4, x=3)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5"],"cls":["","","","",""]}],"vars":[["k","4",0],["x","3",0]],"stack":[]},{"caption":"<code>return sorted(sorted(arr, key=lambda a: (abs(a - x), a))[:k])</code> &mdash; returns <code>[1, 2, 3, 4]</code>. <strong>Result: [1, 2, 3, 4]</strong>","line":2,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5"],"cls":["","","","",""]},{"t":"arr","id":"result","label":"result","v":["1","2","3","4"],"cls":["answer","answer","answer","answer"]}],"vars":[["k","4",0],["x","3",0]],"stack":[]}]},{"title":"Shrink a window from both ends","code":"def find_closest_elements(arr, k, x):\n    lo, hi = 0, len(arr) - 1\n    while hi - lo + 1 > k:\n        if x - arr[lo] <= arr[hi] - x:\n            hi -= 1\n        else:\n            lo += 1\n    return arr[lo:hi + 1]","frames":[{"caption":"<strong>Shrink a window from both ends</strong> &mdash; O(n - k) time, O(1) extra space. Input: <code>find_closest_elements(arr=[1, 2, 3, 4, 5, 6, 7, 8], k=3, x=5)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","","","","","",""]}],"vars":[["k","3",0],["x","5",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(arr) - 1</code> &mdash; <code>lo = 0</code>; <code>hi = 7</code>","line":2,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["src","","","","","","","src"],"ptr":{"7":["hi"],"0":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","0",1],["hi","7",1]],"stack":[]},{"caption":"<code>while hi - lo + 1 &gt; k:</code> &rarr; <strong>true</strong> (hi = 7, k = 3, lo = 0)","line":3,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["src","","","","","","","src"],"ptr":{"7":["hi"],"0":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","0",0],["hi","7",0]],"stack":[]},{"caption":"<code>if x - arr[lo] &lt;= arr[hi] - x:</code> &rarr; <strong>false</strong> (hi = 7, lo = 0, x = 5)","line":4,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["src","","","","","","","src"],"ptr":{"7":["hi"],"0":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","0",0],["hi","7",0]],"stack":[]},{"caption":"<code>lo += 1</code> &mdash; <code>lo = 1</code>","line":7,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","src","","","","","","src"],"ptr":{"7":["hi"],"1":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","1",1],["hi","7",0]],"stack":[]},{"caption":"<code>while hi - lo + 1 &gt; k:</code> &rarr; <strong>true</strong> (hi = 7, k = 3, lo = 1)","line":3,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","src","","","","","","src"],"ptr":{"7":["hi"],"1":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","1",0],["hi","7",0]],"stack":[]},{"caption":"<code>if x - arr[lo] &lt;= arr[hi] - x:</code> &rarr; <strong>true</strong> (hi = 7, lo = 1, x = 5)","line":4,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","src","","","","","","src"],"ptr":{"7":["hi"],"1":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","1",0],["hi","7",0]],"stack":[]},{"caption":"<code>hi -= 1</code> &mdash; <code>hi = 6</code>","line":5,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","src","","","","","src",""],"ptr":{"6":["hi"],"1":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","1",0],["hi","6",1]],"stack":[]},{"caption":"<code>while hi - lo + 1 &gt; k:</code> &rarr; <strong>true</strong> (hi = 6, k = 3, lo = 1)","line":3,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","src","","","","","src",""],"ptr":{"6":["hi"],"1":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","1",0],["hi","6",0]],"stack":[]},{"caption":"<code>if x - arr[lo] &lt;= arr[hi] - x:</code> &rarr; <strong>false</strong> (hi = 6, lo = 1, x = 5)","line":4,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","src","","","","","src",""],"ptr":{"6":["hi"],"1":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","1",0],["hi","6",0]],"stack":[]},{"caption":"<code>lo += 1</code> &mdash; <code>lo = 2</code>","line":7,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","src","","","","src",""],"ptr":{"6":["hi"],"2":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","2",1],["hi","6",0]],"stack":[]},{"caption":"<code>while hi - lo + 1 &gt; k:</code> &rarr; <strong>true</strong> (hi = 6, k = 3, lo = 2)","line":3,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","src","","","","src",""],"ptr":{"6":["hi"],"2":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","2",0],["hi","6",0]],"stack":[]},{"caption":"<code>if x - arr[lo] &lt;= arr[hi] - x:</code> &rarr; <strong>true</strong> (hi = 6, lo = 2, x = 5)","line":4,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","src","","","","src",""],"ptr":{"6":["hi"],"2":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","2",0],["hi","6",0]],"stack":[]},{"caption":"<code>hi -= 1</code> &mdash; <code>hi = 5</code>","line":5,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","src","","","src","",""],"ptr":{"5":["hi"],"2":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","2",0],["hi","5",1]],"stack":[]},{"caption":"<code>while hi - lo + 1 &gt; k:</code> &rarr; <strong>true</strong> (hi = 5, k = 3, lo = 2)","line":3,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","src","","","src","",""],"ptr":{"5":["hi"],"2":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","2",0],["hi","5",0]],"stack":[]},{"caption":"<code>if x - arr[lo] &lt;= arr[hi] - x:</code> &rarr; <strong>false</strong> (hi = 5, lo = 2, x = 5)","line":4,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","src","","","src","",""],"ptr":{"5":["hi"],"2":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","2",0],["hi","5",0]],"stack":[]},{"caption":"<code>lo += 1</code> &mdash; <code>lo = 3</code>","line":7,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","","src","","src","",""],"ptr":{"5":["hi"],"3":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","3",1],["hi","5",0]],"stack":[]},{"caption":"<code>while hi - lo + 1 &gt; k:</code> &rarr; <strong>false</strong> (hi = 5, k = 3, lo = 3)","line":3,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","","src","","src","",""],"ptr":{"5":["hi"],"3":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","3",0],["hi","5",0]],"stack":[]},{"caption":"<code>return arr[lo:hi + 1]</code> &mdash; returns <code>[4, 5, 6]</code>. <strong>Result: [4, 5, 6]</strong>","line":8,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","","src","","src","",""],"ptr":{"5":["hi"],"3":["lo"]}},{"t":"arr","id":"result","label":"result","v":["4","5","6"],"cls":["answer","answer","answer"]}],"vars":[["k","3",0],["x","5",0],["lo","3",0],["hi","5",0]],"stack":[]}],"example":1},{"title":"Binary search the window's left edge","code":"def find_closest_elements(arr, k, x):\n    lo, hi = 0, len(arr) - k\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if x - arr[mid] > arr[mid + k] - x:\n            lo = mid + 1                      # the window should start further right\n        else:\n            hi = mid\n    return arr[lo:lo + k]","frames":[{"caption":"<strong>Binary search the window's left edge</strong> &mdash; O(log(n - k) + k) time, O(1) extra space. Input: <code>find_closest_elements(arr=[1, 2, 3, 4, 5, 6, 7, 8], k=3, x=5)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","","","","","",""]}],"vars":[["k","3",0],["x","5",0]],"stack":[]},{"caption":"<code>lo, hi = 0, len(arr) - k</code> &mdash; <code>lo = 0</code>; <code>hi = 5</code>","line":2,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["src","","","","","src","",""],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","0",1],["hi","5",1]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 5, lo = 0)","line":3,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["src","","","","","src","",""],"ptr":{"5":["hi"],"0":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","0",0],["hi","5",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 2</code>","line":4,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["src","","src","","","src","",""],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["k","3",0],["x","5",0],["lo","0",0],["hi","5",0],["mid","2",1]],"stack":[]},{"caption":"<code>if x - arr[mid] &gt; arr[mid + k] - x:</code> &rarr; <strong>true</strong> (k = 3, mid = 2, x = 5)","line":5,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["src","","src","","","src","",""],"ptr":{"5":["hi"],"0":["lo"],"2":["mid"]}}],"vars":[["k","3",0],["x","5",0],["lo","0",0],["hi","5",0],["mid","2",0]],"stack":[]},{"caption":"<code>lo = mid + 1</code> &mdash; <code>lo = 3</code> <em>(the window should start further right)</em>","line":6,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","src","src","","src","",""],"ptr":{"5":["hi"],"3":["lo"],"2":["mid"]}}],"vars":[["k","3",0],["x","5",0],["lo","3",1],["hi","5",0],["mid","2",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 5, lo = 3)","line":3,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","src","src","","src","",""],"ptr":{"5":["hi"],"3":["lo"],"2":["mid"]}}],"vars":[["k","3",0],["x","5",0],["lo","3",0],["hi","5",0],["mid","2",0]],"stack":[]},{"caption":"<code>mid = (lo + hi) // 2</code> &mdash; <code>mid = 4</code>","line":4,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","","src","src","src","",""],"ptr":{"5":["hi"],"3":["lo"],"4":["mid"]}}],"vars":[["k","3",0],["x","5",0],["lo","3",0],["hi","5",0],["mid","4",1]],"stack":[]},{"caption":"<code>if x - arr[mid] &gt; arr[mid + k] - x:</code> &rarr; <strong>false</strong> (k = 3, mid = 4, x = 5)","line":5,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","","src","src","src","",""],"ptr":{"5":["hi"],"3":["lo"],"4":["mid"]}}],"vars":[["k","3",0],["x","5",0],["lo","3",0],["hi","5",0],["mid","4",0]],"stack":[]},{"caption":"<code>hi = mid</code> &mdash; <code>hi = 4</code>","line":8,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","","src","src","","",""],"ptr":{"4":["hi","mid"],"3":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","3",0],["hi","4",1],["mid","4",0]],"stack":[]},{"caption":"<code>while lo &lt; hi:</code> &rarr; <strong>true</strong> (hi = 4, lo = 3)","line":3,"panels":[{"t":"arr","id":"arr","label":"arr","v":["1","2","3","4","5","6","7","8"],"cls":["","","","src","src","","",""],"ptr":{"4":["hi","mid"],"3":["lo"]}}],"vars":[["k","3",0],["x","5",0],["lo","3",0],["hi","4",0],["mid","4",0]],"stack":[]}