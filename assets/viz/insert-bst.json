{"chapters":[{"title":"Iterative: walk to the empty slot","code":"def insert_into_bst(root, val):\n    new = TreeNode(val)\n    if root is None:\n        return new\n    node = root\n    while True:\n        if val < node.val:\n            if node.left is None:\n                node.left = new\n                return root\n            node = node.left\n        else:\n            if node.right is None:\n                node.right = new\n                return root\n            node = node.right","frames":[{"caption":"<strong>Iterative: walk to the empty slot</strong> &mdash; O(h) time, O(1) extra space. Input: <code>insert_into_bst(root=tree (4), val=5)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4424320272","1",0.0,2.5,"",[]],["n4420710352","2",1.0,1.25,"",[]],["n4424321488","3",2.0,2.5,"",[]],["n4424041200","4",3.0,0.0,"cur",["root"]],["n4420710032","7",4.0,1.25,"",[]]],"edges":[["n4424041200","n4420710352","",""],["n4420710352","n4424320272","",""],["n4420710352","n4424321488","",""],["n4424041200","n4420710032","",""]],"dir":false}],"vars":[["val","5",0]],"stack":[]},{"caption":"<code>new = TreeNode(val)</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4424320272","1",0.0,2.5,"",[]],["n4420710352","2",1.0,1.25,"",[]],["n4424321488","3",2.0,2.5,"",[]],["n4424041200","4",3.0,0.0,"cur",["root"]],["n4420710032","7",4.0,1.25,"",[]]],"edges":[["n4424041200","n4420710352","",""],["n4420710352","n4424320272","",""],["n4420710352","n4424321488","",""],["n4424041200","n4420710032","",""]],"dir":false},{"t":"net","id":"tree1","label":"tree (second)","nodes":[["n4424075600","5",0.0,0.0,"cur",["new"]]],"edges":[],"dir":false}],"vars":[["val","5",0]],"stack":[]},{"caption":"<code>if root is None:</code> &rarr; <strong>false</strong>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4424320272","1",0.0,2.5,"",[]],["n4420710352","2",1.0,1.25,"",