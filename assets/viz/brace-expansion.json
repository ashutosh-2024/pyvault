{"chapters":[{"title":"Parse into option groups, backtrack in sorted order","code":"def expand(s):\n    groups, i = [], 0\n    while i < len(s):\n        if s[i] == \"{\":\n            j = s.index(\"}\", i)\n            groups.append(sorted(s[i + 1:j].split(\",\")))\n            i = j + 1\n        else:\n            groups.append([s[i]])\n            i += 1\n\n    out, path = [], []\n\n    def dfs(g):\n        if g == len(groups):\n            out.append(\"\".join(path))\n            return\n        for ch in groups[g]:\n            path.append(ch)\n            dfs(g + 1)\n            path.pop()\n\n    dfs(0)\n    return out","frames":[{"caption":"<strong>Parse into option groups, backtrack in sorted order</strong> &mdash; O(W &middot; L) time, O(L) extra space. Input: <code>expand(s='{a,b}{c,d}')</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"s","label":"s","v":["{","a",",","b","}","{","c",",","d","}"],"cls":["","","","","","","","","",""]}],"vars":[["s","'{a,b}{c,d}'",0]],"stack":[]},{"caption":"<code>groups, i = [], 0</code> &mdash; <code>i = 0</code>; <code>groups = []</code>","line":2,"panels":[{"t":"arr","id":"s","label":"s","v":["{","a",",","b","}","{","c",",","d","}"],"cls":["src","","","","","","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"groups","label":"groups","v":[],"cls":[],"noidx":true}],"vars":[["s","'{a,b}{c,d}'",0],["i","0",1]],"stack":[]},{"caption":"<code>while i &lt; len(s):</code> &rarr; <strong>true</strong> (i = 0, s = '{a,b}{c,d}')","line":3,"panels":[{"t":"arr","id":"s","label":"s","v":["{","a",",","b","}","{","c",",","d","}"],"cls":["src","","","","","","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"groups","label":"groups","v":[],"cls":[],"noidx":true}],"vars":[["s","'{a,b}{c,d}'",0],["i","0",0]],"stack":[]},{"caption":"<code>if s[i] == \"{\":</code> &rarr; <strong>true</strong> (i = 0, s = '{a,b}{c,d}')","line":4,"panels":[{"t":"arr","id":"s","label":"s","v":["{","a",",","b","}","{",