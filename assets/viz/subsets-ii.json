{"chapters":[{"title":"Sort, skip equal siblings","code":"def subsets_with_dup(nums):\n    nums = sorted(nums)\n    out, path = [], []\n\n    def dfs(start):\n        out.append(path[:])\n        for i in range(start, len(nums)):\n            if i > start and nums[i] == nums[i - 1]:\n                continue\n            path.append(nums[i])\n            dfs(i + 1)\n            path.pop()\n\n    dfs(0)\n    return out","frames":[{"caption":"<strong>Sort, skip equal siblings</strong> &mdash; O(n &middot; 2<sup>n</sup>) time, O(n) extra space. Input: <code>subsets_with_dup(nums=[1, 2, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","2"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>nums = sorted(nums)</code> &mdash; <code>nums</code> is now <code>[1, 2, 2]</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","2"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>out, path = [], []</code> &mdash; <code>out = []</code>; <code>path = []</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","2"],"cls":["","",""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>def dfs(start):</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","2"],"cls":["","",""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>dfs(0)</code> &mdash; calls <code>dfs(start=0)</code>","line":14,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","2"],"cls":["src","",""],"ptr":{"0":["start"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["start","0",1]],"stack":["subsets_w