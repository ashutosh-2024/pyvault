"arr","id":"G","label":"G","v":["1","1","2","5","14"],"cls":["","","","",""]}],"vars":[["n","4",0],["size","4",0],["root","4",0]],"stack":[]},{"caption":"<code>return G[n]</code> &mdash; returns <code>14</code>. <strong>Result: 14</strong>","line":6,"panels":[{"t":"arr","id":"G","label":"G","v":["1","1","2","5","14"],"cls":["","","","",""]}],"vars":[["n","4",0],["size","4",0],["root","4",0]],"stack":[]}],"example":1},{"title":"Closed form: the Catalan number","code":"from math import comb\n\n\ndef num_trees(n):\n    return comb(2 * n, n) // (n + 1)","frames":[{"caption":"<strong>Closed form: the Catalan number</strong> &mdash; O(n) time, O(1) extra space. Input: <code>num_trees(n=1)</code>. Step through to watch the code work on this input.","line":4,"panels":[],"vars":[["n","1",0]],"stack":[]},{"caption":"<code>return comb(2 * n, n) // (n + 1)</code> &mdash; returns <code>1</code>. <strong>Result: 1</strong>","line":5,"panels":[],"vars":[["n","1",0]],"stack":[]}]}]}