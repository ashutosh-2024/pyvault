{"chapters":[{"title":"Bottom-up DP over sizes","code":"def num_trees(n):\n    G = [1] + [0] * n\n    for size in range(1, n + 1):\n        for root in range(1, size + 1):\n            G[size] += G[root - 1] * G[size - root]\n    return G[n]","frames":[{"caption":"<strong>Bottom-up DP over sizes</strong> &mdash; O(n&sup2;) time, O(n) extra space. Input: <code>num_trees(n=7)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","7",0]],"stack":[]},{"caption":"<code>G = [1] + [0] * n</code> &mdash; <code>G = [1, 0, 0, 0, 0, 0, 0, 0]</code>","line":2,"panels":[{"t":"arr","id":"G","label":"G","v":["1","0","0","0","0","0","0","0"],"cls":["","","","","","","",""]}],"vars":[["n","7",0]],"stack":[]},{"caption":"<code>for size in range(1, n + 1):</code> &mdash; <code>size = 1</code>","line":3,"panels":[{"t":"arr","id":"G","label":"G","v":["1","0","0","0","0","0","0","0"],"cls":["","","","","","","",""]}],"vars":[["n","7",0],["size","1",1]],"stack":[]},{"caption":"<code>for root in range(1, size + 1):</code> &mdash; <code>root = 1</code>","line":4,"panels":[{"t":"arr","id":"G","label":"G","v":["1","0","0","0","0","0","0","0"],"cls":["","","","","","","",""]}],"vars":[["n","7",0],["size","1",0],["root","1",1]],"stack":[]},{"caption":"<code>G[size] += G[root - 1] * G[size - root]</code> &mdash; <code>G[1]</code> becomes <code>1</code>","line":5,"panels":[{"t":"arr","id":"G","label":"G","v":["1","1","0","0","0","0","0","0"],"cls":["","cur","","","","","",""]}],"vars":[["n","7",0],["size","1",0],["root","1",0]],"stack":[]},{"caption":"<code>for root in range(1, size + 1):</code>","line":4,"panels":[{"t":"arr","id":"G","label":"G","v":["1","1","0","0","0","0","0","0"],"cls":["","","","","","","",""]}],"vars":[["n","7",0],["size","1",0],["root","1",0]],"stack":[]},{"caption":"<code>for size in range(1, n + 1):</code> &mdash; <code>size = 2</code>","line":3,"panels":[{"t":"arr","id":"G","label":"G","v":["1","1","0","0","0","0","0","0"],"cls":[