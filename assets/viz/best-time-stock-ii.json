{"chapters":[{"title":"Try every buy/sell decision","code":"def max_profit(prices):\n    def best(day, holding):\n        if day == len(prices):\n            return 0\n        skip = best(day + 1, holding)\n        if holding:\n            return max(skip, prices[day] + best(day + 1, False))\n        return max(skip, -prices[day] + best(day + 1, True))\n\n    return best(0, False)","frames":[{"caption":"<strong>Try every buy/sell decision</strong> &mdash; O(2<sup>n</sup>) time, O(n) extra space. Input: <code>max_profit(prices=[5, 3, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>def best(day, holding):</code>","line":2,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>return best(0, False)</code> &mdash; calls <code>best(day=0, holding=F)</code>","line":10,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","0",1],["holding","F",1]],"stack":["max_profit(prices)","best(day=0, holding=F)"]},{"caption":"<code>if day == len(prices):</code> &rarr; <strong>false</strong> (day = 0)","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","0",0],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)"]},{"caption":"<code>skip = best(day + 1, holding)</code> &mdash; calls <code>best(day=1, holding=F)</code>","line":5,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","1",1],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=F)"]},{"caption":"<code>if day == len(prices):</code> &rarr; <strong>false</strong> (day = 1)","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","1",0],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=F)"]},{"caption":"<code>skip = best(day + 1, holding)</code> &mdash; calls <code>best(day=2, holding=F)</code>","line":5,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","2",1],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=F)","best(day=2, holding=F)"]},{"caption":"<code>if day == len(prices):</code> &rarr; <strong>false</strong> (day = 2)","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","2",0],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=F)","best(day=2, holding=F)"]},{"caption":"<code>skip = best(day + 1, holding)</code> &mdash; calls <code>best(day=3, holding=F)</code>","line":5,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","3",1],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=F)","best(day=2, holding=F)","best(day=3, holding=F)"]},{"caption":"<code>if day == len(prices):</code> &rarr; <strong>true</strong> (day = 3)","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","3",0],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=F)","best(day=2, holding=F)","best(day=3, holding=F)"]},{"caption":"<code>return 0</code> &mdash; <code>best</code> returns <code>0</code> to <code>best</code>","line":4,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","3",0],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=F)","best(day=2, holding=F)","best(day=3, holding=F)"]},{"caption":"<code>if holding:</code> &rarr; <strong>false</strong> (holding = F) &mdash; <c