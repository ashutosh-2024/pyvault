"4","4","7","7"],"cls":["","","","","","src"],"ptr":{"5":["i"]}},{"t":"arr","id":"hold","label":"hold","v":["-7","-1","-1","1","1","3"],"cls":["","","","","","src"],"ptr":{"5":["i"]}}],"vars":[["n","6",0],["i","5",0]],"stack":[]},{"caption":"<code>return cash[-1]</code> &mdash; returns <code>7</code>. <strong>Result: 7</strong>","line":8,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","","src"],"ptr":{"5":["i"]}},{"t":"arr","id":"cash","label":"cash","v":["0","0","4","4","7","7"],"cls":["","","","","","src"],"ptr":{"5":["i"]}},{"t":"arr","id":"hold","label":"hold","v":["-7","-1","-1","1","1","3"],"cls":["","","","","","src"],"ptr":{"5":["i"]}}],"vars":[["n","6",0],["i","5",0]],"stack":[]}]},{"title":"DP with two rolling variables","code":"def max_profit(prices):\n    cash, hold = 0, -prices[0]\n    for p in prices[1:]:\n        cash, hold = max(cash, hold + p), max(hold, cash - p)\n    return cash","frames":[{"caption":"<strong>DP with two rolling variables</strong> &mdash; O(n) time, O(1) extra space. Input: <code>max_profit(prices=[7, 1, 5, 3, 6, 4])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>cash, hold = 0, -prices[0]</code> &mdash; <code>cash = 0</code>; <code>hold = -7</code>","line":2,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]}],"vars":[["cash","0",1],["hold","-7",1]],"stack":[]},{"caption":"<code>for p in prices[1:]:</code> &mdash; <code>p = 1</code>","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]}],"vars":[["cash","0",0],["hold","-7",0],["p","1",1]],"stack":[]},{"caption":"<code>cash, hold = max(cash, hold + p), max(hold, cash - p)</code> &mdash; <code>hold = -1</code>","line":4,"panels":[{"t":"arr","