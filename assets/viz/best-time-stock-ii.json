{"chapters":[{"title":"Try every buy/sell decision","code":"def max_profit(prices):\n    def best(day, holding):\n        if day == len(prices):\n            return 0\n        skip = best(day + 1, holding)\n        if holding:\n            return max(skip, prices[day] + best(day + 1, False))\n        return max(skip, -prices[day] + best(day + 1, True))\n\n    return best(0, False)","frames":[{"caption":"<strong>Try every buy/sell decision</strong> &mdash; O(2<sup>n</sup>) time, O(n) extra space. Input: <code>max_profit(prices=[5])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>def best(day, holding):</code>","line":2,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>return best(0, False)</code> &mdash; calls <code>best(day=0, holding=F)</code>","line":10,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5"],"cls":[""]}],"vars":[["day","0",1],["holding","F",1]],"stack":["max_profit(prices)","best(day=0, holding=F)"]},{"caption":"<code>if day == len(prices):</code> &rarr; <strong>false</strong> (day = 0)","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5"],"cls":[""]}],"vars":[["day","0",0],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)"]},{"caption":"<code>skip = best(day + 1, holding)</code> &mdash; calls <code>best(day=1, holding=F)</code>","line":5,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5"],"cls":[""]}],"vars":[["day","1",1],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=F)"]},{"caption":"<code>if day == len(prices):</code> &rarr; <strong>true</strong> (day = 1)","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5"],"cls":[""]}],"vars":[["day","1",0],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=F)"]},{"caption":"<code>return 0</code> &mdash; <code>best</code> returns <code>0</code> to <code>best</code>","line":4,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5"],"cls":[""]}],"vars":[["day","1",0],["holding","F",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=F)"]},{"caption":"<code>if holding:</code> &rarr; <strong>false</strong> (holding = F) &mdash; <code>day = 0</code>; <code>skip = 0</code>","line":6,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5"],"cls":[""]}],"vars":[["day","0",1],["holding","F",0],["skip","0",1]],"stack":["max_profit(prices)","best(day=0, holding=F)"]},{"caption":"<code>return max(skip, -prices[day] + best(day + 1, True))</code> &mdash; calls <code>best(day=1, holding=T)</code>","line":8,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5"],"cls":[""]}],"vars":[["day","1",1],["holding","T",1],["skip","0",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=T)"]},{"caption":"<code>if day == len(prices):</code> &rarr; <strong>true</strong> (day = 1)","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5"],"cls":[""]}],"vars":[["day","1",0],["holding","T",0],["skip","0",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=T)"]},{"caption":"<code>return 0</code> &mdash; <code>best</code> returns <code>0</code> to <code>best</code>. <strong>Result: 0</strong>","line":4,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5"],"cls":[""]}],"vars":[["day","1",0],["holding","T",0],["skip","0",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=T)"]}]},{"title":"DP over (day, holding)","code":"def max_profit(prices):\n    n = len(prices)\n    cash, hold = [0] * n, [0] * n\n    hold[0] = -prices[0]\n    for i in range(1, n):\n        cash[i] = max(cash[i - 1], hold[i - 1] + prices[i])    # sell today, or not\n        hold[i] = max(hold[i - 1], cash[i - 1] - prices[i])    # buy today, or not\n    return cash[-1]","frames":[{"caption":"<strong>DP over (day, holding)</strong> &mdash; O(n) time, O(n) extra space. Input: <code>max_profit(prices=[7, 1, 5, 3, 6, 4])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>n = len(prices)</code> &mdash; <code>n = 6</code>","line":2,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]}],"vars":[["n","6",1]],"stack":[]},{"caption":"<code>cash, hold = [0] * n, [0] * n</code> &mdash; <code>cash = [0, 0, 0, 0, 0, 0]</code>; <code>hold = [0, 0, 0, 0, 0, 0]</code>","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]},{"t":"arr","id":"cash","label":"cash","v":["0","0","0","0","0","0"],"cls":["","","","","",""]},{"t":"arr","id":"hold","label":"hold","v":["0","0","0","0","0","0"],"cls":["","","","","",""]}],"vars":[["n","6",0]],"stack":[]},{"caption":"<code>hold[0] = -prices[0]</code> &mdash; <code>hold[0]</code> becomes <code>-7</code>","line":4,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","","","","",""]},{"t":"arr","id":"cash","label":"cash","v":["0","0","0","0","0","0"],"cls":["","","","","",""]},{"t":"arr","id":"hold","label":"hold","v":["-7","0","0","0","0","0"],"cls":["cur","","","","",""]}],"vars":[["n","6",0]],"stack":[]},{"caption":"<code>for i in range(1, n):</code> &mdash; <code>i = 1</code>","line":5,"panels":[{"t":"arr","id":"prices","label":"prices","v":["7","1","5","3","6","4"],"cls":["","src","","","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"cash","label":"cash","v":["0","0","0","0","0","0"],"cls":["","src","","","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"hold","label":"hold","v":["-7","0","0","0","0","0"],"cls":["","src","","","",""],"ptr":{"1":["i"]}}],"va