ng=F)","best(day=3, holding=F)"]},{"caption":"<code>if holding:</code> &rarr; <strong>false</strong> (holding = F) &mdash; <code>day = 2</code>; <code>skip = 0</code>","line":6,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","2",1],["holding","F",0],["skip","0",1]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=T)","best(day=2, holding=F)"]},{"caption":"<code>return max(skip, -prices[day] + best(day + 1, True))</code> &mdash; calls <code>best(day=3, holding=T)</code>","line":8,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","3",1],["holding","T",1],["skip","0",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=T)","best(day=2, holding=F)","best(day=3, holding=T)"]},{"caption":"<code>if day == len(prices):</code> &rarr; <strong>true</strong> (day = 3)","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","3",0],["holding","T",0],["skip","0",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=T)","best(day=2, holding=F)","best(day=3, holding=T)"]},{"caption":"<code>return 0</code> &mdash; <code>best</code> returns <code>0</code> to <code>best</code>. <strong>Result: 0</strong>","line":4,"panels":[{"t":"arr","id":"prices","label":"prices","v":["5","3","1"],"cls":["","",""]}],"vars":[["day","3",0],["holding","T",0],["skip","0",0]],"stack":["max_profit(prices)","best(day=0, holding=F)","best(day=1, holding=T)","best(day=2, holding=F)","best(day=3, holding=T)"]}],"example":2},{"title":"DP over (day, holding)","code":"def max_profit(prices):\n    n = len(prices)\n    cash, hold = [0] * n, [0] * n\n    hold[0] = -prices[0]\n    for i in range(1, n):\n        cash[i] = max(cash[i - 1], hold[i - 1] + prices[i])    # sell today, or not\n        hold[i] = max(hold[i - 1], cash[i - 1] - prices[i])    # buy today, or not\n    return cash[-1]","frames":[{"caption":"<strong>DP over (day, holding)</strong> &mdash; O(n) time, O(n) extra space. Input: <code>max_profit(prices=[1, 5, 3, 6])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"prices","label":"prices","v":["1","5","3","6"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>n = len(prices)</code> &mdash; <code>n = 4</code>","line":2,"panels":[{"t":"arr","id":"prices","label":"prices","v":["1","5","3","6"],"cls":["","","",""]}],"vars":[["n","4",1]],"stack":[]},{"caption":"<code>cash, hold = [0] * n, [0] * n</code> &mdash; <code>cash = [0, 0, 0, 0]</code>; <code>hold = [0, 0, 0, 0]</code>","line":3,"panels":[{"t":"arr","id":"prices","label":"prices","v":["1","5","3","6"],"cls":["","","",""]},{"t":"arr","id":"cash","label":"cash","v":["0","0","0","0"],"cls":["","","",""]},{"t":"arr","id":"hold","label":"hold","v":["0","0","0","0"],"cls":["","","",""]}],"vars":[["n","4",0]],"stack":[]},{"caption":"<code>hold[0] = -prices[0]</code> &mdash; <code>hold[0]</code> becomes <code>-1</code>","line":4,"panels":[{"t":"arr","id":"prices","label":"prices","v":["1","5","3","6"],"cls":["","","",""]},{"t":"arr","id":"cash","label":"cash","v":["0","0","0","0"],"cls":["","","",""]},{"t":"arr","id":"hold","label":"hold","v":["-1","0","0","0"],"cls":["cur","","",""]}],"vars":[["n","4",0]],"stack":[]},{"caption":"<code>for i in range(1, n):</code> &mdash; <code>i = 1</code>","line":5,"panels":[{"t":"arr","id":"prices","label":"prices","v":["1","5","3","6"],"cls":["","src","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"cash","label":"cash","v":["0","0","0","0"],"cls":["","src","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"hold","label":"hold","v":["-1","0","0","0"],"cls":["","src","",""],"ptr":{"1":["i"]}}],"vars":[["n","4",0],["i","1",1]],"stack":[]},{"caption":"<code>cash[i] = max(cash[i - 1], hold[i - 1] + prices[i])</code> &mdash; <code>cash[1]</code> becomes <code>4</code> <em>(sell today, or not)</em>"