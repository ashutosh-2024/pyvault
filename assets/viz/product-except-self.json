>a = 6</code>; <code>b = 1</code>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","4"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"left","label":"left","v":["1","1","2","6"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"right","label":"right","v":["24","12","4","1"],"cls":["src","","",""],"ptr":{"0":["i"]}}],"vars":[["n","4",0],["i","0",0],["a","6",1],["b","1",1]],"stack":[]},{"caption":"<code>return [a * b for a, b in zip(left, right)]</code> &mdash; returns <code>[24, 12, 8, 6]</code>. <strong>Result: [24, 12, 8, 6]</strong>","line":8,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","4"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"left","label":"left","v":["1","1","2","6"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"right","label":"right","v":["24","12","4","1"],"cls":["src","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"result","label":"result","v":["24","12","8","6"],"cls":["answer","answer","answer","answer"]}],"vars":[["n","4",0],["i","0",0]],"stack":[]}],"example":1},{"title":"Output array plus a running suffix","code":"def product_except_self(nums):\n    n = len(nums)\n    out = [1] * n\n    for i in range(1, n):\n        out[i] = out[i - 1] * nums[i - 1]        # prefix products\n    suffix = 1\n    for i in range(n - 1, -1, -1):\n        out[i] *= suffix\n        suffix *= nums[i]\n    return out","frames":[{"caption":"<strong>Output array plus a running suffix</strong> &mdash; O(n) time, O(1) beyond the output extra space. Input: <code>product_except_self(nums=[1, 2, 3, 4])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","4"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>n = len(nums)</code> &mdash; <code>n = 4</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","4"],"cls":["","","",""]}],"vars":[["n","4",1]],"stack":[]},{"capt