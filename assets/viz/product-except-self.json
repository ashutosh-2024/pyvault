/code>","line":11,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","4"],"cls":["","","",""]}],"vars":[["zeros","0",0],["total","24",0],["x","4",1]],"stack":[]},{"caption":"<code>return [total // x for x in nums]</code> &mdash; returns <code>[24, 12, 8, 6]</code>. <strong>Result: [24, 12, 8, 6]</strong>","line":11,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","4"],"cls":["","","",""]},{"t":"arr","id":"result","label":"result","v":["24","12","8","6"],"cls":["answer","answer","answer","answer"]}],"vars":[["zeros","0",0],["total","24",0],["x","4",0]],"stack":[]}],"example":1},{"title":"Prefix and suffix product arrays","code":"def product_except_self(nums):\n    n = len(nums)\n    left, right = [1] * n, [1] * n\n    for i in range(1, n):\n        left[i] = left[i - 1] * nums[i - 1]\n    for i in range(n - 2, -1, -1):\n        right[i] = right[i + 1] * nums[i + 1]\n    return [a * b for a, b in zip(left, right)]","frames":[{"caption":"<strong>Prefix and suffix product arrays</strong> &mdash; O(n) time, O(n) extra space. Input: <code>product_except_self(nums=[1, 2, 3, 4])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","4"],"cls":["","","",""]}],"vars":[],"stack":[]},{"caption":"<code>n = len(nums)</code> &mdash; <code>n = 4</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","4"],"cls":["","","",""]}],"vars":[["n","4",1]],"stack":[]},{"caption":"<code>left, right = [1] * n, [1] * n</code> &mdash; <code>left = [1, 1, 1, 1]</code>; <code>right = [1, 1, 1, 1]</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3","4"],"cls":["","","",""]},{"t":"arr","id":"left","label":"left","v":["1","1","1","1"],"cls":["","","",""]},{"t":"arr","id":"right","label":"right","v":["1","1","1","1"],"cls":["","","",""]}],"vars":[["n","4",0]],"stack":[]},{"caption":"<code>for i in range(1, n):</code> &mdash; <code>i = 1<