{"chapters":[{"title":"Postorder sums into a Counter","code":"def find_frequent_tree_sum(root):\n    counts = Counter()\n\n    def total(node):\n        if node is None:\n            return 0\n        s = node.val + total(node.left) + total(node.right)\n        counts[s] += 1\n        return s\n\n    total(root)\n    if not counts:\n        return []\n    top = max(counts.values())\n    return [s for s, c in counts.items() if c == top]","frames":[{"caption":"<strong>Postorder sums into a Counter</strong> &mdash; O(n) time, O(n) extra space. Input: <code>find_frequent_tree_sum(root=tree (5))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4389202000","2",0.0,1.25,"",[]],["n4392502336","5",1.0,0.0,"cur",["root"]],["n4389199760","-3",2.0,1.25,"",[]]],"edges":[["n4392502336","n4389202000","",""],["n4392502336","n4389199760","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>counts = Counter()</code> &mdash; <code>counts = {}</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4389202000","2",0.0,1.25,"",[]],["n4392502336","5",1.0,0.0,"cur",["root"]],["n4389199760","-3",2.0,1.25,"",[]]],"edges":[["n4392502336","n4389202000","",""],["n4392502336","n4389199760","",""]],"dir":false},{"t":"arr","id":"counts","label":"counts (Counter)","v":[],"cls":[],"keys":[]}],"vars":[],"stack":[]},{"caption":"<code>def total(node):</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4389202000","2",0.0,1.25,"",[]],["n4392502336","5",1.0,0.0,"cur",["root"]],["n4389199760","-3",2.0,1.25,"",[]]],"edges":[["n4392502336","n4389202000","",""],["n4392502336","n4389199760","",""]],"dir":false},{"t":"arr","id":"counts","label":"counts (Counter)","v":[],"cls":[],"keys":[]}],"vars":[],"stack":[]},{"caption":"<code>total(root)</code> &mdash; calls <code>total(node=(5))</code>","line":11,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4389202000"