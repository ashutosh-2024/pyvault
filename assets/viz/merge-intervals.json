{"chapters":[{"title":"Overlap graph, connected components","code":"def merge(intervals):\n    n = len(intervals)\n    adj = [[j for j in range(n) if j != i and intervals[i][0] <= intervals[j][1]\n            and intervals[j][0] <= intervals[i][1]] for i in range(n)]\n    seen, out = [False] * n, []\n    for i in range(n):\n        if seen[i]:\n            continue\n        stack, lo, hi = [i], intervals[i][0], intervals[i][1]\n        seen[i] = True\n        while stack:\n            k = stack.pop()\n            lo, hi = min(lo, intervals[k][0]), max(hi, intervals[k][1])\n            for j in adj[k]:\n                if not seen[j]:\n                    seen[j] = True\n                    stack.append(j)\n        out.append([lo, hi])\n    return sorted(out)","frames":[{"caption":"<strong>Overlap graph, connected components</strong> &mdash; O(n&sup2;) time, O(n&sup2;) extra space. Input: <code>merge(intervals=[[2, 3], [1, 10], [10, 12]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["2,3","1,10","10,12"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>n = len(intervals)</code> &mdash; <code>n = 3</code>","line":2,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["2,3","1,10","10,12"],"cls":["","",""]}],"vars":[["n","3",1]],"stack":[]},{"caption":"<code>and intervals[j][0] &lt;= intervals[i][1]] for i in range(n)]</code>","line":4,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["2,3","1,10","10,12"],"cls":["","",""]}],"vars":[["n","3",0]],"stack":[]},{"caption":"<code>adj = [[j for j in range(n) if j != i and intervals[i][0] &lt;= intervals[j][1]</code>","line":3,"panels":[{"t":"arr","id":"intervals","label":"intervals","v":["2,3","1,10","10,12"],"cls":["","",""]}],"vars":[["n","3",0]],"stack":[]},{"caption":"<code>and intervals[j][0] &lt;= intervals[i][1]] for i in range(n)]</code> &mdash; <code>i = 0</code>","line":4,"panels":[{"t":"arr","id"