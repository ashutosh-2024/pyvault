{"chapters":[{"title":"Move everything on every push","code":"class MyQueue:\n    def __init__(self):\n        self.s, self.helper = [], []\n\n    def push(self, x):\n        while self.s:\n            self.helper.append(self.s.pop())\n        self.s.append(x)\n        while self.helper:\n            self.s.append(self.helper.pop())\n\n    def pop(self):\n        return self.s.pop()\n\n    def peek(self):\n        return self.s[-1]\n\n    def empty(self):\n        return not self.s","frames":[{"caption":"<strong>Move everything on every push</strong> &mdash; push O(n), pop O(1) time, O(n) extra space. Running <code>q = MyQueue(); q.push(1); q.push(2); assert q.peek() == 1 and q.pop() == 1 and q.empty() is False</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","y","Q","u","e","u","e"],"cls":["","","","","","",""]}],"vars":[["self","'MyQueue'",0]],"stack":[]},{"caption":"<code>self.s, self.helper = [], []</code> &mdash; returns <code>None</code>; <code>self.s = []</code>; <code>self.helper = []</code>","line":3,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>while self.s:</code> &rarr; <strong>false</strong> &mdash; <code>x = 1</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","1",1]],"stack":[]},{"caption":"<code>self.s.append(x)</code> &mdash; <code>self.s</code> gets <code>1</code> appended","line":8,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["1"],"cls":["cur"]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","1",0]],"stack":[]},{"caption":"<code>while self.helper:</code> &rarr; <strong>false</strong> &mdash; returns <code>None</code>","line":9,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["1"],"cls":[""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","1",0]],"stack":[]},{"caption":"<code>while self.s:</code> &rarr; <strong>true</strong> &mdash; <code>x = 2</code>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["1"],"cls":[""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","2",1]],"stack":[]},{"caption":"<code>self.helper.append(self.s.pop())</code> &mdash; <code>1</code> popped off the end of <code>self.s</code>; <code>self.helper</code> gets <code>1</code> appended","line":7,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.helper","label":"self.helper","v":["1"],"cls":["cur"]}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>while self.s:</code> &rarr; <strong>false</strong>","line":6,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.helper","label":"self.helper","v":["1"],"cls":[""]}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>self.s.append(x)</code> &mdash; <code>self.s</code> gets <code>2</code> appended","line":8,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["2"],"cls":["cur"]},{"t":"arr","id":"self.helper","label":"self.helper","v":["1"],"cls":[""]}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>while self.helper:</code> &rarr; <strong>true</strong>","line":9,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["2"],"cls":[""]},{"t":"arr","id":"self.helper","label":"self.helper","v":["1"],"cls":[""]}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>self.s.append(self.helper.pop())</code> &mdash; <code>self.s</code> gets <code>1</code> appended; <code>1</code> popped off the end of <code>self.helper</code>","line":10,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["2","1"],"cls":["","cur"]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>while self.helper:</code> &rarr; <strong>false</strong> &mdash; returns <code>None</code>","line":9,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["2","1"],"cls":["",""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[["x","2",0]],"stack":[]},{"caption":"<code>return self.s[-1]</code> &mdash; returns <code>1</code>","line":16,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["2","1"],"cls":["",""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>return self.s.pop()</code> &mdash; returns <code>1</code>; <code>1</code> popped off the end of <code>self.s</code>","line":13,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["2"],"cls":[""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>return not self.s</code> &mdash; returns <code>F</code>. <strong>Result: F</strong>","line":19,"panels":[{"t":"arr","id":"self.s","label":"self.s","v":["2"],"cls":[""]},{"t":"arr","id":"self.helper","label":"self.helper","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]}]},{"title":"Input and output stacks, transfer lazily","code":"class MyQueue:\n    def __init__(self):\n        self.inbox, self.outbox = [], []\n\n    def push(self, x):\n        self.inbox.append(x)\n\n    def _shift(self):\n        if not self.outbox:\n            while self.inbox:\n                self.outbox.append(self.inbox.pop())   # reverses: oldest on top\n\n    def pop(self):\n        self._shift()\n        return self.outbox.pop()\n\n    def peek(self):\n        self._shift()\n        return self.outbox[-1]\n\n    def empty(self):\n        return not self.inbox and not self.outbox","frames":[{"caption":"<strong>Input and output stacks, transfer lazily</strong> &mdash; amortised O(1) time, O(n) extra space. Running <code>q = MyQueue(); q.push(1); q.push(2); assert q.peek() == 1 and q.pop() == 1 and q.empty() is False</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","y","Q","u","e","u","e"],"cls":["","","","","","",""]}],"vars":[["self","'MyQueue'",0]],"stack":[]},{"caption":"<code>self.inbox, self.outbox = [], []</code> &mdash; returns <code>None</code>; <code>self.inbox = []</code>; <code>self.outbox = []</code>","line":3,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.outbox","label":"self.outbox","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>self.inbox.append(x)</code> &mdash; returns <code>None</code>; <code>self.inbox</code> gets <code>1</code> appended; <code>x = 1</code>","line":6,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":["1"],"cls":["cur"]},{"t":"arr","id":"self.outbox","label":"self.outbox","v":[],"cls":[],"noidx":true}],"vars":[["x","1",1]],"stack":[]},{"caption":"<code>self.inbox.append(x)</code> &mdash; returns <code>None</code>; <code>self.inbox</code> gets <code>2</code> appended; <code>x = 2</code>","line":6,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":["1","2"],"cls":["","cur"]},{"t":"arr","id":"self.outbox","label":"self.outbox","v":[],"cls":[],"noidx":true}],"vars":[["x","2",1]],"stack":[]},{"caption":"<code>self._shift()</code> &mdash; calls <code>_shift()</code>","line":18,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":["1","2"],"cls":["",""]},{"t":"arr","id":"self.outbox","label":"self.outbox","v":[],"cls":[],"noidx":true}],"vars":[],"stack":["peek()","_shift()"]},{"caption":"<code>if not self.outbox:</code> &rarr; <strong>true</strong>","line":9,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":["1","2"],"cls":["",""]},{"t":"arr","id":"self.outbox","label":"self.outbox","v":[],"cls":[],"noidx":true}],"vars":[],"stack":["peek()","_shift()"]},{"caption":"<code>while self.inbox:</code> &rarr; <strong>true</strong>","line":10,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":["1","2"],"cls":["",""]},{"t":"arr","id":"self.outbox","label":"self.outbox","v":[],"cls":[],"noidx":true}],"vars":[],"stack":["peek()","_shift()"]},{"caption":"<code>self.outbox.append(self.inbox.pop())</code> &mdash; <code>2</code> popped off the end of <code>self.inbox</code>; <code>self.outbox</code> gets <code>2</code> appended <em>(reverses: oldest on top)</em>","line":11,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":["1"],"cls":[""]},{"t":"arr","id":"self.outbox","label":"self.outbox","v":["2"],"cls":["cur"]}],"vars":[],"stack":["peek()","_shift()"]},{"caption":"<code>while self.inbox:</code> &rarr; <strong>true</strong>","line":10,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":["1"],"cls":[""]},{"t":"arr","id":"self.outbox","label":"self.outbox","v":["2"],"cls":[""]}],"vars":[],"stack":["peek()","_shift()"]},{"caption":"<code>self.outbox.append(self.inbox.pop())</code> &mdash; <code>1</code> popped off the end of <code>self.inbox</code>; <code>self.outbox</code> gets <code>1</code> appended <em>(reverses: oldest on top)</em>","line":11,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.outbox","label":"self.outbox","v":["2","1"],"cls":["","cur"]}],"vars":[],"stack":["peek()","_shift()"]},{"caption":"<code>while self.inbox:</code> &rarr; <strong>false</strong> &mdash; <code>_shift</code> returns <code>None</code> to <code>peek</code>","line":10,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.outbox","label":"self.outbox","v":["2","1"],"cls":["",""]}],"vars":[],"stack":["peek()","_shift()"]},{"caption":"<code>return self.outbox[-1]</code> &mdash; returns <code>1</code>","line":19,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.outbox","label":"self.outbox","v":["2","1"],"cls":["",""]}],"vars":[],"stack":[]},{"caption":"<code>self._shift()</code> &mdash; calls <code>_shift()</code>","line":14,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.outbox","label":"self.outbox","v":["2","1"],"cls":["",""]}],"vars":[],"stack":["pop()","_shift()"]},{"caption":"<code>if not self.outbox:</code> &rarr; <strong>false</strong> &mdash; <code>_shift</code> returns <code>None</code> to <code>pop</code>","line":9,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.outbox","label":"self.outbox","v":["2","1"],"cls":["",""]}],"vars":[],"stack":["pop()","_shift()"]},{"caption":"<code>return self.outbox.pop()</code> &mdash; returns <code>1</code>; <code>1</code> popped off the end of <code>self.outbox</code>","line":15,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.outbox","label":"self.outbox","v":["2"],"cls":[""]}],"vars":[],"stack":[]},{"caption":"<code>return not self.inbox and not self.outbox</code> &mdash; returns <code>F</code>. <strong>Result: F</strong>","line":22,"panels":[{"t":"arr","id":"self.inbox","label":"self.inbox","v":[],"cls":[],"noidx":true},{"t":"arr","id":"self.outbox","label":"self.outbox","v":["2"],"cls":[""]}],"vars":[],"stack":[]}]}]}