{"chapters":[{"title":"Direct-address boolean array","code":"class MyHashSet:\n    def __init__(self):\n        self.present = [False] * (10 ** 6 + 1)\n\n    def add(self, key):\n        self.present[key] = True\n\n    def remove(self, key):\n        self.present[key] = False\n\n    def contains(self, key):\n        return self.present[key]","frames":[{"caption":"<strong>Direct-address boolean array</strong> &mdash; O(1) per operation time, O(key range) extra space. Running <code>s = MyHashSet(); s.add(1); s.add(2); assert s.contains(1) is True and s.contains(3) is False; s.add(2) …</code>. Step through to watch the code work on this input.","line":2,"panels":[{"t":"arr","id":"self","label":"self","v":["M","y","H","a","s","h","S","e","t"],"cls":["","","","","","","","",""]}],"vars":[["self","'MyHashSet'",0]],"stack":[]},{"caption":"<code>self.present = [False] * (10 ** 6 + 1)</code> &mdash; returns <code>None</code>; <code>self.present = [F, F, F, F, F, F, F, F, …]</code>","line":3,"panels":[],"vars":[["self.present","[F, F, F, F, F, F, F, F, …]",1]],"stack":[]},{"caption":"<code>self.present[key] = True</code> &mdash; returns <code>None</code>; <code>self.present[1]</code> becomes <code>T</code>; <code>key = 1</code>","line":6,"panels":[],"vars":[["self.present","[F, T, F, F, F, F, F, F, …]",1],["key","1",1]],"stack":[]},{"caption":"<code>self.present[key] = True</code> &mdash; returns <code>None</code>; <code>self.present[2]</code> becomes <code>T</code>; <code>key = 2</code>","line":6,"panels":[],"vars":[["self.present","[F, T, T, F, F, F, F, F, …]",1],["key","2",1]],"stack":[]},{"caption":"<code>return self.present[key]</code> &mdash; returns <code>T</code>; <code>key = 1</code>","line":12,"panels":[],"vars":[["self.present","[F, T, T, F, F, F, F, F, …]",0],["key","1",1]],"stack":[]},{"caption":"<code>return self.present[key]</code> &mdash; returns <code>F</code>; <code>key = 3</code>","line":12,"panels":[],"vars":[["self.present","[F, T, T, F, F, F, F, F, …]",0],["key","3",1]],"stack":[]},{"caption":"<code>self.present[key] = True</code> &mdash; returns <code>None</code>; <code>key = 2</code>","line":6,"panels":[],"vars":[["self.present","[F, T, T, F, F, F, F, F, …]",0],["key","2",1]],"stack":[]},{"caption":"<code>return self.present[key]</code> &mdash; returns <code>T</code>","line":12,"panels":[],"vars":[["self.present","[F, T, T, F, F, F, F, F, …]",0],["key","2",0]],"stack":[]},{"caption":"<code>self.present[key] = False</code> &mdash; returns <code>None</code>; <code>self.present[2]</code> becomes <code>F</code>","line":9,"panels":[],"vars":[["self.present","[F, T, F, F, F, F, F, F, …]",1],["key","2",0]],"stack":[]},{"caption":"<code>return self.present[key]</code> &mdash; returns <code>F</code>. <strong>Result: F</strong>","line":12,"panels":[],"vars":[["self.present","[F, T, F, F, F, F, F, F, …]",0],["key","2",0]],"stack":[]}]},{"title":"Separate chaining with buckets","code":"class MyHashSet:\n    B = 10007                                   # a prime bucket count\n\n    def __init__(self):\n        self.buckets = [[] for _ in range(self.B)]\n\n    def _bucket(self, key):\n        return self.buckets[key % self.B]\n\n    def add(self, key):\n        b = self._bucket(key)\n        if key not in b:\n            b.append(key)\n\n    def remove(self, key):\n        b = self._bucket(key)\n        if key in b:\n            b.remove(key)\n\n    def contains(self, key):\n        return key in self._bucket(key)","frames":[{"caption":"<strong>Separate chaining with buckets</strong> &mdash; O(1) average, O(n) worst time, O(buckets + n) extra space. Running <code>s.add(1); s.add(2); assert s.contains(1) is True and s.contains(3) is False; s.add(2); assert s.contains(2) is True …</code>. Step through to watch the code work on this input.","line":10,"panels":[],"vars":[["self.buckets","[[], [], [], [], [], [], [], [], …]",0],["key","1",0]],"stack":[]},{"caption":"<code>b = self._bucket(key)</code> &mdash; calls <code>_bucket(key=1)</code>","line":11,"panels":[],"vars":[["self.buckets","[[], [], [], [], [], [], [], [], …]",0],["key","1",0]],"stack":["add(key=1)","_bucket(key=1)"]},{"caption":"<code>return self.buckets[key % self.B]</code> &mdash; <code>_bucket</code> returns <code>[]</code> to <code>add</code>","line":8,"panels":[],"vars":[["self.buckets","[[], [], [], [], [], [], [], [], …]",0],["key","1",0]],"stack":["add(key=1)","_bucket(key=1)"]},{"caption":"<code>if key not in b:</code> &rarr; <strong>true</strong> (key = 1) &mdash; <code>b = []</code>","line":12,"panels":[{"t":"arr","id":"b","label":"b","v":[],"cls":[],"noidx":true}],"vars":[["self.buckets","[[], [], [], [], [], [], [], [], …]",0],["key","1",0]],"stack":[]},{"caption":"<code>b.append(key)</code> &mdash; returns <code>None</code>; <code>self.buckets[1]</code> becomes <code>[1]</code>; <code>b</code> gets <code>1</code> appended","line":13,"panels":[{"t":"arr","id":"b","label":"b","v":["1"],"cls":["cur"]}],"vars":[["self.buckets","[[], [1], [], [], [], [], [], [], …]",1],["key","1",0]],"stack":[]},{"caption":"<code>b = self._bucket(key)</code> &mdash; calls <code>_bucket(key=2)</code>","line":11,"panels":[],"vars":[["self.buckets","[[], [1], [], [], [], [], [], [], …]",0],["key","2",1]],"stack":["add(key=2)","_bucket(key=2)"]},{"caption":"<code>return self.buckets[key % self.B]</code> &mdash; <code>_bucket</code> returns <code>[]</code> to <code>add</code>","line":8,"panels":[],"vars":[["self.buckets","[[], [1], [], [], [], [], [], [], …]",0],["key","2",0]],"stack":["add(key=2)","_bucket(key=2)"]},{"caption":"<code>if key not in b:</code> &rarr; <strong>true</strong> (key = 2) &mdash; <code>b = []</code>","line":12,"panels":[{"t":"arr","id":"b","label":"b","v":[],"cls":[],"noidx":true}],"vars":[["self.buckets","[[], [1], [], [], [], [], [], [], …]",0],["key","2",0]],"stack":[]},{"caption":"<code>b.append(key)</code> &mdash; returns <code>None</code>; <code>self.buckets[2]</code> becomes <code>[2]</code>; <code>b</code> gets <code>2</code> appended","line":13,"panels":[{"t":"arr","id":"b","label":"b","v":["2"],"cls":["cur"]}],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",1],["key","2",0]],"stack":[]},{"caption":"<code>return key in self._bucket(key)</code> &mdash; calls <code>_bucket(key=1)</code>","line":21,"panels":[],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","1",1]],"stack":["contains(key=1)","_bucket(key=1)"]},{"caption":"<code>return self.buckets[key % self.B]</code> &mdash; <code>_bucket</code> returns <code>[1]</code> to <code>contains</code>","line":8,"panels":[],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","1",0]],"stack":["contains(key=1)","_bucket(key=1)"]},{"caption":"<code>return key in self._bucket(key)</code> &mdash; calls <code>_bucket(key=3)</code>","line":21,"panels":[],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","3",1]],"stack":["contains(key=3)","_bucket(key=3)"]},{"caption":"<code>return self.buckets[key % self.B]</code> &mdash; <code>_bucket</code> returns <code>[]</code> to <code>contains</code>","line":8,"panels":[],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","3",0]],"stack":["contains(key=3)","_bucket(key=3)"]},{"caption":"<code>b = self._bucket(key)</code> &mdash; calls <code>_bucket(key=2)</code>","line":11,"panels":[],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","2",1]],"stack":["add(key=2)","_bucket(key=2)"]},{"caption":"<code>return self.buckets[key % self.B]</code> &mdash; <code>_bucket</code> returns <code>[2]</code> to <code>add</code>","line":8,"panels":[],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","2",0]],"stack":["add(key=2)","_bucket(key=2)"]},{"caption":"<code>if key not in b:</code> &rarr; <strong>false</strong> (key = 2) &mdash; returns <code>None</code>; <code>b = [2]</code>","line":12,"panels":[{"t":"arr","id":"b","label":"b","v":["2"],"cls":[""]}],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","2",0]],"stack":[]},{"caption":"<code>return key in self._bucket(key)</code> &mdash; calls <code>_bucket(key=2)</code>","line":21,"panels":[],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","2",0]],"stack":["contains(key=2)","_bucket(key=2)"]},{"caption":"<code>return self.buckets[key % self.B]</code> &mdash; <code>_bucket</code> returns <code>[2]</code> to <code>contains</code>","line":8,"panels":[],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","2",0]],"stack":["contains(key=2)","_bucket(key=2)"]},{"caption":"<code>b = self._bucket(key)</code> &mdash; calls <code>_bucket(key=2)</code>","line":16,"panels":[],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","2",0]],"stack":["remove(key=2)","_bucket(key=2)"]},{"caption":"<code>return self.buckets[key % self.B]</code> &mdash; <code>_bucket</code> returns <code>[2]</code> to <code>remove</code>","line":8,"panels":[],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","2",0]],"stack":["remove(key=2)","_bucket(key=2)"]},{"caption":"<code>if key in b:</code> &rarr; <strong>true</strong> (key = 2) &mdash; <code>b = [2]</code>","line":17,"panels":[{"t":"arr","id":"b","label":"b","v":["2"],"cls":[""]}],"vars":[["self.buckets","[[], [1], [2], [], [], [], [], [], …]",0],["key","2",0]],"stack":[]},{"caption":"<code>b.remove(key)</code> &mdash; returns <code>None</code>; <code>self.buckets[2]</code> becomes <code>[]</code>; <code>2</code> popped off the end of <code>b</code>","line":18,"panels":[{"t":"arr","id":"b","label":"b","v":[],"cls":[],"noidx":true}],"vars":[["self.buckets","[[], [1], [], [], [], [], [], [], …]",1],["key","2",0]],"stack":[]},{"caption":"<code>return key in self._bucket(key)</code> &mdash; calls <code>_bucket(key=2)</code>","line":21,"panels":[],"vars":[["self.buckets","[[], [1], [], [], [], [], [], [], …]",0],["key","2",0]],"stack":["contains(key=2)","_bucket(key=2)"]},{"caption":"<code>return self.buckets[key % self.B]</code> &mdash; <code>_bucket</code> returns <code>[]</code> to <code>contains</code>. <strong>Result: F</strong>","line":8,"panels":[],"vars":[["self.buckets","[[], [1], [], [], [], [], [], [], …]",0],["key","2",0]],"stack":["contains(key=2)","_bucket(key=2)"]}]}]}