{"chapters":[{"title":"Backtracking with a start index","code":"def subsets(nums):\n    out, path = [], []\n\n    def dfs(start):\n        out.append(path[:])                   # every node is an answer\n        for i in range(start, len(nums)):\n            path.append(nums[i])\n            dfs(i + 1)                        # only later elements from here on\n            path.pop()\n\n    dfs(0)\n    return out","frames":[{"caption":"<strong>Backtracking with a start index</strong> &mdash; O(n &middot; 2<sup>n</sup>) time, O(n) extra space. Input: <code>subsets(nums=[1, 2, 3])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>out, path = [], []</code> &mdash; <code>out = []</code>; <code>path = []</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>def dfs(start):</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3"],"cls":["","",""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[],"stack":[]},{"caption":"<code>dfs(0)</code> &mdash; calls <code>dfs(start=0)</code>","line":11,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2","3"],"cls":["src","",""],"ptr":{"0":["start"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["start","0",1]],"stack":["subsets(nums)","dfs(start=0)"]},{"caption":"<code>out.append(path[:])</code> &mdash; <code>out</code> gets <code>[]</code> appended <em>(every node is an answer)</em>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["1","2