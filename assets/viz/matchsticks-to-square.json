1","2","2","2"],"cls":["","","","",""]},{"t":"arr","id":"sides","label":"sides","v":["2","2","2","2"],"cls":["","","src",""],"ptr":{"2":["k"]}},{"t":"arr","id":"sticks","label":"sticks","v":["2","2","2","1","1"],"cls":["","","src","",""],"ptr":{"2":["i"]}},{"t":"arr","id":"tried","label":"tried (set)","v":["0"],"cls":[""],"noidx":true}],"vars":[["total","8",0],["side","2",0],["i","2",1],["k","2",1]],"stack":["makesquare(matchsticks)","dfs(i=0)","dfs(i=1)","dfs(i=2)"]},{"caption":"<code>return True</code> &mdash; <code>dfs</code> returns <code>T</code> to <code>dfs</code>; <code>i = 1</code>; <code>k = 1</code>","line":20,"panels":[{"t":"arr","id":"matchsticks","label":"matchsticks","v":["1","1","2","2","2"],"cls":["","","","",""]},{"t":"arr","id":"sides","label":"sides","v":["2","2","2","2"],"cls":["","src","",""],"ptr":{"1":["k"]}},{"t":"arr","id":"sticks","label":"sticks","v":["2","2","2","1","1"],"cls":["","src","","",""],"ptr":{"1":["i"]}},{"t":"arr","id":"tried","label":"tried (set)","v":["0"],"cls":[""],"noidx":true}],"vars":[["total","8",0],["side","2",0],["i","1",1],["k","1",1]],"stack":["makesquare(matchsticks)","dfs(i=0)","dfs(i=1)"]},{"caption":"<code>return True</code> &mdash; <code>dfs</code> returns <code>T</code> to <code>makesquare</code>; <code>i = 0</code>; <code>k = 0</code>. <strong>Result: T</strong>","line":20,"panels":[{"t":"arr","id":"matchsticks","label":"matchsticks","v":["1","1","2","2","2"],"cls":["","","","",""]},{"t":"arr","id":"sides","label":"sides","v":["2","2","2","2"],"cls":["src","","",""],"ptr":{"0":["k"]}},{"t":"arr","id":"sticks","label":"sticks","v":["2","2","2","1","1"],"cls":["src","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"tried","label":"tried (set)","v":["0"],"cls":[""],"noidx":true}],"vars":[["total","8",0],["side","2",0],["i","0",1],["k","0",1]],"stack":["makesquare(matchsticks)","dfs(i=0)"]}],"example":1},{"title":"Bitmask DP over used sticks","code":"def makesquare(matchsticks):\n    total, n = sum(matchsticks), len(matchsticks)\n    if n < 4 or total % 4:\n        return False\n    side = total // 4\n    fill = [-1] * (1 << n)          # fill of the current side, -1 = unreachable\n    fill[0] = 0\n    for mask in range(1 << n):\n        if fill[mask] < 0:\n            continue\n        for i in range(n):\n            if not mask >> i & 1 and fill[mask] + matchsticks[i] <= side:\n                fill[mask | 1 << i] = (fill[mask] + matchsticks[i]) % side\n    return fill[-1] == 0","frames":[{"caption":"<strong>Bitmask DP over used sticks</strong> &mdash; O(n &middot; 2<sup>n</sup>) time, O(2<sup>n</sup>) extra space. Input: <code>makesquare(matchsticks=[1, 1, 1])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"matchsticks","label":"matchsticks","v":["1","1","1"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>total, n = sum(matchsticks), len(matchsticks)</code> &mdash; <code>total = 3</code>; <code>n = 3</code>","line":2,"panels":[{"t":"arr","id":"matchsticks","label":"matchsticks","v":["1","1","1"],"cls":["","",""]}],"vars":[["total","3",1],["n","3",1]],"stack":[]},{"caption":"<code>if n &lt; 4 or total % 4:</code> &rarr; <strong>true</strong> (n = 3, total = 3)","line":3,"panels":[{"t":"arr","id":"matchsticks","label":"matchsticks","v":["1","1","1"],"cls":["","",""]}],"vars":[["total","3",0],["n","3",0]],"stack":[]},{"caption":"<code>return False</code> &mdash; returns <code>F</code>. <strong>Result: F</strong>","line":4,"panels":[{"t":"arr","id":"matchsticks","label":"matchsticks","v":["1","1","1"],"cls":["","",""]}],"vars":[["total","3",0],["n","3",0]],"stack":[]}]}]}