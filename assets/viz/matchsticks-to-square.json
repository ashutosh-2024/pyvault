{"chapters":[{"title":"Fill four sides, longest sticks first","code":"def makesquare(matchsticks):\n    total = sum(matchsticks)\n    if len(matchsticks) < 4 or total % 4:\n        return False\n    side = total // 4\n    sticks = sorted(matchsticks, reverse=True)       # hardest first\n    if sticks[0] > side:\n        return False\n    sides = [0] * 4\n\n    def dfs(i):\n        if i == len(sticks):\n            return True\n        tried = set()\n        for k in range(4):\n            if sides[k] + sticks[i] <= side and sides[k] not in tried:\n                tried.add(sides[k])                   # equal sides are interchangeable\n                sides[k] += sticks[i]\n                if dfs(i + 1):\n                    return True\n                sides[k] -= sticks[i]\n        return False\n\n    return dfs(0)","frames":[{"caption":"<strong>Fill four sides, longest sticks first</strong> &mdash; O(4<sup>n</sup>) worst time, O(n) extra space. Input: <code>makesquare(matchsticks=[1, 1, 2, 2, 2])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"matchsticks","label":"matchsticks","v":["1","1","2","2","2"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>total = sum(matchsticks)</code> &mdash; <code>total = 8</code>","line":2,"panels":[{"t":"arr","id":"matchsticks","label":"matchsticks","v":["1","1","2","2","2"],"cls":["","","","",""]}],"vars":[["total","8",1]],"stack":[]},{"caption":"<code>if len(matchsticks) &lt; 4 or total % 4:</code> &rarr; <strong>false</strong> (total = 8)","line":3,"panels":[{"t":"arr","id":"matchsticks","label":"matchsticks","v":["1","1","2","2","2"],"cls":["","","","",""]}],"vars":[["total","8",0]],"stack":[]},{"caption":"<code>side = total // 4</code> &mdash; <code>side = 2</code>","line":5,"panels":[{"t":"arr","id":"matchsticks","label":"matchsticks","v":["1","1","2","2","2"],"cls":["","","","",""]}],"vars":[["total","8",0],["side","2",1]],"stack":[]},{"caption":"<code>sticks 