{"chapters":[{"title":"Min-heap of one cursor per array","code":"def merge_k_arrays(arrays):\n    heap = [(a[0], i, 0) for i, a in enumerate(arrays) if a]\n    heapq.heapify(heap)\n\n    out = []\n    while heap:\n        value, which, idx = heapq.heappop(heap)\n        out.append(value)\n        if idx + 1 < len(arrays[which]):\n            heapq.heappush(heap, (arrays[which][idx + 1], which, idx + 1))\n    return out","frames":[{"caption":"<strong>Min-heap of one cursor per array</strong> &mdash; O(N log k) time, O(k) extra space. Input: <code>merge_k_arrays(arrays=[[1, 4, 5], [1, 3, 4], [2, 6]])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"arrays","label":"arrays","v":["1,4,5","1,3,4","2,6"],"cls":["","",""]}],"vars":[],"stack":[]},{"caption":"<code>heap = [(a[0], i, 0) for i, a in enumerate(arrays) if a]</code> &mdash; <code>i = 0</code>; <code>a = [1, 4, 5]</code>","line":2,"panels":[{"t":"arr","id":"arrays","label":"arrays","v":["1,4,5","1,3,4","2,6"],"cls":["src","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"a","label":"a","v":["1","4","5"],"cls":["","",""]}],"vars":[["i","0",1]],"stack":[]},{"caption":"<code>heap = [(a[0], i, 0) for i, a in enumerate(arrays) if a]</code> &mdash; <code>i = 1</code>; <code>a</code> is now <code>[1, 3, 4]</code>","line":2,"panels":[{"t":"arr","id":"arrays","label":"arrays","v":["1,4,5","1,3,4","2,6"],"cls":["","src",""],"ptr":{"1":["i"]}},{"t":"arr","id":"a","label":"a","v":["1","3","4"],"cls":["","cur","cur"]}],"vars":[["i","1",1]],"stack":[]},{"caption":"<code>heap = [(a[0], i, 0) for i, a in enumerate(arrays) if a]</code> &mdash; <code>i = 2</code>; <code>a</code> is now <code>[2, 6]</code>","line":2,"panels":[{"t":"arr","id":"arrays","label":"arrays","v":["1,4,5","1,3,4","2,6"],"cls":["","","src"],"ptr":{"2":["i"]}},{"t":"arr","id":"a","label":"a","v":["2","6"],"cls":["cur","cur"]}],"vars":[["i","2",1]],"stack":[]},{"caption":"<code>heap = [(a[0], i, 0) for i, a in enumerate(a