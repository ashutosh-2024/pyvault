{"chapters":[{"title":"DP: fewest jumps to each index","code":"def jump(nums):\n    n = len(nums)\n    jumps = [0] + [float(\"inf\")] * (n - 1)\n    for i in range(n):\n        for j in range(i + 1, min(n, i + nums[i] + 1)):\n            jumps[j] = min(jumps[j], jumps[i] + 1)\n    return jumps[-1]","frames":[{"caption":"<strong>DP: fewest jumps to each index</strong> &mdash; O(n&sup2;) time, O(n) extra space. Input: <code>jump(nums=[2, 3, 1, 1, 4])</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","3","1","1","4"],"cls":["","","","",""]}],"vars":[],"stack":[]},{"caption":"<code>n = len(nums)</code> &mdash; <code>n = 5</code>","line":2,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","3","1","1","4"],"cls":["","","","",""]}],"vars":[["n","5",1]],"stack":[]},{"caption":"<code>jumps = [0] + [float(\"inf\")] * (n - 1)</code> &mdash; <code>jumps = [0, ∞, ∞, ∞, ∞]</code>","line":3,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","3","1","1","4"],"cls":["","","","",""]},{"t":"arr","id":"jumps","label":"jumps","v":["0","∞","∞","∞","∞"],"cls":["","","","",""]}],"vars":[["n","5",0]],"stack":[]},{"caption":"<code>for i in range(n):</code> &mdash; <code>i = 0</code>","line":4,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","3","1","1","4"],"cls":["src","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"jumps","label":"jumps","v":["0","∞","∞","∞","∞"],"cls":["src","","","",""],"ptr":{"0":["i"]}}],"vars":[["n","5",0],["i","0",1]],"stack":[]},{"caption":"<code>for j in range(i + 1, min(n, i + nums[i] + 1)):</code> &mdash; <code>j = 1</code>","line":5,"panels":[{"t":"arr","id":"nums","label":"nums","v":["2","3","1","1","4"],"cls":["src","","","",""],"ptr":{"0":["i"]}},{"t":"arr","id":"jumps","label":"jumps","v":["0","∞","∞","∞","∞"],"cls":["src","src","","",""],"ptr":{"0":["i"],"1":["j"]}}],"vars":[["n","5",0],["i","0",0],["j","1",1]],"stack":[]},{"caption":"<code>jumps[j] = min(jumps