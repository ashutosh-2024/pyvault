{"chapters":[{"title":"Sorted candidates, recurse on the same index, break early","code":"def combination_sum(candidates, target):\n    candidates = sorted(candidates)\n    out, path = [], []\n\n    def dfs(start, remaining):\n        if remaining == 0:\n            out.append(path[:])\n            return\n        for i in range(start, len(candidates)):\n            c = candidates[i]\n            if c > remaining:\n                break                          # sorted: everything after is bigger\n            path.append(c)\n            dfs(i, remaining - c)              # i, not i + 1: reuse allowed\n            path.pop()\n\n    dfs(0, target)\n    return out","frames":[{"caption":"<strong>Sorted candidates, recurse on the same index, break early</strong> &mdash; O(N<sup>T/m + 1</sup>) time, O(T/m) extra space. Input: <code>combination_sum(candidates=[4, 6], target=9)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>candidates = sorted(candidates)</code> &mdash; <code>candidates</code> is now <code>[4, 6]</code>","line":2,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["",""]}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>out, path = [], []</code> &mdash; <code>out = []</code>; <code>path = []</code>","line":3,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["",""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>def dfs(start, remaining):</code>","line":5,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["",""]},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["target","9",0]],"stack":[]},{"caption":"<code>dfs(0, target)</code> &mdash; calls <code>dfs(start=0, remaining=9)</code>","line":17,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["src",""],"ptr":{"0":["start"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["target","9",0],["start","0",1],["remaining","9",1]],"stack":["combination_sum(candidates, target=9)","dfs(start=0, remaining=9)"]},{"caption":"<code>if remaining == 0:</code> &rarr; <strong>false</strong> (remaining = 9)","line":6,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["src",""],"ptr":{"0":["start"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["target","9",0],["start","0",0],["remaining","9",0]],"stack":["combination_sum(candidates, target=9)","dfs(start=0, remaining=9)"]},{"caption":"<code>for i in range(start, len(candidates)):</code> &mdash; <code>i = 0</code>","line":9,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["src",""],"ptr":{"0":["i","start"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["target","9",0],["start","0",0],["remaining","9",0],["i","0",1]],"stack":["combination_sum(candidates, target=9)","dfs(start=0, remaining=9)"]},{"caption":"<code>c = candidates[i]</code> &mdash; <code>c = 4</code>","line":10,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["src",""],"ptr":{"0":["i","start"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["target","9",0],["start","0",0],["remaining","9",0],["i","0",0],["c","4",1]],"stack":["combination_sum(candidates, target=9)","dfs(start=0, remaining=9)"]},{"caption":"<code>if c &gt; remaining:</code> &rarr; <strong>false</strong> (c = 4, remaining = 9)","line":11,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["src",""],"ptr":{"0":["i","start"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["target","9",0],["start","0",0],["remaining","9",0],["i","0",0],["c","4",0]],"stack":["combination_sum(candidates, target=9)","dfs(start=0, remaining=9)"]},{"caption":"<code>path.append(c)</code> &mdash; <code>path</code> gets <code>4</code> appended","line":13,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["src",""],"ptr":{"0":["i","start"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":["4"],"cls":["cur"]}],"vars":[["target","9",0],["start","0",0],["remaining","9",0],["i","0",0],["c","4",0]],"stack":["combination_sum(candidates, target=9)","dfs(start=0, remaining=9)"]},{"caption":"<code>dfs(i, remaining - c)</code> &mdash; calls <code>dfs(start=0, remaining=5)</code> <em>(i, not i + 1: reuse allowed)</em>","line":14,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["src",""],"ptr":{"0":["i","start"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":["4"],"cls":[""]}],"vars":[["target","9",0],["start","0",0],["remaining","5",1],["i","0",0],["c","4",0]],"stack":["combination_sum(candidates, target=9)","dfs(start=0, remaining=9)","dfs(start=0, remaining=5)"]},{"caption":"<code>if remaining == 0:</code> &rarr; <strong>false</strong> (remaining = 5)","line":6,"panels":[{"t":"arr","id":"candidates","label":"candidates","v":["4","6"],"cls":["src",""],"ptr":{"0":["i","start"]}},{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":["4"],"cls":[""]}],