{"chapters":[{"title":"Reverse inorder with a running sum","code":"def convert_bst(root):\n    running = 0\n\n    def walk(node):\n        nonlocal running\n        if node is None:\n            return\n        walk(node.right)\n        running += node.val\n        node.val = running\n        walk(node.left)\n\n    walk(root)\n    return root","frames":[{"caption":"<strong>Reverse inorder with a running sum</strong> &mdash; O(n) time, O(h) extra space. Input: <code>convert_bst(root=tree (3))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427821968","1",0.0,1.25,"",[]],["n4427918400","2",1.0,2.5,"",[]],["n4428050320","3",2.0,0.0,"cur",["root"]],["n4427823248","4",3.0,1.25,"",[]]],"edges":[["n4428050320","n4427821968","",""],["n4427821968","n4427918400","",""],["n4428050320","n4427823248","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>running = 0</code> &mdash; <code>running = 0</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427821968","1",0.0,1.25,"",[]],["n4427918400","2",1.0,2.5,"",[]],["n4428050320","3",2.0,0.0,"cur",["root"]],["n4427823248","4",3.0,1.25,"",[]]],"edges":[["n4428050320","n4427821968","",""],["n4427821968","n4427918400","",""],["n4428050320","n4427823248","",""]],"dir":false}],"vars":[["running","0",1]],"stack":[]},{"caption":"<code>def walk(node):</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427821968","1",0.0,1.25,"",[]],["n4427918400","2",1.0,2.5,"",[]],["n4428050320","3",2.0,0.0,"cur",["root"]],["n4427823248","4",3.0,1.25,"",[]]],"edges":[["n4428050320","n4427821968","",""],["n4427821968","n4427918400","",""],["n4428050320","n4427823248","",""]],"dir":false}],"vars":[["running","0",0]],"stack":[]},{"caption":"<code>walk(root)</code> &mdash; calls <code>walk(node=(3))</code>","line":13,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427821968","1",0.0,1.25,"",[]],["n4427