            succ = succ.left\n        if succ.left is None:\n            succ.left = node                 # thread back, go right first\n            node = node.right\n        else:\n            succ.left = None\n            running += node.val\n            node.val = running\n            node = node.left\n    return root","frames":[{"caption":"<strong>Reverse Morris traversal</strong> &mdash; O(n) time, O(1) extra space. Input: <code>convert_bst(root=tree (3))</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427821968","1",0.0,1.25,"",[]],["n4427919920","2",1.0,2.5,"",[]],["n4428050320","3",2.0,0.0,"cur",["root"]],["n4427813648","4",3.0,1.25,"",[]]],"edges":[["n4428050320","n4427821968","",""],["n4427821968","n4427919920","",""],["n4428050320","n4427813648","",""]],"dir":false}],"vars":[],"stack":[]},{"caption":"<code>running, node = 0, root</code> &mdash; <code>running = 0</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427821968","1",0.0,1.25,"",[]],["n4427919920","2",1.0,2.5,"",[]],["n4428050320","3",2.0,0.0,"cur",["root","node"]],["n4427813648","4",3.0,1.25,"",[]]],"edges":[["n4428050320","n4427821968","",""],["n4427821968","n4427919920","",""],["n4428050320","n4427813648","",""]],"dir":false}],"vars":[["running","0",1]],"stack":[]},{"caption":"<code>while node is not None:</code> &rarr; <strong>true</strong>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427821968","1",0.0,1.25,"",[]],["n4427919920","2",1.0,2.5,"",[]],["n4428050320","3",2.0,0.0,"cur",["root","node"]],["n4427813648","4",3.0,1.25,"",[]]],"edges":[["n4428050320","n4427821968","",""],["n4427821968","n4427919920","",""],["n4428050320","n4427813648","",""]],"dir":false}],"vars":[["running","0",0]],"stack":[]},{"caption":"<code>if node.right is None:</code> &rarr; <strong>false</strong>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n44278219