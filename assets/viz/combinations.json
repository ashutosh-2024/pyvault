{"chapters":[{"title":"Backtracking with an upper bound on the next choice","code":"def combine(n, k):\n    out, path = [], []\n\n    def dfs(start):\n        if len(path) == k:\n            out.append(path[:])\n            return\n        last = n - (k - len(path)) + 1         # leave room for the rest\n        for v in range(start, last + 1):\n            path.append(v)\n            dfs(v + 1)\n            path.pop()\n\n    dfs(1)\n    return out","frames":[{"caption":"<strong>Backtracking with an upper bound on the next choice</strong> &mdash; O(k &middot; C(n, k)) time, O(k) extra space. Input: <code>combine(n=4, k=2)</code>. Step through to watch the code work on this input.","line":1,"panels":[],"vars":[["n","4",0],["k","2",0]],"stack":[]},{"caption":"<code>out, path = [], []</code> &mdash; <code>out = []</code>; <code>path = []</code>","line":2,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","4",0],["k","2",0]],"stack":[]},{"caption":"<code>def dfs(start):</code>","line":4,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","4",0],["k","2",0]],"stack":[]},{"caption":"<code>dfs(1)</code> &mdash; calls <code>dfs(start=1)</code>","line":14,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","4",0],["k","2",0],["start","1",1]],"stack":["combine(n=4, k=2)","dfs(start=1)"]},{"caption":"<code>if len(path) == k:</code> &rarr; <strong>false</strong> (k = 2)","line":5,"panels":[{"t":"arr","id":"out","label":"out","v":[],"cls":[],"noidx":true},{"t":"arr","id":"path","label":"path","v":[],"cls":[],"noidx":true}],"vars":[["n","4",0],["k","2",0],["start","1",0]],"stack":["combine(n=4, k=2)","dfs(start=1)"]},{"caption":"<code>last = n - (k - len(path)) + 1</