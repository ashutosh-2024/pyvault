) and first[i] == last[i]:</code> &rarr; <strong>false</strong> (first = 'flight', i = 2, last = 'flower')","line":4,"panels":[{"t":"arr","id":"strs","label":"strs","v":["flower","flow","flight"],"cls":["","",""]},{"t":"arr","id":"first","label":"first","v":["f","l","i","g","h","t"],"cls":["","","src","","",""],"ptr":{"2":["i"]}},{"t":"arr","id":"last","label":"last","v":["f","l","o","w","e","r"],"cls":["","","src","","",""],"ptr":{"2":["i"]}}],"vars":[["first","'flight'",0],["last","'flower'",0],["i","2",0]],"stack":[]},{"caption":"<code>return first[:i]</code> &mdash; returns <code>'fl'</code>. <strong>Result: 'fl'</strong>","line":6,"panels":[{"t":"arr","id":"strs","label":"strs","v":["flower","flow","flight"],"cls":["","",""]},{"t":"arr","id":"first","label":"first","v":["f","l","i","g","h","t"],"cls":["","","src","","",""],"ptr":{"2":["i"]}},{"t":"arr","id":"last","label":"last","v":["f","l","o","w","e","r"],"cls":["","","src","","",""],"ptr":{"2":["i"]}}],"vars":[["first","'flight'",0],["last","'flower'",0],["i","2",0]],"stack":[]}],"example":1}]}