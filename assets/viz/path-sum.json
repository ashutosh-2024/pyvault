{"chapters":[{"title":"Recursive, subtracting as you go","code":"def has_path_sum(root, target):\n    if root is None:\n        return False\n    target -= root.val\n    if root.left is None and root.right is None:\n        return target == 0                 # only leaves end a path\n    return has_path_sum(root.left, target) or has_path_sum(root.right, target)","frames":[{"caption":"<strong>Recursive, subtracting as you go</strong> &mdash; O(n) time, O(h) extra space. Input: <code>has_path_sum(root=tree (1), target=7)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427017584","4",0.0,2.5,"",[]],["n4426912528","2",1.0,1.25,"",[]],["n4427150208","1",2.0,0.0,"cur",["root"]],["n4426920528","3",3.0,1.25,"",[]]],"edges":[["n4427150208","n4426912528","",""],["n4426912528","n4427017584","",""],["n4427150208","n4426920528","",""]],"dir":false}],"vars":[["target","7",0]],"stack":[]},{"caption":"<code>if root is None:</code> &rarr; <strong>false</strong>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427017584","4",0.0,2.5,"",[]],["n4426912528","2",1.0,1.25,"",[]],["n4427150208","1",2.0,0.0,"cur",["root"]],["n4426920528","3",3.0,1.25,"",[]]],"edges":[["n4427150208","n4426912528","",""],["n4426912528","n4427017584","",""],["n4427150208","n4426920528","",""]],"dir":false}],"vars":[["target","7",0]],"stack":[]},{"caption":"<code>target -= root.val</code> &mdash; <code>target = 6</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427017584","4",0.0,2.5,"",[]],["n4426912528","2",1.0,1.25,"",[]],["n4427150208","1",2.0,0.0,"cur",["root"]],["n4426920528","3",3.0,1.25,"",[]]],"edges":[["n4427150208","n4426912528","",""],["n4426912528","n4427017584","",""],["n4427150208","n4426920528","",""]],"dir":false}],"vars":[["target","6",1]],"stack":[]},{"caption":"<code>if root.left is None and root.right is None:</code> &rarr; <strong>false</strong>","line":5,