["n4427017584","4",0.0,2.5,"cur",["root"]],["n4426912528","2",1.0,1.25,"stack",[]],["n4427150208","1",2.0,0.0,"stack",[]],["n4426920528","3",3.0,1.25,"",[]]],"edges":[["n4427150208","n4426912528","",""],["n4426912528","n4427017584","",""],["n4427150208","n4426920528","",""]],"dir":false}],"vars":[["target","0",1]],"stack":["has_path_sum(root=(1), target=6)","has_path_sum(root=(2), target=4)","has_path_sum(root=(4), target=0)"]},{"caption":"<code>if root.left is None and root.right is None:</code> &rarr; <strong>true</strong>","line":5,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427017584","4",0.0,2.5,"cur",["root"]],["n4426912528","2",1.0,1.25,"stack",[]],["n4427150208","1",2.0,0.0,"stack",[]],["n4426920528","3",3.0,1.25,"",[]]],"edges":[["n4427150208","n4426912528","",""],["n4426912528","n4427017584","",""],["n4427150208","n4426920528","",""]],"dir":false}],"vars":[["target","0",0]],"stack":["has_path_sum(root=(1), target=6)","has_path_sum(root=(2), target=4)","has_path_sum(root=(4), target=0)"]},{"caption":"<code>return target == 0</code> &mdash; <code>has_path_sum</code> returns <code>T</code> to <code>has_path_sum</code> <em>(only leaves end a path)</em>. <strong>Result: T</strong>","line":6,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427017584","4",0.0,2.5,"cur",["root"]],["n4426912528","2",1.0,1.25,"stack",[]],["n4427150208","1",2.0,0.0,"stack",[]],["n4426920528","3",3.0,1.25,"",[]]],"edges":[["n4427150208","n4426912528","",""],["n4426912528","n4427017584","",""],["n4427150208","n4426920528","",""]],"dir":false}],"vars":[["target","0",0]],"stack":["has_path_sum(root=(1), target=6)","has_path_sum(root=(2), target=4)","has_path_sum(root=(4), target=0)"]}],"example":1},{"title":"Iterative DFS with running sums","code":"def has_path_sum(root, target):\n    stack = [(root, 0)] if root else []\n    while stack:\n        node, total = stack.pop()\n        total += node.val\n        if node.left is None and node.right is None and total == target:\n            return True\n        for child in (node.left, node.right):\n            if child is not None:\n                stack.append((child, total))\n    return False","frames":[{"caption":"<strong>Iterative DFS with running sums</strong> &mdash; O(n) time, O(h) extra space. Input: <code>has_path_sum(root=tree (1), target=7)</code>. Step through to watch the code work on this input.","line":1,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427016976","4",0.0,2.5,"",[]],["n4426912528","2",1.0,1.25,"",[]],["n4427151552","1",2.0,0.0,"cur",["root"]],["n4426918288","3",3.0,1.25,"",[]]],"edges":[["n4427151552","n4426912528","",""],["n4426912528","n4427016976","",""],["n4427151552","n4426918288","",""]],"dir":false}],"vars":[["target","7",0]],"stack":[]},{"caption":"<code>stack = [(root, 0)] if root else []</code> &mdash; <code>stack = [((1), 0)]</code>","line":2,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427016976","4",0.0,2.5,"",[]],["n4426912528","2",1.0,1.25,"",[]],["n4427151552","1",2.0,0.0,"cur",["root"]],["n4426918288","3",3.0,1.25,"",[]]],"edges":[["n4427151552","n4426912528","",""],["n4426912528","n4427016976","",""],["n4427151552","n4426918288","",""]],"dir":false},{"t":"arr","id":"stack","label":"stack","v":["((1), 0)"],"cls":[""]}],"vars":[["target","7",0]],"stack":[]},{"caption":"<code>while stack:</code> &rarr; <strong>true</strong>","line":3,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427016976","4",0.0,2.5,"",[]],["n4426912528","2",1.0,1.25,"",[]],["n4427151552","1",2.0,0.0,"cur",["root"]],["n4426918288","3",3.0,1.25,"",[]]],"edges":[["n4427151552","n4426912528","",""],["n4426912528","n4427016976","",""],["n4427151552","n4426918288","",""]],"dir":false},{"t":"arr","id":"stack","label":"stack","v":["((1), 0)"],"cls":[""]}],"vars":[["target","7",0]],"stack":[]},{"caption":"<code>node, total = stack.pop()</code> &mdash; <code>((1), 0)</code> popped off the end of <code>stack</code>; <code>total = 0</code>","line":4,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427016976","4",0.0,2.5,"",[]],["n4426912528","2",1.0,1.25,"",[]],["n4427151552","1",2.0,0.0,"cur",["root","node"]],["n4426918288","3",3.0,1.25,"",[]]],"edges":[["n4427151552","n4426912528","",""],["n4426912528","n4427016976","",""],["n4427151552","n4426918288","",""]],"dir":false},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["target","7",0],["total","0",1]],"stack":[]},{"caption":"<code>total += node.val</code> &mdash; <code>total = 1</code>","line":5,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427016976","4",0.0,2.5,"",[]],["n4426912528","2",1.0,1.25,"",[]],["n4427151552","1",2.0,0.0,"cur",["root","node"]],["n4426918288","3",3.0,1.25,"",[]]],"edges":[["n4427151552","n4426912528","",""],["n4426912528","n4427016976","",""],["n4427151552","n4426918288","",""]],"dir":false},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["target","7",0],["total","1",1]],"stack":[]},{"caption":"<code>if node.left is None and node.right is None and total == target:</code> &rarr; <strong>false</strong> (target = 7, total = 1)","line":6,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427016976","4",0.0,2.5,"",[]],["n4426912528","2",1.0,1.25,"",[]],["n4427151552","1",2.0,0.0,"cur",["root","node"]],["n4426918288","3",3.0,1.25,"",[]]],"edges":[["n4427151552","n4426912528","",""],["n4426912528","n4427016976","",""],["n4427151552","n4426918288","",""]],"dir":false},{"t":"arr","id":"stack","label":"stack","v":[],"cls":[],"noidx":true}],"vars":[["target","7",0],["total","1",0]],"stack":[]},{"caption":"<code>for child in (node.left, node.right):</code>","line":8,"panels":[{"t":"net","id":"tree0","label":"tree","nodes":[["n4427016976","4",0.0,2.5,"",[]],["n4426912528","2",1.0,1.25,"cur",["child"]],["n4427151552","1",2.0,0.0,"cur",["root","node"]],["n4426918288","3",3.0,1.25,"",[]]],"edges":[["n4427151552","n44269125